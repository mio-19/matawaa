From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 2 Nov 2026 20:05:55 +1100
Subject: [PATCH] overlay/asteroidos, examples/asteroid: fix app execution,
 invoker paths, QML plugins, ngfd and timed

---
 examples/asteroid/asteroid-desktop.nix        | 57 ++++++++++---------
 overlay/asteroidos/apps/twenty48-qt6.patch    | 10 ++++
 overlay/asteroidos/default.nix                |  2 +-
 overlay/asteroidos/lib/mk-asteroid-app.nix    |  8 +++
 .../nemo-qml-plugin-alarms/default.nix        |  6 +-
 .../nemo-qml-plugin-notifications/default.nix |  6 +-
 overlay/asteroidos/ngfd/default.nix           |  6 ++
 7 files changed, 66 insertions(+), 29 deletions(-)

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index 476f571c..bcb3f0ea 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -232,9 +232,12 @@ in
       # Upstream nfcd state storage directory.
       "d /var/lib/nfcd 0700 root root -"
       # Upstream timed_git.bb creates /var/lib/timed for shared events/settings.
-      "d /var/lib/timed 0775 root root -"
-      "d /var/lib/timed/shared_events 0775 root root -"
-      "d /var/lib/timed/shared_settings 0775 root root -"
+      # timed runs in user session (ceres), so shared events/settings must be owned by ceres.
+      "d /var/lib/timed 0775 ceres users -"
+      "d /var/lib/timed/shared_events 0775 ceres users -"
+      "d /var/lib/timed/shared_settings 0775 ceres users -"
+      # Upstream timed looks for time zone files in standard /usr/share/zoneinfo
+      "L+ /usr/share/zoneinfo - - - - ${pkgs.tzdata}/share/zoneinfo"
       # Upstream supported-languages_git.bb seeds the ceres locale drop-in that
       # user@.service.d/locale.conf reads (installed via environment.etc below).
       "d /home/.system/var/lib/environment/1000 0755 ceres users -"
@@ -657,28 +660,30 @@ in
       wantedBy = [ "default.target" ];
       requires = [ "dbus.socket" ];
       unitConfig.ConditionUser = "!root";
-      environment = {
-        QT_IM_MODULE = "qtvirtualkeyboard";
-        QT_VIRTUALKEYBOARD_STYLE = "watch";
-        QT_VIRTUALKEYBOARD_LAYOUT_PATH = "${pkgs.asteroid.virtualkeyboard}/share/qtvirtualkeyboard/layouts";
-        RIME_SHARED_DATA_DIR = "${pkgs.asteroid.virtualkeyboard}/share/rime-data";
-        # The launcher is the compositor: use the hwcomposer QPA, not xcb.
-        EGL_PLATFORM = "hwcomposer";
-        QT_QPA_PLATFORM = "hwcomposer";
-        # Upstream Qt selects the libhybris EGL server buffer integration
-        # automatically; Qt 6.12's loadServerBufferIntegration() only loads a
-        # key named in this variable, so name the same upstream integration.
-        QT_WAYLAND_SERVER_BUFFER_INTEGRATION = "libhybris-egl-server";
-        LD_PRELOAD = "${pkgs.libhybris}/lib/libEGL.so.1 ${pkgs.libhybris}/lib/libGLESv2.so.2";
-        LD_LIBRARY_PATH = "${pkgs.libhybris}/lib";
-        QT_ENABLE_GLYPH_CACHE_WORKAROUND = "true";
-        QT_GSTREAMER_CAMERABIN_SRC = "droidcamsrc";
-        # Direct Qt diagnostic logs to stderr/launcher.log instead of hidden journal
-        QT_FORCE_STDERR_LOGGING = "1";
-        QT_ASSUME_STDERR_HAS_CONSOLE = "1";
-      }
-      // config.environment.variables
-      // lib.optionalAttrs debugBuild {
+      environment =
+        config.environment.variables
+        // {
+          PATH = lib.mkForce "/run/wrappers/bin:/run/current-system/sw/bin";
+          QT_IM_MODULE = "qtvirtualkeyboard";
+          QT_VIRTUALKEYBOARD_STYLE = "watch";
+          QT_VIRTUALKEYBOARD_LAYOUT_PATH = "${pkgs.asteroid.virtualkeyboard}/share/qtvirtualkeyboard/layouts";
+          RIME_SHARED_DATA_DIR = "${pkgs.asteroid.virtualkeyboard}/share/rime-data";
+          # The launcher is the compositor: use the hwcomposer QPA, not xcb.
+          EGL_PLATFORM = "hwcomposer";
+          QT_QPA_PLATFORM = "hwcomposer";
+          # Upstream Qt selects the libhybris EGL server buffer integration
+          # automatically; Qt 6.12's loadServerBufferIntegration() only loads a
+          # key named in this variable, so name the same upstream integration.
+          QT_WAYLAND_SERVER_BUFFER_INTEGRATION = "libhybris-egl-server";
+          LD_PRELOAD = "${pkgs.libhybris}/lib/libEGL.so.1 ${pkgs.libhybris}/lib/libGLESv2.so.2";
+          LD_LIBRARY_PATH = "${pkgs.libhybris}/lib";
+          QT_ENABLE_GLYPH_CACHE_WORKAROUND = "true";
+          QT_GSTREAMER_CAMERABIN_SRC = "droidcamsrc";
+          # Direct Qt diagnostic logs to stderr/launcher.log instead of hidden journal
+          QT_FORCE_STDERR_LOGGING = "1";
+          QT_ASSUME_STDERR_HAS_CONSOLE = "1";
+        }
+        // lib.optionalAttrs debugBuild {
         # Debug builds: turn on every trace the graphics stack can emit.
         # These are runtime switches only; the upstream code path is unchanged.
         # `*=false` also silences the default category, which is where QML
@@ -762,7 +767,7 @@ in
       serviceConfig = {
         Type = "simple";
         ExecStartPre = "-${pkgs.coreutils}/bin/sleep 1";
-        ExecStart = "${pkgs.bash}/bin/bash -ec 'if [ \"$(/system/bin/getprop sys.boot_completed)\" != 1 ]; then /system/bin/setprop sys.boot_completed 1; fi'";
+        ExecStart = "${pkgs.bash}/bin/bash -ec 'if [ \"$(env -u LD_PRELOAD -u LD_LIBRARY_PATH /system/bin/getprop sys.boot_completed)\" != 1 ]; then env -u LD_PRELOAD -u LD_LIBRARY_PATH /system/bin/setprop sys.boot_completed 1; fi'";
       };
     };
 
diff --git a/overlay/asteroidos/apps/twenty48-qt6.patch b/overlay/asteroidos/apps/twenty48-qt6.patch
index f9607f14..cc32a582 100644
--- a/overlay/asteroidos/apps/twenty48-qt6.patch
+++ b/overlay/asteroidos/apps/twenty48-qt6.patch
@@ -122,3 +122,13 @@ diff -Naur a/src/main.cpp b/src/main.cpp
 +    view->show();
 +    return app->exec();
  }
+diff -Naur a/src/Game.qml b/src/Game.qml
+--- a/src/Game.qml	2026-10-18 16:11:39.875790324 +1100
++++ b/src/Game.qml	2026-10-18 16:11:50.759792980 +1100
+@@ -1,6 +1,5 @@
+ import QtQuick 2.9
+ import Nemo.Configuration 1.0
+-import org.nemomobile.lipstick 0.1
+ 
+ Item {
+     id: main
diff --git a/overlay/asteroidos/default.nix b/overlay/asteroidos/default.nix
index 964a67bf..f8ff2194 100644
--- a/overlay/asteroidos/default.nix
+++ b/overlay/asteroidos/default.nix
@@ -2,7 +2,7 @@
 
 rec {
   mkAsteroidApp = callPackage ./lib/mk-asteroid-app.nix {
-    inherit qml-asteroid;
+    inherit qml-asteroid mapplauncherd;
   };
 
   qml-asteroid = callPackage ./qml-asteroid { };
diff --git a/overlay/asteroidos/lib/mk-asteroid-app.nix b/overlay/asteroidos/lib/mk-asteroid-app.nix
index f89af365..1f0eb3e1 100644
--- a/overlay/asteroidos/lib/mk-asteroid-app.nix
+++ b/overlay/asteroidos/lib/mk-asteroid-app.nix
@@ -7,6 +7,7 @@
   pkg-config,
   qt6,
   qml-asteroid,
+  mapplauncherd,
   kdePackages,
   buildPackages,
 }:
@@ -87,6 +88,13 @@ stdenv.mkDerivation (finalAttrs: {
   ]
   ++ extraBuildInputs;
 
+  # Self-contained app launcher scripts: ensure invoker is resolved to its absolute Nix store path
+  postFixup = ''
+    if [ -d "$out/bin" ]; then
+      find "$out/bin" -type f -exec sed -i "s|\\bexec invoker\\b|exec ${mapplauncherd}/bin/invoker|g" {} +
+    fi
+  '';
+
   meta =
     with lib;
     {
diff --git a/overlay/asteroidos/nemo-qml-plugin-alarms/default.nix b/overlay/asteroidos/nemo-qml-plugin-alarms/default.nix
index 2d20303c..261c3149 100644
--- a/overlay/asteroidos/nemo-qml-plugin-alarms/default.nix
+++ b/overlay/asteroidos/nemo-qml-plugin-alarms/default.nix
@@ -99,7 +99,6 @@ stdenv.mkDerivation (finalAttrs: {
     )
 
     set_target_properties(nemoalarms PROPERTIES
-      PREFIX ""
       OUTPUT_NAME nemoalarms
       LIBRARY_OUTPUT_DIRECTORY "''${CMAKE_CURRENT_BINARY_DIR}"
     )
@@ -110,6 +109,11 @@ stdenv.mkDerivation (finalAttrs: {
     EOF
   '';
 
+  postInstall = ''
+    # Provide both libnemoalarms.so and nemoalarms.so symlinks for QML plugin loader
+    ln -s libnemoalarms.so $out/lib/qt-6/qml/Nemo/Alarms/nemoalarms.so
+  '';
+
   cmakeFlags = [
     "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
     "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
diff --git a/overlay/asteroidos/nemo-qml-plugin-notifications/default.nix b/overlay/asteroidos/nemo-qml-plugin-notifications/default.nix
index ea808abd..3b6dc415 100644
--- a/overlay/asteroidos/nemo-qml-plugin-notifications/default.nix
+++ b/overlay/asteroidos/nemo-qml-plugin-notifications/default.nix
@@ -78,7 +78,6 @@ stdenv.mkDerivation (finalAttrs: {
       Qt6::Qml
       Qt6::DBus)
     set_target_properties(nemonotifications PROPERTIES
-      PREFIX ""
       OUTPUT_NAME nemonotifications)
 
     install(TARGETS nemonotifications-qt6 DESTINATION lib)
@@ -95,6 +94,11 @@ stdenv.mkDerivation (finalAttrs: {
     EOF
   '';
 
+  postInstall = ''
+    # Provide both libnemonotifications.so and nemonotifications.so symlinks for QML plugin loader
+    ln -s libnemonotifications.so $out/lib/qt-6/qml/Nemo/Notifications/nemonotifications.so
+  '';
+
   cmakeFlags = [
     "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
     "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
diff --git a/overlay/asteroidos/ngfd/default.nix b/overlay/asteroidos/ngfd/default.nix
index 3bd40e33..e82464c0 100644
--- a/overlay/asteroidos/ngfd/default.nix
+++ b/overlay/asteroidos/ngfd/default.nix
@@ -55,6 +55,12 @@ stdenv.mkDerivation (finalAttrs: {
     pkg-config
   ];
 
+  # GCC preprocessor defines `linux=1` by default on GNU/Linux. When Autotools bakes
+  # -DDEFAULT_PLUGIN_PATH=@NGFD_PLUGIN_DIR@ into ngfd, the path component
+  # `armv7l-unknown-linux-gnueabihf` gets corrupted into `armv7l-unknown-1-gnueabihf`,
+  # causing ngfd to fail to locate plugins. Undefine `linux` with `-Ulinux`.
+  NIX_CFLAGS_COMPILE = [ "-Ulinux" ];
+
   buildInputs = [
     glib
     libpulseaudio
