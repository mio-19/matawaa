diff --git a/overlay/asteroidos/virtualkeyboard/layouts/phone/main.qml b/overlay/asteroidos/virtualkeyboard/layouts/phone/main.qml
new file mode 100644
index 00000000..0fc5ec0c
--- /dev/null
+++ b/overlay/asteroidos/virtualkeyboard/layouts/phone/main.qml
@@ -0,0 +1,135 @@
+import QtQuick
+import QtQuick.VirtualKeyboard
+import QtQuick.VirtualKeyboard.Plugins.Rime
+
+KeyboardLayout {
+    id: phoneLayout
+    inputMode: InputEngine.InputMode.Latin
+
+    PhoneInputBridge {
+        id: phoneBridge
+        onTextCommitted: function(text) {
+            InputContext.commit(text)
+        }
+    }
+
+    Component.onCompleted: {
+        phoneBridge.requestInput()
+    }
+
+    Component.onDestruction: {
+        phoneBridge.closeInput()
+    }
+
+    keyWeight: 160
+    KeyboardRow {
+        Key { key: Qt.Key_Q; text: "q" }
+        Key { key: Qt.Key_W; text: "w" }
+        Key { key: Qt.Key_E; text: "e" }
+        Key { key: Qt.Key_R; text: "r" }
+        Key { key: Qt.Key_T; text: "t" }
+        Key { key: Qt.Key_Y; text: "y" }
+        Key { key: Qt.Key_U; text: "u" }
+        Key { key: Qt.Key_I; text: "i" }
+        Key { key: Qt.Key_O; text: "o" }
+        Key { key: Qt.Key_P; text: "p" }
+        BackspaceKey {}
+    }
+    KeyboardRow {
+        FillerKey { weight: 56 }
+        Key { key: Qt.Key_A; text: "a" }
+        Key { key: Qt.Key_S; text: "s" }
+        Key { key: Qt.Key_D; text: "d" }
+        Key { key: Qt.Key_F; text: "f" }
+        Key { key: Qt.Key_G; text: "g" }
