diff --git a/overlay/asteroidos/virtualkeyboard/0001-add-rime-plugin-and-layouts.patch b/overlay/asteroidos/virtualkeyboard/0001-add-rime-plugin-and-layouts.patch
new file mode 100644
index 00000000..8bb79c6b
--- /dev/null
+++ b/overlay/asteroidos/virtualkeyboard/0001-add-rime-plugin-and-layouts.patch
@@ -0,0 +1,52 @@
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -9,6 +9,39 @@
+ include(FeatureSummary)
+ include(GNUInstallDirs)
+ 
++find_package(Qt6 REQUIRED COMPONENTS Core Gui Qml Quick VirtualKeyboard DBus)
++find_package(PkgConfig REQUIRED)
++pkg_check_modules(RIME REQUIRED rime)
++
+ add_subdirectory(styles)
+ 
++qt_add_qml_module(qtvkbrimeplugin
++    URI "QtQuick.VirtualKeyboard.Plugins.Rime"
++    VERSION 1.0
++    PLUGIN_TARGET qtvkbrimeplugin
++    SOURCES
++        rimeinputmethod.h
++        rimeinputmethod.cpp
++        phoneinputbridge.h
++        phoneinputbridge.cpp
++)
++
++target_include_directories(qtvkbrimeplugin PRIVATE ${RIME_INCLUDE_DIRS})
++target_link_libraries(qtvkbrimeplugin PRIVATE
++    Qt6::Core
++    Qt6::Gui
++    Qt6::Qml
++    Qt6::VirtualKeyboard
++    Qt6::DBus
++    ${RIME_LIBRARIES}
++)
++
++install(TARGETS qtvkbrimeplugin
++    DESTINATION "${CMAKE_INSTALL_LIBDIR}/qt-6/qml/QtQuick/VirtualKeyboard/Plugins/Rime"
++)
++
++install(DIRECTORY layouts/
++    DESTINATION "${CMAKE_INSTALL_DATADIR}/qtvirtualkeyboard/layouts"
++)
++
+ feature_summary(WHAT ALL FATAL_ON_MISSING_REQUIRED_PACKAGES)
+--- a/styles/watch/CMakeLists.txt
++++ b/styles/watch/CMakeLists.txt
+@@ -1,4 +1,6 @@
+-set(STYLEDEST "${CMAKE_INSTALL_LIBDIR}/qml/QtQuick/VirtualKeyboard/Styles/watch")
++set(STYLEDEST "${CMAKE_INSTALL_LIBDIR}/qt-6/qml/QtQuick/VirtualKeyboard/Styles/watch")
+ install(FILES style.qml DESTINATION "${STYLEDEST}")
+ install(DIRECTORY images/ DESTINATION "${STYLEDEST}/images")
+ 
++install(FILES style.qml DESTINATION "${CMAKE_INSTALL_LIBDIR}/qml/QtQuick/VirtualKeyboard/Styles/watch")
++install(DIRECTORY images/ DESTINATION "${CMAKE_INSTALL_LIBDIR}/qml/QtQuick/VirtualKeyboard/Styles/watch/images")
diff --git a/overlay/asteroidos/virtualkeyboard/default.nix b/overlay/asteroidos/virtualkeyboard/default.nix
new file mode 100644
index 0000000000000000000000000000000000000000..9ad1a161a816d346c7346f4b6b7927817e43a520
--- /dev/null
+++ b/overlay/asteroidos/virtualkeyboard/default.nix
@@ -0,0 +1,79 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  librime,
+  rime-data,
+  buildPackages,
+  noUsrShareHook,
+}:
+
+stdenv.mkDerivation {
+  pname = "asteroid-virtualkeyboard";
+  version = "2.1.0";
+
+  src = fetchFromGitHub {
+    owner = "AsteroidOS";
+    repo = "asteroid-virtualkeyboard";
+    rev = "666743fc42eaa02b9f82155ff3aff3a40e0d45ac";
+    hash = "sha256-Tu466ws5L3cY92i6RRLPFBgANBMJX0lpPPjcEgbugXs=";
+  };
+
+  patches = [
+    ./0001-add-rime-plugin-and-layouts.patch
+  ];
+
+  postPatch = ''
+    cp ${./rimeinputmethod.cpp} rimeinputmethod.cpp
+    cp ${./rimeinputmethod.h} rimeinputmethod.h
+    cp ${./phoneinputbridge.cpp} phoneinputbridge.cpp
+    cp ${./phoneinputbridge.h} phoneinputbridge.h
+    substituteInPlace rimeinputmethod.cpp \
+      --replace-fail '"/usr/share/rime-data"' '"${rime-data}/share/rime-data"'
+    mkdir -p layouts
+    cp -r ${./layouts}/* layouts/
+  '';
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+    noUsrShareHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    qt6.qtvirtualkeyboard
+    librime
+  ];
+
+  cmakeFlags = [
+    "-DCMAKE_INSTALL_LIBDIR=lib"
+    "-DCMAKE_INSTALL_DATADIR=share"
+  ]
+  ++ lib.optionals (!stdenv.buildPlatform.canExecute stdenv.hostPlatform) [
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+  ];
+
+  # Reuse nixpkgs' compiled schemas and dictionaries instead of redeploying
+  # them locally with ignored errors.
+  postInstall = ''
+    mkdir -p "$out/share/rime-data"
+    cp -r ${rime-data}/share/rime-data/. "$out/share/rime-data/"
+  '';
+
+  meta = with lib; {
+    description = "AsteroidOS on-screen virtual keyboard with watch style, layouts, and integrated RIME input method engine";
+    homepage = "https://asteroidos.org/";
+    license = licenses.gpl3Only;
+    platforms = platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/virtualkeyboard/layouts/en_GB/main.qml b/overlay/asteroidos/virtualkeyboard/layouts/en_GB/main.qml
new file mode 100644
index 00000000..81489b12
--- /dev/null
+++ b/overlay/asteroidos/virtualkeyboard/layouts/en_GB/main.qml
@@ -0,0 +1,127 @@
+import QtQuick
+import QtQuick.VirtualKeyboard
+import QtQuick.VirtualKeyboard.Plugins.Rime
+
+KeyboardLayout {
+    id: enGBLayout
+    inputMode: InputEngine.InputMode.Latin
+
+    PhoneInputBridge {
+        id: phoneBridge
+        onTextCommitted: function(text) {
+            InputContext.commit(text)
+        }
+    }
+
+    keyWeight: 160
+    KeyboardRow {
+        Key { key: Qt.Key_Q; text: "q" }
+        Key { key: Qt.Key_W; text: "w" }
+        Key { key: Qt.Key_E; text: "e" }
+        Key { key: Qt.Key_R; text: "r" }
+        Key { key: Qt.Key_T; text: "t" }
+        Key { key: Qt.Key_Y; text: "y" }
+        Key { key: Qt.Key_U; text: "u" }
+        Key { key: Qt.Key_I; text: "i" }
+        Key { key: Qt.Key_O; text: "o" }
+        Key { key: Qt.Key_P; text: "p" }
+        BackspaceKey {}
+    }
+    KeyboardRow {
+        FillerKey { weight: 56 }
+        Key { key: Qt.Key_A; text: "a" }
+        Key { key: Qt.Key_S; text: "s" }
+        Key { key: Qt.Key_D; text: "d" }
+        Key { key: Qt.Key_F; text: "f" }
+        Key { key: Qt.Key_G; text: "g" }
+        Key { key: Qt.Key_H; text: "h" }
+        Key { key: Qt.Key_J; text: "j" }
+        Key { key: Qt.Key_K; text: "k" }
+        Key { key: Qt.Key_L; text: "l" }
+        EnterKey { weight: 283 }
+    }
+    KeyboardRow {
+        keyWeight: 156
+        ShiftKey {}
+        Key { key: Qt.Key_Z; text: "z" }
+        Key { key: Qt.Key_X; text: "x" }
+        Key { key: Qt.Key_C; text: "c" }
+        Key { key: Qt.Key_V; text: "v" }
+        Key { key: Qt.Key_B; text: "b" }
+        Key { key: Qt.Key_N; text: "n" }
+        Key { key: Qt.Key_M; text: "m" }
+        Key { key: Qt.Key_Apostrophe; text: "'"; alternativeKeys: "\"`" }
+        Key { key: Qt.Key_Comma; text: "," }
+        Key { key: Qt.Key_Period; text: "." }
+    }
+    KeyboardRow {
+        keyWeight: 154
+        SymbolModeKey { weight: 200 }
+        ChangeLanguageKey { weight: 140 }
+        Key {
+            weight: 140
+            text: phoneBridge.active ? "📱✓" : "📱"
+            functionKey: true
+            onClicked: {
+                if (phoneBridge.active) {
+                    phoneBridge.closeInput()
+                } else {
+                    phoneBridge.requestInput()
+                }
+            }
+        }
+        SpaceKey { weight: 740 }
+        HideKeyboardKey { weight: 180 }
+    }
+
+    Rectangle {
+        id: phoneStatusPill
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.top: parent.top
+        anchors.topMargin: 2
+        height: 22
+        width: Math.min(statusLabel.implicitWidth + 18, parent.width * 0.85)
+        radius: 11
+        color: "#e61c1c1e"
+        border.color: phoneBridge.active ? "#34c759" : "#8e8e93"
+        border.width: 1
+        visible: opacity > 0.0
+        opacity: pillTimer.running ? 0.95 : 0.0
+        Behavior on opacity { NumberAnimation { duration: 250 } }
+        z: 50
+
+        Timer {
+            id: pillTimer
+            interval: 2500
+            running: false
+        }
+
+        Connections {
+            target: phoneBridge
+            function onActiveChanged() {
+                pillTimer.restart()
+            }
+            function onStatusTextChanged() {
+                pillTimer.restart()
+            }
+        }
+
+        Text {
+            id: statusLabel
+            width: parent.width - 18
+            elide: Text.ElideRight
+            horizontalAlignment: Text.AlignHCenter
+            anchors.centerIn: parent
+            text: "📱 " + phoneBridge.statusText
+            color: "#ffffff"
+            font.pixelSize: 11
+        }
+
+        MouseArea {
+            anchors.fill: parent
+            onClicked: {
+                phoneBridge.closeInput()
+            }
+        }
+    }
+}
