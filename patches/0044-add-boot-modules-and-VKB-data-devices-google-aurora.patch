+# Modules whose .ko files live on the rootfs (/lib/modules/<KREL>/vendor/)
+# and therefore cannot be loaded from the VKB initramfs modules.load.aurora.
+# Systemd's systemd-modules-load.service walks this file at boot, after the
+# rootfs is mounted -- modprobe then resolves dependencies from modules.dep.
+# Order is informational; modprobe handles dep resolution.
+
+# --- WLAN (qcacld-3.0 + CNSS platform glue) ---
+# wlan.ko is the qcacld driver. icnss2 is the integrated cnss subsystem that
+# brokers WLFW QMI between the driver and the modem firmware. The cnss_*
+# helpers are utility modules.
+wlan
+icnss2
+cnss_nl
+cnss_plat_ipc_qmi_svc
+cnss_prealloc
+cnss_utils
+wlan_firmware_service
+google_wlan_mac
+
+# --- ASoC machine driver + codecs ---
+# machine_dlkm is monaco-asoc-snd. Pulls bolero/wcd/wsa/macros/swr via deps.
+# We list a few key ones explicitly so a stale modules.dep does not bite.
+machine_dlkm
+stub_dlkm
+bolero_cdc_dlkm
+besbev_dlkm
+besbev-slave_dlkm
+wsa883x_dlkm
+wcd9xxx_dlkm
+wcd_core_dlkm
+rx_macro_dlkm
+tx_macro_dlkm
+va_macro_dlkm
+swr_dlkm
+swr_ctrl_dlkm
+pinctrl_lpi_dlkm
+pmw5100-spmi_dlkm
+cc_dlkm
+audio_cc_ipc_dlkm
+
+# --- BT slimbus codec + power (gated by qcom,wcn-btfm in DT) ---
+# bt_fm_slim registers "btfmslim_slave" -- required by monaco-asoc-snd's WCN BT
+# dai_links.
+bt_fm_slim
+btpower
+
+# --- BT vHCI (host-side virtual HCI for bluebinder) ---
+hci_vhci
diff --git a/devices/google-aurora/boot/aurora-vkb-assemble.py b/devices/google-aurora/boot/aurora-vkb-assemble.py
new file mode 100755
index 00000000..cefa669a
--- /dev/null
+++ b/devices/google-aurora/boot/aurora-vkb-assemble.py
@@ -0,0 +1,280 @@
+#!/usr/bin/env python3
+# Assemble vendor_kernel_boot.img's ramdisk directory from a declarative
+# manifest. Standalone so it's testable outside bitbake.
+#
+# Usage:
+#   aurora-vkb-assemble.py \
+#       --manifest aurora-vkb-modules.lst \
+#       --kernel-pkgdir <linux-aurora's package/usr/lib/modules/5.15.144/kernel> \
+#       --techpack-dir  <linux-aurora-modules ipk-extracted root> \
+#       --symvers       <kernel's Module.symvers> \
+#       --static-dir    <static metadata: modules.alias etc.> \
+#       --out           <ramdisk staging dir>
+#
+# Exits non-zero on any KMI-CRC mismatch, missing module, or @drop entry whose
+# .ko was accidentally also listed.
+
+import argparse
+import os
+import re
+import shutil
+import struct
+import subprocess
+import sys
+from pathlib import Path
+
+
+def find_ko(roots, name):
+    """Find <name>.ko under any of roots (excluding .debug/), trying
+    dash/underscore variants. Returns the first match or None."""
+    variants = [name, name.replace("_", "-"), name.replace("-", "_")]
+    for root in roots:
+        if not root or not os.path.isdir(root):
+            continue
+        for variant in variants:
+            for dirpath, _, files in os.walk(root):
+                if "/.debug" in dirpath or dirpath.endswith("/.debug"):
+                    continue
+                fname = f"{variant}.ko"
+                if fname in files:
+                    return os.path.join(dirpath, fname)
+    return None
+
+
+def parse_manifest(path):
+    """Yields (kind, payload) tuples. kind in {'module', 'drop', 'dep'}."""
+    with open(path) as f:
+        for lineno, raw in enumerate(f, 1):
+            line = raw.split("#", 1)[0].strip()
+            if not line:
+                continue
+            if line.startswith("@drop "):
+                yield ("drop", line[len("@drop "):].strip())
+                continue
+            if line.startswith("@dep "):
+                # @dep child.ko: parent1.ko parent2.ko
+                body = line[len("@dep "):]
+                if ":" not in body:
+                    sys.exit(f"manifest:{lineno}: @dep missing ':' -- {raw!r}")
+                child, rest = body.split(":", 1)
+                yield ("dep", (child.strip(), rest.strip()))
+                continue
+            if ":" not in line:
+                sys.exit(f"manifest:{lineno}: missing src tag (:k or :tp) -- {raw!r}")
+            name, src = line.rsplit(":", 1)
+            name, src = name.strip(), src.strip()
+            if src not in ("k", "tp"):
+                sys.exit(f"manifest:{lineno}: src tag must be 'k' or 'tp', got {src!r}")
+            yield ("module", (name, src))
+
+
+# Find the module_layout symbol's CRC inside a .ko. The kernel writes CRC32s as
+# little-endian u32 immediately before each __ksymtab_strings entry; finding
+# "module_layout\0" in the strings and reading back 8 bytes (CRC + alignment
+# pad on some kernels, but the CRC is the low u32) matches what reassemble.sh's
+# KMI gate does.
+MOD_LAYOUT_SYM = b"module_layout\x00"
+
+
+def module_layout_crc(ko_path):
+    data = Path(ko_path).read_bytes()
+    m = re.search(MOD_LAYOUT_SYM, data)
+    if not m or m.start() < 8:
+        return None
+    # 8 bytes before the symbol string contains the CRC (u32 little-endian)
+    # followed by padding. Low u32 is the CRC.
+    return struct.unpack("<I", data[m.start() - 8:m.start() - 4])[0]
+
+
+def kernel_module_layout_crc(symvers_path):
+    """Read the kernel-side module_layout CRC from Module.symvers."""
+    with open(symvers_path) as f:
+        for line in f:
+            parts = line.split()
+            if len(parts) >= 2 and parts[1] == "module_layout":
+                return int(parts[0], 16) & 0xFFFFFFFF
+    return None
+
+
+# Only modules in this set get strip --strip-debug. Everything else ships at
+# the size it landed in $FND (foundational `:k` modules come pre-stripped by
+# OE's split-debug behavior) or the techpack ipk (techpack mods have debug info
+# but it doesn't blow the partition cap, except for wlan.ko).
+#
+# Why not strip everything? Empirically: stripping msm_drm.ko and msm_kgsl.ko
+# bricks boot at the G logo on aurora -- likely CFI / build metadata in
+# non-.debug_* sections that --strip-debug nonetheless drops on this
+# clang/kernel combo. Only wlan.ko genuinely *needs* stripping (it's 333 MB
+# raw; everything else fits within the 64 MB lz4-cpio cap unstripped).
+STRIP_MODULES = {"wlan"}
+
+
+def strip_debug(ko_path, strip_bin):
+    """Run host strip --strip-debug if this module is in STRIP_MODULES."""
+    name = Path(ko_path).stem
+    if name not in STRIP_MODULES:
+        return
+    try:
+        subprocess.run(
+            [strip_bin, "--strip-debug", ko_path],
+            check=True, capture_output=True
+        )
+    except (subprocess.CalledProcessError, FileNotFoundError):
+        # Non-fatal; .ko stays at full size. Larger ramdisk but bootable.
+        pass
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--manifest", required=True)
+    ap.add_argument("--kernel-pkgdir", required=True,
+                    help="linux-aurora's package/usr/lib/modules/<v>/kernel")
+    ap.add_argument("--techpack-dir", required=True,
+                    help="linux-aurora-modules ipk-extracted root")
+    ap.add_argument("--symvers", required=True,
+                    help="Kernel Module.symvers (for module_layout CRC)")
+    ap.add_argument("--static-dir", required=True,
+                    help="Stock metadata: modules.alias, modules.softdep, modules.load.charger")
+    ap.add_argument("--out", required=True,
+                    help="Output ramdisk staging dir (will be wiped)")
+    ap.add_argument("--strip", default="/usr/bin/strip")
+    args = ap.parse_args()
+
+    out = Path(args.out)
+    if out.exists():
+        shutil.rmtree(out)
+    md = out / "lib" / "modules"
+    md.mkdir(parents=True)
+
+    # KMI reference
+    kcrc = kernel_module_layout_crc(args.symvers)
+    if kcrc is None:
+        sys.exit(f"ABORT: module_layout CRC not in {args.symvers}")
+    print(f"== kernel module_layout CRC = 0x{kcrc:08x}")
+
+    modules_in_order = []   # [(name, ko_path, src)]
+    dropped = set()
+    deps = []               # [(child, parents_str)]
+
+    for kind, payload in parse_manifest(args.manifest):
+        if kind == "drop":
+            dropped.add(payload)
+        elif kind == "dep":
+            deps.append(payload)
+        else:
+            name, src = payload
+            if name in dropped:
+                sys.exit(f"ABORT: manifest lists {name} but @drop'd earlier")
+            roots = ([args.kernel_pkgdir] if src == "k"
+                     else [args.techpack_dir])
+            ko = find_ko(roots, name)
+            if not ko:
+                # Fallback search the other source. Helps catch a misclassified
+                # tag rather than failing with a generic "not built".
+                fallback = ([args.techpack_dir] if src == "k"
+                            else [args.kernel_pkgdir])
+                ko2 = find_ko(fallback, name)
+                hint = (f" (found in {'techpack' if src == 'k' else 'kernel-pkg'}"
+                        f" -- wrong :{src} tag?)" if ko2 else "")
+                sys.exit(f"ABORT: {name}.ko not built in {src}-source{hint}")
+            modules_in_order.append((name, ko, src))
+
+    # Copy + strip + KMI-gate
+    failed = []
+    for name, ko_src, src in modules_in_order:
+        dst = md / f"{name}.ko"
+        shutil.copy(ko_src, dst)
+        os.chmod(dst, 0o644)
+        strip_debug(str(dst), args.strip)
+        crc = module_layout_crc(str(dst))
+        if crc != kcrc:
+            failed.append((name, src, f"0x{crc:08x}" if crc else "none"))
+    if failed:
+        for n, s, c in failed:
+            print(f"  KMI FAIL: {n}.ko ({s}) module_layout={c} (expected 0x{kcrc:08x})")
+        sys.exit(f"ABORT: KMI-CRC gate failed for {len(failed)} module(s)")
+    print(f"== KMI gate PASSED ({len(modules_in_order)} modules @ CRC 0x{kcrc:08x})")
+
+    # modules.load + modules.load.recovery
+    load_lines = [f"{n}.ko\n" for (n, _, _) in modules_in_order]
+    (md / "modules.load").write_text("".join(load_lines))
+    (md / "modules.load.recovery").write_text("".join(load_lines))
+    print(f"== modules.load + modules.load.recovery: {len(load_lines)} entries")
+
+    # modules.dep -- start from the stock vkbrd modules.dep (with FULL
+    # symbol-dep info for the 96 foundational modules), then apply @dep
+    # overrides from the manifest. Empty deps would make modprobe attempt naked
+    # insmod and the kernel rejects with "Unknown symbol", which we observed
+    # brick boot at 'init: Waiting for mmcblk0p82' (sdhci-msm needed
+    # crypto_qti_disable / cqhci_*; clk-qcom needed gdsc_*; etc.).
+    #
+    # Stock format: "/lib/modules/X.ko: /lib/modules/Y.ko /lib/modules/Z.ko"
+    # Manifest @dep format: "X.ko: Y.ko Z.ko" -- we normalise the bare names to
+    # the /lib/modules/ prefix for consistency.
+    PFX = "/lib/modules/"
+    dep_map = {}  # key = "<X.ko>" (no prefix), value = list of "<Y.ko>" deps
+    static = Path(args.static_dir)
+
+    stock_dep = static / "modules.dep"
+    if stock_dep.is_file():
+        with stock_dep.open() as f:
+            for line in f:
+                line = line.strip()
+                if not line or ":" not in line:
+                    continue
+                key, rest = line.split(":", 1)
+                key = key.strip()
+                key = key[len(PFX):] if key.startswith(PFX) else key
+                if key in dropped:
+                    continue
+                ps = [p.strip() for p in rest.split() if p.strip()]
+                ps = [p[len(PFX):] if p.startswith(PFX) else p for p in ps]
+                ps = [p for p in ps if p[:-3] not in dropped]  # strip ".ko" before drop check
+                dep_map[key] = ps
+        print(f"== stock modules.dep: {len(dep_map)} entries seeded "
+              f"(dropped: {len(dropped)})")
+
+    # Ensure every module listed in the manifest has at least an entry (empty
+    # deps is acceptable for modules with no symbol-deps).
+    for name, _, _ in modules_in_order:
+        ko = f"{name}.ko"
+        if ko not in dep_map:
+            dep_map[ko] = []
+
+    # @dep overrides from the manifest. Manifest uses bare names; normalise.
+    overridden = 0
+    for child, parents in deps:
+        child = child.strip()
+        if child not in dep_map:
+            print(f"  WARN: @dep {child} not in module list -- still recording")
+            dep_map[child] = []
+        parsed = [p.strip() for p in parents.split() if p.strip()]
+        # Allow either bare or prefixed in the manifest
+        parsed = [p[len(PFX):] if p.startswith(PFX) else p for p in parsed]
+        dep_map[child] = parsed
+        overridden += 1
+
+    with (md / "modules.dep").open("w") as f:
+        for ko_name, deps_list in dep_map.items():
+            parts = [PFX + p for p in deps_list]
+            f.write(f"{PFX}{ko_name}:" + ("" if not parts else " " + " ".join(parts)) + "\n")
+    print(f"== modules.dep: {len(dep_map)} entries "
+          f"({overridden} @dep overrides applied)")
+
+    # Static metadata: ship as-is.
+    static = Path(args.static_dir)
+    for name in ("modules.alias", "modules.softdep", "modules.load.charger"):
+        src = static / name
+        if src.is_file():
+            shutil.copy(src, md / name)
+            print(f"== shipped static {name}")
+        else:
+            print(f"  WARN: static {name} missing")
+
+    # Size summary
+    total = sum(f.stat().st_size for f in md.glob("*.ko"))
+    print(f"== ramdisk content: {len(modules_in_order)} .ko (stripped {total} bytes)")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/devices/google-aurora/boot/aurora-vkb-modules.lst b/devices/google-aurora/boot/aurora-vkb-modules.lst
new file mode 100644
index 00000000..404336ee
--- /dev/null
+++ b/devices/google-aurora/boot/aurora-vkb-modules.lst
@@ -0,0 +1,327 @@
+# Aurora vendor_kernel_boot.img module manifest.
+#
+# Drives aurora-boot-images.bb: each entry below ends up as a .ko in
+# vendor_kernel_boot's ramdisk, KMI-CRC-gated against our 5.15 kernel,
+# listed in modules.load + modules.load.recovery (Halium first-stage
+# load_kernel_modules reads modules.load.recovery), and -- where a
+# dependency isn't picked up by modpost automatically -- pinned in
+# modules.dep so modprobe walks suppliers before consumers.
+#
+# Syntax:
+#   <name>:k                 -- kernel-built (linux-aurora kernel-modules)
+#   <name>:tp                -- techpack-built (linux-aurora-modules ipk)
+#   @drop <name>             -- skip stock module (not built / dropped intentionally)
+#   @dep <child>: <parents>  -- add modules.dep line (or override)
+#   # comment / blank        -- ignored
+
+# ────────────────── Foundational SoC chain (load order matters) ──────────────────
+# Mirrors stock vkbrd modules.load with our KMI-correct .ko copies. The
+# foundational ones all come from linux-aurora's kernel-modules package
+# (built via sw5100_gki_defconfig + the .fragment).
+sched-walt:k
+qcom_ipc_logging:k
+qcom-mpm:k
+pinctrl-msm:k
+pinctrl-monaco:k
+clk-qcom:k
+clk-dummy:k
+gdsc-regulator:k
+clk-smd-rpm:k
+dispcc-monaco:k
+gcc-monaco:k
+gpucc-monaco:k
+mdt_loader:k
+smem:k
+smp2p:k
+glink_probe:k
+secure_buffer:k
+mem_buf:k
+mem_buf_dev:k
+socinfo:k
+qcom_wdt_core:k
+qcom_soc_wdt:k
+memory_dump_v2:k
+dcc_v2:k
+qcom-pmu-lib:k
+qcom-dcvs:k
+bwmon:k
+panel_event_notifier:k
+qcom_cpu_vendor_hooks:k
+crypto-qti-common:k
+hwkm_v1:k
+crypto-qti-hwkm:k
+msm_performance:k
+minidump:k
+qcom_logbuf_vh:k
+qti-fixed-regulator:k
+
+# proxy-consumer is intentionally NOT built: CONFIG_REGULATOR_PROXY_CONSUMER
+# stays OFF in sw5100.fragment because enabling it triggers gcc-monaco
+# "Failed to register GCC clocks".
+# Stock vkbrd modules.load lists it; we drop it.
+@drop proxy-consumer
+
+rpm-smd-regulator:k
+stub-regulator:k
+debug-regulator:k
+arm_smmu:k
+msm_dma_iommu_mapping:k
+qcom_iommu_util:k
+iommu-logger:k
+regmap-spmi:k
+qti-regmap-debugfs:k
+qseecom_proxy:k
+qcom-spmi-pmic:k
+qcom_dma_heaps:k
+spmi-pmic-arb:k
+rtc-pm8xxx:k
+qcom-dload-mode:k
+qcom-reboot-reason:k
+cpu_hotplug:k
+qcom-cpufreq-hw:k
+sdhci-msm:k
+cqhci:k
+qcom-scm:k
+qcom-apcs-ipc-mailbox:k
+# msm_qmp = AOSS Qualcomm Messaging Protocol mailbox. btpower's probe path
+# calls mbox_request_channel() against the &qmp_aop phandle to vote the BT
+# slowclock + control vreg rails through AOSS; without this driver the
+# channel request fails, bt_clk_enable() returns error, and Android's BT HAL
+# crashes with "bt_power gpio config failed" (misleading log -- the actual
+# failure is upstream of the GPIO step).
+msm_qmp:k
+qcom_hwspinlock:k
+rproc_qcom_common:k
+qcom_glink:k
+qcom_glink_rpm:k
+rpm-smd:k
+qcom_glink_smem:k
+qcom_smd:k
+nvmem_qcom-spmi-sdam:k
+qnoc-monaco:k
+icc-rpm:k
+qnoc-qos-rpm:k
+qrtr:k
+msm_drm:tp
+msm_kgsl:tp
+qseecom_dlkm:tp
+smcinvoke_dlkm:tp
+
+# ────────────────── Sensors + audio MCU plumbing ──────────────────
+# petc_input_filter + mcu_mic_codec register nanohub_io listeners on the
+# MCU's input + audio channels. Without them, the MCU's early-init
+# messages have no kernel-side consumer and the MCU may not fully
+# transition out of pre-handshake state -- mcu_mgmtd then sees an empty
+# firmware_version readback and re-uploads in a 5-second retry loop.
+nanohub:tp
+petc_input_filter:tp
+mcu_mic_codec:tp
+
+# ────────────────── Bluetooth -- DEFERRED ──────────────────
+# btpower + bt_fm_slim are NOT shipped here. Bricking flash bundle:
+# adding our KMI-correct btpower made it probe hard against
+# missing `wl-reset-gpio` in our DT, killing boot (G logo hang). To
+# re-enable, first add the GPIO bindings btpower expects (see DT) then
+# uncomment:
+#   btpower:tp
+#   bt_fm_slim:tp
+# Without us shipping btpower, Halium's vendor_dlkm phase loads the
+# stock 6.6-kernel btpower.ko with KMI mismatch (OE-tainted, force-
+# loaded, mostly nerfed) -- BT stays broken but the kernel survives.
+
+# ────────────────── USB chain ──────────────────
+# google-extcon-usb-shim probes dwc3-msm's extcon supplier; phy-msm-ssusb-qmp
+# is the QMP SS-PHY. Both must load BEFORE dwc3_msm (see modules.softdep) so
+# fw_devlink resolves. Stock vkbrd ships google-extcon-usb-shim; we add the
+# SS-PHY which is foundational on this SoC variant.
+google-extcon-usb-shim:tp
+phy-msm-ssusb-qmp:k
+phy-generic:k
+phy-msm-snps-hs:k
+dwc3-msm:k
+eud:k
+pinctrl-spmi-gpio:k
+msm_gpi:k
+qpnp-power-on:k
+i2c-msm-geni:k
+qcom-spmi-adc5-gen3:k
+qcom-vadc-common:k
+
+# ────────────────── Charger / BMS chain ──────────────────
+# Built via the linux-aurora-modules google-modules/bms{,/misc} +
+# drivers/power/supply/qcom EXT_MODULES path.
+gvotable:tp
+logbuffer:tp
+qpnp-smblite-main:tp
+qti-qbg-main:tp
+google-bms:tp
+google-battery:tp
+google-charger:tp
+sw5100_bms:tp
+
+# ────────────────── Touch ──────────────────
+# Loaded at first stage: the bootloader applies the stock dtbo, so the
+# touch DT node is present from boot and init_boot's modules.load.aurora
+# lists touch_nt38350.ko. Note the assembler has no ship-but-don't-load
+# syntax -- a `:tp` entry here plus a modules.load.aurora line is the
+# full load contract.
+touch_nt38350:tp
+
+# ────────────────── WLAN supplier graph (PIL/QMI plumbing, then platform) ──────────────────
+# Two-tier dep stack for ICNSS-attached WLAN on monaco (qca6750 integrated
+# into modem PAS). Layer 1 PIL/QMI; Layer 2 QMI/PDR/ramdump suppliers;
+# Layer 3 WLAN platform from techpack.
+#
+# WLAN supplier graph for this SoC (qca6750 over ICNSS/SMP2P/QMI):
+#   cnss_utils <- cnss_prealloc <- cnss_nl
+#               <- wlan_firmware_service <- cnss_plat_ipc_qmi_svc
+#               <- icnss2 (binds DT qcom,icnss)
+#   cfg80211 <- qca_cld3_wlan (binds via icnss_register_driver())
+spi-msm-geni:k
+msm_geni_serial:k
+qcom_aoss:k
+qmi_helpers:k
+smp2p_sleepstate:k
+qcom_ramdump:k
+pdr_interface:k
+qcom_pil_info:k
+qcom_sysmon:k
+qcom_q6v5:k
+
+# ────────────────── SoC infra modem fw expects up before it boots ──────────────────
+msm_sharedmem:k
+msm_memshare:k
+heap_mem_ext_v01:k
+soc_sleep_stats:k
+subsystem_sleep_stats:k
+sysmon_subsystem_stats:k
+power_state:k
+
+# ────────────────── ADSP audio chain (boots ADSP via /sys/kernel/boot_adsp/boot) ──────────────────
+# adsp_loader_dlkm creates /sys/kernel/boot_adsp/boot; writing 1 triggers
+# rproc_boot of remoteproc0 (ab00000.remoteproc-adsp). Modem firmware
+# waits for ADSP to be alive; without this chain modem perpetually
+# crashes & recovers, WLFW QMI server arrives only intermittently,
+# cnss-daemon never gets past wlfw_service_request.
+snd_event_dlkm:tp
+q6_pdr_dlkm:tp
+q6_notifier_dlkm:tp
+gpr_dlkm:tp
+spf_core_dlkm:tp
+audpkt_ion_dlkm:tp
+audio_pkt_dlkm:tp
+audio_prm_dlkm:tp
+adsp_loader_dlkm:tp
+
+# cdsp-loader (in-tree, drivers/soc/qcom/qdsp6v2/cdsp-loader.c) creates
+# /sys/kernel/boot_cdsp/boot; writing 1 triggers PAS boot of the CDSP
+# subsystem. Without this the Android container's
+# init.qti.write.sh wrapper polls for the sysfs node and times out after
+# ~92s in the background.
+cdsp-loader:k
+
+# ────────────────── Modem PAS LAST (auto-boots remoteproc on probe) ──────────────────
+# All infra above must be ready first.
+qcom_q6v5_pas:k
+qrtr-smd:k
+
+# ────────────────── WLAN platform (techpack wlan-platform + cfg80211 + qcacld) ──────────────────
+# google_wlan_mac reads the WLAN MAC address from DT and pushes it into
+# cnss_utils' storage. qca_cld3_wlan reads it back from cnss_utils at
+# init. Without google_wlan_mac, qca_cld3_wlan has no MAC -> no wlan0.
+# google_wlan_mac MUST load before wlan (declared via @dep below) so
+# modprobe orders them correctly.
+cnss_utils:tp
+google_wlan_mac:tp
+cnss_prealloc:tp
+cnss_nl:tp
+wlan_firmware_service:tp
+cnss_plat_ipc_qmi_svc:tp
+icnss2:tp
+cfg80211:k
+wlan:tp
+
+# ────────────────── cs40l26 haptics + boosted speaker amp ──────────────────
+# google-modules/amplifiers/cs40l26: cl_dsp (DSP loader supplier),
+# input-cs40l26-i2c (platform driver -> /sys/class/leds/vibrator),
+# snd-soc-cs40l26 (ALSA codec). All NEW vs stock vkbrd.
+cl_dsp:tp
+cl_dsp-debugfs:tp
+input-cs40l26-i2c:tp
+snd-soc-cs40l26:tp
+
+# ────────────────────────────────────────────────────────────────────
+# modules.dep entries -- each driver lists its direct symbol-suppliers
+# in load order. Halium's modprobe walks transitive deps from this file.
+# Suppliers MUST precede consumers.
+# ────────────────────────────────────────────────────────────────────
+@dep spi-msm-geni.ko: qcom_ipc_logging.ko
+@dep msm_geni_serial.ko: qcom_ipc_logging.ko
+@dep qcom_aoss.ko:
+# msm_qmp imports qmp_send_msg (and friends) from qcom_aoss. Without this
+# dep declaration in modules.dep, busybox modprobe insmod's msm_qmp before
+# qcom_aoss is up and the kernel rejects it on unresolved symbols.
+@dep msm_qmp.ko: qcom_aoss.ko
+@dep qmi_helpers.ko:
+@dep nanohub.ko:
+# The kernel-build depmod emits an empty dep line for qrtr-smd (rpmsg core is
+# built into the GKI kernel so most of its imports resolve to vmlinux), but it
+# does import qrtr_endpoint_* from qrtr.ko and qcom_glink_is_wakeup from
+# qcom_glink.ko -- naked insmod would be rejected on unresolved symbols.
+@dep qrtr-smd.ko: qrtr.ko qcom_glink.ko
+@dep smp2p_sleepstate.ko:
+@dep qcom_ramdump.ko:
+@dep pdr_interface.ko: qmi_helpers.ko
+@dep qcom_pil_info.ko:
+@dep qcom_sysmon.ko: qmi_helpers.ko rproc_qcom_common.ko
+@dep qcom_q6v5.ko: rproc_qcom_common.ko smem.ko qcom_sysmon.ko qmi_helpers.ko
+@dep qcom_q6v5_pas.ko: qcom_sysmon.ko rproc_qcom_common.ko qcom_q6v5.ko qcom-scm.ko mdt_loader.ko qcom_pil_info.ko qcom_aoss.ko secure_buffer.ko qcom_ramdump.ko qmi_helpers.ko smem.ko
+
+# ADSP / audio chain
+@dep snd_event_dlkm.ko:
+@dep q6_pdr_dlkm.ko: pdr_interface.ko qmi_helpers.ko
+@dep q6_notifier_dlkm.ko: rproc_qcom_common.ko q6_pdr_dlkm.ko pdr_interface.ko qmi_helpers.ko
+@dep gpr_dlkm.ko: snd_event_dlkm.ko q6_notifier_dlkm.ko rproc_qcom_common.ko q6_pdr_dlkm.ko pdr_interface.ko qmi_helpers.ko
+@dep spf_core_dlkm.ko: gpr_dlkm.ko snd_event_dlkm.ko q6_notifier_dlkm.ko rproc_qcom_common.ko q6_pdr_dlkm.ko pdr_interface.ko qmi_helpers.ko
+@dep adsp_loader_dlkm.ko: spf_core_dlkm.ko gpr_dlkm.ko snd_event_dlkm.ko q6_notifier_dlkm.ko rproc_qcom_common.ko q6_pdr_dlkm.ko pdr_interface.ko qmi_helpers.ko
+@dep cdsp-loader.ko: rproc_qcom_common.ko qcom_q6v5_pas.ko qcom_q6v5.ko qcom_sysmon.ko qmi_helpers.ko
+@dep audpkt_ion_dlkm.ko: secure_buffer.ko
+@dep audio_pkt_dlkm.ko: gpr_dlkm.ko audpkt_ion_dlkm.ko spf_core_dlkm.ko qcom_ipc_logging.ko snd_event_dlkm.ko q6_notifier_dlkm.ko rproc_qcom_common.ko q6_pdr_dlkm.ko pdr_interface.ko qmi_helpers.ko secure_buffer.ko
+@dep audio_prm_dlkm.ko: q6_notifier_dlkm.ko gpr_dlkm.ko spf_core_dlkm.ko snd_event_dlkm.ko rproc_qcom_common.ko q6_pdr_dlkm.ko pdr_interface.ko qmi_helpers.ko
+
+# SoC infra
+@dep msm_sharedmem.ko:
+@dep msm_memshare.ko: qmi_helpers.ko rproc_qcom_common.ko
+@dep heap_mem_ext_v01.ko: qmi_helpers.ko
+@dep soc_sleep_stats.ko: smem.ko
+@dep subsystem_sleep_stats.ko:
+@dep sysmon_subsystem_stats.ko: smem.ko
+@dep power_state.ko: rproc_qcom_common.ko
+
+# Sensors/audio MCU listeners
+@dep petc_input_filter.ko: nanohub.ko
+@dep mcu_mic_codec.ko: nanohub.ko
+
+# WLAN platform
+@dep cnss_utils.ko:
+@dep google_wlan_mac.ko: cnss_utils.ko
+@dep cnss_prealloc.ko:
+@dep cnss_nl.ko: cnss_utils.ko
+@dep wlan_firmware_service.ko: qmi_helpers.ko
+@dep cnss_plat_ipc_qmi_svc.ko: qmi_helpers.ko
+@dep icnss2.ko: wlan_firmware_service.ko qmi_helpers.ko pdr_interface.ko qcom_ramdump.ko
+@dep cfg80211.ko:
+# google_wlan_mac is NOT a symbol dep of qca_cld3_wlan -- they talk via
+# cnss_utils -- so modpost wouldn't generate this. But modprobe walks
+# modules.dep to ORDER loads; this forces google_wlan_mac BEFORE wlan.
+@dep wlan.ko: cfg80211.ko icnss2.ko cnss_utils.ko google_wlan_mac.ko
+
+# USB chain
+@dep google-extcon-usb-shim.ko:
+@dep phy-msm-ssusb-qmp.ko:
+
+# cs40l26 haptics
+@dep cl_dsp.ko:
+@dep cl_dsp-debugfs.ko: cl_dsp.ko
+@dep input-cs40l26-i2c.ko: cl_dsp.ko cl_dsp-debugfs.ko
+@dep snd-soc-cs40l26.ko: input-cs40l26-i2c.ko cl_dsp.ko cl_dsp-debugfs.ko
diff --git a/devices/google-aurora/boot/default.nix b/devices/google-aurora/boot/default.nix
new file mode 100644
index 00000000..43c39dbd
--- /dev/null
+++ b/devices/google-aurora/boot/default.nix
@@ -0,0 +1,148 @@
+{
+  lib,
+  pkgs,
+  kernel,
+  initrd,
+}:
+
+let
+  inherit (pkgs) buildPackages;
+
+  # mkbootimg geometry from AsteroidOS aurora machine / boot-images recipe
+  flash = {
+    base = "0x10000000";
+    kernel_offset = "0x00008000";
+    ramdisk_offset = "0x01000000";
+    tags_offset = "0x00000100";
+    dtb_offset = "0x01f00000";
+    pagesize = "4096";
+  };
+
+  # Step 1: Patched DTB with ramoops and continuous-splash framebuffer nodes injected
+  dtb =
+    pkgs.runCommand "aurora-dtb-ramoops.dtb"
+      {
+        nativeBuildInputs = [ buildPackages.dtc ];
+      }
+      ''
+        base64 -d ${./static/vkb-base.dtb.base64} > $out
+        chmod +w $out
+
+        # Ramoops node
+        fdtput -c $out /reserved-memory/ramoops@61F00000
+        fdtput -t s $out /reserved-memory/ramoops@61F00000 compatible ramoops
+        fdtput $out /reserved-memory/ramoops@61F00000 no-map
+        fdtput -t x $out /reserved-memory/ramoops@61F00000 reg 0 0x61f00000 0 0x400000
+        fdtput -t x $out /reserved-memory/ramoops@61F00000 record-size 0x40000
+        fdtput -t x $out /reserved-memory/ramoops@61F00000 console-size 0x200000
+        fdtput -t x $out /reserved-memory/ramoops@61F00000 pmsg-size 0x100000
+
+        # Continuous-splash framebuffer node (384x384, stride 1536)
+        fdtput -c $out /cont-splash-fb
+        fdtput -t s $out /cont-splash-fb compatible "qcom,cont-splash-fb"
+        fdtput -t x $out /cont-splash-fb reg 0 0x5c000000 0 0x90000
+        fdtput -t u $out /cont-splash-fb width 384
+        fdtput -t u $out /cont-splash-fb height 384
+        fdtput -t u $out /cont-splash-fb stride 1536
+        fdtput -t s $out /cont-splash-fb format "x8r8g8b8"
+      '';
+
+  # Step 2: Assemble the vendor_kernel_boot ramdisk (modules + metadata)
+  vkbRamdisk =
+    pkgs.runCommand "aurora-vkb-ramdisk"
+      {
+        nativeBuildInputs = [
+          buildPackages.python3
+          buildPackages.cpio
+          buildPackages.lz4
+        ];
+      }
+      ''
+        mkdir -p vkb_staging/lib/modules
+        # Copy static modules metadata
+        cp ${./static/modules.alias} vkb_staging/lib/modules/modules.alias
+        cp ${./static/modules.dep} vkb_staging/lib/modules/modules.dep
+        cp ${./static/modules.load.charger} vkb_staging/lib/modules/modules.load.charger
+        cp ${./static/modules.softdep} vkb_staging/lib/modules/modules.softdep
+        cp ${./modules.load.aurora} vkb_staging/lib/modules/modules.load
+        cp ${./modules.load.aurora} vkb_staging/lib/modules/modules.load.recovery
+
+        # Copy all built kernel modules from kernel package
+        if [ -d "${kernel}/lib/modules" ]; then
+          find "${kernel}/lib/modules" -name '*.ko' -exec cp -v {} vkb_staging/lib/modules/ \;
+        fi
+
+        # Pack into cpio.lz4
+        (
+          cd vkb_staging
+          find . | sort | cpio -o -H newc --owner root:root 2>/dev/null
+        ) | lz4 -l -9 > $out
+      '';
+
+  # Step 3: vendor_kernel_boot.img (header v4)
+  vendorKernelBootImg =
+    pkgs.runCommand "vendor_kernel_boot.img"
+      {
+        nativeBuildInputs = [ buildPackages.mkbootimg ];
+      }
+      ''
+        mkbootimg \
+          --header_version 4 \
+          --pagesize ${flash.pagesize} \
+          --vendor_boot $out \
+          --vendor_ramdisk ${vkbRamdisk} \
+          --dtb ${dtb} \
+          --base ${flash.base} \
+          --kernel_offset ${flash.kernel_offset} \
+          --ramdisk_offset ${flash.ramdisk_offset} \
+          --tags_offset ${flash.tags_offset} \
+          --dtb_offset ${flash.dtb_offset} \
+          --vendor_cmdline ""
+      '';
+
+  # Step 4: boot.img (header v4: kernel only, empty ramdisk)
+  bootImg =
+    pkgs.runCommand "aurora-boot.img"
+      {
+        nativeBuildInputs = [ buildPackages.mkbootimg ];
+      }
+      ''
+        touch empty_ramdisk
+        mkbootimg \
+          --header_version 4 \
+          --kernel ${kernel}/Image \
+          --ramdisk empty_ramdisk \
+          --cmdline "" \
+          -o $out
+      '';
+
+  # Step 5: init_boot.img (header v4: empty kernel, stage-1 initrd in lz4)
+  initBootImg =
+    pkgs.runCommand "aurora-init_boot.img"
+      {
+        nativeBuildInputs = [
+          buildPackages.mkbootimg
+          buildPackages.lz4
+          buildPackages.gzip
+        ];
+      }
+      ''
+        touch empty_kernel
+        gunzip -c ${initrd} | lz4 -l -9 > init_boot_rd.lz4
+        mkbootimg \
+          --header_version 4 \
+          --kernel empty_kernel \
+          --ramdisk init_boot_rd.lz4 \
+          --cmdline "" \
+          -o $out
+      '';
+in
+{
+  inherit
+    dtb
+    vkbRamdisk
+    vendorKernelBootImg
+    bootImg
+    initBootImg
+    ;
+}
diff --git a/devices/google-aurora/boot/google-extcon-usb-shim.conf b/devices/google-aurora/boot/google-extcon-usb-shim.conf
new file mode 100644
index 00000000..190e088d
--- /dev/null
+++ b/devices/google-aurora/boot/google-extcon-usb-shim.conf
@@ -0,0 +1,5 @@
+# Aurora: the google-extcon-usb-shim DT default is to force-disable USB at boot
+# ("USB force-disable:1 changeable:1 dt-support:1 disable-param:0x1" appears in
+# dmesg). With USB gated off, dwc3-msm never registers a UDC and /sys/class/udc
+# stays empty -- our configfs adb gadget can't bind, so no adb.
+options google-extcon-usb-shim usb_force_disable_boot=0
