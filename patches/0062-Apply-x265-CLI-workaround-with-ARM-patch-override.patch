From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sat, 31 Oct 2026 08:53:30 +1100
Subject: [PATCH] Apply x265 CLI workaround with ARM patch override

---
 overlay/cross-compile.nix | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/overlay/cross-compile.nix b/overlay/cross-compile.nix
index 0888185b..023f6aff 100644
--- a/overlay/cross-compile.nix
+++ b/overlay/cross-compile.nix
@@ -106,15 +106,10 @@ else
       };
     });
 
-    # The x265 command-line encoder cannot link its ARM NEON test symbols
-    # under this cross toolchain. FFmpeg links the shared library, not the CLI.
-    x265 = super.x265.overrideAttrs (old: {
-      cmakeFlags = (old.cmakeFlags or [ ]) ++ [ "-DENABLE_CLI=OFF" ];
-    });
   in
   {
     inherit systemd257;
-    inherit mbedtls x265;
+    inherit mbedtls;
     # Keep the patched systemd 262 for old kernels available for debugging
     # or fallback even when the legacy profile selects systemd 257.
     systemd262oldkernel = systemd262OldKernel;
@@ -375,6 +370,9 @@ else
       patches = super.lib.filter (p: !(super.lib.hasInfix "raw" (builtins.baseNameOf (toString p)))) (
         old.patches or [ ]
       );
+      # The command-line encoder fails to link its ARM NEON test symbols.
+      # FFmpeg uses the shared library and does not need this executable.
+      cmakeFlags = (old.cmakeFlags or [ ]) ++ [ "-DENABLE_CLI=OFF" ];
     });
 
     # Skia gnFlags cpu mapping expects "arm" instead of "armv7l".
