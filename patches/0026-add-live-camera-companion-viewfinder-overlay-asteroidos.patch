+ * The only transport is the authenticated BLE AppBridge exposed by
+ * asteroid-btsyncd on the system bus. There is no network path and no video
+ * stream; both command directions are checked against fixed allowlists and
+ * carry no payload.
+ */
+class RemoteCameraBridge : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool bleConnected READ bleConnected NOTIFY bleConnectedChanged)
+    Q_PROPERTY(bool phoneReady READ phoneReady NOTIFY phoneReadyChanged)
+
+public:
+    explicit RemoteCameraBridge(QObject *parent = nullptr);
+
+    bool bleConnected() const { return m_bleConnected; }
+    bool phoneReady() const { return m_phoneReady; }
+
+    // Watch -> phone actions that may be sent.
+    static bool isSendAllowed(const QString &action);
+    // Phone -> watch actions that are acted upon.
+    static bool isReceiveAllowed(const QString &action);
+
+public slots:
+    // Returns false (and sends nothing) if the action is not allowlisted.
+    bool sendCommand(const QString &action);
+    void vibrate(int ms = 50);
+
+signals:
+    void bleConnectedChanged();
+    void phoneReadyChanged();
+    void commandReceived(const QString &action);
+
+private slots:
+    void onMessageReceived(const QString &appId, const QString &action, const QString &payload);
+
+private:
+    void setPhoneReady(bool ready);
+
+    bool m_bleConnected = false;
+    bool m_phoneReady = false;
+};
+
+#endif // REMOTECAMERABRIDGE_H
