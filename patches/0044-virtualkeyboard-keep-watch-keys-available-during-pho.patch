From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 9 Nov 2026 17:32:03 +1100
Subject: [PATCH] virtualkeyboard: keep watch keys available during phone input

---
 .../virtualkeyboard/layouts/en_GB/main.qml    |  93 ++++++-----
 .../virtualkeyboard/layouts/en_US/main.qml    |  93 ++++++-----
 .../virtualkeyboard/layouts/phone/main.qml    | 151 ++++++++++++------
 .../virtualkeyboard/layouts/zh_CN/main.qml    |  93 ++++++-----
 .../virtualkeyboard/layouts/zh_HK/main.qml    |  93 ++++++-----
 .../virtualkeyboard/layouts/zh_TW/main.qml    |  93 ++++++-----
 6 files changed, 332 insertions(+), 284 deletions(-)

diff --git a/overlay/asteroidos/virtualkeyboard/layouts/en_GB/main.qml b/overlay/asteroidos/virtualkeyboard/layouts/en_GB/main.qml
index 586df724..81489b12 100644
--- a/overlay/asteroidos/virtualkeyboard/layouts/en_GB/main.qml
+++ b/overlay/asteroidos/virtualkeyboard/layouts/en_GB/main.qml
@@ -60,11 +60,14 @@ KeyboardLayout {
         ChangeLanguageKey { weight: 140 }
         Key {
             weight: 140
-            text: "📱"
+            text: phoneBridge.active ? "📱✓" : "📱"
             functionKey: true
             onClicked: {
-                phoneOverlay.visible = true
-                phoneBridge.requestInput()
+                if (phoneBridge.active) {
+                    phoneBridge.closeInput()
+                } else {
+                    phoneBridge.requestInput()
+                }
             }
         }
         SpaceKey { weight: 740 }
@@ -72,56 +75,52 @@ KeyboardLayout {
     }
 
     Rectangle {
-        id: phoneOverlay
-        anchors.fill: parent
-        visible: false
-        color: "#1c1c1e"
-        z: 999
+        id: phoneStatusPill
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.top: parent.top
+        anchors.topMargin: 2
+        height: 22
+        width: Math.min(statusLabel.implicitWidth + 18, parent.width * 0.85)
+        radius: 11
+        color: "#e61c1c1e"
+        border.color: phoneBridge.active ? "#34c759" : "#8e8e93"
+        border.width: 1
+        visible: opacity > 0.0
+        opacity: pillTimer.running ? 0.95 : 0.0
+        Behavior on opacity { NumberAnimation { duration: 250 } }
+        z: 50
 
-        Column {
-            anchors.centerIn: parent
-            spacing: 12
-            width: parent.width * 0.9
+        Timer {
+            id: pillTimer
+            interval: 2500
+            running: false
+        }
 
-            Text {
-                text: "📱 Input on Phone"
-                color: "#ffffff"
-                font.bold: true
-                font.pixelSize: 18
-                anchors.horizontalCenter: parent.horizontalCenter
+        Connections {
+            target: phoneBridge
+            function onActiveChanged() {
+                pillTimer.restart()
             }
-
-            Text {
-                text: phoneBridge.statusText
-                color: "#a0a0a0"
-                font.pixelSize: 13
-                wrapMode: Text.WordWrap
-                horizontalAlignment: Text.AlignHCenter
-                anchors.horizontalCenter: parent.horizontalCenter
+            function onStatusTextChanged() {
+                pillTimer.restart()
             }
+        }
 
-            Rectangle {
-                width: parent.width * 0.7
-                height: 38
-                radius: 19
-                color: "#3a3a3c"
-                anchors.horizontalCenter: parent.horizontalCenter
-
-                Text {
-                    anchors.centerIn: parent
-                    text: "⌨️ Return"
-                    color: "#ffffff"
-                    font.bold: true
-                    font.pixelSize: 14
-                }
+        Text {
+            id: statusLabel
+            width: parent.width - 18
+            elide: Text.ElideRight
+            horizontalAlignment: Text.AlignHCenter
+            anchors.centerIn: parent
+            text: "📱 " + phoneBridge.statusText
+            color: "#ffffff"
+            font.pixelSize: 11
+        }
 
-                MouseArea {
-                    anchors.fill: parent
-                    onClicked: {
-                        phoneBridge.closeInput()
-                        phoneOverlay.visible = false
-                    }
-                }
+        MouseArea {
+            anchors.fill: parent
+            onClicked: {
+                phoneBridge.closeInput()
             }
         }
     }
