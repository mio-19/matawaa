diff --git a/overlay/asteroidos/egl-probe/default.nix b/overlay/asteroidos/egl-probe/default.nix
new file mode 100644
index 00000000..81ca384f
--- /dev/null
+++ b/overlay/asteroidos/egl-probe/default.nix
@@ -0,0 +1,35 @@
+# Diagnostic binary used by the debug launcher service to report the EGL
+# config inventory of libhybris' hwcomposer platform.
+{
+  lib,
+  stdenv,
+  libhybris,
+}:
+
+stdenv.mkDerivation {
+  pname = "egl-probe";
+  version = "0";
+
+  src = ./.;
+
+  buildPhase = ''
+    runHook preBuild
+    $CC -O2 -Wall -o egl-probe egl-probe.c \
+      -I${libhybris}/include \
+      -L${libhybris}/lib \
+      -Wl,-rpath,${libhybris}/lib \
+      -lEGL
+    runHook postBuild
+  '';
+
+  installPhase = ''
+    runHook preInstall
+    install -Dm755 egl-probe $out/bin/egl-probe
+    runHook postInstall
+  '';
+
+  meta = with lib; {
+    description = "EGL config inventory probe for libhybris hwcomposer";
+    platforms = platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/egl-probe/egl-probe.c b/overlay/asteroidos/egl-probe/egl-probe.c
new file mode 100644
index 00000000..20d8a19c
--- /dev/null
+++ b/overlay/asteroidos/egl-probe/egl-probe.c
@@ -0,0 +1,120 @@
+/* Diagnostic: dump the EGL display/config inventory from the launcher's
+ * environment (libhybris EGL, EGL_PLATFORM=hwcomposer). Run as an
+ * ExecStartPre of asteroid-launcher so the output lands in launcher.log. */
+#include <EGL/egl.h>
+#include <stdio.h>
+
+static const char *errname(EGLint e)
+{
+    switch (e) {
+    case EGL_SUCCESS: return "SUCCESS";
+    case EGL_NOT_INITIALIZED: return "NOT_INITIALIZED";
+    case EGL_BAD_ACCESS: return "BAD_ACCESS";
+    case EGL_BAD_ALLOC: return "BAD_ALLOC";
+    case EGL_BAD_ATTRIBUTE: return "BAD_ATTRIBUTE";
+    case EGL_BAD_CONFIG: return "BAD_CONFIG";
+    case EGL_BAD_CONTEXT: return "BAD_CONTEXT";
+    case EGL_BAD_CURRENT_SURFACE: return "BAD_CURRENT_SURFACE";
+    case EGL_BAD_DISPLAY: return "BAD_DISPLAY";
+    case EGL_BAD_MATCH: return "BAD_MATCH";
+    case EGL_BAD_NATIVE_PIXMAP: return "BAD_NATIVE_PIXMAP";
+    case EGL_BAD_NATIVE_WINDOW: return "BAD_NATIVE_WINDOW";
+    case EGL_BAD_PARAMETER: return "BAD_PARAMETER";
+    case EGL_BAD_SURFACE: return "BAD_SURFACE";
+    case EGL_CONTEXT_LOST: return "CONTEXT_LOST";
+    default: return "?";
+    }
+}
+
+static int get(EGLDisplay d, EGLConfig c, EGLint attr)
+{
+    EGLint v = -1;
+    eglGetConfigAttrib(d, c, attr, &v);
+    return v;
+}
+
+int main(void)
+{
+    EGLDisplay d = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    printf("egl-probe: display=%p\n", (void *)d);
+    if (d == EGL_NO_DISPLAY) {
+        EGLint e = eglGetError();
+        printf("egl-probe: eglGetDisplay failed 0x%x (%s)\n", e, errname(e));
+        return 1;
+    }
+
+    EGLint maj = 0, min = 0;
+    if (!eglInitialize(d, &maj, &min)) {
+        EGLint e = eglGetError();
+        printf("egl-probe: eglInitialize failed 0x%x (%s)\n", e, errname(e));
+        return 1;
+    }
+    printf("egl-probe: EGL %d.%d vendor=%s version=%s apis=%s\n",
+           maj, min,
+           eglQueryString(d, EGL_VENDOR),
+           eglQueryString(d, EGL_VERSION),
+           eglQueryString(d, EGL_CLIENT_APIS));
+
+    EGLint n = 0;
+    eglGetConfigs(d, NULL, 0, &n);
+    printf("egl-probe: configs=%d\n", n);
+    if (n > 0 && n <= 4096) {
+        static EGLConfig cfgs[4096];
+        eglGetConfigs(d, cfgs, n, &n);
+        for (EGLint i = 0; i < n; i++) {
+            printf("egl-probe: cfg id=%d rgba=%d/%d/%d/%d depth=%d stencil=%d samples=%d surface=0x%x renderable=0x%x caveat=0x%x\n",
+                   get(d, cfgs[i], EGL_CONFIG_ID),
+                   get(d, cfgs[i], EGL_RED_SIZE),
+                   get(d, cfgs[i], EGL_GREEN_SIZE),
+                   get(d, cfgs[i], EGL_BLUE_SIZE),
+                   get(d, cfgs[i], EGL_ALPHA_SIZE),
+                   get(d, cfgs[i], EGL_DEPTH_SIZE),
+                   get(d, cfgs[i], EGL_STENCIL_SIZE),
+                   get(d, cfgs[i], EGL_SAMPLES),
+                   get(d, cfgs[i], EGL_SURFACE_TYPE),
+                   get(d, cfgs[i], EGL_RENDERABLE_TYPE),
+                   get(d, cfgs[i], EGL_CONFIG_CAVEAT));
+        }
+    }
+
+    /* Exactly what qt6-qpa-hwcomposer-plugin's HwComposerContext forces for a
+     * 32-bit screen: RGBA8888 + depth 24 + stencil 8, ES2, window surface. */
+    EGLint strict[] = {
+        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 8,
+        EGL_GREEN_SIZE, 8,
+        EGL_BLUE_SIZE, 8,
+        EGL_ALPHA_SIZE, 8,
+        EGL_DEPTH_SIZE, 24,
+        EGL_STENCIL_SIZE, 8,
+        EGL_SAMPLES, 0,
+        EGL_NONE
+    };
+    EGLConfig c = NULL;
+    EGLint m = 0;
+    EGLBoolean ok = eglChooseConfig(d, strict, &c, 1, &m);
+    {
+        EGLint e = eglGetError();
+        printf("egl-probe: chooseConfig(strict rgba8888/stencil8)=%d matched=%d err=0x%x (%s)\n",
+               ok, m, e, errname(e));
+    }
+
+    EGLint relaxed[] = {
+        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 8,
+        EGL_GREEN_SIZE, 8,
+        EGL_BLUE_SIZE, 8,
+        EGL_NONE
+    };
+    ok = eglChooseConfig(d, relaxed, &c, 1, &m);
+    {
+        EGLint e = eglGetError();
+        printf("egl-probe: chooseConfig(relaxed rgb888)=%d matched=%d err=0x%x (%s)\n",
+               ok, m, e, errname(e));
+    }
+
+    eglTerminate(d);
+    return 0;
+}
diff --git a/overlay/asteroidos/swclock-offset/default.nix b/overlay/asteroidos/swclock-offset/default.nix
new file mode 100644
index 00000000..d7e91032
--- /dev/null
+++ b/overlay/asteroidos/swclock-offset/default.nix
@@ -0,0 +1,30 @@
+# Upstream: meta-asteroid/recipes-android/swclock-offset/swclock-offset_git.bb
+# Restores the system clock at boot from a non-writable RTC using a cached
+# offset file written at shutdown.
+{ stdenv, fetchgit }:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "swclock-offset";
+  version = "0.1";
+
+  src = fetchgit {
+    url = "https://gitlab.com/postmarketOS/swclock-offset.git";
+    rev = "6a4e4dcee814c7cfc22e0f69a6dc510086cb7abf";
+    hash = "sha256-Qqvu4GH016pz8+iMDECE2zXCPKhDPHo3CPzPPgJhITw=";
+  };
+
+  dontConfigure = true;
+  dontBuild = true;
+
+  installPhase = ''
+    runHook preInstall
+    install -Dm755 src/swclock-offset-boot.sh $out/bin/swclock-offset-boot
+    install -Dm755 src/swclock-offset-shutdown.sh $out/bin/swclock-offset-shutdown
+    runHook postInstall
+  '';
+
+  meta = {
+    description = "Synchronise time from a non-writable RTC using a cached offset";
+    platforms = [ "armv7l-linux" ];
+  };
+})
diff --git a/overlay/asteroidos/udev-droid-system/default.nix b/overlay/asteroidos/udev-droid-system/default.nix
new file mode 100644
index 00000000..a4170a61
--- /dev/null
+++ b/overlay/asteroidos/udev-droid-system/default.nix
@@ -0,0 +1,24 @@
+# Upstream: meta-asteroid/recipes-android/udev-droid-system/udev-droid-system_1.0.bb
+# Creates the Android-style /dev/block/platform/msm_sdcc.1/by-name/ links and
+# the subsystem symlinks the vendor HALs expect.
+{ stdenvNoCC, metaAsteroidSrc }:
+
+stdenvNoCC.mkDerivation {
+  pname = "udev-droid-system";
+  version = "1.0";
+
+  dontUnpack = true;
+
+  installPhase = ''
+    runHook preInstall
+    install -Dm644 \
+      ${metaAsteroidSrc}/recipes-android/udev-droid-system/udev-droid-system/998-droid-system.rules \
+      $out/lib/udev/rules.d/998-droid-system.rules
+    runHook postInstall
+  '';
+
+  meta = {
+    description = "Android-compatible /dev symlinks for vendor HALs";
+    platforms = [ "armv7l-linux" ];
+  };
+}
