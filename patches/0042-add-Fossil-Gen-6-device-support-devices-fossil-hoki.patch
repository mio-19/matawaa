diff --git a/devices/fossil-hoki/hybris-android.nix b/devices/fossil-hoki/hybris-android.nix
new file mode 100644
index 00000000..1e97adce
--- /dev/null
+++ b/devices/fossil-hoki/hybris-android.nix
@@ -0,0 +1,22 @@
+{ pkgs }:
+# AsteroidOS ships patched Android system libraries and headers for hybris on
+# the Fossil Gen 6. They contain the HWC2 compatibility layer that the stock
+# Fossil system/vendor image lacks, and the hal-droid init/system binaries
+# used by android-init.service.
+# Source: meta-asteroid recipes-android/android/android_armv7-pie64.bb
+pkgs.runCommand "hybris-p-msm8909w" { } ''
+  mkdir -p $out
+  ${pkgs.gnutar}/bin/tar xf ${
+    pkgs.fetchurl {
+      url = "https://dl.dropboxusercontent.com/s/2btck4hlowhronv/hybris-p-msm8909w.tar.gz";
+      hash = "sha256-19kXAAB3la7c30//pBhVLt8rP9QaAiM2dAGQb09N/tM=";
+    }
+  } -C $out
+
+  # GNSS (#342): the vendor provides gps.default.so under /vendor/lib/hw.
+  # /system is the read-only hal-droid tree, so create the hw module alias at
+  # build time rather than relying on a boot-time symlink into the store.
+  ${pkgs.coreutils}/bin/mkdir -p $out/usr/libexec/hal-droid/system/lib/hw
+  ${pkgs.coreutils}/bin/ln -sfn /vendor/lib/hw/gps.default.so \
+    $out/usr/libexec/hal-droid/system/lib/hw/gps.default.so
+''
diff --git a/devices/fossil-hoki/hybris.nix b/devices/fossil-hoki/hybris.nix
new file mode 100644
index 00000000..cf81a9ad
--- /dev/null
+++ b/devices/fossil-hoki/hybris.nix
@@ -0,0 +1,38 @@
+{
+  lib,
+  pkgs,
+  ...
+}:
+
+let
+  hybrisAndroid = import ./hybris-android.nix { inherit pkgs; };
+in
+{
+  # Build libhybris against the AsteroidOS Android headers and point its
+  # runtime Android library path at the hal-droid tree, matching
+  # meta-asteroid's libhybris_git.bbappend. android-init.service installs
+  # the hybris tarball at /usr/libexec/hal-droid/system.
+  nixpkgs.overlays = lib.mkAfter [
+    (final: super: {
+      libhybris = super.libhybris.overrideAttrs (old: {
+        configureFlags =
+          (lib.filter (
+            flag:
+            !(lib.hasPrefix "--with-android-headers=" flag)
+            && !(lib.hasPrefix "--with-default-hybris-ld-library-path=" flag)
+          ) (old.configureFlags or [ ]))
+          ++ [
+            "--with-android-headers=${hybrisAndroid}/include"
+            "--with-default-hybris-ld-library-path=/usr/libexec/hal-droid/system/lib:${hybrisAndroid}/usr/libexec/hal-droid/system/lib:/vendor/lib:/system/lib"
+          ];
+      });
+
+      # Upstream AsteroidOS installs qt5compat-qmlplugins via OpenEmbedded:
+      # https://github.com/AsteroidOS/meta-asteroid/blob/master/classes/asteroid-image.bbclass
+      # The cross-compilation overlay in overlay/cross-compile.nix builds the full
+      # native Qt5Compat.GraphicalEffects and private C++ plugins (libqtgraphicaleffectsprivateplugin.so),
+      # so qt5compatQml provides the genuine upstream qt5compat package matching meta-asteroid.
+      qt5compatQml = super.qt6.qt5compat;
+    })
+  ];
+}
diff --git a/devices/fossil-hoki/kernel/default.nix b/devices/fossil-hoki/kernel/default.nix
new file mode 100644
index 00000000..50d2ee71
--- /dev/null
+++ b/devices/fossil-hoki/kernel/default.nix
@@ -0,0 +1,232 @@
+{
+  mobile-nixos,
+  stdenv,
+  cpio,
+  fetchFromGitHub,
+  fetchurl,
+  runCommand,
+  xz,
+  ...
+}:
+
+# Fossil Gen 6 (hoki) ships a 4.14 downstream Qualcomm kernel.
+# Upstream source tree: https://github.com/fossil-engineering/kernel-msm-fossil-cw
+# AsteroidOS recipe: https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-kernel/linux/linux-hoki_p.bb
+#
+# It must be built with GCC 8: AsteroidOS's recipe inherits `kernel-gcc8` (https://github.com/AsteroidOS/meta-asteroid/blob/master/classes/kernel-gcc8.bbclass)
+# and notes "gcc >= 13 doesn't boot". Nixpkgs dropped gcc8, so borrow the armv7l
+# cross compiler from nixos-24.05 (the last channel still shipping 8.5.0).
+#
+# Patches 0001-0006 are fetched verbatim from AsteroidOS meta-smartwatch at
+# rev 873c865ca06593d239f911b76b09228ddd70eccc:
+# https://github.com/AsteroidOS/meta-smartwatch/tree/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-kernel/linux/files
+# Patch 0007 fixes unconditional pm_qos_remove_request crash in pcm_native.c:
+# https://github.com/AsteroidOS/meta-smartwatch/pull/344
+# 90_dtbs-install is ours: this tree has no ARM dtbs_install target.
+let
+  # Pinned by git rev rather than a channel URL: channels.nixos.org/nixos-24.05
+  # is a moving target whose NAR hash changes as the branch advances, and that
+  # branch is gone now that 24.05 is EOL.
+  pkgsGcc8 = import (builtins.fetchGit {
+    url = "https://github.com/NixOS/nixpkgs.git";
+    rev = "b134951a4c9f3c995fd7be05f3243f8ecd65d798";
+    shallow = true;
+  }) { };
+
+  cc8 = pkgsGcc8.pkgsCross.armv7l-hf-multiplatform.buildPackages.gcc8;
+
+  # Same as pkgs.overrideCC (pkgs/stdenv/adapters.nix), inlined so this file
+  # does not need the surrounding package set.
+  stdenvGcc8 = stdenv.override {
+    allowedRequisites = null;
+    cc = cc8;
+    hasCC = true;
+  };
+
+  kernel-builder-gcc8 = mobile-nixos.kernel-builder.override {
+    stdenv = stdenvGcc8;
+  };
+
+  # Upstream AsteroidOS defconfig for Fossil Gen 6 (hoki):
+  # https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-kernel/linux/linux-hoki/defconfig
+  upstreamDefconfig = fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-kernel/linux/linux-hoki/defconfig";
+    sha256 = "0fk14m3h7qdbyjlidifddrsp76j0wgq5wsg86vzisv65s8ha84as";
+  };
+
+  # Fetch the verbatim vendor patches instead of vendoring their contents.
+  # fetchurl is used rather than fetchpatch so the files are not transformed.
+  upstreamPatch =
+    name: sha256:
+    fetchurl {
+      url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-kernel/linux/files/${name}";
+      inherit sha256;
+    };
+
+  # Incremental 4.14.206 -> 4.14.207 stable patch. Use the kernel.org `incr`
+  # path; the plain `patch-4.14.207.xz` is a full 4.14.0 -> 4.14.207 diff.
+  stablePatch =
+    runCommand "linux-4.14.206-207.patch"
+      {
+        nativeBuildInputs = [ xz ];
+        src = fetchurl {
+          url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.14.206-207.xz";
+          hash = "sha256-U7olrDZuRkGt6GbXp6Lna20cERa5GX8RqXgbZGPrvX4=";
+        };
+        patchFile = ./linux-4.14.206-207.patch.patch;
+      }
+      ''
+        mkdir -p "$TMPDIR/stable"
+        xz -dc "$src" > "$TMPDIR/stable/linux-4.14.206-207.patch"
+        (cd "$TMPDIR/stable" && patch -p1 -i "$patchFile")
+        cp "$TMPDIR/stable/linux-4.14.206-207.patch" "$out"
+      '';
+
+  # Incremental 4.14.207 -> 4.14.208 stable patch.
+  stablePatch208 =
+    runCommand "linux-4.14.207-208.patch"
+      {
+        nativeBuildInputs = [ xz ];
+        src = fetchurl {
+          url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.14.207-208.xz";
+          hash = "sha256-RUgB0ik3YaGix3k3Tm5VJbIMaSvZIp/+fuCNIuOguHk=";
+        };
+      }
+      ''
+        xz -dc "$src" > "$out"
+      '';
+
+  # Incremental 4.14.208 -> 4.14.209 stable patch.
+  stablePatch209 =
+    runCommand "linux-4.14.208-209.patch"
+      {
+        nativeBuildInputs = [ xz ];
+        src = fetchurl {
+          url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.14.208-209.xz";
+          hash = "sha256-r0AtMyS92An0LizlWgoTbudht5/UD+f+MP38MlBQjQY=";
+        };
+      }
+      ''
