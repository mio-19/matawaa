diff --git a/devices/fossil-hoki/wlan-firmware-hoki.sh b/devices/fossil-hoki/wlan-firmware-hoki.sh
new file mode 100644
index 00000000..f1682bdf
--- /dev/null
+++ b/devices/fossil-hoki/wlan-firmware-hoki.sh
@@ -0,0 +1,30 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+# Symlink stock vendor WCNSS firmware/calibration data into the path the
+# out-of-tree pronto WLAN driver actually looks under, power up WCNSS by
+# opening (not writing) /dev/wcnss_wlan, then load the driver.
+# See https://github.com/AsteroidOS/meta-smartwatch/issues/224
+
+mkdir -p /lib/firmware/wlan/prima
+
+for f in WCNSS_qcom_cfg.ini WCNSS_qcom_wlan_nv.bin WCNSS_wlan_dictionary.dat; do
+	if [ ! -e "/lib/firmware/wlan/prima/$f" ]; then
+		ln -s "/vendor/firmware/wlan/prima/$f" "/lib/firmware/wlan/prima/$f"
+	fi
+done
+
+# The PIL firmware loader requests /lib/firmware/wcnss.mdt and the
+# wcnss.b00..b09 segments, not the /vendor path, so link those too.
+for dir in /vendor/firmware /vendor/firmware_mnt/image /vendor/firmware_mnt; do
+	if [ -d "$dir" ]; then
+		for f in "$dir"/wcnss.*; do
+			[ -e "$f" ] && [ ! -e "/lib/firmware/${f##*/}" ] && ln -sf "$f" "/lib/firmware/${f##*/}"
+		done
+	fi
+done
+
+# Opening this device node is what actually powers WCNSS up; the write
+# itself is expected to fail and is not an error.
+echo 1 > /dev/wcnss_wlan 2>/dev/null || true
+
+modprobe wlan
diff --git a/devices/fossil-hoki/wlan.nix b/devices/fossil-hoki/wlan.nix
new file mode 100644
index 00000000..cfcf4fbd
--- /dev/null
+++ b/devices/fossil-hoki/wlan.nix
@@ -0,0 +1,81 @@
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+
+let
+  kernel = config.mobile.boot.stage-1.kernel.package;
+
+  # AsteroidOS PR #341: "hoki: wlan: working WiFi driver from source".
+  # The stock /vendor/lib/modules/wlan.ko was built against Fossil's own
+  # 4.14.206-perf+ kernel and fails with a vermagic mismatch against ours, so
+  # build the out-of-tree Qualcomm pronto/prima driver against this kernel.
+  prima = pkgs.fetchFromGitHub {
+    owner = "Dev-msm8953";
+    repo = "vendor_qcom_opensource_wlan_prima";
+    rev = "3401b53";
+    hash = "sha256-nApGIHSWY5V06TGqm9w7kylWucddPBAd6yFCXNI/anY=";
+  };
+
+  wlanModule = pkgs.stdenv.mkDerivation {
+    pname = "wlan-prima";
+    version = "4.14";
+    src = prima;
+
+    patches = [
+      ./wlan/0001-hdd_process_bt_sco_profile-fix-use-of-adapter-before.patch
+      ./wlan/0002-Makefile-quote-CC-LD-AR-OBJCOPY-STRIP-in-nested-make.patch
+    ];
+
+    nativeBuildInputs =
+      (with pkgs.buildPackages; [
+        bc
+        bison
+        flex
+        openssl
+        python3
+      ])
+      ++ [ pkgs.buildPackages.buildPackages.gcc ];
+    buildInputs = [ kernel ];
+
+    # The mobile-nixos kernel output has no module build tree, so prepare one
+    # from the kernel source and the config the kernel was built with.
+    # HOSTCC must be a build-platform compiler: the kernel builds fixdep for
+    # the build machine. pkgs.buildPackages.gcc is still the cross compiler,
+    # so reach one level further out for the native one.
+    configurePhase = ''
+      runHook preConfigure
+      cp -r ${kernel.src} kernel-src
+      chmod -R u+w kernel-src
+      cp ${kernel.configfile} kernel-src/.config
+      cp ${./wlan/wakelock.h} kernel-src/include/linux/wakelock.h
+      make -C kernel-src ARCH=arm CROSS_COMPILE=${pkgs.stdenv.cc.targetPrefix} HOSTCC=${pkgs.buildPackages.buildPackages.gcc}/bin/gcc olddefconfig
+      make -C kernel-src ARCH=arm CROSS_COMPILE=${pkgs.stdenv.cc.targetPrefix} HOSTCC=${pkgs.buildPackages.buildPackages.gcc}/bin/gcc modules_prepare
+      runHook postConfigure
+    '';
+
+    makeFlags = [
+      "ARCH=arm"
+      "CROSS_COMPILE=${pkgs.stdenv.cc.targetPrefix}"
+      "HOSTCC=${pkgs.buildPackages.buildPackages.gcc}/bin/gcc"
+      "KERNEL_SOURCE=$(PWD)/kernel-src"
+      "KERNEL_SRC=$(PWD)/kernel-src"
+      "CONFIG_PRONTO_WLAN=m"
+      "WLAN_ROOT=$(PWD)"
+      "MODNAME=wlan"
+    ];
+
+    installPhase = ''
+      mkdir -p $out/lib/modules/${kernel.modDirVersion}/extra
+      cp wlan.ko $out/lib/modules/${kernel.modDirVersion}/extra/wlan.ko
+    '';
+  };
+in
+{
+  # wlan-firmware-hoki.sh symlinks the vendor firmware and opens
+  # /dev/wcnss_wlan before this module is loaded.
+  boot.extraModulePackages = [ wlanModule ];
+  boot.kernelModules = [ "wlan" ];
+}
