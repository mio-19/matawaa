+++ b/overlay/asteroidos/telegram/default.nix
@@ -0,0 +1,83 @@
+{
+  lib,
+  stdenv,
+  cmake,
+  pkg-config,
+  qt6,
+  qml-asteroid,
+  virtualkeyboard ? null,
+  qtvirtualkeyboard ? qt6.qtvirtualkeyboard,
+  tdlib ? null,
+  buildPackages,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "asteroid-telegram";
+  version = "1.0.0";
+
+  src = ./.;
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  cmakeFlags = lib.optionals (!stdenv.buildPlatform.canExecute stdenv.hostPlatform) [
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    qml-asteroid
+  ]
+  ++ lib.optional (tdlib != null) tdlib;
+
+  qtWrapperArgs = [
+    "--prefix"
+    "QML2_IMPORT_PATH"
+    ":"
+    "${qml-asteroid}/lib/qt-6/qml"
+    "--set-default"
+    "QT_IM_MODULE"
+    "qtvirtualkeyboard"
+    "--set-default"
+    "QT_VIRTUALKEYBOARD_STYLE"
+    "watch"
+  ]
+  ++ lib.optionals (qtvirtualkeyboard != null) [
+    "--prefix"
+    "QT_PLUGIN_PATH"
+    ":"
+    "${qtvirtualkeyboard}/lib/qt-6/plugins"
+    "--prefix"
+    "QML2_IMPORT_PATH"
+    ":"
+    "${qtvirtualkeyboard}/lib/qt-6/qml"
+  ]
+  ++ lib.optionals (virtualkeyboard != null) [
+    "--prefix"
+    "QML2_IMPORT_PATH"
+    ":"
+    "${virtualkeyboard}/lib/qt-6/qml"
+    "--set-default"
+    "QT_VIRTUALKEYBOARD_LAYOUT_PATH"
+    "${virtualkeyboard}/share/qtvirtualkeyboard/layouts"
+    "--set-default"
+    "RIME_SHARED_DATA_DIR"
+    "${virtualkeyboard}/share/rime-data"
+  ];
+
+  meta = with lib; {
+    description = "Smartwatch Telegram client for AsteroidOS";
+    homepage = "https://asteroidos.org/";
+    license = licenses.gpl3Plus;
+    mainProgram = "asteroid-telegram";
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/telegram/src/chatmodel.cpp b/overlay/asteroidos/telegram/src/chatmodel.cpp
new file mode 100644
index 00000000..860523e3
--- /dev/null
+++ b/overlay/asteroidos/telegram/src/chatmodel.cpp
@@ -0,0 +1,171 @@
+#include "chatmodel.h"
+
+ChatModel::ChatModel(QObject *parent)
+    : QAbstractListModel(parent)
+{
+}
+
+int ChatModel::rowCount(const QModelIndex &parent) const
+{
+    if (parent.isValid())
+        return 0;
+    return m_filteredChats.size();
+}
+
+QVariant ChatModel::data(const QModelIndex &index, int role) const
+{
+    if (!index.isValid() || index.row() < 0 || index.row() >= m_filteredChats.size())
+        return QVariant();
+
+    const ChatItem &item = m_filteredChats.at(index.row());
+    switch (role) {
+    case IdRole:
+        return item.id;
+    case TitleRole:
+        return item.title;
+    case LastMessageRole:
+        return item.lastMessage;
+    case TimeRole:
+        return item.time;
+    case UnreadCountRole:
+        return item.unreadCount;
+    case AvatarColorRole:
+        return item.avatarColor;
+    default:
+        return QVariant();
+    }
+}
+
+QHash<int, QByteArray> ChatModel::roleNames() const
+{
+    QHash<int, QByteArray> roles;
+    roles[IdRole] = "chatId";
+    roles[TitleRole] = "title";
+    roles[LastMessageRole] = "lastMessage";
+    roles[TimeRole] = "time";
+    roles[UnreadCountRole] = "unreadCount";
+    roles[AvatarColorRole] = "avatarColor";
+    return roles;
+}
+
+void ChatModel::setFilterQuery(const QString &query)
+{
+    if (m_filterQuery != query) {
+        m_filterQuery = query;
+        rebuildFilteredChats();
+        emit filterQueryChanged();
+    }
+}
+
+void ChatModel::rebuildFilteredChats()
+{
+    beginResetModel();
+    m_filteredChats.clear();
+    const QString trimmed = m_filterQuery.trimmed();
+    for (const auto &item : m_chats) {
+        if (trimmed.isEmpty() ||
+            item.title.contains(trimmed, Qt::CaseInsensitive) ||
+            item.lastMessage.contains(trimmed, Qt::CaseInsensitive)) {
+            m_filteredChats.append(item);
+        }
+    }
+    endResetModel();
+}
+
+bool ChatModel::hasChat(const QString &id) const
+{
+    for (const auto &chat : m_chats) {
+        if (chat.id == id)
+            return true;
+    }
+    return false;
+}
+
+void ChatModel::addChat(const QString &id, const QString &title, const QString &lastMessage, const QString &time, int unreadCount, const QString &avatarColor)
+{
+    m_chats.append({id, title, lastMessage, time, unreadCount, avatarColor});
+    rebuildFilteredChats();
+}
+
+void ChatModel::addOrUpdateChat(const QString &id, const QString &title, const QString &lastMessage, const QString &time, int unreadCount, const QString &avatarColor)
+{
+    for (int i = 0; i < m_chats.size(); ++i) {
+        if (m_chats[i].id == id) {
+            m_chats[i].title = title;
+            m_chats[i].lastMessage = lastMessage;
+            m_chats[i].time = time;
+            if (unreadCount >= 0)
+                m_chats[i].unreadCount = unreadCount;
+            if (!avatarColor.isEmpty())
+                m_chats[i].avatarColor = avatarColor;
+
+            // Move to top on new message
+            if (i > 0) {
+                ChatItem item = m_chats.takeAt(i);
+                m_chats.prepend(item);
+            }
+            rebuildFilteredChats();
+            return;
+        }
+    }
+
+    m_chats.prepend({id, title, lastMessage, time, unreadCount, avatarColor});
+    rebuildFilteredChats();
+}
+
+void ChatModel::updateLastMessage(const QString &chatId, const QString &lastMessage, const QString &time)
+{
+    for (int i = 0; i < m_chats.size(); ++i) {
+        if (m_chats[i].id == chatId) {
+            m_chats[i].lastMessage = lastMessage;
+            m_chats[i].time = time;
+            m_chats[i].unreadCount++;
+            if (i > 0) {
+                ChatItem item = m_chats.takeAt(i);
+                m_chats.prepend(item);
+            }
+            rebuildFilteredChats();
+            return;
+        }
+    }
+}
+
+void ChatModel::markAsRead(const QString &chatId)
+{
+    for (int i = 0; i < m_chats.size(); ++i) {
+        if (m_chats[i].id == chatId) {
+            m_chats[i].unreadCount = 0;
+            rebuildFilteredChats();
+            return;
+        }
+    }
+}
+
+void ChatModel::moveChatToTop(const QString &chatId)
+{
+    for (int i = 0; i < m_chats.size(); ++i) {
+        if (m_chats[i].id == chatId) {
+            if (i > 0) {
+                ChatItem item = m_chats.takeAt(i);
+                m_chats.prepend(item);
+                rebuildFilteredChats();
+            }
+            return;
+        }
+    }
+}
+
+void ChatModel::clear()
+{
+    beginResetModel();
+    m_chats.clear();
+    m_filteredChats.clear();
+    endResetModel();
+}
+
+ChatItem ChatModel::getChat(int row) const
+{
+    if (row >= 0 && row < m_filteredChats.size())
+        return m_filteredChats.at(row);
+    return ChatItem();
+}
diff --git a/overlay/asteroidos/telegram/src/chatmodel.h b/overlay/asteroidos/telegram/src/chatmodel.h
new file mode 100644
index 00000000..07a99f0b
--- /dev/null
+++ b/overlay/asteroidos/telegram/src/chatmodel.h
@@ -0,0 +1,63 @@
+#ifndef CHATMODEL_H
+#define CHATMODEL_H
+
+#include <QAbstractListModel>
+#include <QList>
+
+struct ChatItem {
+    QString id;
+    QString title;
+    QString lastMessage;
+    QString time;
+    int unreadCount;
+    QString avatarColor;
+};
+
+class ChatModel : public QAbstractListModel
+{
+    Q_OBJECT
+
+    Q_PROPERTY(QString filterQuery READ filterQuery WRITE setFilterQuery NOTIFY filterQueryChanged)
+
+public:
+    enum ChatRoles {
+        IdRole = Qt::UserRole + 1,
+        TitleRole,
+        LastMessageRole,
+        TimeRole,
+        UnreadCountRole,
+        AvatarColorRole
+    };
+
+    explicit ChatModel(QObject *parent = nullptr);
+
+    int rowCount(const QModelIndex &parent = QModelIndex()) const override;
+    QVariant data(const QModelIndex &index, int role = Qt::DisplayRole) const override;
+    QHash<int, QByteArray> roleNames() const override;
+
+    QString filterQuery() const { return m_filterQuery; }
+    void setFilterQuery(const QString &query);
+
+    bool hasChat(const QString &id) const;
+    void addChat(const QString &id, const QString &title, const QString &lastMessage, const QString &time, int unreadCount, const QString &avatarColor);
+    void addOrUpdateChat(const QString &id, const QString &title, const QString &lastMessage, const QString &time, int unreadCount, const QString &avatarColor);
+    void updateLastMessage(const QString &chatId, const QString &lastMessage, const QString &time);
+    void markAsRead(const QString &chatId);
+    void moveChatToTop(const QString &chatId);
+    void clear();
+
+    ChatItem getChat(int row) const;
+    QList<ChatItem> allChats() const { return m_chats; }
+
+signals:
+    void filterQueryChanged();
+
+private:
+    void rebuildFilteredChats();
+
+    QList<ChatItem> m_chats;
+    QList<ChatItem> m_filteredChats;
+    QString m_filterQuery;
+};
+
+#endif // CHATMODEL_H
diff --git a/overlay/asteroidos/telegram/src/main.cpp b/overlay/asteroidos/telegram/src/main.cpp
new file mode 100644
index 00000000..c156c0e4
--- /dev/null
+++ b/overlay/asteroidos/telegram/src/main.cpp
@@ -0,0 +1,30 @@
+#include <QGuiApplication>
+#include <QQmlApplicationEngine>
+#include <QQmlContext>
+#include <QIcon>
+#include "telegramclient.h"
+
+int main(int argc, char *argv[])
+{
+    qputenv("QT_QUICK_CONTROLS_STYLE", "Asteroid");
+
+    QGuiApplication app(argc, argv);
+    app.setApplicationName("asteroid-telegram");
+    app.setApplicationDisplayName("Telegram");
+    app.setOrganizationName("AsteroidOS");
+    app.setOrganizationDomain("asteroidos.org");
+    app.setWindowIcon(QIcon::fromTheme("asteroid-telegram", QIcon(":/asteroid-telegram.svg")));
+
+    TelegramClient client;
+
+    QQmlApplicationEngine engine;
+    engine.rootContext()->setContextProperty("telegramClient", &client);
+    engine.rootContext()->setContextProperty("chatModel", client.chats());
+    engine.rootContext()->setContextProperty("messageModel", client.messages());
+
+    engine.load(QUrl(QStringLiteral("qrc:/qml/main.qml")));
+    if (engine.rootObjects().isEmpty())
+        return -1;
+
+    return app.exec();
+}
diff --git a/overlay/asteroidos/telegram/src/messagemodel.cpp b/overlay/asteroidos/telegram/src/messagemodel.cpp
new file mode 100644
index 00000000..0d6b84f6
--- /dev/null
+++ b/overlay/asteroidos/telegram/src/messagemodel.cpp
@@ -0,0 +1,81 @@
+#include "messagemodel.h"
+
+MessageModel::MessageModel(QObject *parent)
+    : QAbstractListModel(parent)
+{
+}
+
+int MessageModel::rowCount(const QModelIndex &parent) const
+{
+    if (parent.isValid())
+        return 0;
+    return m_messages.size();
+}
+
+QVariant MessageModel::data(const QModelIndex &index, int role) const
+{
+    if (!index.isValid() || index.row() < 0 || index.row() >= m_messages.size())
+        return QVariant();
+
+    const MessageItem &item = m_messages.at(index.row());
+    switch (role) {
+    case IdRole:
+        return item.id;
+    case SenderRole:
+        return item.senderName;
+    case TextRole:
+        return item.text;
+    case TimeRole:
+        return item.time;
+    case IsOutgoingRole:
+        return item.isOutgoing;
+    case IsDeliveredRole:
+        return item.isDelivered;
+    case TypeRole:
+        return item.type;
+    case ExtraInfoRole:
+        return item.extraInfo;
+    default:
+        return QVariant();
+    }
+}
+
+QHash<int, QByteArray> MessageModel::roleNames() const
+{
+    QHash<int, QByteArray> roles;
+    roles[IdRole] = "messageId";
+    roles[SenderRole] = "senderName";
+    roles[TextRole] = "text";
+    roles[TimeRole] = "time";
+    roles[IsOutgoingRole] = "isOutgoing";
+    roles[IsDeliveredRole] = "isDelivered";
+    roles[TypeRole] = "type";
+    roles[ExtraInfoRole] = "extraInfo";
+    return roles;
+}
+
+void MessageModel::addMessage(const QString &id, const QString &sender, const QString &text, const QString &time, bool isOutgoing, bool isDelivered, const QString &type, const QString &extraInfo)
+{
+    beginInsertRows(QModelIndex(), m_messages.size(), m_messages.size());
+    m_messages.append({id, sender, text, time, isOutgoing, isDelivered, type, extraInfo});
+    endInsertRows();
+}
+
+void MessageModel::updateDelivered(const QString &id, bool isDelivered)
+{
+    for (int i = 0; i < m_messages.size(); ++i) {
+        if (m_messages[i].id == id) {
+            m_messages[i].isDelivered = isDelivered;
+            QModelIndex idx = index(i, 0);
+            emit dataChanged(idx, idx, {IsDeliveredRole});
+            return;
+        }
+    }
+}
+
+void MessageModel::clear()
+{
+    beginResetModel();
+    m_messages.clear();
+    endResetModel();
+}
