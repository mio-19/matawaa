From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 19:10:00 +1100
Subject: [PATCH] devices/fossil-hoki: do not hold multi-user for wlan firmware

WCNSS firmware loading can stall waiting for the modem, and wlan-firmware-hoki was a oneshot, so multi-user.target waited behind it. Keep it as a Type=simple setup service so WiFi initialization runs without blocking the user session.
---
 devices/fossil-hoki/default.nix | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/devices/fossil-hoki/default.nix b/devices/fossil-hoki/default.nix
index 414535bb..9d17da00 100644
--- a/devices/fossil-hoki/default.nix
+++ b/devices/fossil-hoki/default.nix
@@ -295,8 +295,8 @@
       coreutils
     ];
     serviceConfig = {
-      Type = "oneshot";
-      RemainAfterExit = true;
+      # Firmware loading can stall waiting for WCNSS; do not hold multi-user.
+      Type = "simple";
       ExecStart = "${pkgs.writeShellScript "wlan-firmware-hoki" (
         builtins.readFile ./wlan-firmware-hoki.sh
       )}";
