+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<busconfig>
+  <!-- Deny by default: only root and the unprivileged watch session user
+       (ceres, which runs asteroid-btsyncd and the apps) may talk to btsyncd. -->
+  <policy user="root">
+    <allow own="org.asteroidos.btsyncd"/>
+    <allow send_destination="org.asteroidos.btsyncd"/>
+    <allow receive_sender="org.asteroidos.btsyncd"/>
+  </policy>
+  <policy user="ceres">
+    <allow own="org.asteroidos.btsyncd"/>
+    <allow send_destination="org.asteroidos.btsyncd"/>
+    <allow receive_sender="org.asteroidos.btsyncd"/>
+  </policy>
+</busconfig>
