+++ b/overlay/asteroidos/asteroid-btsyncd/appbridgeservice.h
@@ -0,0 +1,86 @@
+/*
+ * Copyright (C) 2026 AsteroidOS
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef APPBRIDGESERVICE_H
+#define APPBRIDGESERVICE_H
+
+#include <QObject>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include "service.h"
+#include "characteristic.h"
+#include "common.h"
+
+// Wire format limits. Frames are [0xA0][appIdLen][appId][actionLen][action][payload].
+#define APP_BRIDGE_MAGIC          0xA0
+#define APP_BRIDGE_MAX_PACKET     512
+#define APP_BRIDGE_MAX_TOKEN_LEN  64
+#define APP_BRIDGE_MAX_PAYLOAD    256
+
+class AppBridgeService;
+
+// TX characteristic: Watch -> Phone notifications
+class AppBridgeTxChrc : public Characteristic
+{
+    Q_OBJECT
+    Q_PROPERTY(QByteArray Value READ getValue NOTIFY valueChanged)
+public:
+    AppBridgeTxChrc(QDBusConnection bus, int index, Service *service);
+
+public slots:
+    QByteArray ReadValue(QVariantMap) { return m_value; }
+    void StartNotify() {}
+    void StopNotify() {}
+    void sendPacket(const QByteArray &packet);
+
+signals:
+    void valueChanged();
+
+private:
+    QByteArray m_value;
+    QByteArray getValue() { return m_value; }
+    void emitPropertiesChanged();
+};
+
+// RX characteristic: Phone -> Watch writes
+class AppBridgeRxChrc : public Characteristic
+{
+    Q_OBJECT
+public:
+    AppBridgeRxChrc(QDBusConnection bus, int index, AppBridgeService *service);
+
+public slots:
+    void WriteValue(QByteArray value, QVariantMap);
+
+private:
+    AppBridgeService *m_service;
+};
+
+class AppBridgeService : public Service
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.asteroidos.btsyncd.AppBridge")
+public:
+    explicit AppBridgeService(int index, QDBusConnection bus, QObject *parent = nullptr);
+
+    void handleRxPacket(const QByteArray &packet);
+
+public slots:
+    void sendMessage(const QString &appId, const QString &action, const QString &payload);
+    void sendBytes(const QString &appId, const QString &action, const QByteArray &payload);
+
+signals:
+    void messageReceived(const QString &appId, const QString &action, const QString &payload);
+
+private:
+    AppBridgeTxChrc *m_txChrc;
+    AppBridgeRxChrc *m_rxChrc;
+};
+
+#endif // APPBRIDGESERVICE_H
diff --git a/overlay/asteroidos/asteroid-btsyncd/camera-shutter.sh b/overlay/asteroidos/asteroid-btsyncd/camera-shutter.sh
new file mode 100644
index 00000000..843b7162
--- /dev/null
+++ b/overlay/asteroidos/asteroid-btsyncd/camera-shutter.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# Ask the paired phone camera to perform one of the allowlisted remote actions.
+set -eu
+
+DEST="org.asteroidos.btsyncd"
+OBJECT="/org/asteroidos/btsyncd/appbridge"
+INTERFACE="org.asteroidos.btsyncd.AppBridge"
+ACTION="${1:-capture}"
+
+case "$ACTION" in
+    capture | flip | zoom_in | zoom_out | torch | mode_photo | mode_video | status_query) ;;
+    *)
+        echo "camera-shutter: unsupported action '$ACTION'" >&2
+        echo "usage: camera-shutter [capture|flip|zoom_in|zoom_out|torch|mode_photo|mode_video|status_query]" >&2
+        exit 2
+        ;;
+esac
+
+exec busctl --system call "$DEST" "$OBJECT" "$INTERFACE" sendMessage sss "org.asteroidos.camera" "$ACTION" ""
diff --git a/overlay/asteroidos/asteroid-btsyncd/default.nix b/overlay/asteroidos/asteroid-btsyncd/default.nix
new file mode 100644
index 00000000..770dc95b
--- /dev/null
+++ b/overlay/asteroidos/asteroid-btsyncd/default.nix
@@ -0,0 +1,85 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  systemd,
+  qt6,
+  qml-asteroid,
+  amber-mpris,
+  mlite,
+  kdePackages,
+  buildPackages,
+}:
+
+let
+  isCross = !stdenv.buildPlatform.canExecute stdenv.hostPlatform;
+in
+stdenv.mkDerivation (finalAttrs: {
+  pname = "asteroid-btsyncd";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "AsteroidOS";
+    repo = "asteroid-btsyncd";
+    rev = "e14fbcd9a157f0988204e874b03f6f800f89d645";
+    sha256 = "15vpd3y817gz8j1d7f56k5g1y3747grsjqc5z7b896n7rs2p8ijc";
+  };
+
+  strictDeps = true;
+
+  # AsteroidOS Bluetooth synchronization daemon
+  # Upstream repository: https://github.com/AsteroidOS/asteroid-btsyncd
+  # Companion phone app protocol (Gadgetbridge): https://codeberg.org/Freeyourgadget/Gadgetbridge
+  patches = [
+    # Adds find-phone D-Bus command and synchronization packet support for Gadgetbridge
+    ./find-phone.patch
+    # Generic App Bridge GATT service and D-Bus interface for remote camera and sensor sync
+    ./app-bridge.patch
+  ];
+
+  postPatch = ''
+    cp ${./appbridgeservice.h} src/appbridgeservice.h
+    cp ${./appbridgeservice.cpp} src/appbridgeservice.cpp
+  '';
+
+  nativeBuildInputs = [
+    cmake
+    kdePackages.extra-cmake-modules
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  cmakeFlags = [
+    "-DECM_DIR=${kdePackages.extra-cmake-modules}/share/ECM/cmake"
+  ]
+  ++ lib.optionals isCross [
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+    "-DQt6LinguistTools_DIR=${buildPackages.qt6.qttools}/lib/cmake/Qt6LinguistTools"
+  ];
+
+  buildInputs = [
+    systemd
+    qt6.qtbase
+    qt6.qtdeclarative
+    qml-asteroid
+    amber-mpris
+    mlite
+  ];
+
+  postInstall = ''
+    install -Dm755 ${./find-phone.sh} $out/bin/find-phone
+    install -Dm755 ${./camera-shutter.sh} $out/bin/camera-shutter
+    install -Dm644 ${./org.asteroidos.btsyncd.conf} $out/share/dbus-1/system.d/org.asteroidos.btsyncd.conf
+  '';
+
+  meta = with lib; {
+    description = "Bluetooth Low Energy synchronization daemon for AsteroidOS";
+    homepage = "https://asteroidos.org/";
+    license = licenses.gpl3Plus;
+    platforms = platforms.linux;
+  };
+})
