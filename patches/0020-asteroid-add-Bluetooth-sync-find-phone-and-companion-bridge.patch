diff --git a/overlay/asteroidos/asteroid-btsyncd/appbridgeservice.cpp b/overlay/asteroidos/asteroid-btsyncd/appbridgeservice.cpp
new file mode 100644
index 00000000..e73d496f
--- /dev/null
+++ b/overlay/asteroidos/asteroid-btsyncd/appbridgeservice.cpp
@@ -0,0 +1,300 @@
+/*
