+
+#include "appbridgeservice.h"
+#include <QDebug>
+#include <QSet>
+
+AppBridgeTxChrc::AppBridgeTxChrc(QDBusConnection bus, int index, Service *service)
+    : Characteristic(bus, index, APP_BRIDGE_TX_UUID,
+                     {"read", "notify", "encrypt-authenticated-read", "encrypt-authenticated-notify"},
+                     service)
+{
+}
+
+void AppBridgeTxChrc::sendPacket(const QByteArray &packet)
+{
+    m_value = packet;
+    emit valueChanged();
+    emitPropertiesChanged();
+    qDebug() << "AppBridge: Sent packet size" << packet.size();
+}
+
+void AppBridgeTxChrc::emitPropertiesChanged()
+{
+    QDBusConnection connection = QDBusConnection::systemBus();
+    QDBusMessage message = QDBusMessage::createSignal(getPath().path(),
+                                                      "org.freedesktop.DBus.Properties",
+                                                      "PropertiesChanged");
+
+    QVariantMap changedProperties;
+    changedProperties[QStringLiteral("Value")] = QVariant(m_value);
+
+    QList<QVariant> arguments;
+    arguments << QVariant(GATT_CHRC_IFACE) << QVariant(changedProperties) << QVariant(QStringList());
+    message.setArguments(arguments);
+
+    if (!connection.send(message)) {
+        qDebug() << "AppBridge: Failed to send DBus property notification signal";
+    }
+}
+
+AppBridgeRxChrc::AppBridgeRxChrc(QDBusConnection bus, int index, AppBridgeService *service)
+    : Characteristic(bus, index, APP_BRIDGE_RX_UUID,
+                     {"write", "write-without-response", "encrypt-authenticated-write"},
+                     service),
+      m_service(service)
+{
+}
+
+void AppBridgeRxChrc::WriteValue(QByteArray value, QVariantMap)
+{
+    if (m_service) {
+        m_service->handleRxPacket(value);
+    }
+}
+
+AppBridgeService::AppBridgeService(int index, QDBusConnection bus, QObject *parent)
+    : Service(bus, index, APP_BRIDGE_UUID, parent)
+{
+    m_txChrc = new AppBridgeTxChrc(bus, 0, this);
+    addCharacteristic(m_txChrc);
+
+    m_rxChrc = new AppBridgeRxChrc(bus, 1, this);
+    addCharacteristic(m_rxChrc);
+
+    bus.registerObject("/org/asteroidos/btsyncd/appbridge", this,
+                       QDBusConnection::ExportAllSlots | QDBusConnection::ExportAllSignals | QDBusConnection::ExportAllProperties);
+}
+
+namespace {
+
+const QString kCameraId = QStringLiteral("org.asteroidos.camera");
+const QString kSpo2Id = QStringLiteral("org.asteroidos.spo2");
+const QString kKeyboardId = QStringLiteral("org.asteroidos.keyboard");
+
+// Wire alias -> canonical app id. Anything else is rejected.
+QString normalizeAppId(const QString &id)
+{
+    if (id == QStringLiteral("cam") || id == kCameraId) {
+        return kCameraId;
+    }
+    if (id == QStringLiteral("spo2") || id == kSpo2Id) {
+        return kSpo2Id;
+    }
+    if (id == QStringLiteral("kbd") || id == kKeyboardId) {
+        return kKeyboardId;
+    }
+    return QString();
+}
+
+QByteArray compactAppId(const QString &canonical)
+{
+    if (canonical == kCameraId) {
+        return QByteArrayLiteral("cam");
+    }
+    if (canonical == kKeyboardId) {
+        return QByteArrayLiteral("kbd");
+    }
+    return QByteArrayLiteral("spo2");
+}
+
+// Phone -> watch camera actions (the only ones the watch acts upon).
+bool isCameraRxAction(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("ready"),
+        QStringLiteral("paused"),
+        QStringLiteral("photo_captured"),
+        QStringLiteral("video_started"),
+        QStringLiteral("video_stopped"),
+    };
+    return allowed.contains(action);
+}
+
+// Watch -> phone camera actions.
+bool isCameraTxAction(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("capture"),
+        QStringLiteral("flip"),
+        QStringLiteral("zoom_in"),
+        QStringLiteral("zoom_out"),
+        QStringLiteral("torch"),
+        QStringLiteral("mode_photo"),
+        QStringLiteral("mode_video"),
+        QStringLiteral("status_query"),
+    };
+    return allowed.contains(action);
+}
+
+// Phone -> watch keyboard actions.
+bool isKeyboardRxAction(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("commit"),
+        QStringLiteral("text"),
+        QStringLiteral("backspace"),
+        QStringLiteral("enter"),
+        QStringLiteral("close"),
+    };
+    return allowed.contains(action);
+}
+
+// Watch -> phone keyboard actions.
+bool isKeyboardTxAction(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("request_input"),
+        QStringLiteral("open"),
+        QStringLiteral("close"),
+    };
+    return allowed.contains(action);
+}
+
+// Generic action syntax for apps without a fixed action list (spo2).
+bool isPlainToken(const QByteArray &token)
+{
+    if (token.isEmpty() || token.size() > APP_BRIDGE_MAX_TOKEN_LEN) {
+        return false;
+    }
+    for (char ch : token) {
+        const bool ok = (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9')
+                        || ch == '_' || ch == '.';
+        if (!ok) {
+            return false;
+        }
+    }
+    return true;
+}
+
+size_t maxPayloadFor(const QString &canonicalAppId)
+{
+    // The camera protocol carries no payload in either direction.
+    return canonicalAppId == kCameraId ? 0 : APP_BRIDGE_MAX_PAYLOAD;
+}
+
+} // namespace
+
+void AppBridgeService::sendMessage(const QString &appId, const QString &action, const QString &payload)
+{
+    sendBytes(appId, action, payload.toUtf8());
+}
+
+void AppBridgeService::sendBytes(const QString &appId, const QString &action, const QByteArray &payload)
+{
+    const QString canonical = normalizeAppId(appId);
+    if (canonical.isEmpty()) {
+        qWarning() << "AppBridge: rejecting send, app id not allowed";
+        return;
+    }
+
+    const QByteArray actionBytes = action.toUtf8();
+    if (!isPlainToken(actionBytes)) {
+        qWarning() << "AppBridge: rejecting send, malformed action";
+        return;
+    }
+    if (canonical == kCameraId && !isCameraTxAction(action)) {
+        qWarning() << "AppBridge: rejecting send, camera action not allowed:" << action;
+        return;
+    }
+    if (canonical == kKeyboardId && !isKeyboardTxAction(action)) {
+        qWarning() << "AppBridge: rejecting send, keyboard action not allowed:" << action;
+        return;
+    }
+
+    QByteArray body = payload;
+    if (canonical == kCameraId) {
+        body.clear();
+    } else if (static_cast<size_t>(body.size()) > maxPayloadFor(canonical)) {
+        qWarning() << "AppBridge: rejecting send, payload too large";
+        return;
+    }
+
+    const QByteArray appIdBytes = compactAppId(canonical);
+
+    QByteArray packet;
+    packet.append(static_cast<char>(APP_BRIDGE_MAGIC));
+    packet.append(static_cast<char>(appIdBytes.size()));
+    packet.append(appIdBytes);
+    packet.append(static_cast<char>(actionBytes.size()));
+    packet.append(actionBytes);
+    packet.append(body);
+
+    if (packet.size() > APP_BRIDGE_MAX_PACKET) {
+        qWarning() << "AppBridge: rejecting send, packet too large";
+        return;
+    }
+
+    if (m_txChrc) {
+        m_txChrc->sendPacket(packet);
+    }
+}
+
+void AppBridgeService::handleRxPacket(const QByteArray &packet)
+{
+    // Layout: [0xA0][appIdLen][appId][actionLen][action][payload]
+    const int size = packet.size();
+    if (size < 4 || size > APP_BRIDGE_MAX_PACKET) {
+        qWarning() << "AppBridge: dropping packet with invalid size" << size;
+        return;
+    }
+
+    if (static_cast<uint8_t>(packet.at(0)) != APP_BRIDGE_MAGIC) {
+        qWarning() << "AppBridge: dropping packet with invalid magic byte";
+        return;
+    }
+
+    int offset = 1;
+    const int appIdLen = static_cast<uint8_t>(packet.at(offset++));
+    if (appIdLen == 0 || appIdLen > APP_BRIDGE_MAX_TOKEN_LEN || offset + appIdLen + 1 > size) {
+        qWarning() << "AppBridge: dropping packet with invalid app id length";
+        return;
+    }
+    const QByteArray rawAppId = packet.mid(offset, appIdLen);
+    offset += appIdLen;
+
+    const int actionLen = static_cast<uint8_t>(packet.at(offset++));
+    if (actionLen == 0 || actionLen > APP_BRIDGE_MAX_TOKEN_LEN || offset + actionLen > size) {
+        qWarning() << "AppBridge: dropping packet with invalid action length";
+        return;
+    }
+    const QByteArray rawAction = packet.mid(offset, actionLen);
+    offset += actionLen;
+
+    if (!isPlainToken(rawAppId) || !isPlainToken(rawAction)) {
+        qWarning() << "AppBridge: dropping packet with malformed app id or action";
+        return;
+    }
+
+    const QString appId = normalizeAppId(QString::fromLatin1(rawAppId));
+    if (appId.isEmpty()) {
+        qWarning() << "AppBridge: dropping packet for unknown app id";
+        return;
+    }
+    const QString action = QString::fromLatin1(rawAction);
+
+    const QByteArray payloadBytes = packet.mid(offset);
+    if (static_cast<size_t>(payloadBytes.size()) > maxPayloadFor(appId)) {
+        qWarning() << "AppBridge: dropping packet with disallowed payload size" << payloadBytes.size();
+        return;
+    }
+
+    if (appId == kCameraId && !isCameraRxAction(action)) {
+        qWarning() << "AppBridge: dropping unexpected camera action from phone:" << action;
+        return;
+    }
+    if (appId == kKeyboardId && !isKeyboardRxAction(action)) {
+        qWarning() << "AppBridge: dropping unexpected keyboard action from phone:" << action;
+        return;
+    }
+
+    qDebug() << "AppBridge: Received message for" << appId << "action:" << action;
+    emit messageReceived(appId, action, QString::fromUtf8(payloadBytes));
+}
diff --git a/overlay/asteroidos/asteroid-btsyncd/appbridgeservice.h b/overlay/asteroidos/asteroid-btsyncd/appbridgeservice.h
new file mode 100644
