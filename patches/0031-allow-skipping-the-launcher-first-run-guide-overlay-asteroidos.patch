From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:13:49 +1100
Subject: [PATCH] allow skipping the launcher first-run guide
 (overlay/asteroidos)

Apply the skip-firstrun patch to asteroid-launcher so the initial
tutorial and setup guide can be dismissed with a visible skip button.

This is useful for preconfigured watch images and automated bring-up.
---
 .../asteroidos/asteroid-launcher/default.nix  |  2 ++
 .../asteroid-launcher/skip-firstrun.patch     | 23 +++++++++++++++++++
 2 files changed, 25 insertions(+)
 create mode 100644 overlay/asteroidos/asteroid-launcher/skip-firstrun.patch

diff --git a/overlay/asteroidos/asteroid-launcher/default.nix b/overlay/asteroidos/asteroid-launcher/default.nix
index 235c277e..698d8ef5 100644
--- a/overlay/asteroidos/asteroid-launcher/default.nix
+++ b/overlay/asteroidos/asteroid-launcher/default.nix
@@ -42,6 +42,8 @@ stdenv.mkDerivation (finalAttrs: {
   patches = [
     # QuickPanel quick-toggle button to trigger the find-phone alarm on the companion phone
     ./find-phone.patch
+    # Tip for first-time tutorial indicating long press skips the guide
+    ./skip-firstrun.patch
     # Remove OpacityMask dependency from the 400ms initial splash animation
     ./splash-no-opacitymask.patch
     # Proactively show and activate compositor window on startup (matching upstream AsteroidOS DisplayOn)
diff --git a/overlay/asteroidos/asteroid-launcher/skip-firstrun.patch b/overlay/asteroidos/asteroid-launcher/skip-firstrun.patch
new file mode 100644
index 00000000..3049a22c
--- /dev/null
+++ b/overlay/asteroidos/asteroid-launcher/skip-firstrun.patch
@@ -0,0 +1,23 @@
+--- a/src/qml/firstrun/Tutorial.qml
++++ b/src/qml/firstrun/Tutorial.qml
+@@ -524,6 +524,20 @@
+             horizontalAlignment: Text.AlignHCenter
+         }
+ 
++        Label {
++            id: skipTip
++            visible: tuto.state === "WELCOME"
++            text: qsTr("Long press to skip")
++            font.pixelSize: Dims.l(3.5)
++            color: "#888888"
++            horizontalAlignment: Text.AlignHCenter
++            anchors {
++                bottom: nextButton.top
++                horizontalCenter: parent.horizontalCenter
++                bottomMargin: Dims.h(1)
++            }
++        }
++
+         IconButton {
+             id: nextButton
+             iconName: "ios-arrow-dropright"
