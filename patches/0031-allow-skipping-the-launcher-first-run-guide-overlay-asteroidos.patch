From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:13:49 +1100
Subject: [PATCH] allow skipping the launcher first-run guide
 (overlay/asteroidos)

Apply the skip-firstrun patch to asteroid-launcher so the initial
tutorial and setup guide can be dismissed with a visible skip button.

This is useful for preconfigured watch images and automated bring-up.
---
 .../asteroidos/asteroid-launcher/default.nix  |  2 +
 .../asteroid-launcher/skip-firstrun.patch     | 45 +++++++++++++++++++
 2 files changed, 47 insertions(+)
 create mode 100644 overlay/asteroidos/asteroid-launcher/skip-firstrun.patch

diff --git a/overlay/asteroidos/asteroid-launcher/default.nix b/overlay/asteroidos/asteroid-launcher/default.nix
index bfc24190..1a58d148 100644
--- a/overlay/asteroidos/asteroid-launcher/default.nix
+++ b/overlay/asteroidos/asteroid-launcher/default.nix
@@ -41,6 +41,8 @@ stdenv.mkDerivation (finalAttrs: {
   patches = [
     # QuickPanel quick-toggle button to trigger the find-phone alarm on the companion phone
     ./find-phone.patch
+    # Visible skip button for first-time tutorial and initial setup guide
+    ./skip-firstrun.patch
   ];
 
   nativeBuildInputs = [
diff --git a/overlay/asteroidos/asteroid-launcher/skip-firstrun.patch b/overlay/asteroidos/asteroid-launcher/skip-firstrun.patch
new file mode 100644
index 00000000..a3dc5d7b
--- /dev/null
+++ b/overlay/asteroidos/asteroid-launcher/skip-firstrun.patch
@@ -0,0 +1,45 @@
+--- a/src/qml/firstrun/FirstRunConfig.qml	2026-10-18 13:45:58.913015468 +1100
++++ b/src/qml/firstrun/FirstRunConfig.qml	2026-10-18 13:45:58.913015468 +1100
+@@ -267,6 +267,20 @@
+     }
+ 
+     IconButton {
++        id: skipButton
++        iconName: "ios-close"
++        anchors {
++            top: parent.top
++            horizontalCenter: parent.horizontalCenter
++            topMargin: Dims.iconButtonMargin
++        }
++        onClicked: {
++            firstRun.stopFirstRun()
++            config.destroy()
++        }
++    }
++
++    IconButton {
+         id: nextButton
+         iconName: "ios-arrow-dropright"
+         anchors { 
+--- a/src/qml/firstrun/Tutorial.qml	2026-10-18 13:45:58.913015468 +1100
++++ b/src/qml/firstrun/Tutorial.qml	2026-10-18 13:45:58.913015468 +1100
+@@ -525,6 +525,19 @@
+         }
+ 
+         IconButton {
++            id: skipButton
++            iconName: "ios-close"
++            anchors {
++                top: parent.top
++                horizontalCenter: parent.horizontalCenter
++                topMargin: Dims.iconButtonMargin
++            }
++            onClicked: {
++                tuto.state = "DONE";
++            }
++        }
++
++        IconButton {
+             id: nextButton
+             iconName: "ios-arrow-dropright"
+             anchors { 
