From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:13:49 +1100
Subject: [PATCH] allow skipping the launcher first-run guide
 (overlay/asteroidos)

Fetch upstream PR 310 to allow dismissing the initial tutorial
and setup guide with a visible "Long press to skip" hint and long-press handler.
---
 overlay/asteroidos/asteroid-launcher/default.nix | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/overlay/asteroidos/asteroid-launcher/default.nix b/overlay/asteroidos/asteroid-launcher/default.nix
index 235c277e..95bab117 100644
--- a/overlay/asteroidos/asteroid-launcher/default.nix
+++ b/overlay/asteroidos/asteroid-launcher/default.nix
@@ -2,6 +2,7 @@
   lib,
   stdenv,
   fetchFromGitHub,
+  fetchpatch,
   cmake,
   pkg-config,
   qt6,
@@ -42,6 +43,12 @@ stdenv.mkDerivation (finalAttrs: {
   patches = [
     # QuickPanel quick-toggle button to trigger the find-phone alarm on the companion phone
     ./find-phone.patch
+    # Tip for first-time tutorial indicating long press skips the guide
+    # Upstream PR: https://github.com/AsteroidOS/asteroid-launcher/pull/310
+    (fetchpatch {
+      url = "https://github.com/AsteroidOS/asteroid-launcher/pull/310.patch";
+      hash = "sha256-zFU7CbI4YqPSDWirkhUW5wxYwYLi0rft2AxwJ7TGqMg=";
+    })
     # Remove OpacityMask dependency from the 400ms initial splash animation
     ./splash-no-opacitymask.patch
     # Proactively show and activate compositor window on startup (matching upstream AsteroidOS DisplayOn)
