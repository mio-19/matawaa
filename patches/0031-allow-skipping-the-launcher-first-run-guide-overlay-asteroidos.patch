From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:13:49 +1100
Subject: [PATCH] allow skipping the launcher first-run guide
 (overlay/asteroidos)

Fetch upstream PR 310 to allow dismissing the initial tutorial
and setup guide with a visible "Long press to skip" hint and long-press handler.
---
 overlay/asteroidos/asteroid-launcher/default.nix | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/overlay/asteroidos/asteroid-launcher/default.nix b/overlay/asteroidos/asteroid-launcher/default.nix
index 6a681bcf..34a7fd1e 100644
--- a/overlay/asteroidos/asteroid-launcher/default.nix
+++ b/overlay/asteroidos/asteroid-launcher/default.nix
@@ -39,7 +39,6 @@ stdenv.mkDerivation (finalAttrs: {
 
   strictDeps = true;
 
-<<<<<<< HEAD
   postPatch = ''
     substituteInPlace src/qml/MainScreen.qml \
       --replace-fail "/usr/share/asteroid-launcher" "/run/current-system/sw/share/asteroid-launcher"
@@ -60,22 +59,23 @@ stdenv.mkDerivation (finalAttrs: {
       --replace-fail "/usr/bin/notificationtool" "/run/current-system/sw/bin/notificationtool"
   '';
 
