From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sat, 31 Oct 2026 08:19:48 +1100
Subject: [PATCH] Switch nixpkgs pin to cached nixos-26.05

---
 .../pkgs/scripted-installer/automated-installer.rb        | 2 +-
 npins/sources.json                                        | 8 ++++----
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/examples/installer/pkgs/scripted-installer/automated-installer.rb b/examples/installer/pkgs/scripted-installer/automated-installer.rb
index 40739168..431bead7 100644
--- a/examples/installer/pkgs/scripted-installer/automated-installer.rb
+++ b/examples/installer/pkgs/scripted-installer/automated-installer.rb
@@ -105,7 +105,7 @@ end
 # See also `nix.nixPath` option, which uses `nixpkgs=/nix/var/nix/profiles/per-user/root/channels/nixos`
 # Keep installed systems on the same nixpkgs branch as the image builds.
 channels = [
-  ["https://github.com/NixOS/nixpkgs/archive/refs/heads/staging-26.05.tar.gz", "nixos"],
+  ["https://github.com/NixOS/nixpkgs/archive/refs/heads/nixos-26.05.tar.gz", "nixos"],
   ["https://github.com/mobile-nixos/mobile-nixos/archive/refs/heads/development.tar.gz", "mobile-nixos"],
 ].map{|pair| pair.join(" ") }.join("\n")
 File.write(File.join(MOUNT_POINT, "/root/.nix-channels"), channels)
diff --git a/npins/sources.json b/npins/sources.json
index 5de2861a..dba66e0c 100644
--- a/npins/sources.json
+++ b/npins/sources.json
@@ -7,11 +7,11 @@
         "owner": "NixOS",
         "repo": "nixpkgs"
       },
-      "branch": "staging-26.05",
-      "revision": "141fd3604320e9250ae88d93ca306ae4db0e5aa9",
-      "url": "https://github.com/NixOS/nixpkgs/archive/141fd3604320e9250ae88d93ca306ae4db0e5aa9.tar.gz",
+      "branch": "nixos-26.05",
+      "revision": "6f06d204d8f2d8761d9da78778745974a3216381",
+      "url": "https://github.com/NixOS/nixpkgs/archive/6f06d204d8f2d8761d9da78778745974a3216381.tar.gz",
       "submodules": false,
-      "hash": "sha256-o73IL5zqycdwz4gTesIwNHMT4UEjwrFxLmBOQ9IFONE="
+      "hash": "sha256-loLMnbbS4KhmG2ln9EY6f0YMNCA273Yx02oWYQ9IMeE="
     }
   },
   "version": 8
