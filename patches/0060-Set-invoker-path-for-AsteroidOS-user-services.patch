From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sun, 1 Nov 2026 21:37:27 +1100
Subject: [PATCH] Set invoker path for AsteroidOS user services

---
 examples/asteroid/asteroid-desktop.nix | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index a0c1cdf8..4387681b 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -748,6 +748,15 @@ in
     # Apply the same EnvironmentFile on the only user manager we run.
     systemd.services."user@1000" = {
       overrideStrategy = "asDropin";
+      # AsteroidOS desktop entries and service wrappers invoke apps through
+      # `invoker`. The systemd user manager does not inherit the interactive
+      # shell PATH, so expose mapplauncherd to the manager and all its apps.
+      environment.PATH =
+        "/run/current-system/sw/bin:"
+        + lib.makeBinPath [
+          pkgs.asteroid.mapplauncherd
+          pkgs.coreutils
+        ];
       serviceConfig.EnvironmentFile = [
         "-/home/.system/var/lib/environment/1000/locale.conf"
       ];
