   libiodata,
   buildPackages,
   metaAsteroidSrc,
+  tzdata,
 }:
 
 let
@@ -46,6 +47,7 @@ stdenv.mkDerivation (finalAttrs: {
     qt6.qtbase
     systemd
     libiodata
+    tzdata
   ];
 
   # timed-qt6.pc Requires iodata-qt6, so consumers need its pkg-config file.
@@ -245,6 +247,11 @@ Requires: Qt6Core Qt6DBus timed-qt6
 Libs: -L''${libdir} -ltimed-voland-qt6
 Cflags: -I''${includedir} -I@CMAKE_INSTALL_PREFIX@/include
 EOF
+
+    substituteInPlace src/server/settings.cpp \
+      --replace-fail '"/usr/share/zoneinfo/' "\"${tzdata}/share/zoneinfo/"
+    substituteInPlace src/lib/aliases.cpp \
+      --replace-fail '"/usr/share/zoneinfo/' "\"${tzdata}/share/zoneinfo/"
   '';
 
   postInstall = ''
diff --git a/overlay/asteroidos/virtualkeyboard/default.nix b/overlay/asteroidos/virtualkeyboard/default.nix
index 5d616bcb..54ce4ee1 100644
--- a/overlay/asteroidos/virtualkeyboard/default.nix
+++ b/overlay/asteroidos/virtualkeyboard/default.nix
@@ -28,6 +28,8 @@ stdenv.mkDerivation (finalAttrs: {
   postPatch = ''
     cp ${./rimeinputmethod.cpp} rimeinputmethod.cpp
     cp ${./rimeinputmethod.h} rimeinputmethod.h
+    substituteInPlace rimeinputmethod.cpp \
+      --replace-fail '"/usr/share/rime-data"' '"${rime-data}/share/rime-data"'
     mkdir -p layouts
     cp -r ${./layouts}/* layouts/
   '';
diff --git a/overlay/systemd.nix b/overlay/systemd.nix
index 324ad95f..45012ded 100644
--- a/overlay/systemd.nix
+++ b/overlay/systemd.nix
@@ -36,9 +36,13 @@ let
 
   systemd257 =
     (super.lib.callPackageWith
-      (builtins.intersectAttrs (super.lib.functionArgs (import ./systemd-257)) final)
+      (builtins.intersectAttrs (super.lib.functionArgs (import ./systemd-257)) super)
       ./systemd-257
-      { stdenv = systemdStdenv; }
+      {
+        stdenv = systemdStdenv;
+        libcap = super.libcap.override { usePam = false; };
+        util-linux = super.util-linuxMinimal;
+      }
     ).override
       (
         {
@@ -47,6 +51,10 @@ let
           withHomed = false;
           withRepart = false;
           withFido2 = false;
+          withIptables = false;
+          withRemote = false;
+          withTpm2Tss = false;
+          withImportd = false;
         }
         // super.lib.optionalAttrs (superStdenv.hostPlatform.isAarch32) {
           withLibBPF = false;
