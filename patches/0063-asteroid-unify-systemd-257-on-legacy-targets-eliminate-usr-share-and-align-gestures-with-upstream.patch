+    QT_QPA_EGLFS_INTEGRATION = lib.mkDefault "eglfs_kms";
+    QT_QPA_EGLFS_ALWAYS_SET_MODE = lib.mkDefault "1";
   };
 
   zramSwap.enable = true;
