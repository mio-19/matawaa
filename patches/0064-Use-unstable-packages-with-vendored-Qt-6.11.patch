--- a/overlay/cross-compile.nix
+++ b/overlay/cross-compile.nix
@@ -1,8 +1,8 @@
 # Overlays and package workarounds that only make sense during cross-compilation.
 #
-# When building natively (buildPlatform == hostPlatform), this overlay returns empty {}.
-# When cross-compiling, it provides upstream fixes for Qt 6, 32-bit ARM toolchains,
-# NetSurf host build tools, Skia, systemd, and libkiwix.
+# When building natively, this overlay selects vendored Qt 6.11 for matching
+# Qt host tools. When cross-compiling, it also provides upstream fixes for Qt 6,
+# 32-bit ARM toolchains, NetSurf host build tools, Skia, systemd, and libkiwix.
 final: super:
 
 let
@@ -11,7 +11,12 @@ let
     superStdenv != null && superStdenv.buildPlatform.system != superStdenv.hostPlatform.system;
 in
 if !isCross then
-  { }
+  {
+    # Use the same vendored Qt package definitions for host tools as for the
+    # target Qt libraries during cross compilation. Their dependencies and
+    # toolchains still come from the current Nixpkgs package set.
+    qt6 = final.callPackage ./vendor/qt-6.11 { };
+  }
 else
   let
     # Pinned revision of AsteroidOS meta-asteroid used as the source for
@@ -97,19 +102,9 @@ else
           }
         );
 
-    # Mbed TLS 3.6.6's ARM AES/GCM code triggers GCC 15's array-bounds
-    # diagnostic in its bytewise XOR helper. The package enables -Werror,
-    # so keep that compiler warning non-fatal for this cross-built package.
-    mbedtls = super.mbedtls.overrideAttrs (old: {
-      env = (old.env or { }) // {
-        NIX_CFLAGS_COMPILE = ((old.env or { }).NIX_CFLAGS_COMPILE or "") + " -Wno-error=array-bounds";
-      };
-    });
-
   in
   {
     inherit systemd257;
-    inherit mbedtls;
     # Keep the patched systemd 262 for old kernels available for debugging
     # or fallback even when the legacy profile selects systemd 257.
     systemd262oldkernel = systemd262OldKernel;
@@ -133,7 +128,7 @@ else
 
     # Upstream nixpkgs Qt6 modules skip QtQuick integration during cross-compilation
     # because cross Qt6QuickTools, Qt6QmlTools, and Qt6ShaderToolsTools cmake flags are missing.
-    qt6 = super.qt6.overrideScope (
+    qt6 = (final.callPackage ./vendor/qt-6.11 { }).overrideScope (
       qfinal: qsuper: {
         # Upstream AsteroidOS builds Qt without desktop GL on hybris machines:
         # meta-asteroid/recipes-qt/qt6/qtbase_git.bbappend does
@@ -364,18 +359,6 @@ else
     # Smartwatches do not use InfiniBand, so disable RDMA.
     libpcap = super.libpcap.override { withRdma = false; };
 
-    # x265 4.2 in nixpkgs contains an obsolete patch for 32-bit ARM that was
-    # already incorporated upstream, causing patch rejects during cross builds.
-    x265 = (super.x265.override {
-      # The command-line encoder fails to link its ARM NEON test symbols.
-      # FFmpeg uses the shared library and does not need this executable.
-      cliSupport = false;
-    }).overrideAttrs (old: {
-      patches = super.lib.filter (p: !(super.lib.hasInfix "raw" (builtins.baseNameOf (toString p)))) (
-        old.patches or [ ]
-      );
-    });
-
     # Skia gnFlags cpu mapping expects "arm" instead of "armv7l".
     # Reference: https://github.com/NixOS/nixpkgs/blob/master/pkgs/by-name/sk/skia/package.nix
     skia = super.skia.override {
diff --git a/overlay/vendor/qt-6.11/README.md b/overlay/vendor/qt-6.11/README.md
new file mode 100644
index 00000000..f9b7b01f
--- /dev/null
+++ b/overlay/vendor/qt-6.11/README.md
@@ -0,0 +1,14 @@
+Vendored Qt 6.11 package definitions
+====================================
+
+Source: NixOS/nixpkgs `staging-26.05`, revision
+`3da11a55bdd37955b63cc4182ff789eeaa152329` (Qt 6.11.3).
+
+The package expressions in this directory are called from the active unstable
+package set. Dependencies, compilers, and other non-Qt packages therefore come
+from unstable. The cross-compilation changes from
+`overlay/nixpkgs-patches/0001-qt6-cross-host-leak.patch` are applied to the Qt
+files here so target modules use matching Qt 6.11 host tools.
+
+Nixpkgs is licensed under the MIT license; see the Nixpkgs source for the full
+license text.
diff --git a/overlay/vendor/qt-6.11/default.nix b/overlay/vendor/qt-6.11/default.nix
new file mode 100644
index 00000000..e8a7c285
--- /dev/null
+++ b/overlay/vendor/qt-6.11/default.nix
@@ -0,0 +1,160 @@
+{
+  newScope,
+  lib,
+  stdenv,
+  generateSplicesForMkScope,
+  makeScopeWithSplicing',
+  fetchurl,
+  fetchpatch2,
+  makeSetupHook,
+  makeWrapper,
+  runCommand,
+  gst_all_1,
+  libglvnd,
+  darwin,
+  apple-sdk_15,
+  darwinMinVersionHook,
+  buildPackages,
+  python3,
+  config,
+}:
+
+let
+  srcs = import ./srcs.nix {
+    inherit fetchurl;
+    mirror = "mirror://qt";
+  };
+
+  addPackages =
+    self:
+    let
+      callPackage = self.newScope {
+        inherit (self) qtModule;
+        inherit srcs python3 stdenv;
+      };
+
+      # Per <https://doc.qt.io/qt-6/macos.html#supported-versions>.
+      # This should reflect the highest “Build Environment” and the
+      # lowest “Target Platform”.
+      darwinVersionInputs = [
+        apple-sdk_15
+        (darwinMinVersionHook "12.0")
+      ];
+
+      onlyPluginsAndQml =
+        drv:
+        let
+          drv' = drv.__spliced.targetTarget or drv;
+          inherit (self.qtbase) qtPluginPrefix qtQmlPrefix;
+        in
+        (runCommand "${drv'.name}-only-plugins-qml" { } ''
+          mkdir -p $(dirname "$out/${qtPluginPrefix}")
+          test -d "${drv'}/${qtPluginPrefix}" && ln -s "${drv'}/${qtPluginPrefix}" "$out/${qtPluginPrefix}" || true
+          test -d "${drv'}/${qtQmlPrefix}" && ln -s "${drv'}/${qtQmlPrefix}" "$out/${qtQmlPrefix}" || true
+        '');
+    in
+    {
+
+      inherit callPackage srcs darwinVersionInputs;
+
+      qtModule = callPackage ./qtModule.nix {
+        inherit darwinVersionInputs;
+      };
+
+      qtbase = callPackage ./modules/qtbase {
+        withGtk3 = !stdenv.hostPlatform.isMinGW;
+        inherit darwinVersionInputs;
+        inherit (srcs.qtbase) src version;
+      };
+      env = callPackage ./qt-env.nix { };
+      qt3d = callPackage ./modules/qt3d.nix { };
+      qt5compat = callPackage ./modules/qt5compat.nix { };
+      qtcharts = callPackage ./modules/qtcharts.nix { };
+      qtconnectivity = callPackage ./modules/qtconnectivity.nix { };
+      qtdatavis3d = callPackage ./modules/qtdatavis3d.nix { };
+      qtdeclarative = callPackage ./modules/qtdeclarative { };
+      qtdoc = callPackage ./modules/qtdoc.nix { };
+      qtgraphs = callPackage ./modules/qtgraphs.nix { };
+      qtgrpc = callPackage ./modules/qtgrpc.nix { };
+      qthttpserver = callPackage ./modules/qthttpserver.nix { };
+      qtimageformats = callPackage ./modules/qtimageformats.nix { };
+      qtlanguageserver = callPackage ./modules/qtlanguageserver.nix { };
+      qtlocation = callPackage ./modules/qtlocation.nix { };
