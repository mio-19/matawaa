From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 9 Nov 2026 10:55:46 +1100
Subject: [PATCH] modules: add AsteroidOS machine configuration

---
 modules/asteroid-config.nix                                |   41 +++++++++++++
 modules/module-list.nix                                    |    1 ++
2 files changed, 42 insertions(+)

diff --git a/modules/asteroid-config.nix b/modules/asteroid-config.nix
new file mode 100644
index 0000000000000000000000000000000000000000..422aec0f7298912217258f89eed6f3ba7427aae7
--- /dev/null
+++ b/modules/asteroid-config.nix
@@ -0,0 +1,41 @@
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+
+let
+  inherit (lib) mkIf;
+  screenCfg = config.mobile.hardware.screen;
+  watchCfg = config.mobile.hardware.watch;
+  devName =
+    if config.mobile ? device && config.mobile.device ? name then
+      config.mobile.device.name
+    else
+      "generic";
+
+  # Generates standard /etc/asteroid/machine.conf expected by AsteroidOS launcher,
+  # qml-asteroid, and applications.
+  machineConf = (pkgs.formats.ini { }).generate "machine.conf" {
+    Display = {
+      FLAT_TIRE = screenCfg.chinHeight;
+      ROUND = screenCfg.shape == "round" || screenCfg.shape == "chin";
+      NEEDS_BURN_IN_PROTECTION = watchCfg.burnInProtection;
+    }
+    // lib.optionalAttrs (watchCfg.borderGestureWidth != null) {
+      BORDER_GESTURE_WIDTH = watchCfg.borderGestureWidth;
+    };
+    Capabilities = {
+      HAS_WLAN = watchCfg.hasWlan;
+      HAS_SPEAKER = watchCfg.hasSpeaker;
+    };
+    Identity.MACHINE = devName;
+  };
+
+in
+{
+  config = mkIf (config.mobile.enable && watchCfg.enable) {
+    environment.etc."asteroid/machine.conf".source = machineConf;
+  };
+}
diff --git a/modules/module-list.nix b/modules/module-list.nix
index 0a18885d..fe4ce596 100644
--- a/modules/module-list.nix
+++ b/modules/module-list.nix
@@ -2,6 +2,7 @@
 # Keep this list `:sort`ed.
 [
   ./adb.nix
+  ./asteroid-config.nix
   ./beautification.nix
   ./boot-control.nix
   ./boot-initrd.nix
