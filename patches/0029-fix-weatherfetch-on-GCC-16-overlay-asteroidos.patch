From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:23:25 +1100
Subject: [PATCH] fix weatherfetch on GCC 16 (overlay/asteroidos)

Apply the small compatibility patch that lets bberoset/asteroid-weatherfetch
compile with modern GCC 16 toolchains.
---
 overlay/asteroidos/community-apps/default.nix         |  3 +++
 .../community-apps/weatherfetch-gcc16.patch           | 11 +++++++++++
 2 files changed, 14 insertions(+)
 create mode 100644 overlay/asteroidos/community-apps/weatherfetch-gcc16.patch

diff --git a/overlay/asteroidos/community-apps/default.nix b/overlay/asteroidos/community-apps/default.nix
index 9cb0865e..57ad6c31 100644
--- a/overlay/asteroidos/community-apps/default.nix
+++ b/overlay/asteroidos/community-apps/default.nix
@@ -193,6 +193,9 @@ rec {
     desc = "Direct internet weather forecast fetcher for AsteroidOS";
     rev = "70044bb4904d22f521fa7eb7448d5007bd863f97";
     sha256 = "04m1shcw9a36dpa5ibw5728c6d1vqiah9djlr79fq51c12sy7fvl";
+    patches = [
+      ./weatherfetch-gcc16.patch
+    ];
     extraBuildInputs = [
       mlite
     ];
diff --git a/overlay/asteroidos/community-apps/weatherfetch-gcc16.patch b/overlay/asteroidos/community-apps/weatherfetch-gcc16.patch
new file mode 100644
index 00000000..26bb0392
--- /dev/null
+++ b/overlay/asteroidos/community-apps/weatherfetch-gcc16.patch
@@ -0,0 +1,11 @@
+--- a/src/WeatherParser.cpp
++++ b/src/WeatherParser.cpp
+@@ -199,7 +199,7 @@ void WeatherParser::parseWeatherJson(const QString &weatherJson)
+ {
+     constexpr unsigned maxWeatherDays{5};
+     auto days{weatherJsonToVector(weatherJson)};
+-    unsigned count{std::min(maxWeatherDays, days.size())};
++    unsigned count{static_cast<unsigned>(std::min<std::size_t>(maxWeatherDays, days.size()))};
+     for (unsigned i = 0; i < count; ++i) {
+         MDConfItem(QString("/org/asteroidos/weather/day%1/id").arg(i)).set(days[i].icon);
+         MDConfItem(QString("/org/asteroidos/weather/day%1/min-temp").arg(i)).set(days[i].mintemp);
