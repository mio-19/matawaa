From 9cb20ff974d6a554cb979de0aa1a9f1a65e16245 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 10 Nov 2026 14:09:07 +1100
Subject: [PATCH] asteroid-camera: use Asteroid iconName controls

---
 .../asteroidos/apps/camera/camera-companion.patch    | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/overlay/asteroidos/apps/camera/camera-companion.patch b/overlay/asteroidos/apps/camera/camera-companion.patch
index 5c709868..d88b81a4 100644
--- a/overlay/asteroidos/apps/camera/camera-companion.patch
+++ b/overlay/asteroidos/apps/camera/camera-companion.patch
@@ -351,7 +351,7 @@ index 41a2961..573ba51 100644
 +        IconButton {
 +            width: Dims.w(0.13)
 +            height: width
-+            icon: app.isVideoMode ? "ios-videocam" : "ios-camera"
++            iconName: app.isVideoMode ? "ios-videocam" : "ios-camera"
 +            onClicked: {
 +                app.isVideoMode = !app.isVideoMode
 +                bridge.vibrate(30)
@@ -369,7 +369,7 @@ index 41a2961..573ba51 100644
 +        IconButton {
 +            width: Dims.w(0.13)
 +            height: width
-+            icon: app.countdownSeconds === 0 ? "ios-timer-outline" : "ios-timer"
++            iconName: app.countdownSeconds === 0 ? "ios-timer-outline" : "ios-timer"
 +            onClicked: {
 +                if (app.countdownSeconds === 0) app.countdownSeconds = 3
 +                else if (app.countdownSeconds === 3) app.countdownSeconds = 5
@@ -384,7 +384,7 @@ index 41a2961..573ba51 100644
 +        IconButton {
 +            width: Dims.w(0.13)
 +            height: width
-+            icon: "ios-flash"
++            iconName: "ios-flash"
 +            onClicked: {
 +                bridge.sendCommand("torch")
 +                bridge.vibrate(25)
@@ -407,7 +407,7 @@ index 41a2961..573ba51 100644
 +        IconButton {
 +            width: Dims.w(0.13)
 +            height: width
-+            icon: "ios-reverse-camera"
++            iconName: "ios-reverse-camera"
 +            onClicked: {
 +                bridge.sendCommand("flip")
 +                bridge.vibrate(35)
@@ -419,7 +419,7 @@ index 41a2961..573ba51 100644
 +        IconButton {
 +            width: Dims.w(0.13)
 +            height: width
-+            icon: "ios-add"
++            iconName: "ios-add"
 +            onClicked: {
 +                bridge.sendCommand("zoom_in")
 +                bridge.vibrate(20)
@@ -431,7 +431,7 @@ index 41a2961..573ba51 100644
 +        IconButton {
 +            width: Dims.w(0.13)
 +            height: width
-+            icon: "ios-remove"
++            iconName: "ios-remove"
 +            onClicked: {
 +                bridge.sendCommand("zoom_out")
 +                bridge.vibrate(20)
-- 
2.56.0

