From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 2 Nov 2026 12:21:18 +1100
Subject: [PATCH] examples/asteroid, devices/families: link mce against
 config.systemd.package and export battery udev attributes

---
 devices/families/asteroidos.nix        |  23 ++-
 examples/asteroid/asteroid-desktop.nix | 218 ++++++++++++++-----------
 2 files changed, 142 insertions(+), 99 deletions(-)

diff --git a/devices/families/asteroidos.nix b/devices/families/asteroidos.nix
index 72acc76f..f1e3d863 100644
--- a/devices/families/asteroidos.nix
+++ b/devices/families/asteroidos.nix
@@ -17,9 +17,20 @@ let
   debugNetwork = cfg.enable || stage2SshCfg.enable;
 in
 {
-  systemd.package = lib.mkForce (
-    if config.mobile.hardware.watch.kernel == "legacy" then pkgs.systemd257 else pkgs.systemd
-  );
+  # Legacy smartwatch kernels (Linux 4.x) lack STATX_MNT_ID, close_range, and modern
+  # cgroup/pidfd APIs required by systemd >= 261. Override systemd and udev system-wide
+  # to systemd 257 for all consumers on legacy watch targets (without polluting buildPackages).
+  nixpkgs.overlays = lib.mkIf (config.mobile.hardware.watch.kernel == "legacy") (lib.mkAfter [
+    (final: super: super.lib.optionalAttrs (super.stdenv.hostPlatform.isAarch32) {
+      systemd = final.systemd257;
+      udev = final.systemd257;
+      lvm2 = super.lvm2.overrideAttrs (old: {
+        outputChecks = builtins.mapAttrs (_: v: (v // { disallowedRequisites = [ ]; })) (
+          old.outputChecks or { }
+        );
+      });
+    })
+  ]);
 
   assertions = [
     {
@@ -171,6 +182,12 @@ in
     ACTION=="add", KERNEL=="MTK_SMI", MODE="0664", GROUP="video"
     ACTION=="add", KERNEL=="mali", MODE="0664", GROUP="video"
     ACTION=="add", KERNEL=="vboxguest", MODE="0664", GROUP="video"
+
+    # Export power_supply capacity and status to udev database for MCE battery-udev plugin
+    SUBSYSTEM=="power_supply", ATTR{type}=="Battery", ATTR{capacity}=="?*", ENV{POWER_SUPPLY_CAPACITY}="$attr{capacity}"
+    SUBSYSTEM=="power_supply", ATTR{type}=="Battery", ATTR{status}=="?*", ENV{POWER_SUPPLY_STATUS}="$attr{status}"
+    SUBSYSTEM=="power_supply", KERNEL=="battery", ATTR{capacity}=="?*", ENV{POWER_SUPPLY_CAPACITY}="$attr{capacity}"
+    SUBSYSTEM=="power_supply", KERNEL=="battery", ATTR{status}=="?*", ENV{POWER_SUPPLY_STATUS}="$attr{status}"
   '';
 
   # Default to ext4 root filesystem for compatibility across vendor kernels
diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index cc0a48d6..8b6b586d 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -16,40 +16,19 @@ let
     || config.mobile.hardware.watch.stage2-save-logs.enable
     || config.mobile.hardware.watch.stage2-ssh.enable;
 
-  # Pinned AsteroidOS meta-asteroid revision, used to fetch upstream units and
-  # policies at build time instead of vendoring copies in this repository.
-  # https://github.com/AsteroidOS/meta-asteroid
-  asteroidOSRev = "5021f282a286a4825b6314264f0a7ff62cbe72d1";
+  isLegacy = config.mobile.hardware.watch.kernel == "legacy";
 
   # Upstream asteroid-launcher_git.bb installs a seeded notification database
   # into the ceres user's privileged data directory.
   # https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-asteroid/asteroid-launcher/asteroid-launcher/Notifications
-  launcherNotifications = pkgs.fetchurl {
-    name = "notifications.db";
-    url = "https://raw.githubusercontent.com/AsteroidOS/meta-asteroid/${asteroidOSRev}/recipes-asteroid/asteroid-launcher/asteroid-launcher/Notifications/notifications.db";
-    hash = "sha256-QK2tngW8h/K/IcYaTXs61RdfKb8NshS4n7AtK41K6aM=";
-  };
-  launcherNotificationsWal = pkgs.fetchurl {
-    name = "notifications.db-wal";
-    url = "https://raw.githubusercontent.com/AsteroidOS/meta-asteroid/${asteroidOSRev}/recipes-asteroid/asteroid-launcher/asteroid-launcher/Notifications/notifications.db-wal";
-    hash = "sha256-gRtpUBYYtNI3tKDw3/2If5nFyiTLfKPLNUC1gF83qm4=";
-  };
-  launcherNotificationsShm = pkgs.fetchurl {
-    name = "notifications.db-shm";
-    url = "https://raw.githubusercontent.com/AsteroidOS/meta-asteroid/${asteroidOSRev}/recipes-asteroid/asteroid-launcher/asteroid-launcher/Notifications/notifications.db-shm";
-    hash = "sha256-lZXfg4awjBp0HSRIpdqyyFrtRXWv5HUst9u5tha/ZVo=";
-  };
+  launcherNotifications = "${pkgs.asteroid.meta-asteroid-src}/recipes-asteroid/asteroid-launcher/asteroid-launcher/Notifications/notifications.db";
+  launcherNotificationsWal = "${pkgs.asteroid.meta-asteroid-src}/recipes-asteroid/asteroid-launcher/asteroid-launcher/Notifications/notifications.db-wal";
+  launcherNotificationsShm = "${pkgs.asteroid.meta-asteroid-src}/recipes-asteroid/asteroid-launcher/asteroid-launcher/Notifications/notifications.db-shm";
 
   # Upstream connman_%.bbappend replaces connman's D-Bus policy with one that
   # also admits the ceres user; expose it through services.dbus.packages.
   connmanDbusPolicy = pkgs.runCommand "asteroid-connman-dbus-policy" { } ''
-    install -Dm644 ${
-      pkgs.fetchurl {
-        name = "connman-dbus.conf";
-        url = "https://raw.githubusercontent.com/AsteroidOS/meta-asteroid/${asteroidOSRev}/recipes-connectivity/connman/connman/connman-dbus.conf";
-        hash = "sha256-iC4/pjt6UB/fcUqukFX/nEavNuETNmAvVW0T8T0ody0=";
-      }
-    } $out/share/dbus-1/system.d/connman.conf
+    install -Dm644 ${pkgs.asteroid.meta-asteroid-src}/recipes-connectivity/connman/connman/connman-dbus.conf $out/share/dbus-1/system.d/connman.conf
   '';
 in
 {
@@ -65,7 +44,44 @@ in
