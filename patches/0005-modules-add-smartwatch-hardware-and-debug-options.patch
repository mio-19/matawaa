From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 9 Nov 2026 10:55:46 +1100
Subject: [PATCH] modules: add smartwatch hardware and debug options

---
 modules/hardware-watch.nix | 196 +++++++++++++++++++++++++++++++++++++
 modules/module-list.nix    |   1 +
 2 files changed, 197 insertions(+)
 create mode 100644 modules/hardware-watch.nix

diff --git a/modules/hardware-watch.nix b/modules/hardware-watch.nix
new file mode 100644
index 00000000..4c9a9b22
--- /dev/null
+++ b/modules/hardware-watch.nix
@@ -0,0 +1,196 @@
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+
+let
+  inherit (lib)
+    mkDefault
+    mkEnableOption
+    mkIf
+    mkMerge
+    mkOption
+    types
+    ;
+
+  screenCfg = config.mobile.hardware.screen;
+  watchCfg = config.mobile.hardware.watch;
+in
+{
+  options.mobile.hardware.screen = {
+    shape = mkOption {
+      type = types.enum [
+        "round"
+        "square"
+        "squircle"
+        "chin"
+      ];
+      default =
+        if !watchCfg.enable then
+          "square"
+        else if screenCfg.chinHeight > 0 then
+          "chin"
+        else if (screenCfg ? width && screenCfg ? height && screenCfg.width == screenCfg.height) then
+          "round"
+        else
+          "square";
+      description = ''
+        Physical shape of the smartwatch display.
+        Controls Wayland clipping boundaries, watchface layouts, and notification card shapes.
+      '';
+    };
+
+    chinHeight = mkOption {
+      type = types.int;
+      default = 0;
+      description = ''
+        Height in pixels of the non-display cutout area at the bottom of the screen
+        (e.g., the flat-tire bar on Moto 360 models).
+      '';
+    };
+
+    radius = mkOption {
+      type = types.int;
+      default =
+        if
+          watchCfg.enable && (screenCfg.shape == "round" || screenCfg.shape == "chin") && (screenCfg ? width)
+        then
+          screenCfg.width / 2
+        else
+          0;
+      description = ''
+        Corner or circular radius of the screen in pixels.
+      '';
+    };
+  };
+
+  options.mobile.hardware.watch = {
+    enable = mkOption {
+      type = types.bool;
+      default = false;
+      description = ''
+        Whether this device is a smartwatch. Enables watch-specific input,
+        display clipping, thermal limits, and power profiles.
+      '';
+    };
+
+    hasCrown = mkOption {
+      type = types.bool;
+      default = false;
+      description = ''
+        Whether the watch features a rotating crown / rotary encoder.
+      '';
+    };
+
+    hasHaptics = mkOption {
+      type = types.bool;
+      default = true;
+      description = ''
+        Whether the device has a vibration / haptic feedback motor.
+      '';
+    };
+
+    hasSpeaker = mkOption {
+      type = types.bool;
+      default = false;
+      description = ''
+        Whether the device has a loudspeaker. Mirrors upstream
+        MACHINE_HAS_SPEAKER and is exposed to the UI through
+        /etc/asteroid/machine.conf.
+      '';
+    };
+
+    borderGestureWidth = mkOption {
+      type = types.nullOr (types.either types.str types.float);
+      default = null;
+      description = ''
+        Fraction of display width/height dedicated to border gestures (0.0 - 1.0).
+        Mirrors upstream MACHINE_DISPLAY_BORDER_GESTURE_WIDTH in /etc/asteroid/machine.conf.
+        When null, qml-asteroid defaults to 0.1 (10% of screen edge).
+      '';
+    };
+
+    aodSupport = mkOption {
+      type = types.bool;
+      default = true;
+      description = ''
+        Enable Always-On Display (AOD) ambient low-power refresh mode.
+      '';
+    };
+
+    burnInProtection = mkOption {
+      type = types.bool;
+      default = true;
+      description = ''
+        Enable OLED pixel shift protection during ambient / AOD mode.
+      '';
+    };
+
+    thermalLimitWrist = mkOption {
+      type = types.int;
+      default = 43;
+      description = ''
+        Maximum acceptable surface temperature in degrees Celsius
+        for safe prolonged skin contact on the wrist.
+      '';
+    };
+
+    kernel = mkOption {
+      type = types.enum [
+        "legacy"
+        "modern"
+      ];
+      default = "legacy";
+      description = ''
+        Watch kernel generation. "legacy" uses the vendor 4.14 kernel and the
+        old systemd 257 package; "modern" uses the mainline kernel and the
+        current systemd package.
+      '';
+    };
+
+    stage1-pause-debug.enable = mkOption {
+      type = types.bool;
+      default = false;
+      description = "Enable development-only stage-1 console, SSH/telnet, and switch-root pause; enable explicitly in the debug device/example configuration.";
+    };
+
+    stage2-save-logs.enable = mkOption {
+      type = types.bool;
+      default = false;
+      description = "Persist the stage-2 systemd journal to /var/log/journal and coredumps to /var/lib/systemd/coredump for debugging; disabled for production watches.";
+    };
+
+    stage2-ssh.enable = mkOption {
+      type = types.bool;
+      default = false;
+      description = "Enable the stage-2 SSH server and USB networking without the stage-1 pause/console.";
+    };
+  };
+
+  config = mkIf (config.mobile.enable && watchCfg.enable) {
+    # Environment variables for AsteroidOS / Wayland compositors to configure geometry
+    environment.variables = {
+      ASTEROID_SCREEN_SHAPE = screenCfg.shape;
+      ASTEROID_SCREEN_WIDTH = toString screenCfg.width;
+      ASTEROID_SCREEN_HEIGHT = toString screenCfg.height;
+      ASTEROID_SCREEN_CHIN = toString screenCfg.chinHeight;
+      ASTEROID_SCREEN_RADIUS = toString screenCfg.radius;
+      ASTEROID_HAS_CROWN = if watchCfg.hasCrown then "1" else "0";
+    };
+
+    # Udev rules for watch hardware:
+    # 1. Haptics: grant user access to timed_output or vibrator leds
+    # 2. Rotary encoder crown: tag as pointer / scroll wheel
+    services.udev.extraRules = ''
+      # Smartwatch haptics / vibration motor access
+      SUBSYSTEM=="timed_output", KERNEL=="vibrator", MODE="0666"
+      SUBSYSTEM=="leds", KERNEL=="*vibrat*", MODE="0666"
+
+      # Smartwatch rotary crown mapping
+      ACTION=="add", SUBSYSTEM=="input", ATTR{name}=="*rotary*", ENV{ID_INPUT_KEY}="1", ENV{ID_INPUT_WHEEL}="1"
+      ACTION=="add", SUBSYSTEM=="input", ATTR{name}=="*crown*", ENV{ID_INPUT_KEY}="1", ENV{ID_INPUT_WHEEL}="1"
+    '';
+  };
+}
diff --git a/modules/module-list.nix b/modules/module-list.nix
index 039be083..e9d9a143 100644
--- a/modules/module-list.nix
+++ b/modules/module-list.nix
@@ -23,6 +23,7 @@
   ./hardware-rockchip.nix
   ./hardware-screen.nix
   ./hardware-soc.nix
+  ./hardware-watch.nix
   ./hardware.nix
   ./initrd-base.nix
   ./initrd-boot-gui.nix
