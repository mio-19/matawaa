From c910b5eed759eaac1d1bb4cd36e08b79025dd99e Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:26:38 +1100
Subject: [PATCH] extend recovery key detection for smartwatch buttons
 (boot/stage-1)

Recognize smartwatch stem and side buttons as recovery keys, including
KEY_POWER, KEY_HOMEPAGE, KEY_SEARCH, KEY_MENU, KEY_BACK, BTN_9,
BTN_SIDE, BTN_0, BTN_1, and BTN_TRIGGER_HAPPY.

On round-display devices, poll briefly so a short stem press is not
missed. Existing volume and keyboard recovery keys are unchanged.
---
 boot/lib/hal/recovery.rb | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/boot/lib/hal/recovery.rb b/boot/lib/hal/recovery.rb
index 6eaaf611..0fda186a 100644
--- a/boot/lib/hal/recovery.rb
+++ b/boot/lib/hal/recovery.rb
@@ -14,6 +14,17 @@ module Hal
       :KEY_LEFTSHIFT,
       :KEY_RIGHTSHIFT,
       :KEY_ESC,
+      # Smartwatch hardware buttons
+      :KEY_POWER,
+      :KEY_HOMEPAGE,
+      :KEY_SEARCH,
+      :KEY_MENU,
+      :KEY_BACK,
+      :BTN_9, # Stem button on Fossil Gen 6 (code 0x109)
+      :BTN_SIDE, # Side stem button (code 0x113)
+      :BTN_0, # Generic hardware button 0 (code 0x100)
+      :BTN_1, # Generic hardware button 1 (code 0x101)
+      :BTN_TRIGGER_HAPPY, # Trigger happy / stem button on Qualcomm platforms
     ]
 
     def firmware_wants_recovery?()
@@ -38,7 +49,17 @@ module Hal
 
     # Is the normal boot flow interrupted by a key input?
     def boot_interrupted?()
-      Evdev.keys_held(KEYS)
+      return true if Evdev.keys_held(KEYS)
+
+      # On smartwatches, check over a 1-second window to detect a middle button press
+      if Configuration["watch"] || (Configuration["screen"] && Configuration["screen"]["shape"] == "round")
+        10.times do
+          sleep(0.1)
+          return true if Evdev.keys_held(KEYS)
+        end
+      end
+
+      false
     end
 
     def wants_recovery?
