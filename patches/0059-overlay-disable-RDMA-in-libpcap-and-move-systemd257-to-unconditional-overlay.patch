From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 2 Nov 2026 17:51:01 +1100
Subject: [PATCH] overlay: disable RDMA in libpcap and move systemd257 to
 unconditional overlay

---
 overlay/cross-compile.nix | 74 ---------------------------------------
 overlay/overlay.nix       | 14 ++++++--
 overlay/systemd.nix       | 60 +++++++++++++++++++++++++++++++
 3 files changed, 72 insertions(+), 76 deletions(-)
 create mode 100644 overlay/systemd.nix

diff --git a/overlay/cross-compile.nix b/overlay/cross-compile.nix
index 0885724d..de136c27 100644
--- a/overlay/cross-compile.nix
+++ b/overlay/cross-compile.nix
@@ -34,82 +34,8 @@ else
         ];
       });
 
-    # Prefer OpenEmbedded's fdinfo-based STATX_MNT_ID fallback over our
-    # st_dev approximation. OE marks it native-tools-only, but /proc/self/fdinfo
-    # is available in stage-2, so apply it to the target as well.
-    # Reference: https://github.com/openembedded/openembedded-core/blob/master/meta/recipes-core/systemd/systemd/Handle-missing-STATX_MNT_ID-on-older-kernels.patch
-    systemdStatxPatch = final.fetchurl {
-      url = "https://raw.githubusercontent.com/openembedded/openembedded-core/99c96202a2c9aea84f5ceb267a8c63c0cff58b1e/meta/recipes-core/systemd/systemd/Handle-missing-STATX_MNT_ID-on-older-kernels.patch";
-      hash = "sha256-griFG/VhaG1Y5CJeWPuwIo2tCFF5EN9R1YE6T7b80gQ=";
-    };
-
-    # systemd 261/262 require newer kernel primitives. Keep the current
-    # old-kernel-patched package under the explicit fallback name, but use
-    # systemd 257 from the NixOS 25.05 nixpkgs for the 4.14 target. 25.05 was
-    # the last nixpkgs release building systemd 257 (257.10).
-    #
-    # Reference: https://github.com/systemd/systemd/blob/v257/NEWS
-    systemd262OldKernel =
-      (super.systemd.override (
-        super.lib.optionalAttrs (superStdenv.hostPlatform.isAarch32) {
-          # systemd BPF framework fails when cross-compiling on 32-bit ARM
-          # due to missing linux/types.h in clang target bpf.
-          withLibBPF = false;
-        }
-      )).overrideAttrs
-        (old: {
-          patches = (old.patches or [ ]) ++ [
-            ./patches/systemd-261-mountpoint-old-kernel.patch
-            ./patches/systemd-261-faccessat-old-kernel.patch
-            ./patches/systemd-262-pidfd-old-kernel.patch
-            systemdStatxPatch
-            ./patches/systemd-262-close-range-old-kernel.patch
-            ./patches/systemd-262-epoll-pwait2-old-kernel.patch
-            ./patches/systemd-262-proc-credentials-old-kernel.patch
-          ];
-        });
-
-    # The systemd 257 definition comes from Nixpkgs 25.05, but GCC 16.2.0's
-    # libgomp sizes the omp_get_uid_from_device buffer for 10 digits and
-    # misses the sign, so the target build fails under -Werror=format-truncation.
-    systemdStdenv = super.stdenv.override {
-      cc = super.stdenv.cc.override {
-        cc = super.stdenv.cc.cc.overrideAttrs (old: {
-          patches = (old.patches or [ ]) ++ [ ./patches/gcc-16.2.0-libgomp-uid-buffer.patch ];
-        });
-      };
-    };
-
-    systemd257 =
-      (super.lib.callPackageWith
-        (builtins.intersectAttrs (super.lib.functionArgs (import ./systemd-257)) final)
-        ./systemd-257
-        { stdenv = systemdStdenv; }
-      ).override
-        (
-          {
-            # hoki has no encrypted root or EFI UKI; dropping these removes the
-            # only postFixup users of makeBinaryWrapper, whose helper hook pulls
-            # in the GCC build that currently fails on armv7.
-            withCryptsetup = false;
-            withUkify = false;
-            withHomed = false;
-            withRepart = false;
-            withFido2 = false;
-          }
-          // super.lib.optionalAttrs (superStdenv.hostPlatform.isAarch32) {
-            withLibBPF = false;
-          }
-        );
-
   in
   {
-    inherit systemd257;
-    # Keep the patched systemd 262 for old kernels available for debugging
-    # or fallback even when the legacy profile selects systemd 257.
-    systemd262oldkernel = systemd262OldKernel;
-    systemd_latest-oldkernel = systemd262OldKernel;
-
     # ModemManager's generated GDBus sources race with the static archive link
     # when building in parallel; serialize its build.
     modemmanager = super.modemmanager.overrideAttrs (old: {
diff --git a/overlay/overlay.nix b/overlay/overlay.nix
index 78fdbdd7..bb5de193 100644
--- a/overlay/overlay.nix
+++ b/overlay/overlay.nix
@@ -2,8 +2,10 @@ final: super:
 
 let
   callPackage = final.callPackage;
+  systemdOverlay = import ./systemd.nix final super;
 in
-  {
+  systemdOverlay
+  // {
     # Misc. tools.
     # Keep sorted.
     adbd = callPackage ./adbd { };
@@ -78,7 +80,15 @@ in
     # All that follows will have to be cleaned and then upstreamed.
     #
 
-    # No such fixes as of now, this comment is merely a placeholder to keep the general structure.
+    # Upstream libpcap defaults to withRdma = true on Linux, pulling rdma-core.
+    # rdma-core builds man pages using pandoc by default, which pulls in GHC.
+    # On 32-bit ARM (armv7l-linux), GHC cannot bootstrap (cannot bootstrap GHC on
+    # this platform ('armv7l-linux' with libc 'defaultLibc')), breaking native ARM CI.
+    # Neither mobile devices nor smartwatches have RDMA hardware (InfiniBand/RoCE),
+    # so disable RDMA in libpcap and disable man pages in rdma-core to prevent pulling
+    # the entire Pandoc and GHC toolchain.
+    libpcap = super.libpcap.override { withRdma = false; };
+    rdma-core = super.rdma-core.override { withManPages = false; };
 
     # Things specific to mobile-nixos.
     # Not necessarily internals, but they probably won't go into <nixpkgs>.
diff --git a/overlay/systemd.nix b/overlay/systemd.nix
new file mode 100644
index 00000000..324ad95f
--- /dev/null
+++ b/overlay/systemd.nix
@@ -0,0 +1,60 @@
+final: super:
+
+let
+  superStdenv = super.stdenv;
+
+  systemdStatxPatch = final.fetchurl {
+    url = "https://raw.githubusercontent.com/openembedded/openembedded-core/99c96202a2c9aea84f5ceb267a8c63c0cff58b1e/meta/recipes-core/systemd/systemd/Handle-missing-STATX_MNT_ID-on-older-kernels.patch";
+    hash = "sha256-griFG/VhaG1Y5CJeWPuwIo2tCFF5EN9R1YE6T7b80gQ=";
+  };
+
+  systemd262OldKernel =
+    (super.systemd.override (
+      super.lib.optionalAttrs (superStdenv.hostPlatform.isAarch32) {
+        withLibBPF = false;
+      }
+    )).overrideAttrs
+      (old: {
+        patches = (old.patches or [ ]) ++ [
+          ./patches/systemd-261-mountpoint-old-kernel.patch
+          ./patches/systemd-261-faccessat-old-kernel.patch
+          ./patches/systemd-262-pidfd-old-kernel.patch
+          systemdStatxPatch
+          ./patches/systemd-262-close-range-old-kernel.patch
+          ./patches/systemd-262-epoll-pwait2-old-kernel.patch
+          ./patches/systemd-262-proc-credentials-old-kernel.patch
+        ];
+      });
+
+  systemdStdenv = super.stdenv.override {
+    cc = super.stdenv.cc.override {
+      cc = super.stdenv.cc.cc.overrideAttrs (old: {
+        patches = (old.patches or [ ]) ++ [ ./patches/gcc-16.2.0-libgomp-uid-buffer.patch ];
+      });
+    };
+  };
+
+  systemd257 =
+    (super.lib.callPackageWith
+      (builtins.intersectAttrs (super.lib.functionArgs (import ./systemd-257)) final)
+      ./systemd-257
+      { stdenv = systemdStdenv; }
+    ).override
+      (
+        {
+          withCryptsetup = false;
+          withUkify = false;
+          withHomed = false;
+          withRepart = false;
+          withFido2 = false;
+        }
+        // super.lib.optionalAttrs (superStdenv.hostPlatform.isAarch32) {
+          withLibBPF = false;
+        }
+      );
+in
+{
+  inherit systemd257;
+  systemd262oldkernel = systemd262OldKernel;
+  systemd_latest-oldkernel = systemd262OldKernel;
+}
