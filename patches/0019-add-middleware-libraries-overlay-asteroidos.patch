diff --git a/overlay/asteroidos/keepalive/default.nix b/overlay/asteroidos/keepalive/default.nix
new file mode 100644
index 00000000..d98c0386
--- /dev/null
+++ b/overlay/asteroidos/keepalive/default.nix
@@ -0,0 +1,131 @@
+# Nemo keepalive background activity scheduling library and QML plugin
+# Upstream repository: https://github.com/sailfishos/nemo-keepalive
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/blob/master/recipes-nemomobile/nemo-keepalive/nemo-keepalive_git.bb
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  mce-dev,
+  libiphb,
+  buildPackages,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "keepalive";
+  version = "1.2.6";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "nemo-keepalive";
+    rev = "c38d05b5ebc871dc36561abaf9bbf1dfb8438e83";
+    sha256 = "02dw2z212cjajk98dk2xc6nf3f9j2pz5qnpgmrcmkfddm9kcnf70";
+  };
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    mce-dev
+    libiphb
+  ];
+
+  cmakeFlags = [
+    "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+  ];
+
+  preConfigure = ''
+    cd lib
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -p mceiface.h:mceiface.cpp mceiface.xml
+    cd ..
+  '';
+
+  postPatch = ''
+    cat << "EOF" > CMakeLists.txt
+cmake_minimum_required(VERSION 3.16)
+project(keepalive LANGUAGES CXX)
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_AUTOMOC ON)
+
+find_package(Qt6 REQUIRED COMPONENTS Core DBus Qml)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(IPHB REQUIRED IMPORTED_TARGET libiphb)
+pkg_check_modules(MCE REQUIRED IMPORTED_TARGET mce)
+
+set(LIB_SRC
+  lib/displayblanking.cpp
+  lib/displayblanking_p.cpp
+  lib/backgroundactivity.cpp
+  lib/backgroundactivity_p.cpp
+  lib/mceiface.cpp
+  lib/heartbeat.cpp
+)
+
+set(PUBLIC_HEADERS
+  lib/displayblanking.h
+  lib/backgroundactivity.h
+)
+
+add_library(keepalive SHARED ''${LIB_SRC} ''${PUBLIC_HEADERS})
+target_include_directories(keepalive PUBLIC
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/lib>
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_BINARY_DIR}>
+  $<INSTALL_INTERFACE:include/keepalive>
+)
+target_link_libraries(keepalive PUBLIC Qt6::Core Qt6::DBus PkgConfig::IPHB PkgConfig::MCE)
+set_target_properties(keepalive PROPERTIES VERSION 1.2.6 SOVERSION 1)
+
+install(TARGETS keepalive DESTINATION lib)
+install(FILES ''${PUBLIC_HEADERS} DESTINATION include/keepalive)
+
+configure_file(keepalive.pc.in keepalive.pc @ONLY)
+install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/keepalive.pc DESTINATION lib/pkgconfig)
+
+add_library(keepaliveplugin MODULE
+  plugin/plugin.cpp
+  plugin/declarativebackgroundactivity.cpp
+)
+target_include_directories(keepaliveplugin PRIVATE lib plugin)
+target_link_libraries(keepaliveplugin PRIVATE Qt6::Core Qt6::Qml keepalive)
+
+install(TARGETS keepaliveplugin LIBRARY DESTINATION lib/qt-6/qml/Nemo/KeepAlive)
+install(FILES plugin/qmldir plugin/plugins.qmltypes DESTINATION lib/qt-6/qml/Nemo/KeepAlive)
+EOF
+
+    cat << "EOF" > keepalive.pc.in
+prefix=@CMAKE_INSTALL_PREFIX@
+exec_prefix=''${prefix}
+libdir=''${prefix}/lib
+includedir=''${prefix}/include/keepalive
+
+Name: libkeepalive
+Description: Nemomobile CPU/display keepalive development files
+Version: 1.2.6
+Requires: Qt6Core Qt6DBus
+Libs: -L''${libdir} -lkeepalive
+Cflags: -I''${includedir}
+EOF
+  '';
+
+  postInstall = ''
+    mkdir -p $out/lib/qt-6/qml/org/nemomobile
+    ln -s ../../Nemo/KeepAlive $out/lib/qt-6/qml/org/nemomobile/keepalive
+  '';
+
+  meta = with lib; {
+    description = "Nemomobile CPU and display keepalive library and QML plugin";
+    homepage = "https://github.com/sailfishos/nemo-keepalive";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+})
