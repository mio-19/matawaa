diff --git a/overlay/asteroidos/keepalive/default.nix b/overlay/asteroidos/keepalive/default.nix
new file mode 100644
index 00000000..f9a34dfb
--- /dev/null
+++ b/overlay/asteroidos/keepalive/default.nix
@@ -0,0 +1,167 @@
+# Nemo keepalive background activity scheduling library
+# Upstream repository: https://github.com/sailfishos/nemo-keepalive
+{
+  lib,
+  stdenv,
+  cmake,
+  pkg-config,
+  qt6,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "keepalive";
+  version = "1.0.0";
+  dontUnpack = true;
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+  ];
+
+  postPatch = ''
+        mkdir -p src include/keepalive
+        cat << "EOF" > CMakeLists.txt
+    cmake_minimum_required(VERSION 3.16)
+    project(keepalive LANGUAGES CXX)
+    find_package(Qt6 REQUIRED COMPONENTS Core)
+    set(CMAKE_AUTOMOC ON)
+    add_library(keepalive SHARED src/backgroundactivity.cpp src/backgroundactivity.h)
+    target_include_directories(keepalive PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/include>
+      $<INSTALL_INTERFACE:include>
+    )
+    target_link_libraries(keepalive PUBLIC Qt6::Core)
+    set_target_properties(keepalive PROPERTIES VERSION 1.0.0 SOVERSION 1)
+    install(TARGETS keepalive DESTINATION lib)
+    install(DIRECTORY include/keepalive DESTINATION include)
+    configure_file(keepalive.pc.in keepalive.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/keepalive.pc DESTINATION lib/pkgconfig)
+    EOF
+        cat << "EOF" > include/keepalive/backgroundactivity.h
+    #ifndef BACKGROUNDACTIVITY_H_
+    #define BACKGROUNDACTIVITY_H_
+    #include <QObject>
+    #include <QTimer>
+    class BackgroundActivity : public QObject {
+        Q_OBJECT
+        Q_ENUMS(State Frequency)
+    public:
+        enum State { Stopped, Waiting, Running };
+        enum Frequency {
+            Range = 0,
+            ThirtySeconds = 30,
+            TwoAndHalfMinutes = 150,
+            FiveMinutes = 300,
+            TenMinutes = 600,
+            FifteenMinutes = 900,
+            ThirtyMinutes = 1800,
+            OneHour = 3600,
+            TwoHours = 7200,
+            FourHours = 14400,
+            EightHours = 28800,
+            TenHours = 36000,
+            TwelveHours = 43200,
+            TwentyFourHours = 86400,
+            MaximumFrequency = 0x7fffffff
+        };
+        explicit BackgroundActivity(QObject *parent = nullptr);
+        virtual ~BackgroundActivity();
+        Frequency wakeupFrequency() const;
+        void wakeupRange(int &min_delay, int &max_delay) const;
+        bool isWaiting() const;
+        bool isRunning() const;
+        bool isStopped() const;
+        BackgroundActivity::State state() const;
+        void setWakeupFrequency(Frequency slot);
+        void setWakeupRange(int min_delay, int max_delay);
+        void setState(BackgroundActivity::State new_state);
+        void wait(Frequency slot);
+        void wait(int min_delay, int max_delay = -1);
+        QString id() const;
+    public Q_SLOTS:
+        void wait();
+        void run();
+        void stop();
+    Q_SIGNALS:
+        void waiting();
+        void running();
+        void stopped();
+        void stateChanged();
+    private Q_SLOTS:
+        void onTimeout();
+    private:
+        State m_state = Stopped;
+        Frequency m_frequency = Range;
+        int m_minDelay = 0;
+        int m_maxDelay = 0;
+        QTimer *m_timer;
+    };
+    #endif
+    EOF
+        cp include/keepalive/* src/
+        cat << "EOF" > src/backgroundactivity.cpp
+    #include <keepalive/backgroundactivity.h>
+    BackgroundActivity::BackgroundActivity(QObject *parent) : QObject(parent), m_timer(new QTimer(this)) {
+        m_timer->setSingleShot(true);
+        connect(m_timer, &QTimer::timeout, this, &BackgroundActivity::onTimeout);
+    }
+    BackgroundActivity::~BackgroundActivity() {}
+    BackgroundActivity::Frequency BackgroundActivity::wakeupFrequency() const { return m_frequency; }
+    void BackgroundActivity::wakeupRange(int &min_delay, int &max_delay) const { min_delay = m_minDelay; max_delay = m_maxDelay; }
+    bool BackgroundActivity::isWaiting() const { return m_state == Waiting; }
+    bool BackgroundActivity::isRunning() const { return m_state == Running; }
+    bool BackgroundActivity::isStopped() const { return m_state == Stopped; }
+    BackgroundActivity::State BackgroundActivity::state() const { return m_state; }
+    void BackgroundActivity::setWakeupFrequency(Frequency slot) { m_frequency = slot; }
+    void BackgroundActivity::setWakeupRange(int min_delay, int max_delay) { m_minDelay = min_delay; m_maxDelay = max_delay; }
+    void BackgroundActivity::setState(BackgroundActivity::State new_state) {
+        if (m_state != new_state) {
+            m_state = new_state;
+            emit stateChanged();
+            if (m_state == Waiting) emit waiting();
+            else if (m_state == Running) emit running();
+            else if (m_state == Stopped) emit stopped();
+        }
+    }
+    void BackgroundActivity::wait(Frequency slot) { setWakeupFrequency(slot); wait((int)slot, (int)slot); }
+    void BackgroundActivity::wait(int min_delay, int max_delay) { setWakeupRange(min_delay, max_delay); wait(); }
+    void BackgroundActivity::wait() {
+        setState(Waiting);
+        int delay = (m_minDelay > 0) ? m_minDelay : 10;
+        m_timer->start(delay * 1000);
+    }
+    void BackgroundActivity::run() { m_timer->stop(); setState(Running); }
+    void BackgroundActivity::stop() { m_timer->stop(); setState(Stopped); }
+    void BackgroundActivity::onTimeout() { run(); }
+    QString BackgroundActivity::id() const { return QStringLiteral("activity"); }
+    #include "moc_backgroundactivity.cpp"
+    EOF
+        cat << "EOF" > keepalive.pc.in
+    prefix=@CMAKE_INSTALL_PREFIX@
+    exec_prefix=''${prefix}
+    libdir=''${prefix}/lib
+    includedir=''${prefix}/include
+
+    Name: keepalive
+    Description: CPU/display keepalive development library
+    Version: 1.0.0
+    Requires: Qt6Core
+    Libs: -L''${libdir} -lkeepalive
+    Cflags: -I''${includedir}
+    EOF
+  '';
+
+  meta = with lib; {
+    description = "Nemomobile CPU and display keepalive library";
+    homepage = "https://github.com/sailfishos/nemo-keepalive";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/libconnman-qt/default.nix b/overlay/asteroidos/libconnman-qt/default.nix
new file mode 100644
index 00000000..38928a7b
--- /dev/null
+++ b/overlay/asteroidos/libconnman-qt/default.nix
@@ -0,0 +1,139 @@
+# Qt6 library and QML plugin for ConnMan
+# Upstream repository: https://github.com/sailfishos/libconnman-qt
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-connectivity/libconnman-qt
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  buildPackages,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "libconnman-qt";
+  version = "1.3.3";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "libconnman-qt";
+    rev = "6b5ad435bbe9cb306324fc5d09a3624543e2ff63";
+    sha256 = "0dwrbiy8zi18i3y7ars54gnszvmzkyjv856505vz322faiazbdxi";
+  };
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+  ];
+
+  cmakeFlags = [
+    "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+  ];
+
+  preConfigure = ''
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -p connman_clock_interface.h:connman_clock_interface.cpp libconnman-qt/connman_clock.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -p connman_session_interface.h:connman_session_interface.cpp libconnman-qt/connman_session.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -p connman_technology_interface.h:connman_technology_interface.cpp libconnman-qt/connman_technology.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -i qdbusxml2cpp_dbus_types.h -p connman_service_interface.h:connman_service_interface.cpp libconnman-qt/connman_service.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -i qdbusxml2cpp_dbus_types.h -p connman_vpn_manager_interface.h:connman_vpn_manager_interface.cpp libconnman-qt/connman_vpn_manager.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -i qdbusxml2cpp_dbus_types.h -p connman_vpn_connection_interface.h:connman_vpn_connection_interface.cpp libconnman-qt/connman_vpn_connection.xml
+  '';
+
+  postPatch = ''
+    cat << "EOF" > CMakeLists.txt
+cmake_minimum_required(VERSION 3.16)
+project(libconnman-qt LANGUAGES CXX)
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_AUTOMOC ON)
+
+find_package(Qt6 REQUIRED COMPONENTS Core DBus Network Qml)
+
+set(LIB_SRC
+  libconnman-qt/clockmodel.cpp
+  libconnman-qt/commondbustypes.cpp
+  libconnman-qt/connmannetworkproxyfactory.cpp
+  libconnman-qt/counter.cpp
+  libconnman-qt/logging.cpp
+  libconnman-qt/marshalutils.cpp
+  libconnman-qt/networkmanager.cpp
+  libconnman-qt/networkservice.cpp
+  libconnman-qt/networksession.cpp
+  libconnman-qt/networktechnology.cpp
+  libconnman-qt/sessionagent.cpp
+  libconnman-qt/useragent.cpp
+  libconnman-qt/vpnconnection.cpp
+  libconnman-qt/vpnmanager.cpp
+  libconnman-qt/vpnmodel.cpp
+  connman_clock_interface.cpp
+  connman_session_interface.cpp
+  connman_technology_interface.cpp
+  connman_service_interface.cpp
+  connman_vpn_manager_interface.cpp
+  connman_vpn_connection_interface.cpp
+)
+
+file(GLOB PUBLIC_HEADERS "libconnman-qt/*.h")
+
+add_library(connman-qt6 SHARED ''${LIB_SRC} ''${PUBLIC_HEADERS})
+target_compile_definitions(connman-qt6 PRIVATE HAVE_LIBDBUSACCESS=0)
+target_include_directories(connman-qt6 PUBLIC
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/libconnman-qt>
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_BINARY_DIR}>
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}>
+  $<INSTALL_INTERFACE:include/connman-qt6>
+)
+target_link_libraries(connman-qt6 PUBLIC Qt6::Core Qt6::DBus Qt6::Network)
+set_target_properties(connman-qt6 PROPERTIES VERSION 1.3.3 SOVERSION 1)
+
+install(TARGETS connman-qt6 DESTINATION lib)
+install(FILES ''${PUBLIC_HEADERS} DESTINATION include/connman-qt6)
+
+configure_file(connman-qt6.pc.in connman-qt6.pc @ONLY)
+install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/connman-qt6.pc DESTINATION lib/pkgconfig)
+
+add_library(ConnmanQtDeclarative MODULE
+  plugin/plugin.cpp
+  plugin/technologyservicemodel.cpp
+  plugin/savedservicemodel.cpp
+  plugin/declarativenetworkmanager.cpp
+)
+target_include_directories(ConnmanQtDeclarative PRIVATE libconnman-qt plugin ''${CMAKE_CURRENT_BINARY_DIR})
+target_link_libraries(ConnmanQtDeclarative PRIVATE Qt6::Core Qt6::DBus Qt6::Qml connman-qt6)
+target_link_options(ConnmanQtDeclarative PRIVATE -Wl,--no-undefined)
+
+install(TARGETS ConnmanQtDeclarative LIBRARY DESTINATION lib/qt-6/qml/Connman)
+install(FILES plugin/qmldir plugin/plugins.qmltypes DESTINATION lib/qt-6/qml/Connman)
+EOF
+
+    cat << "EOF" > connman-qt6.pc.in
+prefix=@CMAKE_INSTALL_PREFIX@
+exec_prefix=''${prefix}
+libdir=''${prefix}/lib
+includedir=''${prefix}/include/connman-qt6
+
+Name: connman-qt6
+Description: Qt Connman Library
+Version: 1.3.3
+Requires: Qt6Core Qt6DBus Qt6Network
+Libs: -L''${libdir} -lconnman-qt6
+Cflags: -I''${includedir}
+EOF
