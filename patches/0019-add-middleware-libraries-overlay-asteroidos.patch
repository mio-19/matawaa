diff --git a/overlay/asteroidos/sensorfw/CMakeLists.txt b/overlay/asteroidos/sensorfw/CMakeLists.txt
new file mode 100644
index 00000000..6ad5cc23
--- /dev/null
+++ b/overlay/asteroidos/sensorfw/CMakeLists.txt
@@ -0,0 +1,264 @@
+# CMake build for Nemomobile SensorFW.
+#
+# The upstream project ships qmake files only. nixpkgs' qmake cannot be used
+# for cross-compilation here (its installed mkspecs never load
+# mkspecs/modules/qmodule.pri, so even a trivial Qt project fails on
+# qtConfig()), so this file mirrors what the .pro files build:
+#   - libsensordatatypes-qt6, libsensorfw-qt6, libsensorclient-qt6
+#   - sensorfwd
+#   - sensor / filter / chain / adaptor plugins
+#   - the hybris adaptor library and plugins (option ENABLE_HYBRIS)
+cmake_minimum_required(VERSION 3.16)
+project(sensorfw LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+set(CMAKE_AUTOMOC ON)
+
+option(ENABLE_HYBRIS "Build the libhybris sensor adaptors" OFF)
+
+find_package(Qt6 REQUIRED COMPONENTS Core DBus Network)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(SYSTEMD REQUIRED IMPORTED_TARGET libsystemd)
+
+set(SFW_PLUGIN_DIR "${CMAKE_INSTALL_PREFIX}/lib/sensord-qt6")
+
+include_directories(
+  ${CMAKE_CURRENT_SOURCE_DIR}
+  ${CMAKE_CURRENT_SOURCE_DIR}/include
+  ${CMAKE_CURRENT_SOURCE_DIR}/core
+  ${CMAKE_CURRENT_SOURCE_DIR}/datatypes
+  ${CMAKE_CURRENT_SOURCE_DIR}/filters
+  ${CMAKE_CURRENT_SOURCE_DIR}/sensors/magnetometersensor
+  ${ANDROID_INCLUDE}
+  ${HYBRIS_LIB}/include/hybris/common
+)
+
+# --- datatypes ------------------------------------------------------------
+file(GLOB DATATYPES_SRC ${CMAKE_CURRENT_SOURCE_DIR}/datatypes/*.cpp)
+file(GLOB DATATYPES_HDR ${CMAKE_CURRENT_SOURCE_DIR}/datatypes/*.h)
+add_library(sensordatatypes-qt6 SHARED ${DATATYPES_SRC} ${DATATYPES_HDR})
+target_link_libraries(sensordatatypes-qt6 PUBLIC Qt6::Core Qt6::DBus)
+set_target_properties(sensordatatypes-qt6 PROPERTIES VERSION 0.9.0 SOVERSION 0)
+install(TARGETS sensordatatypes-qt6 LIBRARY DESTINATION lib)
+install(FILES ${DATATYPES_HDR} DESTINATION include/sensord-qt6/datatypes)
+
+file(GLOB SFW_PUBLIC_HDR ${CMAKE_CURRENT_SOURCE_DIR}/include/*.h)
+install(FILES ${SFW_PUBLIC_HDR} DESTINATION include/sensord-qt6)
+
+# --- core (libsensorfw) ---------------------------------------------------
+set(CORE_SRC
+  core/sensormanager.cpp
+  core/sensormanager_a.cpp
+  core/pusher.cpp
+  core/ringbuffer.cpp
+  core/producer.cpp
+  core/source.cpp
+  core/consumer.cpp
+  core/bin.cpp
+  core/filter.cpp
+  core/deviceadaptor.cpp
+  core/loader.cpp
+  core/plugin.cpp
+  core/abstractsensor_a.cpp
+  core/abstractsensor.cpp
+  core/logging.cpp
+  core/parameterparser.cpp
+  core/abstractchain.cpp
+  core/sysfsadaptor.cpp
+  core/sockethandler.cpp
+  core/inputdevadaptor.cpp
+  core/config.cpp
+  core/nodebase.cpp
+  # Used by config.cpp (display/PSM state changes); part of the upstream core
+  # build even though it is not listed in core.pro.
+  core/mcewatcher.cpp
+)
+file(GLOB CORE_HDR ${CMAKE_CURRENT_SOURCE_DIR}/core/*.h)
+# hybrisadaptor.h is built by the hybris library, not the core one (it needs
+# the Android HAL headers). lsclient/hybrisbindertypes belong to the Sailfish
+# and binder variants that this build does not compile.
+list(REMOVE_ITEM CORE_HDR
+  ${CMAKE_CURRENT_SOURCE_DIR}/core/hybrisadaptor.h
+  ${CMAKE_CURRENT_SOURCE_DIR}/core/lsclient.h
+  ${CMAKE_CURRENT_SOURCE_DIR}/core/hybrisbindertypes.h
+)
+add_library(sensorfw-qt6 SHARED ${CORE_SRC} ${CORE_HDR})
+target_compile_definitions(sensorfw-qt6 PRIVATE PLUGIN_DIRECTORY="${SFW_PLUGIN_DIR}")
+target_link_libraries(sensorfw-qt6 PUBLIC Qt6::Core Qt6::DBus Qt6::Network sensordatatypes-qt6)
+set_target_properties(sensorfw-qt6 PROPERTIES VERSION 0.9.0 SOVERSION 0)
+install(TARGETS sensorfw-qt6 LIBRARY DESTINATION lib)
+
+# --- D-Bus client API -----------------------------------------------------
+file(GLOB CLIENT_SRC ${CMAKE_CURRENT_SOURCE_DIR}/qt-api/*.cpp)
+file(GLOB CLIENT_HDR ${CMAKE_CURRENT_SOURCE_DIR}/qt-api/*.h)
+add_library(sensorclient-qt6 SHARED ${CLIENT_SRC} ${CLIENT_HDR})
+target_link_libraries(sensorclient-qt6 PUBLIC Qt6::Core Qt6::DBus Qt6::Network sensordatatypes-qt6)
+set_target_properties(sensorclient-qt6 PROPERTIES VERSION 0.9.0 SOVERSION 0)
+install(TARGETS sensorclient-qt6 LIBRARY DESTINATION lib)
+install(FILES ${CLIENT_HDR} DESTINATION include/sensord-qt6)
+
+# --- daemon ---------------------------------------------------------------
+add_executable(sensorfwd
+  sensord/main.cpp
+  sensord/parser.cpp
+  sensord/calibrationhandler.cpp
+)
+target_link_libraries(sensorfwd PRIVATE
+  sensorfw-qt6
+  sensordatatypes-qt6
+  Qt6::Core
+  Qt6::DBus
+  Qt6::Network
+  PkgConfig::SYSTEMD
+)
+install(TARGETS sensorfwd RUNTIME DESTINATION sbin)
+
+# --- plugins --------------------------------------------------------------
+# Each plugin directory is flat: globbing *.cpp reproduces the upstream
+# SOURCES lists (they never mix files in from other directories).
+function(sfw_plugin target dir)
+  file(GLOB srcs ${dir}/*.cpp)
+  file(GLOB hdrs ${dir}/*.h)
+  add_library(${target} MODULE ${srcs} ${hdrs})
+  target_include_directories(${target} PRIVATE ${dir})
+  target_link_libraries(${target} PRIVATE
+    sensorfw-qt6
+    sensordatatypes-qt6
+    Qt6::Core
+    Qt6::DBus
+    Qt6::Network
+  )
+  install(TARGETS ${target} LIBRARY DESTINATION lib/sensord-qt6)
+endfunction()
+
+file(GLOB SENSOR_DIRS RELATIVE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/sensors/*)
+file(GLOB FILTER_DIRS RELATIVE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/filters/*)
+file(GLOB CHAIN_DIRS RELATIVE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/chains/*)
+file(GLOB ADAPTOR_DIRS RELATIVE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/adaptors/*)
+
+# Plugins include headers from sibling plugin dirs (chains use filters/*),
+# so every plugin directory is on the include path.
+foreach(d ${SENSOR_DIRS} ${FILTER_DIRS} ${CHAIN_DIRS} ${ADAPTOR_DIRS})
+  if(IS_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/${d})
+    include_directories(${CMAKE_CURRENT_SOURCE_DIR}/${d})
+  endif()
+endforeach()
+
+foreach(d ${SENSOR_DIRS})
+  get_filename_component(name ${d} NAME)
+  if(IS_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/${d} AND NOT name STREQUAL "contextplugin")
+    sfw_plugin(${name} ${CMAKE_CURRENT_SOURCE_DIR}/${d})
+  endif()
+endforeach()
+
+foreach(d ${FILTER_DIRS})
+  get_filename_component(name ${d} NAME)
+  if(IS_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/${d})
+    sfw_plugin(${name} ${CMAKE_CURRENT_SOURCE_DIR}/${d})
+  endif()
+endforeach()
+
+foreach(d ${CHAIN_DIRS})
+  get_filename_component(name ${d} NAME)
+  if(IS_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/${d})
+    sfw_plugin(${name} ${CMAKE_CURRENT_SOURCE_DIR}/${d})
+  endif()
+endforeach()
+
+# Legacy x86/tablet adaptors that no longer compile against Qt 6/GCC 16 and
+# are not referenced by the wearable (hybris) sensor configuration.
+set(SKIP_ADAPTORS
+  magnetometeradaptor-ncdk
+  mpu6050accelerometer
+  mrstaccelerometer
+  oaktrailaccelerometer
+  oemtabletaccelerometer
+  oemtabletalsadaptor-ascii
+  oemtabletgyroscopeadaptor
+  oemtabletmagnetometeradaptor
+  pegatronaccelerometeradaptor
+  steaccelerometeradaptor
+)
+
+foreach(d ${ADAPTOR_DIRS})
+  get_filename_component(name ${d} NAME)
+  if(NOT IS_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/${d})
+    continue()
+  endif()
+  if(name MATCHES "^hybris")
+    continue()
+  endif()
+  if(name IN_LIST SKIP_ADAPTORS)
+    continue()
+  endif()
+  sfw_plugin(${name} ${CMAKE_CURRENT_SOURCE_DIR}/${d})
+  if(name STREQUAL "iioadaptor")
+    pkg_check_modules(UDEV REQUIRED IMPORTED_TARGET libudev)
+    target_link_libraries(${name} PRIVATE PkgConfig::UDEV)
+  endif()
+endforeach()
+
+# --- hybris adaptors ------------------------------------------------------
+if(ENABLE_HYBRIS)
+  if(NOT HYBRIS_LIB)
+    message(FATAL_ERROR "HYBRIS_LIB must point at the libhybris prefix")
+  endif()
+  if(NOT ANDROID_INCLUDE)
+    message(FATAL_ERROR "ANDROID_INCLUDE must point at the Android headers")
+  endif()
+  find_library(HARDWARE_LIB hardware PATHS ${HYBRIS_LIB}/lib REQUIRED)
+  find_library(HYBRIS_COMMON_LIB hybris-common PATHS ${HYBRIS_LIB}/lib REQUIRED)
+
+  include_directories(${ANDROID_INCLUDE} ${HYBRIS_LIB}/include/hybris/common)
+
+  add_library(hybrissensorfw-qt6 SHARED core/hybrisadaptor.cpp core/hybrisadaptor.h)
+  target_link_libraries(hybrissensorfw-qt6 PUBLIC
+    sensorfw-qt6
+    sensordatatypes-qt6
+    Qt6::Core
+    ${HARDWARE_LIB}
+    ${HYBRIS_COMMON_LIB}
+  )
+  set_target_properties(hybrissensorfw-qt6 PROPERTIES VERSION 0.9.0 SOVERSION 0)
+  install(TARGETS hybrissensorfw-qt6 LIBRARY DESTINATION lib)
+
+  foreach(d ${ADAPTOR_DIRS})
+    get_filename_component(name ${d} NAME)
+    if(IS_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/${d} AND name MATCHES "^hybris")
+      sfw_plugin(${name} ${CMAKE_CURRENT_SOURCE_DIR}/${d})
+      target_link_libraries(${name} PRIVATE
+        hybrissensorfw-qt6
+        ${HARDWARE_LIB}
+        ${HYBRIS_COMMON_LIB}
+      )
+    endif()
+  endforeach()
+endif()
+
+# --- configuration, unit and pkg-config ----------------------------------
+install(FILES
+  config/10-sensord-default.conf
+  config/20-sensors-default.conf
+  DESTINATION etc/sensorfw/sensord.conf.d
+)
+install(FILES sensorfw.conf DESTINATION share/dbus-1/system.d)
+install(FILES rpm/sensorfwd.service DESTINATION lib/systemd/system)
+if(ENABLE_HYBRIS)
+  install(FILES config/sensord-hybris.conf DESTINATION etc/sensorfw RENAME primaryuse.conf)
+endif()
+
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/sensord-qt6.pc
+"prefix=${CMAKE_INSTALL_PREFIX}
+includedir=\${prefix}/include/sensord-qt6
+libdir=\${prefix}/lib
+
+Name: Sensorfw-qt6
+Description: Sensord for Qt 6
+Version: 0.15.1
+Requires: Qt6Core Qt6DBus Qt6Network
+Libs: -L\${libdir} -lsensorclient-qt6 -lsensordatatypes-qt6
+Cflags: -I\${includedir} -I\${includedir}/datatypes
+")
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/sensord-qt6.pc DESTINATION lib/pkgconfig)
diff --git a/overlay/asteroidos/sensorfw/default.nix b/overlay/asteroidos/sensorfw/default.nix
new file mode 100644
index 00000000..03131382
--- /dev/null
+++ b/overlay/asteroidos/sensorfw/default.nix
@@ -0,0 +1,82 @@
+# Nemomobile SensorFW sensor daemon and Qt client API
+# Upstream repository: https://github.com/sailfishos/sensorfw
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-nemomobile/sensorfw
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  fetchpatch,
+  cmake,
+  pkg-config,
+  qt6,
+  systemd,
+  libhybris,
+  android-headers,
+  udev,
+}:
+
+let
+  metaAsteroidRev = "5af858f49f33efe6d6ef4aa027bee7eeffb27cee";
+
+  upstreamPatch =
+    name: hash:
+    fetchpatch {
+      inherit name hash;
+      url = "https://raw.githubusercontent.com/AsteroidOS/meta-asteroid/${metaAsteroidRev}/recipes-nemomobile/sensorfw/files/${name}";
+    };
+in
+stdenv.mkDerivation (finalAttrs: {
+  pname = "sensorfw";
+  version = "0.15.1";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "sensorfw";
+    rev = "b62d0e591d736c904128fcfc8476f22cfdbe53b9";
+    hash = "sha256-+rTwVJSaYAV7lCUPISxtlPZvRyIeFiAgsdOfuBat98k=";
+  };
+
+  patches = [
+    (upstreamPatch "0001-Do-not-hide-stepcounter-by-default.patch" "sha256-FNjH+q3kjQDeJP5yaAZ24z8FpU0gZ8GJAFuElzM3bsM=")
+    (upstreamPatch "0002-Add-heart-rate-monitor-sensor-with-hybris-adaptor.patch" "sha256-qRXs9vrszoG1bVnjkIVtRaXEvaLtNKs7Z1PsR759VQo=")
+    (upstreamPatch "0003-Add-Wrist-gesture-sensor-via-libhybris-adaptor.patch" "sha256-WyVwM0KEtADQhAeZTGy6we9BSyITchcClT+phNTdhuc=")
+    (upstreamPatch "0004-Fix-compilation-when-autohybris-is-used.patch" "sha256-RJ711Knze6feQOPfa/UD6r9jG870H//hOnbFPzhoS5s=")
+    (upstreamPatch "0005-Fix-compilation-when-hybris-is-used.patch" "sha256-evbbTXcBF/a6Y998373+p2vv7PnYWX71Ei9GFH+BaA8=")
+    (upstreamPatch "0006-hybrisadaptor-Queue-erroneous-events-too.patch" "sha256-k10UaeZO9dEa+VApzyr2itLv6ZEqwnMhA+RXGkiWYlk=")
+    (upstreamPatch "0007-qt-api-Fix-synchronous-D-Bus-calls-on-Qt-6.patch" "sha256-7TRSkpcprdQczLhhsL9lqjTr4oRYMt3Z6JgbDcxCMjE=")
+  ];
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    systemd
+    libhybris
+    android-headers
+    udev
+  ];
+
+  # Upstream only ships qmake project files; CMakeLists.txt mirrors them.
+  postPatch = ''
+    cp ${./CMakeLists.txt} CMakeLists.txt
+  '';
+
+  cmakeFlags = [
+    "-DENABLE_HYBRIS=ON"
+    "-DHYBRIS_LIB=${libhybris}"
+    "-DANDROID_INCLUDE=${android-headers}/include/android"
+  ];
+
+  meta = with lib; {
+    description = "Nemomobile sensor daemon and Qt sensor client API";
+    homepage = "https://github.com/sailfishos/sensorfw";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/timed-qt6/default.nix b/overlay/asteroidos/timed-qt6/default.nix
new file mode 100644
index 00000000..acffe994
--- /dev/null
+++ b/overlay/asteroidos/timed-qt6/default.nix
@@ -0,0 +1,111 @@
+# Timed Qt6 client library interface
+# Upstream repository: https://github.com/sailfishos/timed
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-nemomobile/timed
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  libiodata,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "timed-qt6";
+  version = "3.6.0";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "timed";
+    rev = "80ea5e63cf58db616789adbfeb9cf3bfd63dddaa";
+    sha256 = "1byd00z946q2bd6xi4s2vyxb380gh84d143jc8p8n26ifmvlpb79";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    libiodata
+  ];
+
+  preConfigure = ''
+    mkdir -p include/timed-qt6
+    cp src/lib/*.h include/timed-qt6/
+    cp src/lib/event src/lib/interface src/lib/wallclock src/lib/qmacro include/timed-qt6/
+    # NOTE: src/lib/hidden/exception is a qmake-only shim that makes the
+    # in-tree "#include <exception>" resolve to timed-qt6/exception.h. Do not
+    # install it: the public include dir is passed as -I to all consumers, and
+    # a file named "exception" there shadows the C++ standard <exception>
+    # header (breaking std::exception_ptr / <future> in every dependent).
+  '';
+
+  postPatch = ''
+    cat << "EOF" > CMakeLists.txt
+cmake_minimum_required(VERSION 3.16)
+project(timed-qt6 LANGUAGES CXX)
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_AUTOMOC ON)
+
+find_package(Qt6 REQUIRED COMPONENTS Core DBus)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(IODATA REQUIRED iodata-qt6)
+
+set(LIB_SRC
+  src/lib/interface.cpp
+  src/lib/event-io.cpp
+  src/lib/event-pimple.cpp
+  src/lib/exception.cpp
+  src/lib/nanotime.cpp
+  src/lib/aliases.cpp
+  src/lib/wall-settings.cpp
+  src/lib/wall-info.cpp
+  src/lib/qmacro.cpp
+)
+
+add_library(timed-qt6 SHARED ''${LIB_SRC})
+target_include_directories(timed-qt6 PUBLIC
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/include>
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/src/lib>
+  $<INSTALL_INTERFACE:include/timed-qt6>
+  ''${IODATA_INCLUDE_DIRS}
+)
+target_link_libraries(timed-qt6 PUBLIC Qt6::Core Qt6::DBus ''${IODATA_LIBRARIES} rt)
+set_target_properties(timed-qt6 PROPERTIES VERSION 3.6.0 SOVERSION 3)
+
+install(TARGETS timed-qt6 DESTINATION lib)
+file(GLOB HEADERS "include/timed-qt6/*")
+install(FILES ''${HEADERS} DESTINATION include/timed-qt6)
+
+configure_file(timed-qt6.pc.in timed-qt6.pc @ONLY)
+install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/timed-qt6.pc DESTINATION lib/pkgconfig)
+EOF
+
+    cat << "EOF" > timed-qt6.pc.in
+prefix=@CMAKE_INSTALL_PREFIX@
+exec_prefix=''${prefix}
+libdir=''${prefix}/lib
+includedir=''${prefix}/include/timed-qt6
+
+Name: timed-qt6
+Description: Timed Qt6 client library
+Version: 3.6.0
+Requires: Qt6Core Qt6DBus iodata-qt6
+Libs: -L''${libdir} -ltimed-qt6
+Cflags: -I''${includedir}
+EOF
+  '';
+
+  meta = with lib; {
+    description = "Time daemon Qt6 client library";
+    homepage = "https://github.com/sailfishos/timed";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/usb-moded-dev/default.nix b/overlay/asteroidos/usb-moded-dev/default.nix
new file mode 100644
index 00000000..e5b4858a
--- /dev/null
+++ b/overlay/asteroidos/usb-moded-dev/default.nix
@@ -0,0 +1,42 @@
+# Development headers and pkgconfig for usb_moded daemon
+# Upstream repository: https://github.com/sailfishos/usb-moded
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/blob/master/recipes-nemomobile/usb-moded/usb-moded_git.bb
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "usb-moded-dev";
+  version = "0.86.0";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "usb-moded";
+    rev = "6190edfe778df9896f1f3026a7ab087dbc02dd3f";
+    sha256 = "sha256-fv5jurY/ulGfWIc4VbTeuyVNs/QqNyxzC6Hyb6amg9c=";
+  };
+
+  strictDeps = true;
+
+  dontBuild = true;
+
+  installPhase = ''
+    runHook preInstall
+    mkdir -p $out/include/usb-moded $out/lib/pkgconfig
+    cp src/com.meego.usb_moded.xml $out/include/usb-moded/
+    cp src/usb_moded*.h $out/include/usb-moded/
+    sed -e "s|@VERSION@|${finalAttrs.version}|" \
+        -e "s|prefix=/usr|prefix=$out|" \
+        usb_moded.pc.in > $out/lib/pkgconfig/usb_moded.pc
+    runHook postInstall
+  '';
+
+  meta = with lib; {
+    description = "C headers and pkg-config for usb_moded daemon";
+    homepage = "https://github.com/sailfishos/usb-moded";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/usb-moded-qt6/default.nix b/overlay/asteroidos/usb-moded-qt6/default.nix
new file mode 100644
index 00000000..0e985634
--- /dev/null
+++ b/overlay/asteroidos/usb-moded-qt6/default.nix
@@ -0,0 +1,90 @@
+# Qt6 bindings and client library for usb-moded daemon
+# Upstream repository: https://github.com/sailfishos/libusb-moded-qt
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  dbus,
+  buildPackages,
+  usb-moded-dev,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "usb-moded-qt6";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "libusb-moded-qt";
+    rev = "10f2bcb86e9c116ae94da668d997c09c0966388c";
+    sha256 = "sha256-hCNbpJQz/0Vja7lZTk8zJvEYxt3jCDZoSv4XPTdbBZs=";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    usb-moded-dev
+    dbus
+  ];
+
+  postPatch = ''
+        cat << "EOF" > CMakeLists.txt
+    cmake_minimum_required(VERSION 3.16)
+    project(usb-moded-qt6 LANGUAGES CXX)
+    find_package(Qt6 REQUIRED COMPONENTS Core DBus)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(dbus-1 REQUIRED IMPORTED_TARGET dbus-1)
+    pkg_check_modules(usb_moded REQUIRED IMPORTED_TARGET usb_moded)
+    set(CMAKE_AUTOMOC ON)
+    file(GLOB HEADERS "src/*.h")
+    set(SOURCES src/qusbmode.cpp src/qusbmoded.cpp usb_moded_interface.cpp)
+    add_library(usb-moded-qt6 SHARED ''${SOURCES} ''${HEADERS})
+    target_compile_definitions(usb-moded-qt6 PRIVATE QUSBMODED_LIBRARY)
+    target_include_directories(usb-moded-qt6 PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/src>
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}>
+      $<INSTALL_INTERFACE:include/usb-moded-qt6>
+    )
+    target_link_libraries(usb-moded-qt6 PUBLIC Qt6::Core Qt6::DBus PkgConfig::dbus-1 PkgConfig::usb_moded)
+    set_target_properties(usb-moded-qt6 PROPERTIES VERSION 1.0.0 SOVERSION 1)
+    install(TARGETS usb-moded-qt6 DESTINATION lib)
+    install(FILES ''${HEADERS} DESTINATION include/usb-moded-qt6)
+    configure_file(usb-moded-qt6.pc.in usb-moded-qt6.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/usb-moded-qt6.pc DESTINATION lib/pkgconfig)
+    EOF
+        cat << "EOF" > usb-moded-qt6.pc.in
+    prefix=@CMAKE_INSTALL_PREFIX@
+    exec_prefix=''${prefix}
+    libdir=''${prefix}/lib
+    includedir=''${prefix}/include/usb-moded-qt6
+
+    Name: usb-moded-qt6
+    Description: Qt bindings for usb_moded
+    Version: 1.0.0
+    Requires: Qt6Core Qt6DBus
+    Libs: -L''${libdir} -lusb-moded-qt6
+    Cflags: -I''${includedir}
+    EOF
+  '';
+
+  preConfigure = ''
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -N -c QUsbModedInterface -p usb_moded_interface.h:usb_moded_interface.cpp ${usb-moded-dev}/include/usb-moded/com.meego.usb_moded.xml
+  '';
+
+  meta = with lib; {
+    description = "Qt6 client library and bindings for usb_moded daemon";
+    homepage = "https://github.com/sailfishos/libusb-moded-qt";
+    license = licenses.bsd3;
+    platforms = platforms.linux;
+  };
+})
