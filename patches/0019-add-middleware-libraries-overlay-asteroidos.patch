+    patch -p2 -i ${
+      upstreamPatch "0001-Remove-references-to-host-path-in-package-config-fil.patch"
+        "sha256-9JtlPyiqN8CrMikCBOwUDZ8+BShDCDefiiZZ5KPeVg8="
+    }
+    patch -p2 -i ${
+      upstreamPatch "0002-tests-workaround-Wimplicit-function-declaration-in-s.patch"
+        "sha256-B3ffNEfjJf8Xz7Wv+pK84Dk3jY6FvgAE3otf158+oLo="
+    }
+  '';
 
   postAutoreconf = ''
     substituteInPlace configure \
@@ -38,9 +61,8 @@ stdenv.mkDerivation {
   '';
 
   NIX_CFLAGS_COMPILE = [
-    # This libhybris is old, but even libhybris from 2024 fails to compile
-    # due to many warnings. Let's instead ignore the warnings, and instead
-    # plan to get an updated adbd that maybe does not depend on libhybris.
+    # libhybris trips -Werror=implicit-function-declaration / int-conversion /
+    # incompatible-pointer-types with modern toolchains.
     "-Wno-implicit-function-declaration"
     "-Wno-incompatible-pointer-types"
     "-Wno-int-conversion"
@@ -52,15 +74,31 @@ stdenv.mkDerivation {
 
   configureFlags = [
     "--with-android-headers=${android-headers}/include/android/"
+    # Upstream meta-asteroid libhybris_git.bbappend.
