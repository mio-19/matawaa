+    qt6.qtdeclarative
+  ];
+
+  cmakeFlags = [
+    "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+  ];
+
+  preConfigure = ''
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -p connman_clock_interface.h:connman_clock_interface.cpp libconnman-qt/connman_clock.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -p connman_session_interface.h:connman_session_interface.cpp libconnman-qt/connman_session.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -p connman_technology_interface.h:connman_technology_interface.cpp libconnman-qt/connman_technology.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -i qdbusxml2cpp_dbus_types.h -p connman_service_interface.h:connman_service_interface.cpp libconnman-qt/connman_service.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -i qdbusxml2cpp_dbus_types.h -p connman_vpn_manager_interface.h:connman_vpn_manager_interface.cpp libconnman-qt/connman_vpn_manager.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -i qdbusxml2cpp_dbus_types.h -p connman_vpn_connection_interface.h:connman_vpn_connection_interface.cpp libconnman-qt/connman_vpn_connection.xml
+  '';
+
+  postPatch = ''
+    cat << "EOF" > CMakeLists.txt
+cmake_minimum_required(VERSION 3.16)
+project(libconnman-qt LANGUAGES CXX)
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_AUTOMOC ON)
+
+find_package(Qt6 REQUIRED COMPONENTS Core DBus Network Qml)
+
+set(LIB_SRC
+  libconnman-qt/clockmodel.cpp
+  libconnman-qt/commondbustypes.cpp
+  libconnman-qt/connmannetworkproxyfactory.cpp
+  libconnman-qt/counter.cpp
+  libconnman-qt/logging.cpp
+  libconnman-qt/marshalutils.cpp
+  libconnman-qt/networkmanager.cpp
+  libconnman-qt/networkservice.cpp
+  libconnman-qt/networksession.cpp
+  libconnman-qt/networktechnology.cpp
+  libconnman-qt/sessionagent.cpp
+  libconnman-qt/useragent.cpp
+  libconnman-qt/vpnconnection.cpp
+  libconnman-qt/vpnmanager.cpp
+  libconnman-qt/vpnmodel.cpp
+  connman_clock_interface.cpp
+  connman_session_interface.cpp
+  connman_technology_interface.cpp
+  connman_service_interface.cpp
+  connman_vpn_manager_interface.cpp
+  connman_vpn_connection_interface.cpp
+)
+
+file(GLOB PUBLIC_HEADERS "libconnman-qt/*.h")
+
+add_library(connman-qt6 SHARED ''${LIB_SRC} ''${PUBLIC_HEADERS})
+target_compile_definitions(connman-qt6 PRIVATE HAVE_LIBDBUSACCESS=0)
+target_include_directories(connman-qt6 PUBLIC
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/libconnman-qt>
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_BINARY_DIR}>
+  $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}>
+  $<INSTALL_INTERFACE:include/connman-qt6>
+)
+target_link_libraries(connman-qt6 PUBLIC Qt6::Core Qt6::DBus Qt6::Network)
+set_target_properties(connman-qt6 PROPERTIES VERSION 1.3.3 SOVERSION 1)
+
+install(TARGETS connman-qt6 DESTINATION lib)
+install(FILES ''${PUBLIC_HEADERS} DESTINATION include/connman-qt6)
+
+configure_file(connman-qt6.pc.in connman-qt6.pc @ONLY)
+install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/connman-qt6.pc DESTINATION lib/pkgconfig)
+
+add_library(ConnmanQtDeclarative MODULE
+  plugin/plugin.cpp
+  plugin/technologyservicemodel.cpp
+  plugin/savedservicemodel.cpp
+  plugin/declarativenetworkmanager.cpp
+)
+target_include_directories(ConnmanQtDeclarative PRIVATE libconnman-qt plugin ''${CMAKE_CURRENT_BINARY_DIR})
+target_link_libraries(ConnmanQtDeclarative PRIVATE Qt6::Core Qt6::DBus Qt6::Qml connman-qt6)
+target_link_options(ConnmanQtDeclarative PRIVATE -Wl,--no-undefined)
+
+install(TARGETS ConnmanQtDeclarative LIBRARY DESTINATION lib/qt-6/qml/Connman)
+install(FILES plugin/qmldir plugin/plugins.qmltypes DESTINATION lib/qt-6/qml/Connman)
+EOF
+
+    cat << "EOF" > connman-qt6.pc.in
+prefix=@CMAKE_INSTALL_PREFIX@
+exec_prefix=''${prefix}
+libdir=''${prefix}/lib
+includedir=''${prefix}/include/connman-qt6
