--- a/overlay/asteroidos/default.nix
+++ b/overlay/asteroidos/default.nix
@@ -7,5 +7,70 @@ rec {
 
   qml-asteroid = callPackage ./qml-asteroid { };
 
+  amber-mpris = callPackage ./amber-mpris { };
+  mlite = callPackage ./mlite { };
+  nemo-qml-plugin-configuration = callPackage ./nemo-qml-plugin-configuration {
+    inherit mlite;
+  };
+  nemo-qml-plugin-dbus = callPackage ./nemo-qml-plugin-dbus { };
+  libconnman-qt = callPackage ./libconnman-qt { };
+  libiodata = callPackage ./libiodata { };
+  mce-dev = callPackage ./mce-dev { };
+  mce-qt6 = callPackage ./mce-qt6 {
+    inherit mce-dev;
+  };
+  ngf-qt6 = callPackage ./ngf-qt6 { };
+  usb-moded-dev = callPackage ./usb-moded-dev { };
+  usb-moded-qt6 = callPackage ./usb-moded-qt6 {
+    inherit usb-moded-dev;
+  };
+
+  # Low-level Nemomobile/SailfishOS libraries for MCE and KeepAlive
+  libdsme = callPackage ./libdsme { };
+  libiphb = callPackage ./libiphb {
+    inherit mce-dev libdsme;
+  };
+  libngf = callPackage ./libngf { };
+
+  # Mode Control Entity (MCE) daemon
+  # Upstream repository: https://github.com/sailfishos/mce
+  # AsteroidOS recipes: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-nemomobile/mce
+  mce = callPackage ./mce {
+    inherit libdsme libiphb libngf usb-moded-dev mce-dev;
+  };
+
+  # Nemomobile SensorFW daemon and client API (qtsensors sensorfw backend).
+  # Upstream: https://github.com/sailfishos/sensorfw
+  sensorfw = callPackage ./sensorfw {
+    inherit (pkgs) libhybris android-headers;
+  };
+
+  # Device state machine daemon MCE talks to.
+  # Upstream: https://github.com/sailfishos/dsme
+  dsme = callPackage ./dsme {
+    inherit libdsme libngf libiphb mce-dev;
+  };
+
+  keepalive = callPackage ./keepalive {
+    inherit mce-dev libiphb;
+  };
+  timed-qt6 = callPackage ./timed-qt6 {
+    inherit libiodata;
+  };
+
+  # Calendar subsystem: accounts-qt, kcalendarcore, mkcal, and nemo-qml-plugin-calendar
+  # Upstream repository: https://gitlab.com/accounts-sso/accounts-qt
+  # Upstream repository: https://github.com/sailfishos-mirror/kcalendarcore
+  # Upstream repository: https://github.com/sailfishos/mkcal
+  # Upstream repository: https://github.com/sailfishos/nemo-qml-plugin-calendar
+  accounts-qt = callPackage ./accounts-qt { };
+  kcalendarcore = callPackage ./kcalendarcore { };
+  mkcal = callPackage ./mkcal {
+    inherit kcalendarcore timed-qt6;
+  };
+  nemo-qml-plugin-calendar = callPackage ./nemo-qml-plugin-calendar {
+    inherit accounts-qt kcalendarcore mkcal timed-qt6 libiodata;
+  };
+
   inherit (pkgs) msm-fb-refresher;
 }
diff --git a/overlay/asteroidos/dsme/default.nix b/overlay/asteroidos/dsme/default.nix
new file mode 100644
index 00000000..285f6b58
--- /dev/null
+++ b/overlay/asteroidos/dsme/default.nix
@@ -0,0 +1,122 @@
+# Nemomobile DSME (device state machine daemon) with AsteroidOS patches
+# Upstream repository: https://github.com/sailfishos/dsme
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-nemomobile/dsme
+{
+  lib,
+  stdenv,
+  fetchgit,
+  fetchpatch,
+  fetchurl,
+  autoreconfHook,
+  pkg-config,
+  glib,
+  dbus,
+  dbus-glib,
+  cryptsetup,
+  systemd,
+  mce-dev,
+  libngf,
+  libiphb,
+  libdsme,
+}:
+
+let
+  metaAsteroidRev = "5af858f49f33efe6d6ef4aa027bee7eeffb27cee";
+
+  asteroidPatch =
+    name: hash:
+    fetchpatch {
+      inherit name hash;
+      url = "https://raw.githubusercontent.com/AsteroidOS/meta-asteroid/${metaAsteroidRev}/recipes-nemomobile/dsme/dsme/${name}";
+    };
+
+  dsmeService = fetchurl {
+    name = "dsme.service";
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-asteroid/${metaAsteroidRev}/recipes-nemomobile/dsme/dsme/dsme.service";
+    hash = "sha256-6IO1Q6tCkMRcYtlq5eU06ZlrHpRYGkKfurYMZwa4os4=";
+  };
+in
+stdenv.mkDerivation (finalAttrs: {
+  pname = "dsme";
+  version = "0.84.7";
+
+  src = fetchgit {
+    url = "https://github.com/sailfishos/dsme.git";
+    rev = "ab78f9c1945505c06beb3662878b6be9781565bd";
+    fetchSubmodules = true;
+    hash = "sha256-XJpDKqOe2X3nZTUgCudw3n0pa2m4MY6X7fJxU46Icik=";
+  };
+
+  patches = [
+    (asteroidPatch "0002-Fix-and-improve-alarm-time-serialization.patch" "sha256-GCpSPP8EtQsly7VC91s5PFJnx+uFqJHQ+GQR9yI6rqI=")
+  ];
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    autoreconfHook
+    pkg-config
+  ];
+
+  buildInputs = [
+    glib
+    dbus
+    dbus-glib
+    cryptsetup
+    systemd
+    mce-dev
+    libngf
+    libiphb
+    libdsme
+  ];
+
+  preConfigure = ''
+    # Upstream's autogen.sh; autoreconfHook covers libtoolize/aclocal/automake.
+    if [ ! -x configure ]; then
+      NOCONFIGURE=1 ./autogen.sh
+    fi
+  '';
+
+  postPatch = ''
+    # Upstream runs dsme as the desktop user on AsteroidOS.
+    substituteInPlace dsme/dsme.conf \
+      --replace-fail '<policy user="root">' '<policy user="ceres">'
+
+    # The unit tests do not build with GCC 16 (-Werror=parentheses on legacy
+    # asserts) and are not shipped by the upstream recipe's runtime package.
+    substituteInPlace Makefile.am \
+      --replace-fail 'SUBDIRS = dbus-gmain dsme modules util test tests getbootstate' \
+                     'SUBDIRS = dbus-gmain dsme modules util getbootstate'
+  '';
+
+  configureFlags = [
+    # configure bakes DSME_SBIN_PATH from $exec_prefix at configure time; without
+    # an explicit sbindir autoconf leaves it as "NONE/sbin", and the dsme
+    # watchdog then cannot exec dsme-server.
+    "--sbindir=${placeholder "out"}/sbin"
+    "--disable-poweron-timer"
+    "--disable-upstart"
+    "--enable-systemd"
+    "--enable-runlevel"
+    "--enable-pwrkeymonitor"
+    "--disable-validatorlistener"
+    "--disable-static"
+    "--enable-usewheel"
+  ];
+
+  # The tests are removed from SUBDIRS in postPatch; build and install then
+  # recurse into the daemon, modules and utilities only.
+
+  postInstall = ''
+    install -Dm644 reboot-via-dsme.sh $out/etc/profile.d/reboot-via-dsme.sh
+    install -Dm644 ${dsmeService} $out/lib/systemd/system/dsme.service
+  '';
+
+  meta = with lib; {
+    description = "Device state machine daemon for Nemomobile/AsteroidOS";
+    homepage = "https://github.com/sailfishos/dsme";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+})
