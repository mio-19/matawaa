+-        goto EXIT;
+-
+-    /* The touch duration must not be too short or too long */
+-    int64_t t = self->mtt_end_tick - self->mtt_beg_tick;
+-    if( t < MT_TOUCH_DBLTAP_DELAY_MIN || t > MT_TOUCH_DBLTAP_DELAY_MAX )
+-        goto EXIT;
+-
+-    is_single_tap = true;
+-
+-EXIT:
+-    return is_single_tap;
+-}
