   ]
   ++ lib.optional targetPlatform.isAarch64 "--enable-arch=arm64"
   ++ lib.optional targetPlatform.isAarch32 "--enable-arch=arm"
   ;
 
+  # configure.ac searches for wayland-scanner, but nixpkgs splits it into its
