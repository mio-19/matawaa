index 00000000..aefe53f7
--- /dev/null
+++ b/overlay/asteroidos/mce/patches/0006-Ambient-Mode-Exit-ambient-mode-when-touch-is-detecte.patch
@@ -0,0 +1,67 @@
+From 73ce23a858581541379275743cb528d079a1a045 Mon Sep 17 00:00:00 2001
+From: MagneFire <IDaNLContact@gmail.com>
+Date: Sun, 7 Mar 2021 23:07:09 +0100
+Subject: [PATCH] Ambient Mode: Exit ambient mode when touch is detected.
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+Upstream-Status: Inappropriate
+
+Signed-off-by: Darrel Griët <dgriet@gmail.com>
+---
+ modules/display.c | 27 +++++++++++++++++++++++++++
+ 1 file changed, 27 insertions(+)
+
+diff --git a/modules/display.c b/modules/display.c
+index 85d0df3..3c50973 100644
+--- a/modules/display.c
++++ b/modules/display.c
+@@ -413,6 +413,7 @@ static bool                mdy_shutdown_in_progress(void);
