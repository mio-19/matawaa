+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/src/include>
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/src/dbus>
+      $<INSTALL_INTERFACE:include/ngf-qt6>
+    )
+    target_link_libraries(ngf-qt6 PUBLIC Qt6::Core Qt6::DBus)
+    set_target_properties(ngf-qt6 PROPERTIES VERSION 1.0.0 SOVERSION 1)
+    install(TARGETS ngf-qt6 DESTINATION lib)
+    install(FILES ''${HEADERS} DESTINATION include/ngf-qt6)
+    configure_file(ngf-qt6.pc.in ngf-qt6.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/ngf-qt6.pc DESTINATION lib/pkgconfig)
+
+    add_library(ngf-declarative MODULE
+      declarative/src/plugin.cpp
+      declarative/src/declarativengfevent.cpp
+      declarative/src/declarativengfeventproperty.cpp
+    )
+    target_include_directories(ngf-declarative PRIVATE src/include declarative/src)
+    target_link_libraries(ngf-declarative PRIVATE Qt6::Core Qt6::Qml ngf-qt6)
+    install(TARGETS ngf-declarative LIBRARY DESTINATION lib/qt-6/qml/Nemo/Ngf)
+    install(FILES declarative/qmldir declarative/plugins.qmltypes DESTINATION lib/qt-6/qml/Nemo/Ngf)
