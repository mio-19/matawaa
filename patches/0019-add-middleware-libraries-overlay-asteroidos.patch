++    }
++}
++
+ /** Keypad slide input state; assume closed */
+ static cover_state_t keyboard_slide_input_state = COVER_CLOSED;
+ 
+@@ -2276,6 +2299,10 @@ static datapipe_handler_t mdy_datapipe_handlers[] =
