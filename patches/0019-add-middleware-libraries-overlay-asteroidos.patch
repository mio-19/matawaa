+    homepage = "https://github.com/sailfishos/libconnman-qt";
+    license = licenses.asl20;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/libdsme/default.nix b/overlay/asteroidos/libdsme/default.nix
new file mode 100644
index 00000000..2278e470
--- /dev/null
+++ b/overlay/asteroidos/libdsme/default.nix
@@ -0,0 +1,82 @@
+# Nemomobile's libdsme library
+# Upstream repository: https://github.com/sailfishos/libdsme
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/blob/master/recipes-nemomobile/dsme/libdsme_git.bb
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  pkg-config,
+  glib,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "libdsme";
+  version = "0.67.0";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "libdsme";
+    rev = "67e57c5e90e37d4a53cf3ea4dae028444c62c8e8";
+    sha256 = "0cydr03c2qyaq1z231ahqfzydaib4qgi9l78mrb60ji56gg9q95v";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    pkg-config
+  ];
+
+  buildInputs = [
+    glib
+  ];
+
+  buildPhase = ''
+    runHook preBuild
+    $CC -fPIC -c -o protocol.pic.o protocol.c -std=c99 -O2 -Wall $($PKG_CONFIG --cflags glib-2.0)
+    $CC -fPIC -c -o message.pic.o message.c -std=c99 -O2 -Wall $($PKG_CONFIG --cflags glib-2.0)
+    $CC -fPIC -c -o alarm_limit.pic.o alarm_limit.c -std=c99 -O2 -Wall $($PKG_CONFIG --cflags glib-2.0)
+    $CC -shared -Wl,-soname,libdsme.so.0 -o libdsme.so.0.3.0 protocol.pic.o message.pic.o alarm_limit.pic.o $($PKG_CONFIG --libs glib-2.0)
+
+    $CC -fPIC -c -o dsme_dbus_if.pic.o modules/dsme_dbus_if.c -std=c99 -O2 -Wall
+    $CC -shared -Wl,-soname,libdsme_dbus_if.so.0 -o libdsme_dbus_if.so.0.3.0 dsme_dbus_if.pic.o
+
+    $CC -fPIC -c -o thermalmanager_dbus_if.pic.o modules/thermalmanager_dbus_if.c -std=c99 -O2 -Wall
+    $CC -shared -Wl,-soname,libthermalmanager_dbus_if.so.0 -o libthermalmanager_dbus_if.so.0.3.0 thermalmanager_dbus_if.pic.o
+    runHook postBuild
+  '';
+
+  installPhase = ''
+    runHook preInstall
+    mkdir -p $out/lib/pkgconfig $out/include/dsme
+
+    install -m755 libdsme.so.0.3.0 $out/lib/
+    ln -s libdsme.so.0.3.0 $out/lib/libdsme.so.0
+    ln -s libdsme.so.0.3.0 $out/lib/libdsme.so
+
+    install -m755 libdsme_dbus_if.so.0.3.0 $out/lib/
+    ln -s libdsme_dbus_if.so.0.3.0 $out/lib/libdsme_dbus_if.so.0
+    ln -s libdsme_dbus_if.so.0.3.0 $out/lib/libdsme_dbus_if.so
+
+    install -m755 libthermalmanager_dbus_if.so.0.3.0 $out/lib/
+    ln -s libthermalmanager_dbus_if.so.0.3.0 $out/lib/libthermalmanager_dbus_if.so.0
+    ln -s libthermalmanager_dbus_if.so.0.3.0 $out/lib/libthermalmanager_dbus_if.so
+
+    install -m644 include/dsme/*.h $out/include/dsme/
+    install -m644 modules/*.h $out/include/dsme/
+
+    for pc in dsme.pc dsme_dbus_if.pc thermalmanager_dbus_if.pc; do
+      sed -e "s|prefix=/usr|prefix=$out|" \
+          -e "s|includedir=\''${prefix}/include|includedir=\''${prefix}/include/dsme|" \
+          -e "s|Cflags: -I\''${includedir}|Cflags: -I\''${includedir} -I$out/include|" \
+          $pc > $out/lib/pkgconfig/$pc
+    done
+    runHook postInstall
+  '';
+
+  meta = with lib; {
+    description = "Nemomobile DSME dynamic libraries";
+    homepage = "https://github.com/sailfishos/libdsme";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+})
