From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sun, 1 Nov 2026 12:22:08 +1100
Subject: [PATCH] Match Android headers across libhybris consumers

Use the Android headers selected by libhybris for the HWC plugin, SensorFW, and MCE plugin. ARM buffer base alignment and field offsets differ between generic Android 6 headers and Hoki Android 9 headers. Remove independent header arguments so callPackage cannot silently inject generic headers. Preserve allocation diagnostics for on-device verification.
---
 .../hwcomposer-allocation-diagnostics.patch   | 31 +++++++++++++++++++
 devices/fossil-hoki/hybris.nix                |  2 ++
 examples/asteroid/asteroid-desktop.nix        |  1 +
 overlay/asteroidos/default.nix                |  3 +-
 .../mce-plugin-libhybris/default.nix          |  9 ++----
 .../qt6-qpa-hwcomposer-plugin/default.nix     | 12 +++----
 overlay/asteroidos/sensorfw/default.nix       |  5 ++-
 overlay/libhybris/default.nix                 |  1 +
 8 files changed, 47 insertions(+), 17 deletions(-)
 create mode 100644 devices/fossil-hoki/hwcomposer-allocation-diagnostics.patch

diff --git a/devices/fossil-hoki/hwcomposer-allocation-diagnostics.patch b/devices/fossil-hoki/hwcomposer-allocation-diagnostics.patch
new file mode 100644
index 00000000..cb9ddd4b
--- /dev/null
+++ b/devices/fossil-hoki/hwcomposer-allocation-diagnostics.patch
@@ -0,0 +1,31 @@
+--- a/egl/platforms/hwcomposer/hwcomposer_window.cpp
++++ b/egl/platforms/hwcomposer/hwcomposer_window.cpp
+@@ -106,7 +106,27 @@
+     busy = 0;
+     status = 0;
+ 
+-    hybris_gralloc_allocate(width, height, format, (uint32_t)usage, &handle, (uint32_t*)&stride);
++    const int allocationResult =
++        hybris_gralloc_allocate(width, height, format, (uint32_t)usage,
++                                &handle, (uint32_t*)&stride);
++
++    if (getenv("HYBRIS_HWC_DEBUG")) {
++        const native_handle_t *nativeHandle = handle;
++        fprintf(stderr,
++                "hybris-hwc: allocate this=%p native=%p requested=%ux%u "
++                "format=0x%x usage=0x%" PRIx64 " result=%d "
++                "buffer=%ux%u stride=%d format=0x%x usage=0x%" PRIx64 " "
++                "handle=%p numFds=%d numInts=%d fd0=%d\n",
++                this, static_cast<ANativeWindowBuffer *>(this),
++                width, height, format, usage, allocationResult,
++                ANativeWindowBuffer::width, ANativeWindowBuffer::height,
++                ANativeWindowBuffer::stride, ANativeWindowBuffer::format,
++                ANativeWindowBuffer::usage, nativeHandle,
++                nativeHandle ? nativeHandle->numFds : -1,
++                nativeHandle ? nativeHandle->numInts : -1,
++                (nativeHandle && nativeHandle->numFds > 0)
++                    ? nativeHandle->data[0] : -1);
++    }
+ 
+     TRACE("width=%d height=%d stride=%d format=x%x usage=x%x status=%s this=%p",
+         width, height, stride, format, usage, strerror(-status), this);
diff --git a/devices/fossil-hoki/hybris.nix b/devices/fossil-hoki/hybris.nix
index 4dcaa20c..6c9f6620 100644
--- a/devices/fossil-hoki/hybris.nix
+++ b/devices/fossil-hoki/hybris.nix
@@ -15,6 +15,7 @@ in
   nixpkgs.overlays = lib.mkAfter [
     (final: super: {
       libhybris = super.libhybris.overrideAttrs (old: {
+        patches = (old.patches or [ ]) ++ [ ./hwcomposer-allocation-diagnostics.patch ];
         configureFlags =
           (lib.filter (
             flag:
@@ -31,6 +32,7 @@ in
         # the device's pie headers.
         passthru = (old.passthru or { }) // {
           androidHeaders = hybrisAndroid;
+          androidHeadersInclude = "${hybrisAndroid}/include";
         };
       });
 
diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index fd191102..cc8034aa 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -665,6 +665,7 @@ in
         # failing import line even before any component error is printed.
         QML_IMPORT_TRACE = "1";
         QPA_HWC_DEBUG = "1";
+        HYBRIS_HWC_DEBUG = "1";
         QSG_INFO = "1";
         EGL_LOG_LEVEL = "debug";
         LIBGL_DEBUG = "verbose";
diff --git a/overlay/asteroidos/default.nix b/overlay/asteroidos/default.nix
index a50d02cd..a33893cf 100644
--- a/overlay/asteroidos/default.nix
+++ b/overlay/asteroidos/default.nix
@@ -38,7 +38,6 @@ rec {
   qt6-qpa-hwcomposer-plugin = callPackage ./qt6-qpa-hwcomposer-plugin {
     inherit (pkgs)
       libhybris
-      android-headers
       glib
       mtdev
       ;
@@ -94,7 +93,7 @@ rec {
   # Nemomobile SensorFW daemon and client API (qtsensors sensorfw backend).
   # Upstream: https://github.com/sailfishos/sensorfw
   sensorfw = callPackage ./sensorfw {
-    inherit (pkgs) libhybris android-headers;
+    inherit (pkgs) libhybris;
   };
 
   # Device state machine daemon MCE talks to.
diff --git a/overlay/asteroidos/mce-plugin-libhybris/default.nix b/overlay/asteroidos/mce-plugin-libhybris/default.nix
index b8e68a89..6066dc34 100644
--- a/overlay/asteroidos/mce-plugin-libhybris/default.nix
+++ b/overlay/asteroidos/mce-plugin-libhybris/default.nix
@@ -11,10 +11,6 @@
   pkg-config,
   glib,
   libhybris,
-  # The plugin includes <android-config.h>, <system/window.h> and
-  # <hardware/lights.h>, which must match the headers libhybris was built
-  # against.
-  android-headers ? libhybris.passthru.androidHeaders,
 }:
 
 stdenv.mkDerivation {
@@ -43,8 +39,9 @@ stdenv.mkDerivation {
     "-I${glib.dev}/lib/glib-2.0/include"
     # glibconfig.h is arch-specific and lives in the main output.
     "-I${glib}/lib/glib-2.0/include"
-    "-I${android-headers}/include"
-    "-I${android-headers}/include/android"
+    # Use libhybris's device headers directly. A defaulted android-headers
+    # argument would still be filled with the generic package by callPackage.
+    "-I${libhybris.androidHeadersInclude}"
     "-I${libhybris}/include"
   ];
 
diff --git a/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
index c8d6dc03..e69967d8 100644
--- a/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
+++ b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
@@ -9,7 +9,6 @@
   qt6,
   buildPackages,
   libhybris,
-  android-headers,
   libudev,
   glib,
   mtdev,
@@ -25,8 +24,9 @@ let
     };
 
   # HWC2 was introduced after the Android 6 headers in android-headers 23.
-  # Keep the old headers for HWC1/libhybris and use the Android 10 HWC2
-  # headers for this plugin.
+  # Supplement the device headers with HWC2 declarations. Native window and
+  # gralloc types must still come from the exact headers used by libhybris:
+  # mixing Android 6 and Pie changes the C++ buffer base offset on ARM.
   hwc2Headers = runCommand "android-hwc2-headers" { } ''
     mkdir -p $out/include/hardware
     cp ${
@@ -91,7 +91,7 @@ stdenv.mkDerivation (finalAttrs: {
     qt6.qtdeclarative
     qt6.qtwayland
     libhybris
-    android-headers
+    libhybris.androidHeaders
     hwc2Headers
     libudev
     glib
@@ -190,8 +190,8 @@ QRC
     target_include_directories(hwcomposer PRIVATE
       .
       ${hwc2Headers}/include
-      ${android-headers}/include/android
-      ${android-headers}/include/android/hardware
+      ${libhybris.androidHeadersInclude}
+      ${libhybris.androidHeadersInclude}/hardware
       ${libhybris}/include
       ${libhybris}/include/hybris/eglplatformcommon
       ${libhybris}/include/hybris/platformcommon
diff --git a/overlay/asteroidos/sensorfw/default.nix b/overlay/asteroidos/sensorfw/default.nix
index aef62b0b..c9e7b629 100644
--- a/overlay/asteroidos/sensorfw/default.nix
+++ b/overlay/asteroidos/sensorfw/default.nix
@@ -11,7 +11,6 @@
   qt6,
   systemd,
   libhybris,
-  android-headers,
   udev,
 }:
 
@@ -58,7 +57,7 @@ stdenv.mkDerivation (finalAttrs: {
     qt6.qtbase
     systemd
     libhybris
-    android-headers
+    libhybris.androidHeaders
     udev
   ];
 
@@ -70,7 +69,7 @@ stdenv.mkDerivation (finalAttrs: {
   cmakeFlags = [
     "-DENABLE_HYBRIS=ON"
     "-DHYBRIS_LIB=${libhybris}"
-    "-DANDROID_INCLUDE=${android-headers}/include/android"
+    "-DANDROID_INCLUDE=${libhybris.androidHeadersInclude}"
   ];
 
   meta = with lib; {
diff --git a/overlay/libhybris/default.nix b/overlay/libhybris/default.nix
index 807ec78e..8d39d02e 100644
--- a/overlay/libhybris/default.nix
+++ b/overlay/libhybris/default.nix
@@ -106,5 +106,6 @@ stdenv.mkDerivation {
     # Android headers this libhybris was configured against. Out-of-tree
     # libhybris plugins must compile against the same set.
     androidHeaders = android-headers;
+    androidHeadersInclude = "${android-headers}/include/android";
   };
 }
