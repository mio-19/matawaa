diff --git a/devices/fossil-firefish/default.nix b/devices/fossil-firefish/default.nix
new file mode 100644
index 00000000..b8605a4c
--- /dev/null
+++ b/devices/fossil-firefish/default.nix
@@ -0,0 +1,56 @@
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+
+{
+  imports = [
+    ../families/asteroidos.nix
+  ];
+
+  mobile.device.name = "fossil-firefish";
+  mobile.device.identity = {
+    name = "Gen 4 Explorist HR";
+    manufacturer = "Fossil";
+  };
+
+  mobile.device.supportLevel = "supported";
+
+  mobile.hardware = {
+    # Qualcomm Snapdragon Wear 2100 (MSM8909W)
+    soc = "qualcomm-msm8909w";
+    ram = 512;
+    screen = {
+      width = 454;
+      height = 454;
+    };
+    watch = {
+      hasCrown = true;
+      hasHaptics = true;
+      aodSupport = true;
+    };
+  };
+
+  mobile.system.android = {
+    device_name = "firefish";
+    bootimg.flash = {
+      offset_base = "0x80000000";
+      offset_kernel = "0x00008000";
+      offset_ramdisk = "0x01000000";
+      offset_second = "0x00f00000";
+      offset_tags = "0x00000100";
+      pagesize = "2048";
+    };
+  };
+
+  boot.kernelParams = [
+    "console=ttyMSM0,115200,n8"
+    "androidboot.console=ttyMSM0"
+    "androidboot.hardware=firefish"
+    "msm_rtb.filter=0x237"
+    "ehci-hcd.park=3"
+    "vmalloc=300M"
+  ];
+}
diff --git a/devices/fossil-hoki/android-init.nix b/devices/fossil-hoki/android-init.nix
new file mode 100644
index 0000000000000000000000000000000000000000..14061645223aee82b61956c8a5c8bebf7bd4e2bf
--- /dev/null
+++ b/devices/fossil-hoki/android-init.nix
@@ -0,0 +1,232 @@
+{
+  lib,
+  pkgs,
+  ...
+}:
+
+let
+  hybrisAndroid = import ./hybris-android.nix { inherit pkgs; };
+
+  # The hoki init.rc supplements the stock Android init with the Qualcomm
+  # subsystem setup and the Fossil extras. It must not import the stock
+  # hw/init.rc: the stock /system/bin/init already reads it.
+  initRc = pkgs.fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/8c1dbee6c37cdd4ad97d083a59085abf7032ad42/meta-hoki/recipes-android/android-init/android-init/init.rc";
+    hash = "sha256-TBa60Z7PdgTjZYECheZYEA/6D/OZwpVx3bU70XwWJHU=";
+  };
+
+  platPropertyContexts = pkgs.fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/8c1dbee6c37cdd4ad97d083a59085abf7032ad42/meta-hoki/recipes-android/android-init/android-init/plat_property_contexts";
+    hash = "sha256-Je6T4SOA1vfc8bJOLBRwaBqIW4BCO+akXS7L+P1QYuo=";
+  };
+
+  nonplatPropertyContexts = pkgs.fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/8c1dbee6c37cdd4ad97d083a59085abf7032ad42/meta-hoki/recipes-android/android-init/android-init/nonplat_property_contexts";
+    hash = "sha256-PkLCQb9VlnKQXqMofCNFB6p2SXxwd06+E8yFAWMLWXY=";
+  };
+
+  # ld.config.28.txt from AsteroidOS:
+  # Allows Android binaries to load libraries from /usr/libexec/hal-droid/system/lib
+  ldConfig = pkgs.fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/085844a91fd23691f55d8ac08bc3e4c0a8429936/meta-beluga/recipes-core/initrdscripts/initramfs-scripts-android/ld.config.28.txt";
+    hash = "sha256-7QCh5Q/9QxMEhlcA52ykhPVRsNQZbyPqY7YmBCGGYZE=";
+  };
+
+  # AsteroidOS SELinux stub integration for core service managers.
+  # Matches AsteroidOS meta-skipjack, meta-koi, meta-narwhal, meta-pike, meta-ray.
+  patchedInitRc = pkgs.runCommand "init.rc" { } ''
+        ${pkgs.gnused}/bin/sed \
+          -e '/start vndservicemanager/a \    start vendor.gralloc-2-0\n    start vendor.configstore-hal\n    start vendor.audio-hal-2-0' \
+          -e '/setprop sys.hwc.gpu_perf_mode 1/a \    setprop vendor.gralloc.enable_fb_ubwc 0\n    setprop vendor.gralloc.disable_ubwc 1' \
+          ${initRc} > $out
+        cat >> $out <<'EOF'
+
+    # AsteroidOS SELinux stub integration for core service managers
+    service servicemanager /system/bin/servicemanager
+        setenv LD_PRELOAD /system/lib/libselinux_stubs.so
+        class core
+
+    service hwservicemanager /system/bin/hwservicemanager
+        setenv LD_PRELOAD /system/lib/libselinux_stubs.so
+        class core
+
+    service vndservicemanager /vendor/bin/vndservicemanager /dev/vndbinder
+        setenv LD_PRELOAD /system/lib/libselinux_stubs.so
+        class core
+
+    # Graphics Allocator and ConfigStore services for Qualcomm Treble HIDL
+    service vendor.gralloc-2-0 /vendor/bin/hw/android.hardware.graphics.allocator@2.0-service
+        class hal
+        user system
+        group graphics drmrpc
+        capabilities SYS_NICE
+
+    service vendor.configstore-hal /vendor/bin/hw/android.hardware.configstore@1.1-service
+        class hal
+        user system
+        group system
+    EOF
+  '';
+in
+{
+  # Early boot setup for Android HAL and libhybris property contexts and init.rc.
+  # These files reside in the Nix store and are symlinked into / every boot
+  # during early sysinit by systemd-tmpfiles.
+  systemd.tmpfiles.rules = [
+    "L+ /init.rc - - - - ${patchedInitRc}"
+    "L+ /plat_property_contexts - - - - ${platPropertyContexts}"
+    "L+ /nonplat_property_contexts - - - - ${nonplatPropertyContexts}"
+    "L+ /plat_hwservice_contexts - - - - /system/etc/selinux/plat_hwservice_contexts"
+    "L+ /vendor_hwservice_contexts - - - - /vendor/etc/selinux/vendor_hwservice_contexts"
+    "L+ /vndservice_contexts - - - - /vendor/etc/selinux/vndservice_contexts"
+  ];
+
+  # AsteroidOS-style Pie stack: /system is the hal-droid Android 9 tree from
+  # the hybris tarball and /vendor is the stock Pie vendor, so run the matching
+  # hal-droid Pie init. It parses the Pie system/vendor rc files (no apex or
+  # perform_apex_config) and starts servicemanager, hwservicemanager and the
+  # graphics composer that libhybris talks to.
+  systemd.services.android-init = {
+    description = "/system/bin/init initializes the property service and launches servicemanager and logd";
+    wantedBy = [
+      "multi-user.target"
+      "basic.target"
+    ];
+    after = [ "local-fs.target" ];
+    before = [
+      "network.target"
+      "bluetooth.service"
+      "ofono.service"
+      "sensord.service"
+    ];
+    unitConfig.DefaultDependencies = false;
+    unitConfig.Conflicts = [ "shutdown.target" ];
+    serviceConfig = {
+      Type = "simple";
+      # Android init's shutdown waits for the vendor modem to acknowledge
+      # power-down, which never happens on this device (bgcom_dev
+      # "Time out on modem down event", then pil-q6v5-mss "halt timeout").
+      # Without a bound the stop job sits for the default 90 s, so a reboot
+      # looks hung on a blank screen until systemd finally SIGKILLs the
+      # whole Android cgroup. Bound it instead; the kernel gets the same
+      # SIGKILLed init either way, just 75 s sooner.
+      TimeoutStopSec = "15s";
+      ExecStartPre = pkgs.writeShellScript "android-init-pre" ''
+        ln_force() {
+          local target="$1"
+          local link="$2"
+          if [ -L "$link" ] && [ "$(${pkgs.coreutils}/bin/readlink "$link")" = "$target" ]; then
+            return 0
+          fi
+          ${pkgs.coreutils}/bin/rm -rf "$link"
+          ${pkgs.coreutils}/bin/mkdir -p "$(${pkgs.coreutils}/bin/dirname "$link")"
+          ${pkgs.coreutils}/bin/ln -sfn "$target" "$link"
+        }
+
+        # Ensure Qualcomm bootdevice and platform by-name symlinks exist for rmt_storage
+        ${pkgs.coreutils}/bin/mkdir -p /dev/block/bootdevice/by-name /dev/block/platform/msm_sdcc.1/by-name /dev/block/platform/soc/7824900.sdhci/by-name
+        if [ -d /dev/disk/by-partlabel ]; then
+          for p in /dev/disk/by-partlabel/*; do
+            [ -e "$p" ] || continue
+            name=$(${pkgs.coreutils}/bin/basename "$p")
+            ln_force "$p" /dev/block/bootdevice/by-name/"$name"
+            ln_force "$p" /dev/block/platform/msm_sdcc.1/by-name/"$name"
+            ln_force "$p" /dev/block/platform/soc/7824900.sdhci/by-name/"$name"
+          done
+        fi
+        ln_force ${patchedInitRc} /init.rc
+        ln_force ${platPropertyContexts} /plat_property_contexts
+        ln_force ${nonplatPropertyContexts} /nonplat_property_contexts
+        if [ -d /system/lib ]; then
+          # Android Bionic linker namespace isolation requires libraries in /system/lib
+          # to be regular files (not symlinks to /nix/store, which fail namespace checks).
+          # Use cmp -s to skip copying when already identical, avoiding redundant writes.
+          if [ -L /system/lib/libselinux.so ] || ! ${pkgs.diffutils}/bin/cmp -s ${hybrisAndroid}/usr/libexec/hal-droid/system/lib/libselinux_stubs.so /system/lib/libselinux.so; then
+            ${pkgs.coreutils}/bin/rm -f /system/lib/libselinux.so
+            ${pkgs.coreutils}/bin/cp -f ${hybrisAndroid}/usr/libexec/hal-droid/system/lib/libselinux_stubs.so /system/lib/libselinux.so
+          fi
+          if [ -L /system/lib/libselinux_stubs.so ] || ! ${pkgs.diffutils}/bin/cmp -s ${hybrisAndroid}/usr/libexec/hal-droid/system/lib/libselinux_stubs.so /system/lib/libselinux_stubs.so; then
+            ${pkgs.coreutils}/bin/rm -f /system/lib/libselinux_stubs.so
+            ${pkgs.coreutils}/bin/cp -f ${hybrisAndroid}/usr/libexec/hal-droid/system/lib/libselinux_stubs.so /system/lib/libselinux_stubs.so
+          fi
+        fi
+        if [ -f /system/etc/selinux/plat_hwservice_contexts ]; then
+          ln_force /system/etc/selinux/plat_hwservice_contexts /plat_hwservice_contexts
+        fi
+        if [ -f /vendor/etc/selinux/vendor_hwservice_contexts ]; then
+          ln_force /vendor/etc/selinux/vendor_hwservice_contexts /vendor_hwservice_contexts
+        fi
+        if [ -f /vendor/etc/selinux/vndservice_contexts ]; then
+          ln_force /vendor/etc/selinux/vndservice_contexts /vndservice_contexts
+        fi
+        if [ -f /system/etc/ld.config.28.txt ]; then
+          ${pkgs.util-linux}/bin/mount --bind ${ldConfig} /system/etc/ld.config.28.txt || true
+        fi
+
+        # Ensure /lib/firmware exists and has links to all vendor and dynamic firmware
+        ${pkgs.coreutils}/bin/mkdir -p /lib/firmware
+        for dir in /vendor/firmware /system/etc/firmware; do
+          if [ -d "$dir" ]; then
+            for f in "$dir"/*; do
+              [ -e "$f" ] || continue
+              name=$(${pkgs.coreutils}/bin/basename "$f")
+              ln_force "$f" /lib/firmware/"$name"
+            done
+          fi
+        done
+        for dir in /vendor/firmware_mnt/image /vendor/firmware_mnt /vendor/bt_firmware/image /vendor/bt_firmware; do
+          if [ -d "$dir" ]; then
+            for f in "$dir"/*; do
+              [ -e "$f" ] || continue
+              name=$(${pkgs.coreutils}/bin/basename "$f")
+              ln_force "$f" /lib/firmware/"$name"
+            done
+          fi
+        done
+        # Ensure TFA98xx amplifier container firmware is linked under both names expected by kernel
+        if [ -e /system/etc/firmware/tfa98xx.cnt ]; then
+          ln_force /system/etc/firmware/tfa98xx.cnt /lib/firmware/tfa98xx.cnt
+          ln_force /system/etc/firmware/tfa98xx.cnt /lib/firmware/tfa9890.cnt
+        fi
+
+        ${pkgs.coreutils}/bin/touch /dev/.coldboot_done
+      '';
+      ExecStart = "${hybrisAndroid}/usr/libexec/hal-droid/system/bin/init";
+    };
+  };
+
+  # Hardware Composer 2.1 Treble service for libhybris graphics composition.
+  # Managed via systemd so it starts reliably after Android init/servicemanager
+  # with correct bionic library paths and survives Android framework restarts.
+  systemd.services.android-hwcomposer = {
+    description = "Android Hardware Composer 2.1 Service";
+    wantedBy = [ "multi-user.target" ];
+    after = [ "android-init.service" ];
+    requires = [ "android-init.service" ];
+    serviceConfig = {
+      Type = "simple";
+      Restart = "always";
+      RestartSec = "1s";
+      Environment = [
+        "PATH=/system/bin:/vendor/bin"
+        "LD_LIBRARY_PATH=/vendor/lib:/system/lib"
+      ];
+      ExecStartPre = pkgs.writeShellScript "hwcomposer-pre" ''
+        env -i /system/bin/setprop vendor.gralloc.enable_fb_ubwc 0 || true
+        env -i /system/bin/setprop vendor.gralloc.disable_ubwc 1 || true
+      '';
+      ExecStart = "/vendor/bin/hw/android.hardware.graphics.composer@2.1-service";
+    };
+  };
+
+  # AsteroidOS installs root property contexts and init.rc into / at image build time
+  # Reference: meta-smartwatch meta-hoki/recipes-android/android-init/android-init_1.0.bbappend
+  mobile.generatedFilesystems.rootfs.populateCommands = lib.mkAfter ''
+    ln -sf ${patchedInitRc} ./init.rc
+    ln -sf ${platPropertyContexts} ./plat_property_contexts
+    ln -sf ${nonplatPropertyContexts} ./nonplat_property_contexts
+    if [ -f ./system/etc/ld.config.28.txt ]; then
+      cp -f ${ldConfig} ./system/etc/ld.config.28.txt
+    fi
+  '';
+}
diff --git a/devices/fossil-hoki/android-system-data.nix b/devices/fossil-hoki/android-system-data.nix
new file mode 100644
index 00000000..c74a22e3
--- /dev/null
+++ b/devices/fossil-hoki/android-system-data.nix
@@ -0,0 +1,28 @@
+{ pkgs }:
+
+# Installs the Fossil Gen 6 Android 9 system and vendor data for libhybris.
+# Matches upstream AsteroidOS recipe:
+# AsteroidOS/meta-smartwatch: meta-hoki/recipes-android/android/android-system-data_hoki-p.bb
+let
+  inherit (pkgs) buildPackages;
+in
+pkgs.runCommand "android-system-data-hoki-p"
+  {
+    nativeBuildInputs = [
+      buildPackages.gnutar
+      buildPackages.gzip
+    ];
+  }
+  ''
+    mkdir -p $out
+    tar -xzf ${
+      pkgs.fetchurl {
+        url = "https://dl.dropboxusercontent.com/s/1mmpew8kyn52jko/system-hoki-p.tar.gz";
+        hash = "sha256-FBagGo/RnpyCqgypveM9toU+sI9UEVkrSxeDZJcUF84=";
+      }
+    } -C $out
+
+    # GNSS vendor HAL symlink (matching AsteroidOS PR #342)
+    ln -sfn android.hardware.gnss@1.0-service-qti \
+      $out/vendor/bin/hw/android.hardware.gnss@1.0-service
+  ''
diff --git a/devices/fossil-hoki/audio-modules.nix b/devices/fossil-hoki/audio-modules.nix
new file mode 100644
index 00000000..4bcf1878
--- /dev/null
+++ b/devices/fossil-hoki/audio-modules.nix
@@ -0,0 +1,122 @@
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+
+let
+  kernel = config.mobile.boot.stage-1.kernel.package;
+
+  # Upstream AsteroidOS recipe:
+  # https://github.com/AsteroidOS/meta-smartwatch/blob/88b4ac9/meta-hoki/recipes-kernel/modules/linux-audio-modules-hoki_p.bb
+  audioSrc = pkgs.fetchFromGitHub {
+    owner = "fossil-engineering";
+    repo = "kernel-msm-fossil-extra-cw-audiokernel";
+    rev = "c984389253fc58bc316af06bf3504dd2c25382be";
+    hash = "sha256-dcg4NBM8fMuhY1J/Fm4mZrhzSNIaFXQlebcNiTwvB2Q=";
+  };
+
+  upstreamPatch =
+    name: hash:
+    pkgs.fetchurl {
+      url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/88b4ac9/meta-hoki/recipes-kernel/modules/linux-audio-modules-hoki/${name}";
+      inherit hash;
+    };
+
+  audioModules = kernel.stdenv.mkDerivation {
+    pname = "linux-audio-modules-hoki";
+    version = kernel.version;
+    src = audioSrc;
+
+    patches = [
+      (upstreamPatch "0001-Remove-export-from-Kbuild-files.patch" "sha256-vjptUX54W5JCTL1wxFuba6fJC5mSl27sYaBYDF/xL2o=")
+      (upstreamPatch "0002-Avoid-shell-expansion-in-recursively-expanded-variab.patch" "sha256-11a78Tdzw37koeax5WYEu0HvCzxN4ABecyjWG5QHHmc=")
+      (upstreamPatch "0003-Import-beluga-makefile.patch" "sha256-VLbhbVGqJdbYYxAumcyoXpFIHHm3XPHHUqwEBXo4nHc=")
+      (upstreamPatch "0004-Ignore-compilation-warnings.patch" "sha256-5NAHGsk7Go//CPf85rNyjAzbhpnM653ThevAeSik/dQ=")
+      (upstreamPatch "0005-dsp-Compile-codecs-for-out-of-tree-builds.patch" "sha256-/hY0VsLIEY2Xwol3LFqjWaatMZFKiwWsrA7q1uZ33yQ=")
+    ];
+
+    nativeBuildInputs =
+      (with pkgs.buildPackages; [
+        bc
+        bison
+        flex
+        openssl
+        python3
+      ])
+      ++ [ pkgs.buildPackages.buildPackages.gcc ];
+    buildInputs = [ kernel ];
+
+    # Prepare the kernel source tree (with the same stable/device patches as the
+    # running kernel so vermagic matches 4.14.213) and the sibling
+    # kernel-build-artifacts directory expected by 0003-Import-beluga-makefile.patch.
+    configurePhase = ''
+      runHook preConfigure
+      cp -r ${kernel.src} kernel-src
+      chmod -R u+w kernel-src
+      for p in ${lib.concatMapStringsSep " " (p: "${p}") kernel.patches}; do
+        patch -d kernel-src -p1 < "$p"
+      done
+      cp ${kernel.configfile} kernel-src/.config
+      make -C kernel-src ARCH=arm CROSS_COMPILE=${kernel.stdenv.cc.targetPrefix} CC=${kernel.stdenv.cc}/bin/${kernel.stdenv.cc.targetPrefix}cc HOSTCC=${pkgs.buildPackages.buildPackages.gcc}/bin/gcc olddefconfig
+      make -C kernel-src ARCH=arm CROSS_COMPILE=${kernel.stdenv.cc.targetPrefix} CC=${kernel.stdenv.cc}/bin/${kernel.stdenv.cc.targetPrefix}cc HOSTCC=${pkgs.buildPackages.buildPackages.gcc}/bin/gcc modules_prepare
+
+      mkdir -p kernel-build-artifacts/usr/include/linux kernel-build-artifacts/scripts
+      ${pkgs.buildPackages.buildPackages.gcc}/bin/gcc -std=gnu11 kernel-src/scripts/unifdef.c -o kernel-build-artifacts/scripts/unifdef
+
+      # Extract vmlinux Module.symvers from the built kernel zImage + System.map
+      # so CONFIG_MODVERSIONS=y CRC checks (including module_layout) pass at load time.
+      python3 - "${kernel}" kernel-src/Module.symvers <<'PY'
+      import struct, sys, zlib
+      kdir, out_path = sys.argv[1], sys.argv[2]
+      zimg = open(kdir + "/zImage", "rb").read()
+      img = zlib.decompress(zimg[zimg.find(b"\x1f\x8b\x08"):], 16 + zlib.MAX_WBITS)
+      syms, ksymtab = {}, []
+      for line in open(kdir + "/System.map"):
+          addr_s, _, name = line.split()
+          addr = int(addr_s, 16)
+          syms[name] = addr
+          if name.startswith("__ksymtab_"):
+              ksymtab.append((addr, name[len("__ksymtab_"):]))
+      base = syms["_text"]
+      with open(out_path, "w") as out:
+          for saddr, sname in sorted(ksymtab):
+              if saddr < syms["__start___ksymtab_gpl"]:
+                  i = (saddr - syms["__start___ksymtab"]) // 8
+                  crc_addr, lic = syms["__start___kcrctab"] + i * 4, "EXPORT_SYMBOL"
+              else:
+                  i = (saddr - syms["__start___ksymtab_gpl"]) // 8
+                  crc_addr, lic = syms["__start___kcrctab_gpl"] + i * 4, "EXPORT_SYMBOL_GPL"
+              crc = struct.unpack_from("<I", img, crc_addr - base)[0]
+              out.write(f"0x{crc:08x}\t{sname}\tvmlinux\t{lic}\n")
+      PY
+      runHook postConfigure
+    '';
+
+    makeFlags = [
+      "ARCH=arm"
+      "CROSS_COMPILE=${kernel.stdenv.cc.targetPrefix}"
+      "CC=${kernel.stdenv.cc}/bin/${kernel.stdenv.cc.targetPrefix}cc"
+      "HOSTCC=${pkgs.buildPackages.buildPackages.gcc}/bin/gcc"
+      "KERNEL_SRC=$(PWD)/kernel-src"
+    ];
+
+    installPhase = ''
+      runHook preInstall
+      modDir=$out/lib/modules/${kernel.modDirVersion}
+      mkdir -p "$modDir/extra"
+      find asoc dsp ipc soc -name '*.ko' -exec cp -v {} "$modDir/extra/" \;
+      for ko in "$modDir/extra"/*.ko; do
+        touch "$ko.cer"
+      done
+      touch "$modDir/modules.cer" "$modDir/modules.builtin" "$modDir/modules.builtin.modinfo"
+      echo "#" > "$modDir/modules.order"
+      runHook postInstall
+    '';
+  };
+in
+{
+  # Loaded by init.rc (`exec -- /sbin/modprobe -a audio_apr ...`) before booting ADSP.
+  boot.extraModulePackages = [ audioModules ];
+}
diff --git a/devices/fossil-hoki/default.nix b/devices/fossil-hoki/default.nix
new file mode 100644
index 00000000..a6a6e41d
--- /dev/null
+++ b/devices/fossil-hoki/default.nix
@@ -0,0 +1,588 @@
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+
+let
+  hybrisAndroid = import ./hybris-android.nix { inherit pkgs; };
+  androidSystemData = import ./android-system-data.nix { inherit pkgs; };
+
+  tfa9890Cnt = pkgs.runCommand "tfa9890.cnt" { } ''
+    ${pkgs.coreutils}/bin/base64 -d ${./tfa9890.cnt.base64} > $out
+  '';
+
+  # Static vendor and system firmware package for kernel direct firmware loader
+  hokiFirmware = pkgs.runCommand "hoki-firmware" { } ''
+    mkdir -p $out/lib/firmware
+    cp -a ${androidSystemData}/vendor/firmware/* $out/lib/firmware/
+    if [ -d ${androidSystemData}/system/etc/firmware ]; then
+      cp -a ${androidSystemData}/system/etc/firmware/* $out/lib/firmware/
+    fi
+    cp -f ${tfa9890Cnt} $out/lib/firmware/tfa9890.cnt
+  '';
+
+  # Non-graphic feedback (haptics) DRV260X configuration for tactile feedback
+  # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/blob/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-nemomobile/ngfd/ngfd_git.bbappend
+  hokiNgfdIni = pkgs.fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-nemomobile/ngfd/ngfd/51-ffmemless.ini";
+    sha256 = "19bzmmhhn526wyqcg163x1hc8czrmxli22m68s07srr4zza9dman";
+  };
+
+  hokiNgfdConfig = pkgs.runCommand "hoki-ngfd-config" { } ''
+    install -Dm644 ${hokiNgfdIni} $out/share/ngfd/plugins.d/51-ffmemless.ini
+  '';
+
+  # Debug builds get Qt plugin/loader tracing in the compositor environment,
+  # so a launcher dlopen/EGL failure is visible in the journal without
+  # hand-editing 20-device.conf on the device.
+  debugBuild =
+    config.mobile.hardware.watch.stage1-pause-debug.enable
+    || config.mobile.hardware.watch.stage2-save-logs.enable
+    || config.mobile.hardware.watch.stage2-ssh.enable;
+in
+{
+  imports = [
+    ../families/asteroidos.nix
+    ./hybris.nix
+    ./android-init.nix
+    ./wlan.nix
+    ./audio-modules.nix
+  ];
+
+  mobile.device.name = "fossil-hoki";
+  mobile.device.identity = {
+    name = "Gen 6";
+    manufacturer = "Fossil";
+  };
+
+  mobile.device.supportLevel = "supported";
+
+  # Upstream meta-hoki/conf/machine/hoki.conf: MACHINE_HAS_SPEAKER = "true".
+  # Exposed to the launcher/QML through /etc/asteroid/machine.conf.
+  mobile.hardware.watch.hasSpeaker = true;
+
+  # Linux 4.14 btrfs supports compress=zstd (without a level), noatime and
+  # space_cache=v2. It rejects compress=zstd:3 / zstd3 and space_cache v1.
+  # The image builder disables block-group-tree for this kernel.
+  mobile.generatedFilesystems.rootfs = {
+    filesystem = lib.mkForce "btrfs";
+    btrfs.compression = "zstd";
+  };
+
+  # btrfs-progs provides `btrfs filesystem resize` for rootfs growth and
+  # maintenance; stage-1 already gets it from modules/rootfs.nix.
+
+  mobile.hardware = {
+    # Qualcomm Snapdragon Wear 4100+ (SDA429W / SDM429W), Cortex-A53.
+    # The Android system image is the 32-bit armv7l ABI.
+    soc = "qualcomm-sda429w";
+    ram = 1024 * 1;
+    screen = {
+      width = 416;
+      height = 416;
+    };
+    watch = {
+      hasCrown = true;
+      hasHaptics = true;
+      aodSupport = true;
+      stage1-pause-debug.enable = false;
+      stage2-ssh.enable = true;
+      stage2-save-logs.enable = true;
+    };
+  };
+
+  mobile.boot.stage-1 = {
+    kernel.package = pkgs.callPackage ./kernel { };
+  };
+
+  mobile.system.android = {
+    device_name = "hoki";
+    ab_partitions = true;
+    bootimg.flash = {
+      offset_base = "0x80000000";
+      offset_kernel = "0x00008000";
+      offset_ramdisk = "0x01000000";
+      offset_second = "0x00f00000";
+      offset_tags = "0x00000100";
+      pagesize = "4096";
+    };
+  };
+
+  # The DTB is appended to the kernel image (CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE).
+  # 90_dtbs-install.patch copies it flat into $out/dtbs/.
+  mobile.system.android.appendDTB = [
+    "dtbs/sda429-hoki.dtb"
+  ];
+
+  # Kernel parameters matching upstream AsteroidOS / Android bootloader configuration
+  # Reference: https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-kernel/linux/linux-hoki/img_info
+  boot.kernelParams = [
+    "console=ttyMSM0,115200,n8"
+    "androidboot.console=ttyMSM0"
+    "androidboot.hardware=hoki"
+    "androidboot.selinux=permissive"
+    "audit=0"
+    "user_debug=30"
+    "msm_rtb.filter=0x237"
+    "ehci-hcd.park=3"
+    "androidboot.bootdevice=7824900.sdhci"
+    "lpm_levels.sleep_disabled=1"
+    "earlycon=msm_serial_dm,0x78b0000"
+    "vmalloc=300M"
+    "androidboot.usbconfigfs=true"
+    "loop.max_part=7"
+    "cgroup.memory=nokmem,nosocket"
+    "datapart=/dev/mmcblk0p50"
+  ]
+  ++ lib.optionals config.mobile.hardware.watch.stage1-pause-debug.enable [
+    # Verbose systemd logging for early stage-2 debugging.
+    "systemd.log_level=debug"
+    "systemd.log_target=kmsg"
+  ];
+
+  mobile.system.type = "android";
+
+  # The hoki vendor kernel does not provide a zram module; avoid the
+  # dev-zram0.device boot timeout.
+  zramSwap.enable = lib.mkForce false;
+
+  # Device-specific userdata partition for stage-1 boot discovery
+  mobile.boot.stage-1.bootConfig.partitions.userdata = "/dev/mmcblk0p50";
+
+  # Ensure stage-1 udev immediately links userdata to /dev/disk/by-label/NIXOS_SYSTEM and /dev/disk/by-partlabel/userdata
+  mobile.boot.stage-1.extraUdevRules = ''
+    KERNEL=="mmcblk0p50", SYMLINK+="disk/by-label/NIXOS_SYSTEM", SYMLINK+="disk/by-partlabel/userdata"
+    ENV{PARTNAME}=="userdata", SYMLINK+="disk/by-label/NIXOS_SYSTEM", SYMLINK+="disk/by-partlabel/userdata"
+    ENV{ID_PART_ENTRY_NAME}=="userdata", SYMLINK+="disk/by-label/NIXOS_SYSTEM", SYMLINK+="disk/by-partlabel/userdata"
+  '';
+
+  environment.systemPackages = [
+    pkgs.alsa-utils
+    pkgs.btrfs-progs
+    pkgs.qrtr
+    pkgs.tinyalsa
+    hokiNgfdConfig
+  ];
+
+  # Include static Qualcomm Adreno GPU, audio DSP and Wi-Fi firmware in the system
+  # closure so the kernel direct firmware loader (/sys/module/firmware_class/parameters/path)
+  # finds a530_pm4.fw, a530_pfp.fw, a506_zap.*, ice40.bin, and tfa98xx.cnt.
+  hardware.firmware = [ hokiFirmware ];
+  mobile.boot.stage-1.firmware = [ hokiFirmware ];
+
+  # Hardware audio mixer DAI link routing for NXP TFA98xx speaker amplifier & digital mic
+  # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/issues/343
+  systemd.services.audio-routing-hoki = {
+    description = "Fossil Gen 6 TFA98xx audio amplifier and microphone mixer routing";
+    wantedBy = [ "multi-user.target" ];
+    wants = [ "dev-snd-controlC0.device" ];
+    after = [
+      "dev-snd-controlC0.device"
+      "sound.target"
+    ];
+    path = with pkgs; [
+      alsa-utils
+      coreutils
+      tinyalsa
+    ];
+    serviceConfig = {
+      Type = "oneshot";
+      RemainAfterExit = true;
+      ExecStart = pkgs.writeShellScript "audio-routing-hoki" ''
+        ln_force() {
+          local target="$1"
+          local link="$2"
+          if [ -L "$link" ] && [ "$(${pkgs.coreutils}/bin/readlink "$link")" = "$target" ]; then
+            return 0
+          fi
+          ${pkgs.coreutils}/bin/rm -rf "$link"
+          ${pkgs.coreutils}/bin/mkdir -p "$(${pkgs.coreutils}/bin/dirname "$link")"
+          ${pkgs.coreutils}/bin/ln -sfn "$target" "$link"
+        }
+
+        # Ensure TFA98xx amplifier DSP container firmware is linked under both names in /lib/firmware
+        mkdir -p /lib/firmware
+        ln_force "${tfa9890Cnt}" /lib/firmware/tfa9890.cnt
+        for p in /system/etc/firmware/tfa98xx.cnt /vendor/firmware/tfa98xx.cnt /etc/firmware/tfa98xx.cnt; do
+          if [ -e "$p" ]; then
+            ln_force "$p" /lib/firmware/tfa98xx.cnt
+            break
+          fi
+        done
+
+        # Bounded poll for ALSA mixer control node (up to 30 seconds) to avoid cold boot race
+        for i in $(seq 1 60); do
+          if [ -e /dev/snd/controlC0 ]; then
+            break
+          fi
+          sleep 0.5
+        done
+
+        if [ -e /dev/snd/controlC0 ]; then
+          # QUAT_MI2S_RX connects MultiMedia1 frontend to TFA98xx speaker amplifier DAI link
+          tinymix -D 0 set "QUAT_MI2S_RX Audio Mixer MultiMedia1" 1 || true
+          tinymix -D 0 set "Playback 0 Volume" 8192 || true
+          tinymix -D 0 set "mono Profile" "Music" || true
+          tinymix -D 0 set "mono Music Playback Volume" 3 || true
+          # TERT_MI2S_TX connects digital microphone to MultiMedia1 capture frontend
+          tinymix -D 0 set "MultiMedia1 Mixer TERT_MI2S_TX" 1 || true
+          # Route digital mic 1 to DEC1
+          tinymix -D 0 set "DEC1 MUX" "DMIC1" || true
+        fi
+      '';
+    };
+  };
+
+  # AsteroidOS Wayland compositor environment is installed as
+  # /var/lib/environment/compositor/20-device.conf below, matching the
+  # upstream EnvironmentFile contract.
+
+  # Hardware node permissions and symlinks for Android HAL / libhybris
+  # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-android/android-init/android-init/init.rc
+  services.udev.extraRules = ''
+    KERNEL=="binder", MODE="0666"
+    KERNEL=="ashmem", MODE="0666"
+    KERNEL=="hwbinder", MODE="0666"
+    KERNEL=="vndbinder", MODE="0666"
+    KERNEL=="mdss_rotator", MODE="0666"
+    SUBSYSTEM=="leds", KERNEL=="vibrator", ATTR{trigger}="transient", MODE="0666"
+    DEVPATH=="/devices/platform/soc/soc:qcom,bg-rsb", ATTR{enable}=="*", MODE="0666"
+
+    # Upstream AsteroidOS block device symlinks for Qualcomm rmt_storage and Android HALs
+    # Reference: meta-asteroid 998-droid-system.rules & Qualcomm bootdevice scheme
+    ENV{ID_PART_ENTRY_NAME}=="?*", SYMLINK+="block/bootdevice/by-name/$env{ID_PART_ENTRY_NAME}", SYMLINK+="block/platform/msm_sdcc.1/by-name/$env{ID_PART_ENTRY_NAME}", SYMLINK+="block/platform/soc/7824900.sdhci/by-name/$env{ID_PART_ENTRY_NAME}"
+  '';
+
+  # Persistent hardware partition mounts on Fossil Gen 6 eMMC
+  # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-core/base-files/base-files/fstab
+  # Upstream AsteroidOS uses hwcomposer and direct MDP overlays; msm-fb-refresher
+  # pans /dev/fb0 continuously which exhausts MDSS hardware pipes (no 2 type pipes available).
+  mobile.quirks.fb-refresher.enable = lib.mkForce false;
+  mobile.quirks.fb-refresher.stage-1.enable = lib.mkForce false;
+
+  fileSystems = {
+    # Upstream AsteroidOS installs /system and /vendor directly into the rootfs
+    # from system-hoki-p.tar.gz rather than mounting an on-disk vendor partition.
+    # /vendor/bt_firmware and /vendor/firmware_mnt mount modem & bluetooth firmware
+    # onto mountpoints within /vendor.
+    "/persist" = {
+      device = "/dev/disk/by-partlabel/persist";
+      fsType = "ext4";
+      options = [
+        "nofail"
+        "errors=continue"
+      ];
+    };
+    "/vendor/firmware_mnt" = {
+      device = "/dev/disk/by-partlabel/modem";
+      fsType = "vfat";
+      options = [
+        "ro"
+        "shortname=lower"
+        "nofail"
+      ];
+    };
+    "/vendor/bt_firmware" = {
+      device = "/dev/disk/by-partlabel/bluetooth";
+      fsType = "vfat";
+      options = [
+        "ro"
+        "shortname=lower"
+        "nofail"
+      ];
+    };
+  };
+
+  # Subsystem boots and firmware mount setup
+  # GNSS vendor service symlink PR: https://github.com/AsteroidOS/meta-smartwatch/pull/342
+  systemd.tmpfiles.rules = [
+    "d /var/lib/environment/compositor 0755 root root -"
+    "L+ /dev/graphics/fb0 - - - - /dev/fb0"
+    "z /dev/fb0 0660 root video -"
+    "z /dev/input/event* 0660 root input -"
+    "d /mnt/vendor 0755 root root -"
+    "L+ /mnt/vendor/persist - - - - /persist"
+    "d /data/vendor 0755 root root -"
+    "d /data/vendor/ssrdump 0755 root root -"
+    "d /data/vendor/bgdaemon 0755 root root -"
+    "d /dev/block 0755 root root -"
+    "d /dev/block/bootdevice 0755 root root -"
+    "L+ /dev/block/bootdevice/by-name - - - - /dev/disk/by-partlabel"
+    "d /dev/block/platform 0755 root root -"
+    "L+ /dev/block/platform/msm_sdcc.1/by-name - - - - /dev/disk/by-partlabel"
+    "p+ /run/psplash_fifo 0666 root root -"
+    "d /sbin 0755 root root -"
+    "L+ /sbin/modprobe - - - - ${pkgs.kmod}/bin/modprobe"
+    "d /lib/firmware 0755 root root -"
+    "L+ /lib/modules - - - - /run/current-system/kernel-modules/lib/modules"
+    "L+ /etc/firmware - - - - /vendor/firmware"
+  ];
+
+  # systemd-tmpfiles refuses to create the compositor environment file at boot:
+  # the image root is owned by uid 1000 (the unprivileged image builder), which
+  # makes /var -> /var/lib an unsafe ownership transition. Install the file in
+  # the image instead so the launcher always sees QPA_HWC_*.
+  mobile.generatedFilesystems.rootfs.populateCommands = lib.mkAfter ''
+    # AsteroidOS installs the hal-droid tree at /usr/libexec/hal-droid
+    mkdir -p ./usr/libexec ./sbin
+    ln -sfn ${hybrisAndroid}/usr/libexec/hal-droid ./usr/libexec/hal-droid
+    ln -sfn ${pkgs.kmod}/bin/modprobe ./sbin/modprobe
+
+    # AsteroidOS installs the Fossil Gen 6 Android 9 system and vendor data
+    # Reference: meta-smartwatch meta-hoki/recipes-android/android/android-system-data_hoki-p.bb
+    mkdir -p ./system ./vendor ./lib/firmware ./etc
+    ln -sfn /run/current-system/kernel-modules/lib/modules ./lib/modules
+    cp -a ${androidSystemData}/system/* ./system/
+    cp -a ${androidSystemData}/vendor/* ./vendor/
+    chmod -R u+w ./system ./vendor
+
+    # Populate /lib/firmware and /etc/firmware with vendor & system firmware for kernel direct loading
+    cp -a ${androidSystemData}/vendor/firmware/* ./lib/firmware/ 2>/dev/null || true
+    if [ -d ${androidSystemData}/system/etc/firmware ]; then
+      cp -a ${androidSystemData}/system/etc/firmware/* ./lib/firmware/ 2>/dev/null || true
+    fi
+    [ -e ./lib/firmware/tfa98xx.cnt ] && ln -sf tfa98xx.cnt ./lib/firmware/tfa9890.cnt || true
+    ln -sfn /vendor/firmware ./etc/firmware
+
+    # Replace stock Android libselinux.so with AsteroidOS libselinux_stubs.so
+    # to stub out SELinux calls for all Android HALs and service managers.
+    cp -f ${hybrisAndroid}/usr/libexec/hal-droid/system/lib/libselinux_stubs.so ./system/lib/libselinux.so
+    cp -f ${hybrisAndroid}/usr/libexec/hal-droid/system/lib/libselinux_stubs.so ./system/lib/libselinux_stubs.so
+
+    # Symlink SELinux service and hardware service contexts to root if present
+    if [ -f ./system/etc/selinux/plat_hwservice_contexts ]; then
+      ln -sf /system/etc/selinux/plat_hwservice_contexts ./plat_hwservice_contexts
+    fi
+    if [ -f ./vendor/etc/selinux/vendor_hwservice_contexts ]; then
+      ln -sf /vendor/etc/selinux/vendor_hwservice_contexts ./vendor_hwservice_contexts
+    fi
+    if [ -f ./vendor/etc/selinux/vndservice_contexts ]; then
+      ln -sf /vendor/etc/selinux/vndservice_contexts ./vndservice_contexts
+    fi
+
+    mkdir -p ./var/lib/environment/compositor
+    cp ${pkgs.writeText "00-default.conf" ''
+      QT_IM_MODULE=qtvirtualkeyboard
+    ''} ./var/lib/environment/compositor/00-default.conf
+
+    cp ${pkgs.writeText "10-platform.conf" ''
+      EGL_PLATFORM=hwcomposer
+      QT_QPA_PLATFORM=hwcomposer
+      QT_ENABLE_GLYPH_CACHE_WORKAROUND=true
+      QT_GSTREAMER_CAMERABIN_SRC=droidcamsrc
+    ''} ./var/lib/environment/compositor/10-platform.conf
+
+    cp ${pkgs.writeText "20-device.conf" ''
+      LIPSTICK_OPTIONS="-plugin evdevkeyboard:/dev/input/event4:keymap=${pkgs.asteroid.assets.keymaps}/share/qt6/keymaps/keys.qmap -plugin evdevkeyboard:/dev/input/event0:keymap=${pkgs.asteroid.assets.keymaps}/share/qt6/keymaps/keys.qmap -plugin evdevmouse:/dev/input/event1"
+      QPA_HWC_FORCE_GLES=1
+      QPA_HWC2_FORCE_DOZE_UPDATE=1
+      QT_OPENGL_NO_BGRA=1
+      ${lib.optionalString debugBuild ''
+        QT_DEBUG_PLUGINS=1
+      ''}
+    ''} ./var/lib/environment/compositor/20-device.conf
+
+    cp ${pkgs.writeText "qt6-hidpi.conf" ''
+      QT_ENABLE_HIGHDPI_SCALING=0
+    ''} ./var/lib/environment/compositor/qt6-hidpi.conf
+  '';
+
+  # Symlink modem and bluetooth partition firmware into /lib/firmware
+  # once /vendor/firmware_mnt and /vendor/bt_firmware are mounted.
+  systemd.services.firmware-mount-links-hoki = {
+    description = "Symlink dynamic modem and bluetooth firmware into /lib/firmware";
+    after = [
+      "vendor-firmware_mnt.mount"
+      "vendor-bt_firmware.mount"
+    ];
+    before = [
+      "android-init.service"
+      "wlan-firmware-hoki.service"
+    ];
+    wantedBy = [ "multi-user.target" ];
+    unitConfig = {
+      DefaultDependencies = false;
+      Conflicts = [ "shutdown.target" ];
+    };
+    serviceConfig = {
+      Type = "oneshot";
+      RemainAfterExit = true;
+      ExecStart = pkgs.writeShellScript "firmware-mount-links-hoki" ''
+        ln_force() {
+          local target="$1"
+          local link="$2"
+          if [ -L "$link" ] && [ "$(${pkgs.coreutils}/bin/readlink "$link")" = "$target" ]; then
+            return 0
+          fi
+          ${pkgs.coreutils}/bin/rm -rf "$link"
+          ${pkgs.coreutils}/bin/mkdir -p "$(${pkgs.coreutils}/bin/dirname "$link")"
+          ${pkgs.coreutils}/bin/ln -sfn "$target" "$link"
+        }
+
+        mkdir -p /lib/firmware
+        # Link modem partition PIL firmware (wcnss, venus, modem, adsp, etc.)
+        for dir in /vendor/firmware_mnt/image /vendor/firmware_mnt; do
+          if [ -d "$dir" ]; then
+            for f in "$dir"/*; do
+              [ -e "$f" ] || continue
+              base=$(${pkgs.coreutils}/bin/basename "$f")
+              ln_force "$f" "/lib/firmware/$base"
+            done
+          fi
+        done
+        # Link bluetooth partition firmware
+        for dir in /vendor/bt_firmware/image /vendor/bt_firmware; do
+          if [ -d "$dir" ]; then
+            for f in "$dir"/*; do
+              [ -e "$f" ] || continue
+              base=$(${pkgs.coreutils}/bin/basename "$f")
+              ln_force "$f" "/lib/firmware/$base"
+            done
+          fi
+        done
+      '';
+    };
+  };
+
+  # The hoki init.rc (run by android-init.service) boots the ADSP/CDSP/SLPI
+  # subsystems, sets their restart levels, fixes up the bg-rsb permissions and
+  # runs init.rsb.sh on sys.boot_completed, matching AsteroidOS. No separate
+  # systemd service is needed.
+
+  # Fossil Gen 6 CPU/GPU underclock and power collapse profile
+  # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-core/underclock/underclock/underclock
+  # Commit: https://github.com/AsteroidOS/meta-smartwatch/commit/8c1dbee6c37cdd4ad97d083a59085abf7032ad42
+  systemd.services.underclock-hoki = {
+    description = "Fossil Gen 6 low power collapse and CPU underclocking";
+    wantedBy = [ "multi-user.target" ];
+    serviceConfig = {
+      Type = "simple";
+      ExecStart = pkgs.writeShellScript "underclock-hoki" ''
+        # Delay tuning until the boot has settled, but do not hold
+        # multi-user.target while waiting.
+        ${pkgs.coreutils}/bin/sleep 20
+
+        # Enable low power mode & allow system-pc
+        if [ -f /sys/module/lpm_levels/parameters/sleep_disabled ]; then
+          echo 0 > /sys/module/lpm_levels/parameters/sleep_disabled 2>/dev/null || true
+        fi
+        if [ -f /sys/module/lpm_levels/system/system-pc/idle_enabled ]; then
+          echo 0 > /sys/module/lpm_levels/system/system-pc/idle_enabled 2>/dev/null || true
+        fi
+        # Set CPU governor to ondemand for quick burst responses
+        if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
+          echo ondemand > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true
+        fi
+        # Disable secondary cores to save battery on wrist
+        for c in 1 2 3; do
+          if [ -f /sys/devices/system/cpu/cpu$c/online ]; then
+            echo 0 > /sys/devices/system/cpu/cpu$c/online 2>/dev/null || true
+          fi
+        done
+      '';
+    };
+  };
+
+  # WCNSS Wi-Fi firmware initialization and driver loading
+  # Upstream PR: https://github.com/AsteroidOS/meta-smartwatch/pull/341 ("hoki: wlan: working WiFi driver from source")
+  systemd.services.wlan-firmware-hoki = {
+    description = "Enable pronto WLAN firmware and load the wlan module on hoki";
+    after = [ "android-init.service" ];
+    before = [ "connman.service" ];
+    wantedBy = [ "multi-user.target" ];
+    path = with pkgs; [
+      kmod
+      coreutils
+    ];
+    serviceConfig = {
+      # Never hold multi-user.target: the prima module waits for WCNSS
+      # firmware inside the kernel, which can take minutes when the firmware
+      # is missing. WiFi coming up late must not delay the user session.
+      Type = "simple";
+      ExecStart = "${pkgs.writeShellScript "wlan-firmware-hoki" (
+        builtins.readFile ./wlan-firmware-hoki.sh
+      )}";
+    };
+  };
+
+  # GNSS AGPS NTP injection configuration & Android HAL library symlink
+  # Upstream PR: https://github.com/AsteroidOS/meta-smartwatch/pull/342 ("hoki: gnss: symlink real vendor HAL service, enable NTP AGPS assistance")
+  environment.etc."gps_xtra.ini".source = ./gps_xtra.ini;
+
+  # The vendor GNSS rc references android.hardware.gnss@1.0-service but the
+  # stock vendor ships the -qti variant. Create the alias at boot (the vendor
+  # partition is read-only, so remount it for the operation) and drop the AGPS
+  # assistance file on /persist, matching PR #342.
+  systemd.services.gnss-hoki = {
+    description = "hoki GNSS vendor service symlink and AGPS assistance";
+    after = [
+      "persist.mount"
+    ];
+    before = [ "android-init.service" ];
+    wantedBy = [ "multi-user.target" ];
+    serviceConfig = {
+      Type = "oneshot";
+      RemainAfterExit = true;
+      ExecStart = pkgs.writeShellScript "gnss-hoki" ''
+        ln_force() {
+          local target="$1"
+          local link="$2"
+          if [ -L "$link" ] && [ "$(${pkgs.coreutils}/bin/readlink "$link")" = "$target" ]; then
+            return 0
+          fi
+          ${pkgs.coreutils}/bin/rm -rf "$link"
+          ${pkgs.coreutils}/bin/mkdir -p "$(${pkgs.coreutils}/bin/dirname "$link")"
+          ${pkgs.coreutils}/bin/ln -sfn "$target" "$link"
+        }
+
+        if [ -d /persist ] && [ -e /etc/gps_xtra.ini ]; then
+          ln_force /etc/gps_xtra.ini /persist/gps_xtra.ini
+        fi
+      '';
+    };
+  };
+
+  # Non-graphic feedback (haptics) DRV260X configuration for tactile feedback
+  # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/blob/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-nemomobile/ngfd/ngfd/51-ffmemless.ini
+  environment.etc."ngf/51-ffmemless.ini".source = hokiNgfdIni;
+  environment.etc."ngfd/plugins.d/51-ffmemless.ini".source = hokiNgfdIni;
+
+  # Qualcomm IPC Router name service
+  # Upstream reference: meta-hoki/conf/machine/hoki.conf (IMAGE_INSTALL += "qrtr")
+  systemd.services.qrtr-ns = {
+    description = "QIPCRTR Name Service";
+    wantedBy = [ "multi-user.target" ];
+    serviceConfig = {
+      ExecStart = "${pkgs.qrtr}/bin/qrtr-ns -f 1";
+      Restart = "always";
+    };
+  };
+
+  # Near Field Communication (NFC) controller configuration
+  # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/blob/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-nemomobile/libnci/libncicore/libncicore.conf
+  environment.etc."libncicore.conf".source = pkgs.fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-nemomobile/libnci/libncicore/libncicore.conf";
+    sha256 = "12zg3n0jysy7lczqwh0kl5ccg1ljgidkqazj6i8v2j9k0nckkx29";
+  };
+
+  # Qualcomm MSM8909W / SDM429W DSP frontend (MultiMedia1 / hw:0,0) only accepts 48,000 Hz.
+  # Configure ALSA plug with rate 48000 so all apps (including 44.1 kHz beatfork tick.wav)
+  # are transparently resampled and play properly.
+  environment.etc."asound.conf".text = ''
+    pcm.!default {
+      type plug
+      slave {
+        pcm "hw:0,0"
+        rate 48000
+        format S16_LE
+      }
+    }
+
+    ctl.!default {
+      type hw
+      card 0
+    }
+  '';
+}
