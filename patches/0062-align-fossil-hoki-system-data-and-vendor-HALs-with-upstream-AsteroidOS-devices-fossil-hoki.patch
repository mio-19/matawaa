From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 26 Oct 2026 23:14:47 +1100
Subject: [PATCH] align fossil-hoki system data and vendor HALs with upstream
 AsteroidOS (devices/fossil-hoki)

---
 devices/fossil-hoki/android-system-data.nix   | 18 ++++++++++
 devices/fossil-hoki/default.nix               | 34 ++++++++-----------
 devices/fossil-hoki/hybris.nix                |  2 +-
 .../qt6-qpa-hwcomposer-plugin/default.nix     |  8 +++++
 4 files changed, 41 insertions(+), 21 deletions(-)
 create mode 100644 devices/fossil-hoki/android-system-data.nix

diff --git a/devices/fossil-hoki/android-system-data.nix b/devices/fossil-hoki/android-system-data.nix
new file mode 100644
index 00000000..4373edde
--- /dev/null
+++ b/devices/fossil-hoki/android-system-data.nix
@@ -0,0 +1,18 @@
+{ pkgs }:
+
+# Installs the Fossil Gen 6 Android 9 system and vendor data for libhybris.
+# Matches upstream AsteroidOS recipe:
+# AsteroidOS/meta-smartwatch: meta-hoki/recipes-android/android/android-system-data_hoki-p.bb
+pkgs.runCommand "android-system-data-hoki-p" { } ''
+  mkdir -p $out
+  ${pkgs.gnutar}/bin/tar -xzf ${
+    pkgs.fetchurl {
+      url = "https://dl.dropboxusercontent.com/s/1mmpew8kyn52jko/system-hoki-p.tar.gz";
+      hash = "sha256-FBagGo/RnpyCqgypveM9toU+sI9UEVkrSxeDZJcUF84=";
+    }
+  } -C $out
+
+  # GNSS vendor HAL symlink (matching AsteroidOS PR #342)
+  ln -sfn android.hardware.gnss@1.0-service-qti \
+    $out/vendor/bin/hw/android.hardware.gnss@1.0-service
+''
diff --git a/devices/fossil-hoki/default.nix b/devices/fossil-hoki/default.nix
index cc4fe5b8..4e92d679 100644
--- a/devices/fossil-hoki/default.nix
+++ b/devices/fossil-hoki/default.nix
@@ -7,6 +7,7 @@
 
 let
   hybrisAndroid = import ./hybris-android.nix { inherit pkgs; };
+  androidSystemData = import ./android-system-data.nix { inherit pkgs; };
 
   # Debug builds get Qt plugin/loader tracing in the compositor environment,
   # so a launcher dlopen/EGL failure is visible in the journal without
@@ -193,18 +194,10 @@ in
   mobile.quirks.fb-refresher.enable = lib.mkForce false;
 
   fileSystems = {
-    # AsteroidOS-style Pie stack: /system is the hal-droid Android 9 tree from
-    # the hybris tarball (installed as a rootfs symlink below) and the stock
-    # p32 vendor (also Pie) supplies the composer and the vendor HALs. The p31
-    # Android 11 system is no longer mounted.
-    "/vendor" = {
-      device = "/dev/disk/by-partlabel/vendor";
-      fsType = "ext4";
-      options = [
-        "ro"
-        "nofail"
-      ];
-    };
+    # Upstream AsteroidOS installs /system and /vendor directly into the rootfs
+    # from system-hoki-p.tar.gz rather than mounting an on-disk vendor partition.
+    # /vendor/bt_firmware and /vendor/firmware_mnt mount modem & bluetooth firmware
+    # onto mountpoints within /vendor.
     "/persist" = {
       device = "/dev/disk/by-partlabel/persist";
       fsType = "ext4";
@@ -252,9 +245,15 @@ in
   # makes /var -> /var/lib an unsafe ownership transition. Install the file in
   # the image instead so the launcher always sees QPA_HWC_*.
   mobile.generatedFilesystems.rootfs.populateCommands = lib.mkAfter ''
-    # AsteroidOS installs the hybris tarball's hal-droid system as /system and
-    # runs the hal-droid Android 9 init against it and the stock Pie vendor.
-    ln -sfn ${hybrisAndroid}/usr/libexec/hal-droid/system ./system
+    # AsteroidOS installs the hal-droid tree at /usr/libexec/hal-droid
+    mkdir -p ./usr/libexec
+    ln -sfn ${hybrisAndroid}/usr/libexec/hal-droid ./usr/libexec/hal-droid
+
+    # AsteroidOS installs the Fossil Gen 6 Android 9 system and vendor data
+    # Reference: meta-smartwatch meta-hoki/recipes-android/android/android-system-data_hoki-p.bb
+    mkdir -p ./system ./vendor
+    cp -a ${androidSystemData}/system/* ./system/
+    cp -a ${androidSystemData}/vendor/* ./vendor/
 
     mkdir -p ./var/lib/environment/compositor
     cp ${pkgs.writeText "20-device.conf" ''
@@ -340,7 +339,6 @@ in
   systemd.services.gnss-hoki = {
     description = "hoki GNSS vendor service symlink and AGPS assistance";
     after = [
-      "vendor.mount"
       "persist.mount"
     ];
     before = [ "android-init.service" ];
@@ -349,10 +347,6 @@ in
       Type = "oneshot";
       RemainAfterExit = true;
       ExecStart = pkgs.writeShellScript "gnss-hoki" ''
-        ${pkgs.util-linux}/bin/mount -o remount,rw /vendor || true
-        ${pkgs.coreutils}/bin/ln -sfn android.hardware.gnss@1.0-service-qti \
-          /vendor/bin/hw/android.hardware.gnss@1.0-service
-        ${pkgs.util-linux}/bin/mount -o remount,ro /vendor || true
         if [ -d /persist ]; then
           ${pkgs.coreutils}/bin/cp -f /etc/gps_xtra.ini /persist/gps_xtra.ini || true
         fi
diff --git a/devices/fossil-hoki/hybris.nix b/devices/fossil-hoki/hybris.nix
index 30fc1c0d..e3fc1259 100644
--- a/devices/fossil-hoki/hybris.nix
+++ b/devices/fossil-hoki/hybris.nix
@@ -38,7 +38,7 @@ in
           do
             if [ -e "$f" ]; then
               ${super.buildPackages.patchelf}/bin/patchelf \
-                --add-needed "$out/lib/libgralloc.so.1" "$f"
+                --add-needed "libgralloc.so.1" "$f"
             fi
           done
         '';
diff --git a/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
index 1762321c..2b3bba17 100644
--- a/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
+++ b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
@@ -107,6 +107,14 @@ stdenv.mkDerivation (finalAttrs: {
       --replace-fail 'Q_PLUGIN_METADATA(IID QPlatformIntegrationFactoryInterface_iid FILE "hwcomposer.json")' \
                      'Q_PLUGIN_METADATA(IID "org.qt-project.Qt.QPA.QPlatformIntegrationFactoryInterface.5.3" FILE "hwcomposer.json")'
 
+    substituteInPlace hwcomposer_backend.cpp \
+      --replace-fail 'pwr_module->init(pwr_module);' 'if (pwr_module->init) pwr_module->init(pwr_module);' \
+      --replace-fail 'pwr_module->powerHint(pwr_module, POWER_HINT_INTERACTION, NULL);' 'if (pwr_module->powerHint) pwr_module->powerHint(pwr_module, POWER_HINT_INTERACTION, NULL);'
+
+    substituteInPlace hwcomposer_backend_v20.cpp \
+      --replace-fail 'pwr_device->setInteractive(pwr_device, false);' 'if (pwr_device->setInteractive) pwr_device->setInteractive(pwr_device, false);' \
+      --replace-fail 'pwr_device->setInteractive(pwr_device, true);' 'if (pwr_device->setInteractive) pwr_device->setInteractive(pwr_device, true);'
+
     cat > CMakeLists.txt <<EOF
     cmake_minimum_required(VERSION 3.16)
     project(hwcomposer LANGUAGES CXX)
