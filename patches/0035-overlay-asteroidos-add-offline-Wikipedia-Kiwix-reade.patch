--- /dev/null
+++ b/overlay/asteroidos/kiwix/CMakeLists.txt
@@ -0,0 +1,58 @@
+cmake_minimum_required(VERSION 3.16)
+project(asteroid-kiwix LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+set(CMAKE_AUTOMOC ON)
+set(CMAKE_AUTORCC ON)
+
+find_package(Qt6 REQUIRED COMPONENTS Core Gui Qml Quick)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(LIBZIM REQUIRED libzim)
+
+add_executable(asteroid-kiwix
+    src/main.cpp
+    src/zimmanager.cpp
+    src/zimmanager.h
+    src/zimimageprovider.cpp
+    src/zimimageprovider.h
+    src/resources.qrc
+)
+
+target_include_directories(asteroid-kiwix PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/src
+    ${LIBZIM_INCLUDE_DIRS}
+)
+
+target_link_libraries(asteroid-kiwix PRIVATE
+    Qt6::Core
+    Qt6::Gui
+    Qt6::Qml
+    Qt6::Quick
+    ${LIBZIM_LIBRARIES}
+)
+
+include(GNUInstallDirs)
+
+install(TARGETS asteroid-kiwix
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
+
+install(FILES org.kiwix.desktop.desktop
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/applications
+)
+
+install(FILES org.kiwix.desktop.desktop
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/applications
+    RENAME asteroid-kiwix.desktop
+)
+
+install(FILES kiwix.svg
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps
+)
+
+install(FILES kiwix.svg
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps
+    RENAME asteroid-kiwix.svg
+)
diff --git a/overlay/asteroidos/kiwix/default.nix b/overlay/asteroidos/kiwix/default.nix
new file mode 100644
index 00000000..2581bb4b
--- /dev/null
+++ b/overlay/asteroidos/kiwix/default.nix
@@ -0,0 +1,86 @@
+{
+  lib,
+  stdenv,
+  cmake,
+  pkg-config,
+  qt6,
+  libzim,
+  qml-asteroid,
+  virtualkeyboard ? null,
+  qtvirtualkeyboard ? qt6.qtvirtualkeyboard,
+  buildPackages,
+}:
+
+let
+  isCross = !stdenv.buildPlatform.canExecute stdenv.hostPlatform;
+in
+stdenv.mkDerivation (finalAttrs: {
+  pname = "asteroid-kiwix";
+  version = "2.0.0";
+
+  src = ./.;
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  cmakeFlags = lib.optionals isCross [
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    libzim
+    qml-asteroid
+  ];
+
+  qtWrapperArgs = [
+    "--prefix"
+    "QML2_IMPORT_PATH"
+    ":"
+    "${qml-asteroid}/lib/qt-6/qml"
+    "--set-default"
+    "QT_IM_MODULE"
+    "qtvirtualkeyboard"
+    "--set-default"
+    "QT_VIRTUALKEYBOARD_STYLE"
+    "watch"
+  ]
+  ++ lib.optionals (qtvirtualkeyboard != null) [
+    "--prefix"
+    "QT_PLUGIN_PATH"
+    ":"
+    "${qtvirtualkeyboard}/lib/qt-6/plugins"
+    "--prefix"
+    "QML2_IMPORT_PATH"
+    ":"
+    "${qtvirtualkeyboard}/lib/qt-6/qml"
+  ]
+  ++ lib.optionals (virtualkeyboard != null) [
+    "--prefix"
+    "QML2_IMPORT_PATH"
+    ":"
+    "${virtualkeyboard}/lib/qt-6/qml"
+    "--set-default"
+    "QT_VIRTUALKEYBOARD_LAYOUT_PATH"
+    "${virtualkeyboard}/share/qtvirtualkeyboard/layouts"
+    "--set-default"
+    "RIME_SHARED_DATA_DIR"
+    "${virtualkeyboard}/share/rime-data"
+  ];
+
+  meta = with lib; {
+    description = "Native lightweight offline Wikipedia and ZIM reader for AsteroidOS powered by libzim with virtual keyboard search";
+    homepage = "https://www.kiwix.org/";
+    license = licenses.gpl3Plus;
+    platforms = platforms.linux;
+    mainProgram = "asteroid-kiwix";
+  };
+})
