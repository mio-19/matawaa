diff --git a/overlay/asteroidos/kiwix/src/main.cpp b/overlay/asteroidos/kiwix/src/main.cpp
new file mode 100644
index 00000000..dcbaae3d
--- /dev/null
+++ b/overlay/asteroidos/kiwix/src/main.cpp
@@ -0,0 +1,43 @@
+#include <QGuiApplication>
+#include <QQmlApplicationEngine>
+#include <QQmlContext>
+#include <QIcon>
+#include "zimmanager.h"
+#include "zimimageprovider.h"
+
+int main(int argc, char *argv[])
+{
+    qputenv("QT_QUICK_CONTROLS_STYLE", "Asteroid");
+    qputenv("QT_IM_MODULE", "qtvirtualkeyboard");
+    qputenv("QT_VIRTUALKEYBOARD_STYLE", "watch");
+
+    QGuiApplication app(argc, argv);
+    app.setApplicationName(QStringLiteral("asteroid-kiwix"));
+    app.setApplicationDisplayName(QStringLiteral("Kiwix"));
+    app.setOrganizationName(QStringLiteral("AsteroidOS"));
+    app.setWindowIcon(QIcon::fromTheme(QStringLiteral("kiwix")));
+
+    ZimManager zimManager;
+
+    QQmlApplicationEngine engine;
+    engine.addImageProvider(QStringLiteral("zim"), new ZimImageProvider(&zimManager));
+    engine.rootContext()->setContextProperty(QStringLiteral("zimManager"), &zimManager);
+
+    // Initial scan and load
+    if (argc > 1 && QString::fromLocal8Bit(argv[1]).endsWith(QStringLiteral(".zim"))) {
+        zimManager.openArchive(QString::fromLocal8Bit(argv[1]));
+    } else {
+        zimManager.scanArchives();
+    }
+
+    const QUrl url(QStringLiteral("qrc:/qml/main.qml"));
+    QObject::connect(&engine, &QQmlApplicationEngine::objectCreated,
+                     &app, [url](QObject *obj, const QUrl &objUrl) {
+        if (!obj && url == objUrl)
+            QCoreApplication::exit(-1);
+    }, Qt::QueuedConnection);
+
+    engine.load(url);
+
+    return app.exec();
+}
diff --git a/overlay/asteroidos/kiwix/src/qml/ArticlePage.qml b/overlay/asteroidos/kiwix/src/qml/ArticlePage.qml
new file mode 100644
index 00000000..557a1944
--- /dev/null
+++ b/overlay/asteroidos/kiwix/src/qml/ArticlePage.qml
@@ -0,0 +1,125 @@
+import QtQuick
+import org.asteroid.controls
+import org.asteroid.utils
+
+Item {
+    id: articlePage
+    anchors.fill: parent
+
+    Column {
+        anchors.fill: parent
+
+        // Top Control Bar
+        Item {
+            id: headerBar
+            width: parent.width
+            height: Dims.h(14)
+
+            Row {
+                anchors.left: parent.left
+                anchors.leftMargin: DeviceSpecs.hasRoundScreen ? Dims.w(8) : Dims.w(3)
+                anchors.verticalCenter: parent.verticalCenter
+                spacing: Dims.w(1.5)
+
+                IconButton {
+                    width: Dims.w(9)
+                    height: width
+                    iconName: "ios-arrow-back"
+                    onClicked: {
+                        if (zimManager.canGoBack) {
+                            zimManager.goBack()
+                        } else {
+                            layerStack.pop()
+                        }
+                    }
+                }
+
+                IconButton {
+                    width: Dims.w(8)
+                    height: width
+                    iconName: "ios-arrow-forward"
+                    opacity: zimManager.canGoForward ? 1.0 : 0.3
+                    onClicked: {
+                        if (zimManager.canGoForward) {
+                            zimManager.goForward()
+                        }
+                    }
+                }
+            }
+
+            Text {
+                anchors.centerIn: parent
+                width: parent.width * 0.42
+                text: zimManager.currentTitle || "Article"
+                color: "#FFFFFF"
+                font.pixelSize: Dims.l(3.4)
+                font.bold: true
+                elide: Text.ElideRight
+                horizontalAlignment: Text.AlignHCenter
+            }
+
+            Row {
+                anchors.right: parent.right
+                anchors.rightMargin: DeviceSpecs.hasRoundScreen ? Dims.w(8) : Dims.w(3)
+                anchors.verticalCenter: parent.verticalCenter
+                spacing: Dims.w(1.5)
+
+                IconButton {
+                    width: Dims.w(9)
+                    height: width
+                    iconName: "ios-search"
+                    onClicked: layerStack.push(searchPageComponent)
+                }
+
+                IconButton {
+                    width: Dims.w(9)
+                    height: width
+                    iconName: "ios-albums-outline"
+                    onClicked: layerStack.push(libraryPageComponent)
+                }
+            }
+        }
+
+        // Article Content Scroll Area
+        Flickable {
+            id: flickable
+            width: parent.width
+            height: parent.height - headerBar.height
+            clip: true
+            contentWidth: width
+            contentHeight: articleText.implicitHeight + (DeviceSpecs.hasRoundScreen ? Dims.h(16) : Dims.h(8))
+            boundsBehavior: Flickable.DragOverBounds
+
+            WheelHandler {
+                target: flickable
+                orientation: Qt.Vertical
+                acceptedDevices: PointerDevice.AllDevices
+                onWheel: function(event) {
+                    var delta = event.angleDelta.y !== 0 ? event.angleDelta.y : event.angleDelta.x
+                    if (delta > 0) {
+                        flickable.contentY = Math.max(flickable.contentY - Dims.h(10), 0)
+                    } else if (delta < 0) {
+                        var maxY = Math.max(0, flickable.contentHeight - flickable.height)
+                        flickable.contentY = Math.min(flickable.contentY + Dims.h(10), maxY)
+                    }
+                }
+            }
+
+            Text {
+                id: articleText
+                width: flickable.width - (DeviceSpecs.hasRoundScreen ? Dims.w(14) : Dims.w(6))
+                anchors.horizontalCenter: parent.horizontalCenter
+                anchors.top: parent.top
+                anchors.topMargin: Dims.h(2)
+                textFormat: Text.RichText
+                text: zimManager.currentHtml
+                wrapMode: Text.Wrap
+                color: "#FFFFFF"
+                onLinkActivated: function(link) {
+                    zimManager.openPath(link)
+                    flickable.contentY = 0
+                }
+            }
+        }
+    }
+}
