     noUsrShareHook
   ]
   ++ lib.optionals (!isCross) [
@@ -100,7 +105,8 @@ stdenv.mkDerivation (finalAttrs: {
     if [ -d "$out/bin" ]; then
       find "$out/bin" -type f -exec sed -i "s|\\bexec invoker\\b|exec ${mapplauncherd}/bin/invoker|g" {} +
     fi
-  '';
+  ''
+  + postFixup;
 
   meta =
     with lib;
@@ -112,4 +118,4 @@ stdenv.mkDerivation (finalAttrs: {
       platforms = platforms.linux;
     }
     // meta;
-})
+}
