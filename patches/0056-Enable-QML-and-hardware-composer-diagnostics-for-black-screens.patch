++// Composition diagnostics (Matawaa debug builds).
++//
++// QPA_HWC_FORCE_GLES=1 (upstream meta-hoki 20-device.conf) hands the
++// compositor's gralloc buffers straight to the display HAL. When the vendor
++// MDP rejects those buffers the only symptom is a black screen: the scene
++// graph still reports rendered frames, so nothing in Qt's own logging points
++// at the display path. QPA_HWC_DEBUG=1 logs the buffer handle and every HWC2
++// return code, which is what identifies a failing buffer import.
++static bool hwcDebugEnabled()
++{
++    static const bool enabled = qEnvironmentVariableIsSet("QPA_HWC_DEBUG");
++    return enabled;
++}
++
++static const char *hwcErrorName(hwc2_error_t error)
++{
++    switch (error) {
++    case HWC2_ERROR_NONE: return "NONE";
++    case HWC2_ERROR_BAD_CONFIG: return "BAD_CONFIG";
++    case HWC2_ERROR_BAD_DISPLAY: return "BAD_DISPLAY";
++    case HWC2_ERROR_BAD_LAYER: return "BAD_LAYER";
++    case HWC2_ERROR_BAD_PARAMETER: return "BAD_PARAMETER";
++    case HWC2_ERROR_HAS_CHANGES: return "HAS_CHANGES";
++    case HWC2_ERROR_NO_RESOURCES: return "NO_RESOURCES";
++    case HWC2_ERROR_NOT_VALIDATED: return "NOT_VALIDATED";
++    case HWC2_ERROR_UNSUPPORTED: return "UNSUPPORTED";
++    default: return "UNKNOWN";
++    }
++}
++
++static void hwcLogBuffer(const char *what, int index,
++                         HWComposerNativeWindowBuffer *buffer, int acquireFenceFd)
++{
++    if (!hwcDebugEnabled())
++        return;
++
++    const native_handle_t *handle = buffer ? buffer->handle : nullptr;
++    qDebug("hwc: %s #%d buffer=%p %ux%u stride=%d format=0x%x usage=0x%llx "
++           "handleFds=%d handleFd0=%d acquireFence=%d",
++           what, index, static_cast<void *>(buffer),
++           buffer ? buffer->width : 0u, buffer ? buffer->height : 0u,
++           buffer ? buffer->stride : 0, buffer ? buffer->format : 0,
++           buffer ? static_cast<unsigned long long>(buffer->usage) : 0ULL,
++           handle ? handle->numFds : -1,
++           (handle && handle->numFds > 0) ? handle->data[0] : -1,
++           acquireFenceFd);
++}
++
+ void hwc2_callback_hotplug(HWC2EventListener* listener, int32_t sequenceId,
+                            hwc2_display_t display, bool connected,
+                            bool primaryDisplay)
+@@ -167,6 +215,11 @@
+ 
+     int acquireFenceFd = getFenceBufferFd(buffer);
+ 
++    static int presentCount = 0;
++    const int presentIndex = presentCount++;
++    if (presentIndex < 5 || (presentIndex % 300) == 0)
++        hwcLogBuffer("present", presentIndex, buffer, acquireFenceFd);
++
+     if (m_syncBeforeSet && acquireFenceFd >= 0) {
+         sync_wait(acquireFenceFd, -1);
+         close(acquireFenceFd);
+@@ -182,33 +235,48 @@
+     error = hwc2_compat_display_validate(hwcDisplay, &numTypes,
+                                                     &numRequests);
+     if (error != HWC2_ERROR_NONE && error != HWC2_ERROR_HAS_CHANGES) {
+-        qDebug("prepare: validate failed for display %d: %d", displayId, error);
++        qWarning("hwc: validate failed for display %d: %s (%d), frame dropped",
++                 displayId, hwcErrorName(error), error);
+         return;
+     }
+ 
+     if (numTypes || numRequests) {
+-        qDebug("prepare: validate required changes for display %d: %d",
+-               displayId, error);
++        qDebug("hwc: validate requested changes for display %d: %s (%d), "
++               "types=%u requests=%u, frame dropped",
++               displayId, hwcErrorName(error), error, numTypes, numRequests);
+         return;
+     }
+ 
+     error = hwc2_compat_display_accept_changes(hwcDisplay);
+     if (error != HWC2_ERROR_NONE) {
+-        qDebug("prepare: acceptChanges failed: %d", error);
++        qWarning("hwc: accept_changes failed: %s (%d), frame dropped",
++                 hwcErrorName(error), error);
+         return;
+     }
+ 
+     QPA_HWC_TIMING_SAMPLE(prepareTime);
+ 
+     QSystrace::begin("graphics", "QPA::set_client_target", "");
+-    hwc2_compat_display_set_client_target(hwcDisplay, /* slot */0, buffer,
+-                                          acquireFenceFd,
+-                                          HAL_DATASPACE_UNKNOWN);
++    const hwc2_error_t setTargetError =
++        hwc2_compat_display_set_client_target(hwcDisplay, /* slot */0, buffer,
++                                              acquireFenceFd,
++                                              HAL_DATASPACE_UNKNOWN);
+     QSystrace::end("graphics", "QPA::set_client_target", "");
++    if (setTargetError != HWC2_ERROR_NONE) {
++        qWarning("hwc: set_client_target failed: %s (%d), buffer fd=%d",
++                 hwcErrorName(setTargetError), setTargetError,
++                 (buffer && buffer->handle && buffer->handle->numFds > 0)
++                     ? buffer->handle->data[0] : -1);
++    }
+ 
+     QSystrace::begin("graphics", "QPA::present", "");
+     int presentFence = -1;
+-    hwc2_compat_display_present(hwcDisplay, &presentFence);
++    const hwc2_error_t presentError =
++        hwc2_compat_display_present(hwcDisplay, &presentFence);
++    if (presentError != HWC2_ERROR_NONE) {
++        qWarning("hwc: present failed: %s (%d)",
++                 hwcErrorName(presentError), presentError);
++    }
+     QSystrace::end("graphics", "QPA::present", "");
+ 
+     QPA_HWC_TIMING_SAMPLE(setTime);
+@@ -221,6 +289,9 @@
+     lastPresentFence = presentFence != -1 ? dup(presentFence) : -1;
+ 
+     setFenceBufferFd(buffer, presentFence);
++
++    if (hwcDebugEnabled() && (presentIndex < 5 || (presentIndex % 300) == 0))
++        qDebug("hwc: present #%d done, fence=%d", presentIndex, presentFence);
+ 
+     if (m_dozeWorkaround && m_backend->isDozing()) {
+         hwc2_compat_display_set_power_mode(hwcDisplay, HWC2_POWER_MODE_DOZE_SUSPEND);
+@@ -263,6 +334,17 @@
+     }
+     HWC_PLUGIN_ASSERT_NOT_NULL(hwc2_primary_display);
+ 
++    if (hwcDebugEnabled()) {
++        HWC2DisplayConfig *config =
++            hwc2_compat_display_get_active_config(hwc2_primary_display);
++        qDebug("hwc: primary display id=%" PRIu64 " config=%dx%d "
++               "vsyncPeriod=%" PRId64 " dpi=%.1fx%.1f",
++               static_cast<uint64_t>(procs->primaryDisplayId),
++               config ? config->width : 0, config ? config->height : 0,
++               config ? config->vsyncPeriod : int64_t(0),
++               config ? config->dpiX : 0.0, config ? config->dpiY : 0.0);
++    }
++
+     sleepDisplay(false);
+ }
+ 
+@@ -309,6 +391,10 @@
+                                          HAL_PIXEL_FORMAT_RGBA_8888,
+                                          hwc2_primary_display, layer, this);
+ 
++    if (hwcDebugEnabled())
++        qDebug("hwc: window %dx%d format=0x%x layer=%p", width, height,
++               HAL_PIXEL_FORMAT_RGBA_8888, static_cast<void *>(layer));
++
+     return (EGLNativeWindowType) static_cast<ANativeWindow *>(hwc_win);
+ }
+ 
+@@ -325,7 +411,9 @@
+     timer.start();
+ #endif
+ 
+-    eglSwapBuffers(display, surface);
++    const EGLBoolean swapped = eglSwapBuffers(display, surface);
++    if (hwcDebugEnabled() && swapped != EGL_TRUE)
++        qWarning("hwc: eglSwapBuffers failed: 0x%x", eglGetError());
+ 
+ #ifdef QPA_HWC_TIMING
+     qDebug("HWComposerBackend::swap(), present=%.3f, sync=%.3f, prepare=%.3f, set=%.3f, total=%.3f",
