From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sat, 31 Oct 2026 00:09:12 +1100
Subject: [PATCH] Enable QML and hardware composer diagnostics for black
 screens

---
 examples/asteroid/asteroid-desktop.nix        |   7 +-
 .../qt6-qpa-hwcomposer-plugin/default.nix     |   1 +
 .../hwc-present-diagnostics.patch             | 204 ++++++++++++++++++
 3 files changed, 211 insertions(+), 1 deletion(-)
 create mode 100644 overlay/asteroidos/qt6-qpa-hwcomposer-plugin/hwc-present-diagnostics.patch

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index 3b47d97a..cb1b0dcb 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -653,13 +653,18 @@ in
         # import/instantiation errors and the QML_IMPORT_TRACE output are
         # reported, so keep `default` warnings and debug on; otherwise a black
         # screen leaves nothing but renderloop chatter in launcher.log.
-        QT_LOGGING_RULES = "*=false;default.warning=true;default.debug=true;qt.qml.*=true;qt.qpa.*=true;qt.waylandcompositor.*=true;qt.scenegraph.*=true;qt.core.plugin.*=true";
+        # QML `console.log/info` (and QML runtime warnings) are logged under the
+        # plain `qml` category, so `*=false` silences them as well: the
+        # diagnostics below would never reach launcher.log without enabling that
+        # category explicitly. `qt.qml.*` only covers its subcategories.
+        QT_LOGGING_RULES = "*=false;default.warning=true;default.debug=true;qml.debug=true;qml.info=true;qml.warning=true;qml.critical=true;qt.qml.*=true;qt.qpa.*=true;qt.waylandcompositor.*=true;qt.scenegraph.*=true;qt.core.plugin.*=true";
         QT_DEBUG_PLUGINS = "1";
         # Log every QML import attempt (module, version, and the directory each
         # candidate was looked up in) plus the scene graph the renderer picked.
         # Both are runtime switches; a missing QML module shows up here as a
         # failing import line even before any component error is printed.
         QML_IMPORT_TRACE = "1";
+        QPA_HWC_DEBUG = "1";
         QSG_INFO = "1";
         EGL_LOG_LEVEL = "debug";
         LIBGL_DEBUG = "verbose";
diff --git a/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
index 9b3ef899..b4cd0f72 100644
--- a/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
+++ b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
@@ -75,6 +75,7 @@ stdenv.mkDerivation (finalAttrs: {
     (patch "0005-Explicitly-make-hwcomposer-a-shared-library.patch" "sha256-Z/zjAhKm6XRQ8zVuSYPiD+rDh7KqZuKzTiUAzmsu+ZE=")
     (patch "0006-v10-Fix-refresh-rate-fallback-unit.patch" "sha256-XOplqx7zKgbjPWIwlJ82O1qFDXXNkj2PDO/TdaP/ync=")
     (patch "0007-v10-Make-updates-request-driven-and-vsync-paced.patch" "sha256-EQhs66R9Vc2a2yH5zVmo8xtC+oVQHjMlKyNAIGrEsbA=")
+    ./hwc-present-diagnostics.patch
   ];
 
   strictDeps = true;
diff --git a/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/hwc-present-diagnostics.patch b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/hwc-present-diagnostics.patch
new file mode 100644
index 00000000..fb5f9bd6
