From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 23:13:18 +1100
Subject: [PATCH] overlay/systemd-257: expose withLogind for the NixOS 26.11
 module

The vendored 257 package predates the withLogind package attribute that current NixOS assertions inspect.
---
 overlay/systemd-257/default.nix | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/overlay/systemd-257/default.nix b/overlay/systemd-257/default.nix
index 303efba3..b704fccd 100644
--- a/overlay/systemd-257/default.nix
+++ b/overlay/systemd-257/default.nix
@@ -890,6 +890,10 @@ stdenv.mkDerivation (finalAttrs: {
     # needed - and therefore `interfaceVersion` should be incremented.
     interfaceVersion = 2;
 
+    # NixOS 26.11 checks this package attribute even though the vendored
+    # systemd 257 definition predates it.
+    withLogind = true;
+
     inherit
       withBootloader
       withCryptsetup
