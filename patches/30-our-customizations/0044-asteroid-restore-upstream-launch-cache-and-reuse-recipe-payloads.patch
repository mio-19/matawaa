diff --git a/overlay/asteroidos/mapplauncherd-qt/default.nix b/overlay/asteroidos/mapplauncherd-qt/default.nix
new file mode 100644
index 00000000..d3856a23
--- /dev/null
+++ b/overlay/asteroidos/mapplauncherd-qt/default.nix
@@ -0,0 +1,92 @@
+# Match meta-asteroid's mapplauncherd-qt recipe, including its Qt 6 source pin.
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  pkg-config,
+  qt6,
+  mapplauncherd,
+  glib,
+  libffi,
+  sqlite,
+  libxml2,
+  metaAsteroidSrc,
+  buildPackages,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "mapplauncherd-qt";
+  version = "0-unstable-2026-03-28";
+
+  src = fetchFromGitHub {
+    owner = "neochapay";
+    repo = "mapplauncherd-qt";
+    rev = "956e42079a1970c7393752488c2169356f6fc8db";
+    hash = "sha256-I/+7XmRH7agX4udu10BFd3t5DiVrLdwQNPRrvdss8O4=";
+  };
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    mapplauncherd
+    glib
+    libffi
+    sqlite
+    libxml2
+  ];
+
+  postPatch = ''
+    substituteInPlace qtbooster/qtbooster.pro \
+      --replace-fail '/usr/libexec/mapplauncherd/' "$out/libexec/mapplauncherd/"
+    substituteInPlace mdeclarativecache/mdeclarativecache.pro \
+      --replace-fail '$$[QT_INSTALL_LIBS]' "$out/lib" \
+      --replace-fail '$$[QT_INSTALL_PREFIX]/include' "$out/include"
+    substituteInPlace data/data.pro \
+      --replace-fail '$$[QT_INSTALL_DATA]/mkspecs/features' "$out/mkspecs/features" \
+      --replace-fail '$$[QT_INSTALL_LIBS]/pkgconfig' "$out/lib/pkgconfig" \
+      --replace-fail '/usr/lib/systemd/user/' "$out/lib/systemd/user/" \
+      --replace-fail 'services.files = booster-qt$''${QT_MAJOR_VERSION}.service booster-qt$''${QT_MAJOR_VERSION}-signal.service' \
+                     'services.files = booster-qt$''${QT_MAJOR_VERSION}.service' \
+      --replace-fail 'services.files += booster-qt$''${QT_MAJOR_VERSION}@.service' ""
+    substituteInPlace data/pkgconfig/qdeclarative6-boostable.pc.in \
+      --replace-fail '-lmdeclarativecache6' "-L$out/lib -lmdeclarativecache6" \
+      --replace-fail '/usr/include/mdeclarativecache6' "$out/include/mdeclarativecache6"
+    substituteInPlace data/mkspecs/features/qdeclarative-boostable.prf \
+      --replace-fail qdeclarative5-boostable qdeclarative6-boostable
+    substituteInPlace data/mkspecs/features/qt-boostable.prf \
+      --replace-fail qt5-boostable qt6-boostable
+    cp ${metaAsteroidSrc}/recipes-nemomobile/mapplauncherd/mapplauncherd-qt/booster-qt6.service data/booster-qt6.service
+    substituteInPlace data/booster-qt6.service \
+      --replace-fail /usr/libexec/mapplauncherd/ "$out/libexec/mapplauncherd/" \
+      --replace-fail 'Wants=booster-qt6-signal.service' ""
+  '';
+
+  # The vendored cross Qt omits its target qmake wrapper. Run the build Qt's
+  # qmake with target module metadata and explicit target tools instead.
+  configurePhase = ''
+    runHook preConfigure
+    export QMAKEPATH="${qt6.qtbase.dev}:${qt6.qtdeclarative.dev}"
+    ${buildPackages.qt6.qtbase}/bin/qmake -early \
+      "VERSION=${finalAttrs.version}" \
+      "QMAKE_CC=$CC" "QMAKE_CXX=$CXX" "QMAKE_LINK=$CXX" \
+      "QMAKE_AR=$AR cqs" "QMAKE_STRIP=$STRIP" \
+      "QMAKE_PKG_CONFIG=$PKG_CONFIG"
+    runHook postConfigure
+  '';
+
+  enableParallelBuilding = true;
+
+  meta = {
+    description = "Qt 6 application launch cache and booster for mapplauncherd";
+    homepage = "https://github.com/neochapay/mapplauncherd-qt";
+    license = lib.licenses.lgpl21Only;
+    platforms = lib.platforms.linux;
+  };
+})
