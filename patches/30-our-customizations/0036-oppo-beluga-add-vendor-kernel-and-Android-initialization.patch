+ #define ARM_CPU_PART_KRYO2XX_GOLD		0x51008000
+ #define ARM_CPU_PART_MASK		0xff00fff0
diff --git a/devices/oppo-beluga/kernel/0002-futex-carry-the-exit-path-to-the-4.9.255-API.patch b/devices/oppo-beluga/kernel/0002-futex-carry-the-exit-path-to-the-4.9.255-API.patch
new file mode 100644
index 00000000..b336077e
--- /dev/null
+++ b/devices/oppo-beluga/kernel/0002-futex-carry-the-exit-path-to-the-4.9.255-API.patch
@@ -0,0 +1,62 @@
+diff --git a/kernel/exit.c b/kernel/exit.c
+--- a/kernel/exit.c
++++ b/kernel/exit.c
+@@ -471,7 +471,7 @@
+ 	struct core_state *core_state;
+ 	int mm_released;
+ 
+-	mm_release(tsk, mm);
++	exit_mm_release(tsk, mm);
+ 	if (!mm)
+ 		return;
+ 	sync_mm_rss(mm);
+@@ -779,16 +779,7 @@
+ #else
+ 		pr_alert("Fixing recursive fault but reboot is needed!\n");
+ #endif
+-		/*
+-		 * We can do this unlocked here. The futex code uses
+-		 * this flag just to verify whether the pi state
+-		 * cleanup has been done or not. In the worst case it
+-		 * loops once more. We pretend that the cleanup was
+-		 * done as there is no way to return. Either the
+-		 * OWNER_DIED bit is set by now or we push the blocked
+-		 * task into the wait for ever nirwana as well.
+-		 */
+-		tsk->flags |= PF_EXITPIDONE;
++		futex_exit_recursive(tsk);
+ 		set_current_state(TASK_UNINTERRUPTIBLE);
+ 		schedule();
+ 	}
+@@ -798,17 +789,6 @@
+ 	sched_exit(tsk);
+ 	schedtune_exit_task(tsk);
+ 
+-	/*
+-	 * Ensure that all new tsk->pi_lock acquisitions must observe
+-	 * PF_EXITING. Serializes against futex.c:attach_to_pi_owner().
+-	 */
+-	smp_mb();
+-	/*
+-	 * Ensure that we must observe the pi_state in exit_mm() ->
+-	 * mm_release() -> exit_pi_state_list().
+-	 */
+-	raw_spin_unlock_wait(&tsk->pi_lock);
+-
+ 	if (unlikely(in_atomic())) {
+ 		pr_info("note: %s[%d] exited with preempt_count %d\n",
