diff --git a/devices/oppo-beluga/kernel/default.nix b/devices/oppo-beluga/kernel/default.nix
new file mode 100644
index 00000000..ddc617f0
--- /dev/null
+++ b/devices/oppo-beluga/kernel/default.nix
@@ -0,0 +1,877 @@
+{
+  lib,
+  mobile-nixos,
+  stdenv,
+  stdenvNoCC,
+  cacert,
+  cpio,
+  curl,
+  fetchgit,
+  fetchurl,
+  runCommand,
+  xz,
+  ...
+}:
+
+# OPPO Watch (beluga) uses the 4.9 msm8909w vendor kernel from AsteroidOS
+# meta-smartwatch. The recipe inherits kernel-gcc8; gcc >= 13 does not boot.
+# Source: https://github.com/AsteroidOS/meta-smartwatch/tree/085844a91fd23691f55d8ac08bc3e4c0a8429936/meta-beluga/recipes-kernel/linux
+let
+  # Same pinned GCC 8 cross compiler used by the hoki vendor kernel.
+  pkgsGcc8 = import (builtins.fetchGit {
+    url = "https://github.com/NixOS/nixpkgs.git";
+    rev = "b134951a4c9f3c995fd7be05f3243f8ecd65d798";
+    shallow = true;
+  }) { system = stdenv.buildPlatform.system; };
+
+  cc8 = pkgsGcc8.pkgsCross.armv7l-hf-multiplatform.buildPackages.gcc8;
+
+  stdenvGcc8 = stdenv.override {
+    allowedRequisites = null;
+    cc = cc8;
+    hasCC = true;
+  };
+
+  kernel-builder-gcc8 = mobile-nixos.kernel-builder.override {
+    stdenv = stdenvGcc8;
+  };
+
+  asteroidos = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/085844a91fd23691f55d8ac08bc3e4c0a8429936/meta-beluga/recipes-kernel/linux";
+
+  upstreamDefconfig = fetchurl {
+    url = "${asteroidos}/linux-beluga/defconfig";
+    hash = "sha256-3ZwmXssSXDYkgZ7c1LfErS2ouqrN8NwOtqnUgE6sXes=";
+  };
+
+  upstreamPatch =
+    name: hash:
+    fetchurl {
+      url = "${asteroidos}/files/${name}";
+      inherit hash;
+    };
+
+  # kernel.org's .xz increments are not byte-reproducible: re-encoding with a
+  # newer xz changes the compressed file. Pin the decompressed patch text
+  # instead, so the hash follows only what the kernel actually gets.
+  fetchXzPatch =
+    {
+      name,
+      url,
+      hash,
+    }:
+    stdenvNoCC.mkDerivation {
+      inherit name;
+      nativeBuildInputs = [
+        curl
+        xz
+      ];
+      outputHashAlgo = "sha256";
+      outputHashMode = "flat";
+      outputHash = hash;
+      SSL_CERT_FILE = "${cacert}/etc/ssl/certs/ca-bundle.crt";
+      buildCommand = ''
+        curl --fail --location --silent --show-error \
+          --retry 8 --retry-all-errors --retry-delay 3 ${url} | xz -dc > "$out"
+      '';
+    };
+
+  # One stable increment. The Makefile hunk is dropped because the version is
+  # set once in postPatch, and this kernel is 32-bit ARM only, so changes for
+  # other architectures are dropped as well.
+  stableIncr =
+    lo: hi: hash: excludes:
+    let
+      name = "linux-4.9.${lo}-${hi}.patch";
+      adaptation = ./stable/${name}.patch;
+      hasAdaptation = builtins.pathExists adaptation;
+      otherArches = "arch/(alpha|arc|arm64|avr32|blackfin|c6x|cris|frv|h8300|hexagon|ia64|m32r|m68k|metag|microblaze|mips|mn10300|nios2|openrisc|parisc|powerpc|s390|score|sh|sparc|tile|um|unicore32|x86|xtensa)/.*";
+      droppedFiles = lib.concatStringsSep "|" (
+        [
+          "Makefile"
+          otherArches
+        ]
+        ++ map lib.escapeRegex excludes
+      );
+    in
+    runCommand name
+      (
+        {
+          nativeBuildInputs = [ xz ];
+          patchText = fetchXzPatch {
+            inherit name hash;
+            url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.9.${lo}-${hi}.xz";
+          };
+          inherit droppedFiles;
+        }
+        // lib.optionalAttrs hasAdaptation { inherit adaptation; }
+      )
+      ''
+        awk -v dropped="$droppedFiles" '
+          /^diff --git / { skip = ($3 ~ "^a/(" dropped ")$") }
+          !skip { print }
+        ' "$patchText" > "${name}"
+        ${lib.optionalString hasAdaptation ''
+          patch -p1 --batch -i "$adaptation"
+        ''}
+        cp "${name}" "$out"
+      '';
+
+  stablePatch113 = stableIncr "112" "113" "sha256-mszs8KHGW9sHfFDq66P4GcIp5S7i/unp4bTU+KdtcvM=" [ ];
+
+  configfile = runCommand "oppo-beluga-defconfig" { inherit upstreamDefconfig; } ''
+    cp "$upstreamDefconfig" "$out"
+  '';
+in
+kernel-builder-gcc8 {
+  version = "4.9.337";
+  inherit configfile;
+
+  postPatch = ''
+    sed -i 's/^SUBLEVEL = 112/SUBLEVEL = 337/' Makefile
