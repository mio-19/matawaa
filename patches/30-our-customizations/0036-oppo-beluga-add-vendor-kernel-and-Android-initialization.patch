+          inherit droppedFiles;
+        }
+        // lib.optionalAttrs hasAdaptation { inherit adaptation; }
+      )
+      ''
+        awk -v dropped="$droppedFiles" '
+          /^diff --git / { skip = ($3 ~ "^a/(" dropped ")$") }
+          !skip { print }
+        ' "$patchText" > "${name}"
+        ${lib.optionalString hasAdaptation ''
+          patch -p1 --batch -i "$adaptation"
+        ''}
+        cp "${name}" "$out"
+      '';
