+  # This defconfig sets CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE, so the bootable
+  # image is arch/arm/boot/zImage-dtb (the built MSM8909 DTBs concatenated).
+  # The builder installs the bare zImage, which has no FDT. Do not add
+  # zImage-dtb to buildFlags: it shares arch/arm/boot/compressed with zImage,
+  # and a parallel make races. Build it serially after install instead.
+  # This tree has no dtbs_install target.
+  buildDTBs = false;
+  postInstall = ''
+    make $makeFlags "''${makeFlagsArray[@]}" zImage-dtb
+    cp -f "$buildRoot/arch/arm/boot/zImage-dtb" "$out/zImage"
+  '';
