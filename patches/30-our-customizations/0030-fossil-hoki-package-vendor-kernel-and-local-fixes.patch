+    (stableIncr "231-232" "sha256-p1W2eMItt4Xo5HlT9jTjVQpxu4k7Z0bJFe1g0O7w0Yo=" [
+      "arch/arm64/include/asm/alternative.h"
+      "drivers/usb/usbip/vudc_sysfs.c"
