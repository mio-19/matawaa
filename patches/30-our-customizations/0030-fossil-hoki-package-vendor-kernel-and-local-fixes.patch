+    # wakeup rework, f_uac1 option validation, the usb_string_copy fix,
+    # USB_AUDIO_IFACE_UNUSED, the mmc power cycle after a failed CMD11, and its
+    # own nfc llcp error paths.
+    (stableIncr "232-233" "sha256-UulKIYdVhrMyHuS8YZIlNU5E5/RXaYgeaBMCtf18F4I=" [
+      "drivers/mmc/core/core.c"
+      "drivers/usb/core/hub.c"
+      "drivers/usb/dwc3/gadget.c"
+      "drivers/usb/gadget/config.c"
+      "drivers/usb/gadget/function/f_uac1.c"
+      "drivers/usb/usbip/vudc_sysfs.c"
+      "net/nfc/llcp_sock.c"
+      "sound/usb/usbaudio.h"
+    ])
+    (stableIncr "233-234" "sha256-uHMi63C+rkgGksoAtvLBm9dQDFqmDrrf+WjG3SXk9qU=" [ ])
+    # Vendor already enables DEVTEN_EOPFEN for 2.30a and frees the dequeued
