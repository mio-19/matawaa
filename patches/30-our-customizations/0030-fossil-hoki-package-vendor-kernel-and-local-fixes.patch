diff --git a/devices/fossil-hoki/kernel/0007-pcm_native-guard-pm_qos_remove_request-with-active-.patch b/devices/fossil-hoki/kernel/0007-pcm_native-guard-pm_qos_remove_request-with-active-.patch
new file mode 100644
index 00000000..cd5c429b
--- /dev/null
+++ b/devices/fossil-hoki/kernel/0007-pcm_native-guard-pm_qos_remove_request-with-active-.patch
@@ -0,0 +1,40 @@
+From: pettcomputers <chris@pettcomputers.com>
+Date: Tue, 2 Sep 2026 00:00:00 -0500
+Subject: [PATCH] pcm_native: guard pm_qos_remove_request with an active check
+ in snd_pcm_hw_free
+
+snd_pcm_hw_free() calls pm_qos_remove_request() unconditionally, while
+two other call sites in this same file (snd_pcm_release_substream and
+snd_pcm_hw_params) correctly guard the equivalent remove call with
+pm_qos_request_active() first. If hw_params ever skips its own
+conditional pm_qos_add_request() (a real, reachable path on hoki via
+the "Tertiary MI2S TX Hostless" PCM device, which never gets a real
+stream opened against it), hw_free's unconditional remove fires
+against a request that was never added, producing a kernel warning
+with a full backtrace.
+
+Found while debugging audio capture on hoki (Skagen Falster Gen 6) -
+see https://github.com/AsteroidOS/meta-smartwatch (audio bring-up).
+Confirmed via direct before/after dmesg comparison that the warning
+and backtrace are gone after this change, both immediately post-boot
+and after a settled retest.
+
+Signed-off-by: pettcomputers <chris@pettcomputers.com>
+---
+ sound/core/pcm_native.c | 1 +
+ 1 file changed, 1 insertion(+)
+
+diff --git a/sound/core/pcm_native.c b/sound/core/pcm_native.c
+index 7d9ef49..cfbf2b5 100644
+--- a/sound/core/pcm_native.c
++++ b/sound/core/pcm_native.c
+@@ -787,6 +787,7 @@ static int snd_pcm_hw_free(struct snd_pcm_substream *substream)
+ 	if (substream->ops->hw_free)
+ 		result = substream->ops->hw_free(substream);
+ 	snd_pcm_set_state(substream, SNDRV_PCM_STATE_OPEN);
++	if (pm_qos_request_active(&substream->latency_pm_qos_req))
+ 	pm_qos_remove_request(&substream->latency_pm_qos_req);
+ 	return result;
+ }
+--
+2.34.1
diff --git a/devices/fossil-hoki/kernel/90_dtbs-install.patch b/devices/fossil-hoki/kernel/90_dtbs-install.patch
new file mode 100644
index 00000000..1cd6dc69
--- /dev/null
+++ b/devices/fossil-hoki/kernel/90_dtbs-install.patch
@@ -0,0 +1,29 @@
+Add a dtbs_install target for the hoki DTB
+
+This downstream 4.14 tree defines dtbs_install only under arch/arm64; ARM has
+no such target, so `make dtbs dtbs_install` installs nothing.
+
+The sda429-hoki sub-make writes its blob to $(obj)/../%.dtb, i.e. into
+arch/arm/boot/dts/, and the parent dts/Makefile never lists it in dtb-y. That
+puts the DTB out of reach of scripts/Makefile.dtbinst, so copy it directly.
+
+diff --git a/arch/arm/Makefile b/arch/arm/Makefile
+--- a/arch/arm/Makefile
++++ b/arch/arm/Makefile
+@@ -361,6 +361,16 @@ $(INSTALL_TARGETS):
+ %.dtb: | scripts
+ 	$(Q)$(MAKE) $(build)=$(boot)/dts MACHINE=$(MACHINE) $(boot)/dts/$@
+ 
++# This downstream tree has no dtbs_install for ARM (only arm64 defines one).
++# The hoki DTB is built into $(boot)/dts/ by the sda429-hoki sub-make, which
++# writes to $(obj)/../%.dtb, so it is not reachable via
++# scripts/Makefile.dtbinst (the parent dts/Makefile does not list it in
++# dtb-y). Install it directly.
++PHONY += dtbs_install
++dtbs_install:
++	$(Q)mkdir -p $(INSTALL_DTBS_PATH)
++	$(Q)cp -v $(boot)/dts/*.dtb $(INSTALL_DTBS_PATH)/
++
+ dtbs: scripts
+ 	$(Q)$(MAKE) $(build)=$(boot)/dts MACHINE=$(MACHINE) dtbs
+ 	$(foreach DIR, $(DTSSUBDIR), $(Q)$(MAKE) $(build)=$(boot)/dts/$(DIR) MACHINE=$(MACHINE) dtbs)
diff --git a/devices/fossil-hoki/kernel/default.nix b/devices/fossil-hoki/kernel/default.nix
new file mode 100644
index 00000000..67d73d65
--- /dev/null
+++ b/devices/fossil-hoki/kernel/default.nix
@@ -0,0 +1,269 @@
+{
+  mobile-nixos,
+  stdenv,
+  cpio,
+  fetchFromGitHub,
+  fetchurl,
+  lib,
+  runCommand,
+  xz,
+  enableDroidspacesBackports ? false,
+  ...
+}:
+
+# Fossil Gen 6 (hoki) ships a 4.14 downstream Qualcomm kernel.
+# Upstream source tree: https://github.com/fossil-engineering/kernel-msm-fossil-cw
+# AsteroidOS recipe: https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-kernel/linux/linux-hoki_p.bb
+#
+# It must be built with GCC 8: AsteroidOS's recipe inherits `kernel-gcc8` (https://github.com/AsteroidOS/meta-asteroid/blob/master/classes/kernel-gcc8.bbclass)
+# and notes "gcc >= 13 doesn't boot". Nixpkgs dropped gcc8, so borrow the armv7l
+# cross compiler from nixos-24.05 (the last channel still shipping 8.5.0).
+#
+# Patches 0001-0006 are fetched verbatim from AsteroidOS meta-smartwatch at
+# rev 873c865ca06593d239f911b76b09228ddd70eccc:
+# https://github.com/AsteroidOS/meta-smartwatch/tree/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-kernel/linux/files
+# Patch 0007 fixes unconditional pm_qos_remove_request crash in pcm_native.c:
+# https://github.com/AsteroidOS/meta-smartwatch/pull/344
+# 90_dtbs-install is ours: this tree has no ARM dtbs_install target.
+let
+  # Pinned by git rev rather than a channel URL: channels.nixos.org/nixos-24.05
+  # is a moving target whose NAR hash changes as the branch advances, and that
+  # branch is gone now that 24.05 is EOL.
+  pkgsGcc8 = import (builtins.fetchGit {
+    url = "https://github.com/NixOS/nixpkgs.git";
+    rev = "b134951a4c9f3c995fd7be05f3243f8ecd65d798";
+    shallow = true;
+  }) { system = stdenv.buildPlatform.system; };
+
+  cc8 = pkgsGcc8.pkgsCross.armv7l-hf-multiplatform.buildPackages.gcc8;
+
+  # Same as pkgs.overrideCC (pkgs/stdenv/adapters.nix), inlined so this file
+  # does not need the surrounding package set.
+  stdenvGcc8 = stdenv.override {
+    allowedRequisites = null;
+    cc = cc8;
+    hasCC = true;
+  };
+
+  kernel-builder-gcc8 = mobile-nixos.kernel-builder.override {
+    stdenv = stdenvGcc8;
+  };
+
+  droidspacesBackports = fetchFromGitHub {
+    owner = "Droidspaces";
+    repo = "droidspaces-backports";
+    rev = "be24159e5cc264b4491f5416d8efd9504031c42b";
+    hash = "sha256-3UpOt71tgYrGyCfOyAgN9CMewFT6uO4UhCvhyVo/82Y=";
+  };
+
+  droidspacesPatch = name: "${droidspacesBackports}/kernel-4.14-series/${name}";
+
+  # Upstream AsteroidOS defconfig for Fossil Gen 6 (hoki):
+  # https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-kernel/linux/linux-hoki/defconfig
+  upstreamDefconfig = fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-kernel/linux/linux-hoki/defconfig";
+    sha256 = "0fk14m3h7qdbyjlidifddrsp76j0wgq5wsg86vzisv65s8ha84as";
+  };
+
+  # Fetch the verbatim vendor patches instead of vendoring their contents.
+  # fetchurl is used rather than fetchpatch so the files are not transformed.
+  upstreamPatch =
+    name: sha256:
+    fetchurl {
+      url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-kernel/linux/files/${name}";
+      inherit sha256;
+    };
+
+  # Kernel.org's incremental 4.14 patches each rewrite the Makefile's
+  # VERSION/PATCHLEVEL/SUBLEVEL. The vendor Makefile is kept as-is and postPatch
+  # sets SUBLEVEL once, so those hunks are dropped for every version.
+  #
+  # Two kinds of divergence remain:
+  #   * a fix the vendor tree already carries: the whole file is listed in
+  #     `excludes` and left out of the patch;
+  #   * vendor code that only differs in context: the hunk is rewritten by
+  #     stable/linux-4.14.<range>.patch.patch, which patches the patch text
+  #     itself so the upstream hunks stay readable.
+  stableIncr =
+    range: hash: excludes:
+    let
+      name = "linux-4.14.${range}.patch";
+      adaptation = ./stable/${name}.patch;
+      hasAdaptation = builtins.pathExists adaptation;
+      droppedFiles = lib.concatStringsSep "|" (map lib.escapeRegex ([ "Makefile" ] ++ excludes));
+    in
+    runCommand name
+      (
+        {
+          nativeBuildInputs = [ xz ];
+          src = fetchurl {
+            url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.14.${range}.xz";
+            inherit hash;
+          };
+          inherit droppedFiles;
+        }
+        // lib.optionalAttrs hasAdaptation { inherit adaptation; }
+      )
+      ''
+        xz -dc "$src" > raw.patch
+        # One section per file starts at "diff --git"; drop the excluded ones.
+        awk -v dropped="$droppedFiles" '
+          /^diff --git / { skip = ($3 ~ "^a/(" dropped ")$") }
+          !skip { print }
+        ' raw.patch > "${name}"
+        ${lib.optionalString hasAdaptation ''
+          patch -p1 --batch -i "$adaptation"
+        ''}
+        cp "${name}" "$out"
+      '';
+
+  # Incremental stable patches, 4.14.206 through 4.14.230.
+  stablePatches = [
+    # The vendor tree already carries the perf-core and Intel PT fixes; only
+    # syncookies still needs the vendor's sock_net() argument.
+    (stableIncr "206-207" "sha256-U7olrDZuRkGt6GbXp6Lna20cERa5GX8RqXgbZGPrvX4=" [
+      "arch/x86/events/intel/pt.c"
+      "include/linux/perf_event.h"
+      "kernel/events/core.c"
+    ])
+    (stableIncr "207-208" "sha256-RUgB0ik3YaGix3k3Tm5VJbIMaSvZIp/+fuCNIuOguHk=" [ ])
+    (stableIncr "208-209" "sha256-r0AtMyS92An0LizlWgoTbudht5/UD+f+MP38MlBQjQY=" [ ])
+    (stableIncr "209-210" "sha256-w4lZp53kPfuo1Gtfs0xkB1Q5kRZ+VaNc7NfEGqKpVn4=" [
+      "drivers/scsi/ufs/ufshcd.c"
+    ])
+    (stableIncr "210-211" "sha256-Lra7YGHSls61bxwvS+fM3ySspqJRdVsaZMWCb7OXynI=" [ ])
+    (stableIncr "211-212" "sha256-2rgzDbH88Z92a+1SIMwW6LhHS2TlWIwOW2w2AK6DWsw=" [
+      "drivers/tty/tty_jobctrl.c"
+      "drivers/usb/gadget/function/f_fs.c"
+    ])
+    (stableIncr "212-213" "sha256-TthjpDn2ZHHYocbu9zOhb9EeguLC/KwMvMKb1/nhOHs=" [
+      "drivers/scsi/ufs/ufshcd.c"
+      "drivers/soc/qcom/smp2p.c"
+      "drivers/usb/gadget/function/f_fs.c"
+    ])
+    (stableIncr "213-214" "sha256-z2VWV17dh99E2YhKa0kktt0VsLVi8rZPZEe2ELlvem8=" [
+      "drivers/md/dm-verity-target.c"
+    ])
+    # Keep the USB gadget fixes, but preserve the vendor's synchronous audio
+    # endpoints instead of upstream's asynchronous ones.
+    (stableIncr "214-215" "sha256-a8t/fKYhziLbxxWND18CLQwKyN57k4HXxYcZFkSk5W4=" [
+      "drivers/ide/ide-atapi.c"
+      "drivers/usb/gadget/composite.c"
+    ])
+    (stableIncr "215-216" "sha256-Zvv1EHoAZzIbn//I36DJRDLQBoLXNxZImolUODN+PVg=" [ ])
+    (stableIncr "216-217" "sha256-ORlW3b6fjz1hnbJHb9wSxib8z4raY9VCmZ+IHrFKwtc=" [ ])
+    # Adapt partial vendor backports of the lazytime and futex fixes, retaining
+    # their missing hunks and the UFS reset fix; keep vendor UFS logging and DMA
+    # allocation, and the vendor's own writeback tracepoints.
+    (stableIncr "217-218" "sha256-f/POnOl5cLdhcWvKZBeJq/3Hi3SHS0azPwyQc9ed1Bw=" [
+      "include/trace/events/writeback.h"
+      "kernel/trace/ring_buffer.c"
+    ])
+    (stableIncr "218-219" "sha256-KdXLpTLNfHGb9O49jZHPR+x+H2rx+tNHq+yIKoyfepc=" [ ])
+    (stableIncr "219-220" "sha256-X1AYdSPqVgGOz+T5cbFqh+ldYw0IjSjqGXXdWxw5XzA=" [ ])
+    # The vendor tree already carries the route uncached-list rework and the
+    # i8042 ByteSpeed quirk.
+    (stableIncr "220-221" "sha256-VTU7ukP17LZMBU9Xdr5US75oZ8A1DQ/Ieb9ZTeKVWpk=" [
+      "drivers/input/serio/i8042-x86ia64io.h"
+      "net/ipv4/route.c"
+    ])
+    # The recordmcount guard has to close after the vendor's CONFIG_LTO_CLANG
+    # block instead of right after cmd_record_mcount.
+    (stableIncr "221-222" "sha256-5XlhUCmBOo4XQVlXN8x+U8RPYWZMBdynjeF1QFN9k/A=" [ ])
+    (stableIncr "222-223" "sha256-3iuxyw2tbkD3SGx7d8ohJXNwessO1ld/VuEO6E742kE=" [ ])
+    # Adapt context in arch/arm64/kernel/module.lds (no prior NOLOAD), zram_drv.c
+    # (vendor dedup fields after pages_compacted), and virtgpu_vq.c (vendor
+    # nents local).
+    (stableIncr "223-224" "sha256-UbUHudX6fUQTRyfBZX10QK4thg/j3WCBs8EkWo432nM=" [ ])
+    # Adapt dm-table.c context around the vendor's
+    # dm_calculate_supported_crypto_modes call.
+    (stableIncr "224-225" "sha256-VT4JuHYUVMInEgVhdse6n3NplM6xi66rH7Sbn0eEqaY=" [ ])
+    # In dwmac4_lib.c the vendor tree delegates the per-channel stop to
+    # dwmac4_dma_stop_tx_chan, so the local value and GMAC_CONFIG_TE clear go.
+    (stableIncr "225-226" "sha256-OOzkf8fO/lc6cg0YzZYoz9kMm6FakwDBSdZm4C1nqbc=" [ ])
+    # The vendor tree already carries the qcom-spmi-vadc LR_MUX2_BAT_ID scale,
+    # the configfs usb_string_copy fix, and its own qrtr_endpoint_post
+    # allocation, and takes an extra lblk out-parameter on ext4_find_entry.
+    (stableIncr "226-227" "sha256-mn15m0XsgIMyLIE3mucuBDIb+fl7zEHdNB3tWs0NPBo=" [
+      "drivers/iio/adc/qcom-spmi-vadc.c"
+      "drivers/usb/gadget/configfs.c"
+      "net/qrtr/qrtr.c"
+    ])
+    # The vendor msm_drv.c already guards against NULL ddev/priv in
+    # msm_pdev_shutdown.
+    (stableIncr "227-228" "sha256-AveGb5kR31JESWYH98KpuQvnP/W6D3FxDeiSHir4pkk=" [
+      "drivers/gpu/drm/msm/msm_drv.c"
+    ])
+    # Adapt the __bpf_skb_max_len removal to the vendor's skb_at_tc_ingress
+    # check.
+    (stableIncr "228-229" "sha256-RL/vEgXgI/0FLTCWGzM0DB66cDLKsAS3cASahqkNM/I=" [ ])
+    (stableIncr "229-230" "sha256-iBMDu/Om8HVm6TbKZ9MpVHl1m9nSK2jbqY+xDuhO9FM=" [ ])
+  ];
+
+  # Patch upstream defconfig to enable required Bluetooth protocols (RFCOMM, BNEP, HIDP),
+  # Btrfs filesystem support, and transparent Zstandard/XXHash compression.
+  configfile =
+    runCommand "fossil-hoki-defconfig"
+      {
+        upstream = upstreamDefconfig;
+        patch = ./defconfig.patch;
+      }
+      ''
+        patch -p1 -i "$patch" -o "$out" "$upstream"
+      '';
+in
+
+kernel-builder-gcc8 {
+  version = "4.14.230";
+  inherit configfile;
+
+  # The vendor tree claims 4.14.206 and every incremental patch's Makefile hunk
+  # is dropped above, so the version is set here instead of 24 times over.
+  postPatch = ''
+    sed -i -E 's/^SUBLEVEL = [0-9]+$/SUBLEVEL = 230/' Makefile
+  '';
+
+  src = fetchFromGitHub {
+    owner = "fossil-engineering";
+    repo = "kernel-msm-fossil-cw";
+    rev = "c0b4c201f2d5a641defe19958a9b4c16f40d866b";
+    sha256 = "sha256-uf5Vln2M64ksT9BC4/R9gLV2yo6zK0vQeolyCUj/u+o=";
+  };
+
+  patches =
+    stablePatches
+    ++ [
+      (upstreamPatch "0001-dts-Add-hoki-device-trees.patch" "0z3c6lbqpqmhqsy158wbpl0zcfkr94nwh42d6px309684qq4c8v2")
+      (upstreamPatch "0002-mmc-Fix-embedded_sdio_data-duplicate-definition.patch" "0h7d3pxz8di2rh257kmc83iwcpf8xmrqhbqq4an2vclfdhyr297j")
+      (upstreamPatch "0003-video-fbdev-msm-Provide-mdss_dsi_switch_page.patch" "1igqg795cvr81w948k4dj8nrbzc2pz5bg6gdp68jfplm2hcs4nch")
+      (upstreamPatch "0004-usb-hcd-Handle-when-host-mode-isn-t-available.patch" "156q9s63d0w5q10jzqs32li91a48ji1652rabvndvm0az8klpxld")
+      (upstreamPatch "0005-initramfs-Don-t-skip-initramfs.patch" "19zjr91880fiisvajnr3sykz5xpmy8i0jnjfvdmvjiw0dd5aa6g2")
+      (upstreamPatch "0006-ARM-8933-1-replace-Sun-Solaris-style-flag-on-section.patch" "0vcplkfqgfb8qyalls4bk55y46vij0a9jaak0shxncyf8a4yfx74")
+      ./0007-pcm_native-guard-pm_qos_remove_request-with-active-.patch
+      ./90_dtbs-install.patch
+    ]
+    ++ lib.optionals enableDroidspacesBackports (
+      map droidspacesPatch [
+        "0001-pidfd-add-P_PIDFD-to-waitid.patch"
+        "0002-fork-don-t-check-parent_tidptr-with-CLONE_PIDFD.patch"
+        "0003-net-introduce-SO_BINDTOIFINDEX-sockopt.patch"
+        "0004-statx-add-mount-ID.patch"
+        "0005-statx-add-mount_root.patch"
+        "0006-utimensat-AT_EMPTY_PATH-support.patch"
+        "0007-vfs-add-faccessat2-syscall.patch"
+        "0008-open-add-close_range.patch"
+        "0009-arch-wire-up-close_range.patch"
+        "0010-rtnetlink-accept-nexthop-message-types-and-multicast.patch"
+      ]
+    );
+
+  isModular = false;
+
+  # Qualcomm backported the 5.3 kheaders feature into this 4.14 tree
+  # (CONFIG_IKHEADERS=y), and kernel/gen_kheaders.sh needs cpio. The builder
+  # only supplies cpio for >= 5.2, so add it here.
+  nativeBuildInputs = [ cpio ];
+
+  # Set by CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE in the defconfig.
+  buildDTBs = true;
+}
diff --git a/devices/fossil-hoki/kernel/defconfig.patch b/devices/fossil-hoki/kernel/defconfig.patch
new file mode 100644
index 00000000..b15a40c2
--- /dev/null
+++ b/devices/fossil-hoki/kernel/defconfig.patch
@@ -0,0 +1,48 @@
+--- a/defconfig
++++ b/defconfig
+@@ -1177,8 +1177,14 @@
+ # CONFIG_HAMRADIO is not set
