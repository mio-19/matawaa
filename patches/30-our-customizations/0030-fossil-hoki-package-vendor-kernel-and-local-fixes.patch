diff --git a/devices/fossil-hoki/kernel/0007-pcm_native-guard-pm_qos_remove_request-with-active-.patch b/devices/fossil-hoki/kernel/0007-pcm_native-guard-pm_qos_remove_request-with-active-.patch
new file mode 100644
index 00000000..cd5c429b
--- /dev/null
+++ b/devices/fossil-hoki/kernel/0007-pcm_native-guard-pm_qos_remove_request-with-active-.patch
@@ -0,0 +1,40 @@
+From: pettcomputers <chris@pettcomputers.com>
+Date: Tue, 2 Sep 2026 00:00:00 -0500
+Subject: [PATCH] pcm_native: guard pm_qos_remove_request with an active check
+ in snd_pcm_hw_free
+
+snd_pcm_hw_free() calls pm_qos_remove_request() unconditionally, while
+two other call sites in this same file (snd_pcm_release_substream and
+snd_pcm_hw_params) correctly guard the equivalent remove call with
+pm_qos_request_active() first. If hw_params ever skips its own
+conditional pm_qos_add_request() (a real, reachable path on hoki via
+the "Tertiary MI2S TX Hostless" PCM device, which never gets a real
+stream opened against it), hw_free's unconditional remove fires
+against a request that was never added, producing a kernel warning
+with a full backtrace.
+
+Found while debugging audio capture on hoki (Skagen Falster Gen 6) -
+see https://github.com/AsteroidOS/meta-smartwatch (audio bring-up).
+Confirmed via direct before/after dmesg comparison that the warning
+and backtrace are gone after this change, both immediately post-boot
+and after a settled retest.
+
+Signed-off-by: pettcomputers <chris@pettcomputers.com>
+---
+ sound/core/pcm_native.c | 1 +
+ 1 file changed, 1 insertion(+)
+
+diff --git a/sound/core/pcm_native.c b/sound/core/pcm_native.c
+index 7d9ef49..cfbf2b5 100644
+--- a/sound/core/pcm_native.c
++++ b/sound/core/pcm_native.c
+@@ -787,6 +787,7 @@ static int snd_pcm_hw_free(struct snd_pcm_substream *substream)
+ 	if (substream->ops->hw_free)
+ 		result = substream->ops->hw_free(substream);
+ 	snd_pcm_set_state(substream, SNDRV_PCM_STATE_OPEN);
++	if (pm_qos_request_active(&substream->latency_pm_qos_req))
+ 	pm_qos_remove_request(&substream->latency_pm_qos_req);
+ 	return result;
+ }
+--
+2.34.1
diff --git a/devices/fossil-hoki/kernel/90_dtbs-install.patch b/devices/fossil-hoki/kernel/90_dtbs-install.patch
new file mode 100644
index 00000000..1cd6dc69
--- /dev/null
+++ b/devices/fossil-hoki/kernel/90_dtbs-install.patch
@@ -0,0 +1,29 @@
+Add a dtbs_install target for the hoki DTB
+
+This downstream 4.14 tree defines dtbs_install only under arch/arm64; ARM has
+no such target, so `make dtbs dtbs_install` installs nothing.
+
+The sda429-hoki sub-make writes its blob to $(obj)/../%.dtb, i.e. into
+arch/arm/boot/dts/, and the parent dts/Makefile never lists it in dtb-y. That
+puts the DTB out of reach of scripts/Makefile.dtbinst, so copy it directly.
+
+diff --git a/arch/arm/Makefile b/arch/arm/Makefile
+--- a/arch/arm/Makefile
++++ b/arch/arm/Makefile
+@@ -361,6 +361,16 @@ $(INSTALL_TARGETS):
+ %.dtb: | scripts
+ 	$(Q)$(MAKE) $(build)=$(boot)/dts MACHINE=$(MACHINE) $(boot)/dts/$@
+ 
++# This downstream tree has no dtbs_install for ARM (only arm64 defines one).
++# The hoki DTB is built into $(boot)/dts/ by the sda429-hoki sub-make, which
++# writes to $(obj)/../%.dtb, so it is not reachable via
++# scripts/Makefile.dtbinst (the parent dts/Makefile does not list it in
++# dtb-y). Install it directly.
++PHONY += dtbs_install
++dtbs_install:
++	$(Q)mkdir -p $(INSTALL_DTBS_PATH)
++	$(Q)cp -v $(boot)/dts/*.dtb $(INSTALL_DTBS_PATH)/
++
+ dtbs: scripts
+ 	$(Q)$(MAKE) $(build)=$(boot)/dts MACHINE=$(MACHINE) dtbs
+ 	$(foreach DIR, $(DTSSUBDIR), $(Q)$(MAKE) $(build)=$(boot)/dts/$(DIR) MACHINE=$(MACHINE) dtbs)
diff --git a/devices/fossil-hoki/kernel/default.nix b/devices/fossil-hoki/kernel/default.nix
new file mode 100644
index 00000000..653808b1
--- /dev/null
+++ b/devices/fossil-hoki/kernel/default.nix
@@ -0,0 +1,1029 @@
+{
+  mobile-nixos,
+  stdenv,
+  cpio,
+  diffutils,
+  fetchFromGitHub,
+  fetchurl,
+  gawk,
+  lib,
+  patch,
+  rpm,
+  runCommand,
+  xz,
+  enableDroidspacesBackports ? false,
+  ...
+}:
+
+# Fossil Gen 6 (hoki) ships a 4.14 downstream Qualcomm kernel.
+# Upstream source tree: https://github.com/fossil-engineering/kernel-msm-fossil-cw
+# AsteroidOS recipe: https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-kernel/linux/linux-hoki_p.bb
+#
+# It must be built with GCC 8: AsteroidOS's recipe inherits `kernel-gcc8` (https://github.com/AsteroidOS/meta-asteroid/blob/master/classes/kernel-gcc8.bbclass)
+# and notes "gcc >= 13 doesn't boot". Nixpkgs dropped gcc8, so borrow the armv7l
+# cross compiler from nixos-24.05 (the last channel still shipping 8.5.0).
+#
+# Patches 0001-0006 are fetched verbatim from AsteroidOS meta-smartwatch at
+# rev 873c865ca06593d239f911b76b09228ddd70eccc:
+# https://github.com/AsteroidOS/meta-smartwatch/tree/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-kernel/linux/files
+# Patch 0007 fixes unconditional pm_qos_remove_request crash in pcm_native.c:
+# https://github.com/AsteroidOS/meta-smartwatch/pull/344
+# 90_dtbs-install is ours: this tree has no ARM dtbs_install target.
+let
+  # Pinned by git rev rather than a channel URL: channels.nixos.org/nixos-24.05
+  # is a moving target whose NAR hash changes as the branch advances, and that
+  # branch is gone now that 24.05 is EOL.
+  pkgsGcc8 = import (builtins.fetchGit {
+    url = "https://github.com/NixOS/nixpkgs.git";
+    rev = "b134951a4c9f3c995fd7be05f3243f8ecd65d798";
+    shallow = true;
+  }) { system = stdenv.buildPlatform.system; };
+
+  cc8 = pkgsGcc8.pkgsCross.armv7l-hf-multiplatform.buildPackages.gcc8;
+
+  # Same as pkgs.overrideCC (pkgs/stdenv/adapters.nix), inlined so this file
+  # does not need the surrounding package set.
+  stdenvGcc8 = stdenv.override {
+    allowedRequisites = null;
+    cc = cc8;
+    hasCC = true;
+  };
+
+  kernel-builder-gcc8 = mobile-nixos.kernel-builder.override {
+    stdenv = stdenvGcc8;
+  };
+
+  droidspacesBackports = fetchFromGitHub {
+    owner = "Droidspaces";
+    repo = "droidspaces-backports";
+    rev = "be24159e5cc264b4491f5416d8efd9504031c42b";
+    hash = "sha256-3UpOt71tgYrGyCfOyAgN9CMewFT6uO4UhCvhyVo/82Y=";
+  };
+
+  droidspacesPatch = name: "${droidspacesBackports}/kernel-4.14-series/${name}";
+
+  # Upstream AsteroidOS defconfig for Fossil Gen 6 (hoki):
+  # https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-kernel/linux/linux-hoki/defconfig
+  upstreamDefconfig = fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-kernel/linux/linux-hoki/defconfig";
+    sha256 = "0fk14m3h7qdbyjlidifddrsp76j0wgq5wsg86vzisv65s8ha84as";
+  };
+
+  # Fetch the verbatim vendor patches instead of vendoring their contents.
+  # fetchurl is used rather than fetchpatch so the files are not transformed.
+  upstreamPatch =
+    name: sha256:
+    fetchurl {
+      url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/873c865ca06593d239f911b76b09228ddd70eccc/meta-hoki/recipes-kernel/linux/files/${name}";
+      inherit sha256;
+    };
+
+  # Kernel.org's incremental 4.14 patches each rewrite the Makefile's
+  # VERSION/PATCHLEVEL/SUBLEVEL. The vendor Makefile is kept as-is and postPatch
+  # sets SUBLEVEL once, so those hunks are dropped for every version.
+  #
+  # Two kinds of divergence remain:
+  #   * a fix the vendor tree already carries: the whole file is listed in
+  #     `excludes` and left out of the patch;
+  #   * vendor code that only differs in context: the hunk is rewritten by
+  #     stable/linux-4.14.<range>.patch.patch, which patches the patch text
+  #     itself so the upstream hunks stay readable.
+  stableIncr =
+    range: hash: excludes:
+    let
+      name = "linux-4.14.${range}.patch";
+      adaptation = ./stable/${name}.patch;
+      hasAdaptation = builtins.pathExists adaptation;
+      droppedFiles = lib.concatStringsSep "|" (map lib.escapeRegex ([ "Makefile" ] ++ excludes));
+    in
+    runCommand name
+      (
+        {
+          nativeBuildInputs = [ xz ];
+          src =
+            let
+              local = ./stable/linux-4.14.${range}.patch.xz;
+            in
+            if builtins.pathExists local then
+              local
+            else
+              fetchurl {
+                url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.14.${range}.xz";
+                inherit hash;
+              };
+          inherit droppedFiles;
+        }
+        // lib.optionalAttrs hasAdaptation { inherit adaptation; }
+      )
+      ''
+        xz -dc "$src" > raw.patch
+        # One section per file starts at "diff --git"; drop the excluded ones.
+        awk -v dropped="$droppedFiles" '
+          /^diff --git / { skip = ($3 ~ "^a/(" dropped ")$") }
+          !skip { print }
+        ' raw.patch > "${name}"
+        ${lib.optionalString hasAdaptation ''
+          patch -p1 --batch -i "$adaptation"
+        ''}
+        cp "${name}" "$out"
+      '';
+
+  # OpenELA kernel-lts 4.14.336 -> 4.14.357, fetched from the GitHub compare
+  # endpoint instead of vendoring the generated diffs. As above, the Makefile
+  # hunk (SUBLEVEL is set once in postPatch) and the .elts/ release metadata
+  # are stripped. GitHub renders the diff itself, so it is pinned by hash: if
+  # GitHub ever changes that rendering the fetch fails loudly rather than
+  # silently changing the kernel.
+  openelaIncr =
+    lo: hi: hash: excludes:
+    let
+      name = "openela-4.14.${lo}-${hi}.patch";
+      adaptation = ./stable/${name}.patch;
+      hasAdaptation = builtins.pathExists adaptation;
+      droppedFiles = lib.concatStringsSep "|" (map lib.escapeRegex excludes);
+    in
+    runCommand name
+      (
+        {
+          src = fetchurl {
+            url = "https://github.com/openela/kernel-lts/compare/v4.14.${lo}-openela...v4.14.${hi}-openela.diff";
+            inherit hash;
+          };
+          inherit droppedFiles;
+        }
+        // lib.optionalAttrs hasAdaptation { inherit adaptation; }
+      )
+      ''
+        # One section per file starts at "diff --git"; drop the excluded ones.
+        awk -v dropped="$droppedFiles" '
+          /^diff --git / {
+            path = $3
+            sub(/^a\//, "", path)
+            skip = (path == "Makefile") || (path ~ /^\.elts\//) || (path ~ "^(" dropped ")$")
+          }
+          !skip { print }
+        ' "$src" > "${name}"
+        ${lib.optionalString hasAdaptation ''
+          patch -p1 --batch -i "$adaptation"
+        ''}
+        cp "${name}" "$out"
+      '';
+
+  # Amazon Linux 2's maintained 4.14 kernel: 4.14.355-287.768.amzn2 is OpenELA
+  # 4.14.355 plus Amazon's 767-patch backport queue, and is the newest 4.14
+  # tree still getting fixes (AL2 shipped it in the 2026-11-09 update). It is
+  # only published as a source RPM; the blob path below is content-addressed
+  # by the same sha256 that pins it, so the fetch cannot drift.
+  #
+  # The tree is rebuilt from the RPM's pristine tarball and its patch queue and
+  # then emitted as a single patch against 4.14.355, so the vendor tree takes
+  # it through the same patch list as every other increment. Files the vendor
+  # tree diverges on are left out, keeping the vendor code instead of a rejected
+  # hunk, the same rule as the increments above.
+  #
+  # Dropping a single file of an AL2 change would leave its remaining files
+  # assuming the half that was dropped (AL2 moved mq_freeze_depth into a mutex,
+  # gave swapin_readahead a fourth argument, and so on), so the seed list below
+  # is expanded in the derivation: an AL2 patch touching a dropped file is
+  # dropped whole. That keeps every surviving change complete, and the build
+  # log prints the expanded list.
+  amzn2Excludes = [
+    # AL2's swapin_readahead takes a vma and address; the vendor swap.h keeps
+    # the vmf argument, so the caller has to stay vendor code too.
+    "mm/swapfile.c"
+    # arm64/x86 code is not built for this armv7l target, and the vendor tree
+    # carries its own arch backports.
+    "arch/arm64/Kconfig"
+    "arch/arm64/Makefile"
+    "arch/arm64/include/asm/Kbuild"
+    "arch/arm64/include/asm/cpucaps.h"
+    "arch/arm64/include/asm/spinlock.h"
+    "arch/arm64/kernel/alternative.c"
+    "arch/arm64/kernel/cpu-reset.h"
+    "arch/arm64/kernel/cpu_errata.c"
+    "arch/arm64/kernel/cpufeature.c"
+    "arch/arm64/kernel/machine_kexec.c"
+    "arch/arm64/kernel/topology.c"
+    "arch/x86/Kconfig"
+    "Documentation/arm64/silicon-errata.txt"
+    # The block layer's freeze API differs: AL2 moves to a mutex-backed
+    # mq_freeze_depth, which the vendor request_queue has no field for.
+    "block/blk-core.c"
+    "block/blk-mq.c"
+    # Vendor qcom/acpi firmware and iommu code predates the AL2 backports
+    # (firmware syfs attributes, non-strict iommu mode, ITS init ordering).
+    "drivers/acpi/device_sysfs.c"
+    "drivers/base/firmware_class.c"
+    "drivers/iommu/arm-smmu.c"
+    "drivers/iommu/dma-iommu.c"
+    "drivers/iommu/io-pgtable-arm.c"
+    "drivers/iommu/io-pgtable.h"
+    "drivers/irqchip/irq-gic-v3.c"
+    "include/linux/iommu.h"
+    # Vendor random.c is the pre-4.9.320 implementation; AL2's RANDOM_WAIT_JITTER
+    # and the ppp_async buffer handling expect Amazon's rewrite.
+    "drivers/char/Kconfig"
+    "drivers/char/random.c"
+    "drivers/net/ppp/ppp_async.c"
+    # Vendor build lists already name the vendor's own directories.
+    "drivers/Makefile"
+    "drivers/misc/Makefile"
+    "lib/Makefile"
+    # The vendor vfs/ext4/nilfs2/udf code takes different helper signatures
+    # (extra lookup arguments, the vendor's fscrypt layout, its nilfs2 pages).
+    "fs/ext4/ext4.h"
+    "fs/ext4/extents.c"
+    "fs/ext4/inline.c"
+    "fs/inode.c"
+    "fs/namei.c"
+    "fs/nilfs2/btree.c"
+    "fs/nilfs2/page.c"
+    "fs/proc/base.c"
+    "fs/udf/inode.c"
+    # AL2's per-netns tcp rmem/wmem and its arg_lock-carrying mm_struct do not
+    # exist in the vendor tree; the sock/tcp headers go with their C files.
+    "include/linux/mm_types.h"
+    "include/net/netns/ipv4.h"
+    "include/net/sock.h"
