+  amzn2Patch =
+    runCommand "amzn2-4.14.355-287.768.patch"
+      {
+        nativeBuildInputs = [
+          cpio
+          diffutils
+          gawk
+          patch
+          rpm
+          xz
+        ];
+        src = fetchurl {
+          url = "https://amazonlinux-2-repos-us-east-1.s3.dualstack.us-east-1.amazonaws.com/blobstore/4056642df4afbf2fddf8d69b82a79e3f0fd39e84cbd64942c924e69e0b1649c8/kernel-4.14.355-287.768.amzn2.src.rpm";
+          sha256 = "sha256-QFZkLfSvvy/d+NabgqeePw/TnoTL1klCySTmngsWScg=";
+        };
+        seed = lib.concatStringsSep "\n" ([ "Makefile" ] ++ amzn2Excludes);
+      }
+      ''
+        mkdir queue
+        rpm2cpio "$src" > payload.cpio
+        ( cd queue && cpio -idm --quiet < ../payload.cpio )
+
+        mkdir pristine al2
+        tar -xJf queue/linux-4.14.355.tar.xz -C pristine --strip-components=1
+        cp -a pristine/. al2/
+        for p in queue/0*.patch; do
+          patch -p1 -d al2 --batch --forward --no-backup-if-mismatch -s -i "$PWD/$p"
+        done
+
+        # Expand the seed into whole AL2 changes: repeat until no patch in the
+        # queue touches a dropped file without being dropped in full.
+        printf '%s\n' "$seed" | sed '/^$/d' | LC_ALL=C sort -u > dropped.list
+        for attempt in $(seq 100); do
+          : > touched.list
+          for p in queue/0*.patch; do
+            sed -n 's|^diff --git a/[^ ]* b/||p' "$p" | LC_ALL=C sort -u > patch.files
+            if [ -s patch.files ] && comm -12 patch.files dropped.list | grep -q .; then
+              cat patch.files >> touched.list
+            fi
+          done
+          cat dropped.list touched.list | LC_ALL=C sort -u > expanded.list
+          if cmp -s dropped.list expanded.list; then break; fi
+          mv expanded.list dropped.list
+        done
+        echo "AL2 4.14.355-287.768.amzn2: dropping $(wc -l < dropped.list) files"
+        cat dropped.list
+
+        # One section per file, sorted by path so the patch is reproducible.
+        ( cd pristine && find . -type f -printf '%P\n' ) | LC_ALL=C sort > pristine.files
+        ( cd al2 && find . -type f -printf '%P\n' ) | LC_ALL=C sort > al2.files
+        LC_ALL=C sort -u pristine.files al2.files > files
+        : > raw.patch
+        while IFS= read -r f; do
+          if [ -f "pristine/$f" ] && [ -f "al2/$f" ] && cmp -s "pristine/$f" "al2/$f"; then
+            continue
+          fi
+          [ -f "pristine/$f" ] || [ -f "al2/$f" ] || continue
+          echo "diff --git a/$f b/$f" >> raw.patch
+          if [ -f "pristine/$f" ] && [ -f "al2/$f" ]; then
+            diff -u --label "a/$f" --label "b/$f" "pristine/$f" "al2/$f" >> raw.patch || true
+          elif [ -f "pristine/$f" ]; then
+            diff -u --label "a/$f" --label /dev/null "pristine/$f" /dev/null >> raw.patch || true
+          else
+            diff -u --label /dev/null --label "b/$f" /dev/null "al2/$f" >> raw.patch || true
+          fi
+        done < files
+
+        # One section per file starts at "diff --git"; drop the excluded ones.
+        awk -v dropped=" $(tr '\n' ' ' < dropped.list) " '
+          /^diff --git / {
+            path = $3
+            sub(/^a\//, "", path)
+            skip = (index(dropped, " " path " ") > 0)
+          }
+          !skip { print }
+        ' raw.patch > "$out"
+      '';
