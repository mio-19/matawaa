+++ b/overlay/asteroidos/mce/patches/0009-reject-negative-timeout-intervals.patch
@@ -0,0 +1,64 @@
+From: Matawaa <noreply@localhost>
+Subject: [PATCH] mce: reject negative timeout intervals
+
+MCE stores configurable timeouts as signed integers, while
+g_timeout_add_seconds() accepts an unsigned interval. A negative setting
+therefore becomes a multi-century timer and can overflow ppoll()'s timeout
+on 32-bit watches. Treat negative values as disabled and log their source.
+
+---
+diff --git a/modules/display.c b/modules/display.c
+index f33ec64..5934fc1 100644
+--- a/modules/display.c
++++ b/modules/display.c
+@@ -4060,6 +4060,15 @@ static void mdy_blanking_schedule_dim(void)
+ 
+     mce_log(LL_DEBUG, "DIM timer scheduled @ %d secs", dim_timeout);
+ 
++    /* A negative setting means the timeout is disabled. Do not pass it to
++     * g_timeout_add_seconds(): its unsigned interval would wrap to a huge
++     * timeout, which can overflow ppoll() on 32-bit systems. */
++    if( dim_timeout < 0 ) {
++        mce_log(LL_WARN, "ignoring negative display dim timeout: %d",
++                dim_timeout);
++        goto EXIT;
++    }
++
+     /* Setup new timeout */
+     mdy_blanking_dim_cb_id = g_timeout_add_seconds(dim_timeout,
+                                                    mdy_blanking_dim_cb, NULL);
+@@ -4315,6 +4324,14 @@ static void mdy_blanking_schedule_lpm_off(void)
+     if( mdy_disp_never_blank )
+         goto EXIT;
+ 
++    /* A negative setting means the timeout is disabled. Do not pass it to
++     * g_timeout_add_seconds(): its unsigned interval would wrap to a huge
++     * timeout, which can overflow ppoll() on 32-bit systems. */
++    if( timeout < 0 ) {
++        mce_log(LL_WARN, "ignoring negative LPM blank timeout: %d", timeout);
++        goto EXIT;
++    }
++
+     /* Setup new timeout */
+     mce_log(LL_DEBUG, "LPM-BLANK timer scheduled @ %d secs", timeout);
+     mdy_blanking_lpm_off_cb_id =
+diff --git a/modules/keypad.c b/modules/keypad.c
+index 930612a..f85cd6c 100644
+--- a/modules/keypad.c
++++ b/modules/keypad.c
+@@ -583,6 +583,15 @@ static void setup_key_backlight_timeout(void)
+ {
+ 	cancel_key_backlight_timeout();
+ 
++	/* A negative setting disables automatic backlight shutoff. Passing it
++	 * to g_timeout_add_seconds() would convert it to a huge unsigned value,
++	 * which can overflow ppoll() on 32-bit systems. */
++	if (key_backlight_timeout < 0) {
++		mce_log(LL_WARN, "ignoring negative key backlight timeout: %d",
++			key_backlight_timeout);
++		return;
++	}
++
+ 	/* Setup a new timeout */
+ 	key_backlight_timeout_cb_id =
+ 		g_timeout_add_seconds(key_backlight_timeout,
