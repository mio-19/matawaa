From 8aac655e73eb187238b0c8b9190dd91d36ae7020 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:22:28 +1100
Subject: [PATCH] add AsteroidOS machine configuration (modules)

Generate /etc/asteroid/machine.conf from the mobile device identity and
screen geometry. AsteroidOS userland reads this file to select the
correct watchface layout, display shape, and hardware capabilities.
---
 modules/asteroid-config.nix | 39 +++++++++++++++++++++++++++++++++++++
 modules/module-list.nix     |  1 +
 2 files changed, 40 insertions(+)
 create mode 100644 modules/asteroid-config.nix

diff --git a/modules/asteroid-config.nix b/modules/asteroid-config.nix
new file mode 100644
index 00000000..52acbff6
--- /dev/null
+++ b/modules/asteroid-config.nix
@@ -0,0 +1,39 @@
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+
+let
+  inherit (lib) mkDefault mkIf;
+  screenCfg = config.mobile.hardware.screen;
+  watchCfg = config.mobile.hardware.watch;
+  devName =
+    if config.mobile ? device && config.mobile.device ? name then
+      config.mobile.device.name
+    else
+      "generic";
+
+  # Generates standard /etc/asteroid/machine.conf expected by AsteroidOS launcher,
+  # qml-asteroid, and applications.
+  machineConf = pkgs.writeText "machine.conf" ''
+    [Display]
+    FLAT_TIRE=${toString screenCfg.chinHeight}
+    BORDER_GESTURE_WIDTH=15
+    ROUND=${if screenCfg.shape == "round" || screenCfg.shape == "chin" then "true" else "false"}
+    NEEDS_BURN_IN_PROTECTION=${if watchCfg.burnInProtection then "true" else "false"}
+
+    [Capabilities]
+    HAS_WLAN=true
+    HAS_SPEAKER=false
+
+    [Identity]
+    MACHINE=${devName}
+  '';
+in
+{
+  config = mkIf (config.mobile.enable && watchCfg.enable) {
+    environment.etc."asteroid/machine.conf".source = machineConf;
+  };
+}
diff --git a/modules/module-list.nix b/modules/module-list.nix
index 0a18885d..fe4ce596 100644
--- a/modules/module-list.nix
+++ b/modules/module-list.nix
@@ -2,6 +2,7 @@
 # Keep this list `:sort`ed.
 [
   ./adb.nix
+  ./asteroid-config.nix
   ./beautification.nix
   ./boot-control.nix
   ./boot-initrd.nix
-- 
