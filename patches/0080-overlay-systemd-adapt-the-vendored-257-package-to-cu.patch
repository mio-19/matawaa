From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 21:43:20 +1100
Subject: [PATCH] overlay/systemd: adapt the vendored 257 package to current
 callPackage

Stop replacing the package-set systemd, expose systemd257 directly, and select it only through systemd.package so dependencies keep using the current systemd. Add the current package-set switches (withNspawn, withVConsole, withSysinstall, withImds, vmlinux-btf) to the vendored 25.05 definition.
---
 devices/families/asteroidos.nix | 2 ++
 overlay/cross-compile.nix       | 2 +-
 overlay/systemd-257/default.nix | 2 ++
 3 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/devices/families/asteroidos.nix b/devices/families/asteroidos.nix
index 4a0a75f4..85c62efc 100644
--- a/devices/families/asteroidos.nix
+++ b/devices/families/asteroidos.nix
@@ -12,6 +12,8 @@ let
     ;
 in
 {
+  systemd.package = lib.mkForce pkgs.systemd257;
+
   mobile.system.type = mkDefault "android";
   mobile.system.system = mkDefault "armv7l-linux";
 
diff --git a/overlay/cross-compile.nix b/overlay/cross-compile.nix
index e2a1e205..8b2b29f3 100644
--- a/overlay/cross-compile.nix
+++ b/overlay/cross-compile.nix
@@ -71,7 +71,7 @@ else
       );
   in
   {
-    systemd = systemd257;
+    inherit systemd257;
     systemd_latest-oldkernel = systemd262OldKernel;
 
     # ModemManager's generated GDBus sources race with the static archive link
diff --git a/overlay/systemd-257/default.nix b/overlay/systemd-257/default.nix
index 132d1dcd..60d79db9 100644
--- a/overlay/systemd-257/default.nix
+++ b/overlay/systemd-257/default.nix
@@ -158,6 +158,8 @@
   withSysinstall ? false,
   # systemd 262 package-set switch, unused by the 25.05 definition.
   withVConsole ? false,
+  # systemd 262 package-set switch, unused by the 25.05 definition.
+  withNspawn ? false,
   withResolved ? true,
   withShellCompletions ? true,
   withSysusers ? true,
