From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Thu, 22 Oct 2026 22:32:08 +1100
Subject: [PATCH] devices/fossil-hoki: update vendor kernel to 4.14.209

kernel.org does not publish a combined 4.14.207 -> 4.14.209 incremental file. Build one derivation from the two published increments, 207 -> 208 and 208 -> 209, and apply the concatenated patch after the adapted 206 -> 207 update.
---
 devices/fossil-hoki/kernel/default.nix | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/devices/fossil-hoki/kernel/default.nix b/devices/fossil-hoki/kernel/default.nix
index 6f61e0b5..b28f1efc 100644
--- a/devices/fossil-hoki/kernel/default.nix
+++ b/devices/fossil-hoki/kernel/default.nix
@@ -82,6 +82,23 @@ let
         cp "$TMPDIR/stable/linux-4.14.206-207.patch" "$out"
       '';
 
+  # Incremental 4.14.207 -> 4.14.209 stable patch. kernel.org does not publish
+  # a combined 207-209 file; concatenate the two published increments.
+  stablePatch209 = runCommand "linux-4.14.207-209.patch" {
+    nativeBuildInputs = [ xz ];
+    src207_208 = fetchurl {
+      url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.14.207-208.xz";
+      hash = "sha256-RUgB0ik3YaGix3k3Tm5VJbIMaSvZIp/+fuCNIuOguHk=";
+    };
+    src208_209 = fetchurl {
+      url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.14.208-209.xz";
+      hash = "sha256-r0AtMyS92An0LizlWgoTbudht5/UD+f+MP38MlBQjQY=";
+    };
+  } ''
+    xz -dc "$src207_208" > "$out"
+    xz -dc "$src208_209" >> "$out"
+  '';
+
   # Patch upstream defconfig to enable required Bluetooth protocols (RFCOMM, BNEP, HIDP),
   # Btrfs filesystem support, and transparent Zstandard/XXHash compression.
   configfile =
@@ -96,7 +113,7 @@ let
 in
 
 kernel-builder-gcc8 {
-  version = "4.14.207";
+  version = "4.14.209";
   inherit configfile;
 
   src = fetchFromGitHub {
@@ -108,6 +125,7 @@ kernel-builder-gcc8 {
 
   patches = [
     stablePatch
+    stablePatch209
     (upstreamPatch "0001-dts-Add-hoki-device-trees.patch" "0z3c6lbqpqmhqsy158wbpl0zcfkr94nwh42d6px309684qq4c8v2")
     (upstreamPatch "0002-mmc-Fix-embedded_sdio_data-duplicate-definition.patch" "0h7d3pxz8di2rh257kmc83iwcpf8xmrqhbqq4an2vclfdhyr297j")
     (upstreamPatch "0003-video-fbdev-msm-Provide-mdss_dsi_switch_page.patch" "1igqg795cvr81w948k4dj8nrbzc2pz5bg6gdp68jfplm2hcs4nch")
