diff --git a/overlay/cross-compile.nix b/overlay/cross-compile.nix
new file mode 100644
index 00000000..02caaf5e
--- /dev/null
+++ b/overlay/cross-compile.nix
@@ -0,0 +1,315 @@
+# Overlays and package workarounds that only make sense during cross-compilation.
+#
+# When building natively, this overlay selects vendored Qt 6.11 for matching
+# Qt host tools. When cross-compiling, it also provides upstream fixes for Qt 6,
+# 32-bit ARM toolchains, NetSurf host build tools, Skia, systemd, and libkiwix.
+final: super:
+
+let
+  superStdenv = super.stdenv or null;
+  isCross =
+    superStdenv != null && superStdenv.buildPlatform.system != superStdenv.hostPlatform.system;
+in
+if !isCross then
+  {
+    # Use the same vendored Qt package definitions for host tools as for the
+    # target Qt libraries during cross compilation. Their dependencies and
+    # toolchains still come from the current Nixpkgs package set.
+    qt6 = final.callPackage ./vendor/qt-6.11 { };
+  }
+else
+  let
+    addCrossQuickTools =
+      pkg:
+      pkg.overrideAttrs (old: {
+        cmakeFlags = (old.cmakeFlags or [ ]) ++ [
+          "-DQt6QuickTools_DIR=${final.buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+          "-DQt6QmlTools_DIR=${final.buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+          "-DQt6ShaderToolsTools_DIR=${final.buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+        ];
+      });
+
+  in
+  {
+    # ModemManager's generated GDBus sources race with the static archive link
+    # when building in parallel; serialize its build.
+    modemmanager = super.modemmanager.overrideAttrs (old: {
+      enableParallelBuilding = false;
+    });
+
+    # libtool relinks the libcanberra-multi plugin before make install creates
+    # the libcanberra.so symlink, so the linker cannot resolve -lcanberra with
+    # current binutils. Pre-create the symlink from the build tree.
+    libcanberra = super.libcanberra.overrideAttrs (old: {
+      preInstall = (old.preInstall or "") + ''
+        mkdir -p $out/lib
+        ln -sf "$PWD/src/.libs/libcanberra.so.0.2.5" "$out/lib/libcanberra.so"
+      '';
+    });
+
+    # Upstream nixpkgs Qt6 modules skip QtQuick integration during cross-compilation
+    # because cross Qt6QuickTools, Qt6QmlTools, and Qt6ShaderToolsTools cmake flags are missing.
+    qt6 = (final.callPackage ./vendor/qt-6.11 { }).overrideScope (
+      qfinal: qsuper: {
+        # Upstream AsteroidOS builds Qt without desktop GL on hybris machines:
+        # meta-asteroid/recipes-qt/qt6/qtbase_git.bbappend does
+        #   PACKAGECONFIG:append = " gles2 "
+        #   PACKAGECONFIG:remove:hybris-machine = " ... gl ... "
+        # i.e. `-opengl es2`. With the nixpkgs default (desktop GL only),
+        # QOpenGLContext::openGLModuleType() returns LibGL, so
+        # QEGLConfigChooser asks for EGL_OPENGL_BIT; the vendor EGL only
+        # exposes ES configs (renderable=0x45 in the egl-probe dump), so
+        # eglChooseConfig() returns no config and eglCreateWindowSurface()
+        # fails with EGL_BAD_CONFIG. `-opengl es2` makes Qt request
+        # EGL_OPENGL_ES2_BIT, which the vendor EGL does provide.
+        qtbase = qsuper.qtbase.overrideAttrs (old: {
+          cmakeFlags = (old.cmakeFlags or [ ]) ++ [ "-DINPUT_opengl=es2" ];
+        });
+        qtdeclarative = qsuper.qtdeclarative.overrideAttrs (old: {
+          cmakeFlags =
+            (map (
+              flag:
+              if final.lib.hasPrefix "-DQt6ShaderToolsTools_DIR=" flag then
+                "-DQt6ShaderToolsTools_DIR=${final.pkgsBuildBuild.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+              else
+                flag
+            ) (old.cmakeFlags or [ ]))
+            ++ [
+              "-DQt6QuickTools_DIR=${final.pkgsBuildBuild.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+              "-DQt6ShaderToolsTools_DIR=${final.pkgsBuildBuild.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+              "-DQt6QuickTools_DIR=${final.pkgsBuildBuild.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+            ];
+        });
+        # Upstream AsteroidOS builds qtwayland's libhybris-egl-server buffer
+        # integration (meta-asteroid recipes-qt/qt6/qtwayland_%.bbappend +
+        # 0001-Fix-libhybris-egl-server-compilation.patch). Qt 6.12 no longer
+        # defines the feature, but it still ships the plugin sources and the
+        # guard is a plain CMake variable, so enable it explicitly and apply
+        # the same upstream patch. Selected at runtime through
+        # QT_WAYLAND_SERVER_BUFFER_INTEGRATION=libhybris-egl-server.
+        qtwayland = (addCrossQuickTools qsuper.qtwayland).overrideAttrs (old: {
+          patches = (old.patches or [ ]) ++ [
+            "${final.meta-asteroid-src}/recipes-qt/qt6/qtwayland/0001-Fix-libhybris-egl-server-compilation.patch"
+          ];
+          cmakeFlags = (old.cmakeFlags or [ ]) ++ [
+            "-DQT_FEATURE_wayland_libhybris_egl_server_buffer=ON"
+          ];
+          buildInputs = (old.buildInputs or [ ]) ++ [ final.libhybris ];
+        });
+        qtvirtualkeyboard = addCrossQuickTools qsuper.qtvirtualkeyboard;
+        qtmultimedia = (addCrossQuickTools qsuper.qtmultimedia).overrideAttrs (old: {
+          buildInputs = final.lib.filter (
+            p:
+            !(final.lib.elem (p.pname or "") [
+              "gst-plugins-bad"
+              "gst-libav"
+            ])
+          ) old.buildInputs;
+          propagatedBuildInputs = final.lib.filter (
+            p:
+            !(final.lib.elem (p.pname or "") [
+              "gst-plugins-bad"
+              "gst-libav"
+              "gst-plugins-good"
+              "gst-plugins-base"
+              "gstreamer"
+              "qtquick3d"
+            ])
+          ) old.propagatedBuildInputs;
+        });
+        qtpositioning = addCrossQuickTools qsuper.qtpositioning;
+        # Upstream AsteroidOS applies wearable-sensor patches to Qt's qtsensors
+        # (heart-rate monitor, step counter, pressure) so apps such as
+        # sensorlogd/health consume real Qt sensor types instead of in-tree
+        # mock headers. Fetched from the pinned upstream revision rather than
+        # vendored here.
+        # Reference: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-qt/qt6/qtsensors
+        qtsensors = (addCrossQuickTools qsuper.qtsensors).overrideAttrs (old: {
+          # Upstream AsteroidOS enables the sensorfw backend on wearable
+          # builds; link it against our packaged SensorFW client library.
+          buildInputs = (old.buildInputs or [ ]) ++ [ final.asteroid.sensorfw ];
+          nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [ final.pkg-config ];
+          cmakeFlags = (old.cmakeFlags or [ ]) ++ [ "-DFEATURE_sensorfw=ON" ];
+          # The upstream patch installs Sensors.conf to an absolute /etc path,
+          # which the sandbox rejects; install it under $out and expose it via
+          # environment.etc in the desktop module.
+          postPatch = (old.postPatch or "") + ''
+            substituteInPlace src/plugins/sensors/sensorfw/CMakeLists.txt \
+              --replace-fail 'DESTINATION /etc/xdg/QtProject' 'DESTINATION etc/xdg/QtProject'
+          '';
+          patches = (old.patches or [ ]) ++ [
+            "${final.meta-asteroid-src}/recipes-qt/qt6/qtsensors/0001-Enable-sensorfw.patch"
+            "${final.meta-asteroid-src}/recipes-qt/qt6/qtsensors/0002-Add-heart-rate-monitor-sensor-with-sensorfw-backend.patch"
+            "${final.meta-asteroid-src}/recipes-qt/qt6/qtsensors/0003-Add-step-counter-sensor-with-sensorfw-backend.patch"
+            "${final.meta-asteroid-src}/recipes-qt/qt6/qtsensors/0004-Add-sensorfw-backend-for-pressure-sensor.patch"
+          ];
+        });
+        qtconnectivity = addCrossQuickTools qsuper.qtconnectivity;
+        qtquick3d = qsuper.qtquick3d.overrideAttrs (old: {
+          cmakeFlags = (old.cmakeFlags or [ ]) ++ [
+            "-DQt6QuickTools_DIR=${final.buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+            "-DQt6QmlTools_DIR=${final.buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+            "-DQt6ShaderToolsTools_DIR=${final.buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+            "-DQt6Quick3DTools_DIR=${final.buildPackages.qt6.qtquick3d}/lib/cmake/Qt6Quick3DTools"
+          ];
+        });
+        qtlocation = addCrossQuickTools qsuper.qtlocation;
+        # Enable Qt5Compat QML modules (Qt5Compat.GraphicalEffects and private C++ plugins)
+        # during cross-compilation, matching upstream AsteroidOS qt5compat-qmlplugins.
+        # Upstream reference: https://github.com/AsteroidOS/meta-asteroid/blob/master/classes/asteroid-image.bbclass
+        qt5compat = (addCrossQuickTools qsuper.qt5compat).overrideAttrs (old: {
+          propagatedBuildInputs = (old.propagatedBuildInputs or [ ]) ++ [
+            qfinal.qtdeclarative
+            qfinal.qtshadertools
+          ];
+        });
+      }
+    );
+
+    # In cross-compilation, libkiwix installs build-time generator scripts into $out/bin
+    # whose shebangs reference buildPackages python3 (143MB), bloating the target rootfs.
+    libkiwix = super.libkiwix.overrideAttrs (old: {
+      postInstall = (old.postInstall or "") + ''
+        rm -rf $out/bin
+      '';
+    });
+
+    # Fix wuffs host gcc and ar invocation when generating libraries during cross compilation
+    wuffs = super.wuffs.overrideAttrs (old: {
+      preInstall = ''
+        mkdir -p bin-compat
+        ln -sf $(type -p ${super.stdenv.cc.targetPrefix}gcc) bin-compat/gcc
+        ln -sf $(type -p ${super.stdenv.cc.targetPrefix}ar) bin-compat/ar
+        export PATH="$PWD/bin-compat:$PATH"
+      '';
+    });
+
+    # NetSurf buildsystem fails to guess BUILD in cross-compilation when host cc is not on PATH,
+    # executes hardcoded /bin/which, and lacks default host compiler for helper tools.
+    # Upstream repository: https://git.netsurf-browser.org/buildsystem.git/
+    netsurf-buildsystem = super.netsurf-buildsystem.overrideAttrs (old: {
+      postPatch = (old.postPatch or "") + ''
+        substituteInPlace makefiles/Makefile.tools \
+          --replace-fail 'BUILD := $(shell $(BUILD_CC) -dumpmachine)' 'BUILD ?= ${super.stdenv.buildPlatform.config}' \
+          --replace-fail 'BUILD_CC ?= cc' 'BUILD_CC ?= ${super.buildPackages.stdenv.cc}/bin/gcc' \
+          --replace-fail 'PKGCONFIG ?= PKG_CONFIG_PATH="$(PREFIX)/lib/pkgconfig:$(PKG_CONFIG_PATH)" pkg-config' 'PKGCONFIG ?= PKG_CONFIG_PATH="$(PREFIX)/lib/pkgconfig:$(PKG_CONFIG_PATH)" $(or $(PKG_CONFIG),${super.stdenv.cc.targetPrefix}pkg-config)' \
+          --replace-warn '/bin/which' 'which'
+      '';
+    });
+
+    libparserutils = super.libparserutils.overrideAttrs (old: {
+      nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [
+        super.buildPackages.perl
+        super.buildPackages.which
+      ];
+    });
+
+    libhubbub = super.libhubbub.overrideAttrs (old: {
+      nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [
+        super.buildPackages.gperf
+        super.buildPackages.perl
+        super.buildPackages.which
+      ];
+    });
+
+    libcss = super.libcss.overrideAttrs (old: {
+      nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [
+        super.buildPackages.perl
+        super.buildPackages.which
+      ];
+    });
+
+    libdom = super.libdom.overrideAttrs (old: {
+      nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [
+        super.buildPackages.which
+      ];
+    });
+
+    libsvgtiny = super.libsvgtiny.overrideAttrs (old: {
+      nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [
+        super.buildPackages.gperf
+        super.buildPackages.which
+      ];
+    });
+
+    netsurf-browser = super.netsurf-browser.overrideAttrs (old: {
+      nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [
+        super.buildPackages.gperf
+        super.buildPackages.nsgenbind
+        super.buildPackages.which
+        super.buildPackages.pkg-config
+        super.buildPackages.zlib
+        super.buildPackages.libpng
+        super.buildPackages.gdk-pixbuf
+        super.buildPackages.glib
+      ];
+      preConfigure = (old.preConfigure or "") + ''
+        cat <<EOF >> Makefile.config
+        override BUILD_CC := ${super.buildPackages.stdenv.cc}/bin/gcc
+        override BUILD_CFLAGS := -I${super.buildPackages.zlib.dev}/include -I${super.buildPackages.libpng.dev}/include
+        override BUILD_LDFLAGS := -L${super.buildPackages.zlib}/lib -L${super.buildPackages.libpng}/lib
+        override PKG_CONFIG := ${super.stdenv.cc.targetPrefix}pkg-config
+        EOF
+        export GDK_PIXBUF_MODULE_FILE="${super.buildPackages.gdk-pixbuf}/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"
+      '';
+    });
+  }
+  // super.lib.optionalAttrs (superStdenv != null && superStdenv.hostPlatform.isAarch32) {
+    # GCC 16 triggers format-truncation errors in libgomp during 32-bit ARM cross compilation.
+    # Disable -Werror on target library builds so Clang/Mesa toolchain dependencies succeed.
+    gcc-unwrapped = super.gcc-unwrapped.overrideAttrs (old: {
+      configureFlags = (old.configureFlags or [ ]) ++ [
+        "--disable-werror"
+      ];
+      env = (old.env or { }) // {
+        EXTRA_FLAGS_FOR_TARGET = (old.env.EXTRA_FLAGS_FOR_TARGET or "") + " -Wno-error=format-truncation";
+      };
+    });
+
+    # Ensure Clang wrapper links target C++ libraries from the patched GCC runtime
+    llvmPackages = super.llvmPackages // {
+      clang = super.llvmPackages.clang.override {
+        gccForLibs = final.gcc-unwrapped;
+      };
+    };
+
+    # libpcap pulls in rdma-core (InfiniBand/RoCE), which fails to cross-compile
+    # on 32-bit ARM due to CMake Python host/target architecture checks.
+    # Smartwatches do not use InfiniBand, so disable RDMA.
+    libpcap = super.libpcap.override { withRdma = false; };
+
+    # Skia gnFlags cpu mapping expects "arm" instead of "armv7l".
+    # Reference: https://github.com/NixOS/nixpkgs/blob/master/pkgs/by-name/sk/skia/package.nix
+    skia = super.skia.override {
+      stdenv = super.stdenv.override (old: {
+        hostPlatform = super.stdenv.hostPlatform // {
+          parsed = super.stdenv.hostPlatform.parsed // {
+            cpu = super.stdenv.hostPlatform.parsed.cpu // {
+              name = "arm";
+            };
+          };
+        };
+      });
+    };
+
+    # Port Ladybird browser to 32-bit ARM (armv7l):
+    # Upstream repository: https://github.com/LadybirdBrowser/ladybird
+    # Patches LibGC (NanBoxedValue, HeapRegion, BlockAllocator) to support 32-bit pointers
+    # and reduces the heap cage from 4 TiB to 128 MiB to fit 32-bit virtual memory.
+    ladybird =
+      (super.ladybird.override {
+        skia = final.skia;
+        angle = final.libglvnd;
+      }).overrideAttrs
+        (old: {
+          patches = (old.patches or [ ]) ++ [
+            ./ladybird/0001-32bit-support.patch
+          ];
+          env = (old.env or { }) // {
+            NIX_LDFLAGS = (old.env.NIX_LDFLAGS or "") + " -latomic";
+          };
+          meta = old.meta // {
+            platforms = (old.meta.platforms or [ ]) ++ [ "armv7l-linux" ];
+          };
+        });
+  }
diff --git a/overlay/default.nix b/overlay/default.nix
new file mode 100644
index 00000000..34e60efd
--- /dev/null
+++ b/overlay/default.nix
@@ -0,0 +1,8 @@
+# Top-level overlay composing base overlay and cross-compilation helpers
+final: super:
+
+let
+  base = import ./overlay.nix final super;
+  cross = import ./cross-compile.nix final super;
+in
+base // cross
diff --git a/overlay/overlay.nix b/overlay/overlay.nix
index 02dfb3ac..085bea2e 100644
--- a/overlay/overlay.nix
+++ b/overlay/overlay.nix
@@ -2,16 +2,26 @@ final: super:
 
 let
   callPackage = final.callPackage;
+  systemdOverlay = import ./systemd.nix final super;
 in
-  {
+  systemdOverlay
+  // {
     # Misc. tools.
     # Keep sorted.
     adbd = callPackage ./adbd { };
     android-headers = callPackage ./android-headers { };
+    asteroid = import ./asteroidos {
+      inherit callPackage;
+      pkgs = final;
+    };
+    meta-asteroid-src = final.asteroid.meta-asteroid-src;
     dtbTool = callPackage ./dtbtool { };
     dtbTool-exynos = callPackage ./dtbtool-exynos { };
-    libhybris = callPackage ./libhybris { };
+    libhybris = callPackage ./libhybris {
+      inherit (final) meta-asteroid-src;
+    };
     mkbootimg = callPackage ./mkbootimg { };
+    oans = callPackage ./oans { };
     msm-fb-refresher = callPackage ./msm-fb-refresher { };
     ply-image = callPackage ./ply-image { };
     qc-image-unpacker = callPackage ./qc-image-unpacker { };
@@ -49,6 +59,8 @@ in
     pd-mapper = callPackage ./qrtr/pd-mapper.nix { };
     rmtfs = callPackage ./qrtr/rmtfs.nix { };
 
+    wpewebkit = callPackage ./wpewebkit { };
+
     lk2ndMsm8953 = callPackage ./lk2nd/msm8953.nix {};
 
     #
@@ -71,7 +83,26 @@ in
     # All that follows will have to be cleaned and then upstreamed.
     #
 
-    # No such fixes as of now, this comment is merely a placeholder to keep the general structure.
+    # Upstream libpcap defaults to withRdma = true on Linux, pulling rdma-core.
+    # rdma-core builds man pages using pandoc by default, which pulls in GHC.
+    # On 32-bit ARM (armv7l-linux), GHC cannot bootstrap (cannot bootstrap GHC on
+    # this platform ('armv7l-linux' with libc 'defaultLibc')), breaking native ARM CI.
+    # Neither mobile devices nor smartwatches have RDMA hardware (InfiniBand/RoCE),
+    # so disable RDMA in libpcap and disable man pages in rdma-core on 32-bit ARM to prevent
+    # pulling the entire Pandoc and GHC toolchain without invalidating the x86_64 build cache.
+    libpcap = if super.stdenv.hostPlatform.isAarch32 then super.libpcap.override { withRdma = false; } else super.libpcap;
+    rdma-core = if super.stdenv.hostPlatform.isAarch32 then super.rdma-core.override { withManPages = false; } else super.rdma-core;
+    tpm2-tss = super.tpm2-tss.overrideAttrs (_: { doCheck = false; });
+    # jemalloc's unit test suite (check_unit, e.g. zero_reallocs and arena_reset_prof)
+    # experiences timing and address-space assertion failures under 32-bit ARM execution on
+    # 64-bit ARM host kernels (e.g. GitHub Actions ubuntu-24.04-arm running armv7l userspace).
+    # In Nixpkgs cross-compilation builds, doCheck is already disabled by default. Disable
+    # doCheck conditionally only for armv7l native (not cross) builds so dependencies like
+    # bind-9.20.30 succeed without failing on known 32-bit ARM jemalloc unit test quirks.
+    jemalloc =
+      if super.stdenv.hostPlatform.isAarch32 && super.stdenv.buildPlatform.system == super.stdenv.hostPlatform.system
+      then super.jemalloc.overrideAttrs (_: { doCheck = false; })
+      else super.jemalloc;
 
     # Things specific to mobile-nixos.
     # Not necessarily internals, but they probably won't go into <nixpkgs>.
@@ -81,6 +112,17 @@ in
         stdenv = with final; overrideCC stdenv buildPackages.clang;
       };
 
+      kernel-builder-gcc49 = callPackage ./mobile-nixos/kernel/builder.nix { };
+      kernel-builder-gcc6 = callPackage ./mobile-nixos/kernel/builder.nix {
+        stdenv = with final; overrideCC stdenv buildPackages.gcc;
+      };
+      kernel-builder-clang_8 = callPackage ./mobile-nixos/kernel/builder.nix {
+        stdenv = with final; overrideCC stdenv buildPackages.clang;
+      };
+      kernel-builder-clang_9 = callPackage ./mobile-nixos/kernel/builder.nix {
+        stdenv = with final; overrideCC stdenv buildPackages.clang;
+      };
+
       # We need to "globally" locally override some packages for stage-1.
       stage-1 = (final.appendOverlays [(import ../boot/overlay)]).mobile-nixos.stage-1;
 
