diff --git a/overlay/asteroidos/virtualkeyboard/0001-add-rime-plugin-and-layouts.patch b/overlay/asteroidos/virtualkeyboard/0001-add-rime-plugin-and-layouts.patch
new file mode 100644
index 00000000..b08fcd8e
--- /dev/null
+++ b/overlay/asteroidos/virtualkeyboard/0001-add-rime-plugin-and-layouts.patch
@@ -0,0 +1,49 @@
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -9,6 +9,36 @@
+ include(FeatureSummary)
+ include(GNUInstallDirs)
+ 
++find_package(Qt6 REQUIRED COMPONENTS Core Gui Qml Quick VirtualKeyboard)
++find_package(PkgConfig REQUIRED)
++pkg_check_modules(RIME REQUIRED rime)
++
+ add_subdirectory(styles)
+ 
++qt_add_qml_module(qtvkbrimeplugin
++    URI "QtQuick.VirtualKeyboard.Plugins.Rime"
++    VERSION 1.0
++    PLUGIN_TARGET qtvkbrimeplugin
++    SOURCES
++        rimeinputmethod.h
++        rimeinputmethod.cpp
++)
++
++target_include_directories(qtvkbrimeplugin PRIVATE ${RIME_INCLUDE_DIRS})
++target_link_libraries(qtvkbrimeplugin PRIVATE
++    Qt6::Core
++    Qt6::Gui
++    Qt6::Qml
++    Qt6::VirtualKeyboard
++    ${RIME_LIBRARIES}
++)
++
++install(TARGETS qtvkbrimeplugin
++    DESTINATION "${CMAKE_INSTALL_LIBDIR}/qt-6/qml/QtQuick/VirtualKeyboard/Plugins/Rime"
++)
++
++install(DIRECTORY layouts/
++    DESTINATION "${CMAKE_INSTALL_DATADIR}/qtvirtualkeyboard/layouts"
++)
++
+ feature_summary(WHAT ALL FATAL_ON_MISSING_REQUIRED_PACKAGES)
+--- a/styles/watch/CMakeLists.txt
++++ b/styles/watch/CMakeLists.txt
+@@ -1,4 +1,6 @@
+-set(STYLEDEST "${CMAKE_INSTALL_LIBDIR}/qml/QtQuick/VirtualKeyboard/Styles/watch")
++set(STYLEDEST "${CMAKE_INSTALL_LIBDIR}/qt-6/qml/QtQuick/VirtualKeyboard/Styles/watch")
+ install(FILES style.qml DESTINATION "${STYLEDEST}")
+ install(DIRECTORY images/ DESTINATION "${STYLEDEST}/images")
+ 
++install(FILES style.qml DESTINATION "${CMAKE_INSTALL_LIBDIR}/qml/QtQuick/VirtualKeyboard/Styles/watch")
++install(DIRECTORY images/ DESTINATION "${CMAKE_INSTALL_LIBDIR}/qml/QtQuick/VirtualKeyboard/Styles/watch/images")
diff --git a/overlay/asteroidos/virtualkeyboard/default.nix b/overlay/asteroidos/virtualkeyboard/default.nix
index f5df8828..5d616bcb 100644
--- a/overlay/asteroidos/virtualkeyboard/default.nix
+++ b/overlay/asteroidos/virtualkeyboard/default.nix
@@ -5,6 +5,8 @@
   cmake,
   pkg-config,
   qt6,
+  librime,
+  rime-data,
   buildPackages,
 }:
 
@@ -19,18 +21,31 @@ stdenv.mkDerivation (finalAttrs: {
     sha256 = "0yw1xq315p7q7illjpq92cs0060lrw94bfk8ywc7fbrr1gmkmvjf";
   };
 
+  patches = [
+    ./0001-add-rime-plugin-and-layouts.patch
+  ];
+
+  postPatch = ''
+    cp ${./rimeinputmethod.cpp} rimeinputmethod.cpp
+    cp ${./rimeinputmethod.h} rimeinputmethod.h
+    mkdir -p layouts
+    cp -r ${./layouts}/* layouts/
+  '';
+
   strictDeps = true;
 
   nativeBuildInputs = [
     cmake
     pkg-config
     qt6.wrapQtAppsHook
+    buildPackages.librime
   ];
 
   buildInputs = [
     qt6.qtbase
     qt6.qtdeclarative
     qt6.qtvirtualkeyboard
+    librime
   ];
 
   cmakeFlags = [
@@ -43,8 +58,27 @@ stdenv.mkDerivation (finalAttrs: {
     "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
   ];
 
+  # Pre-deploy common Chinese schemas (Pinyin, Shuangpin, Wubi, Cangjie, Stroke, Bopomofo, Jyutping)
+  # Upstream: https://github.com/rime/librime
+  postInstall = ''
+    mkdir -p $out/share/rime-data/build
+    cp -r ${rime-data}/share/rime-data/* $out/share/rime-data/
+
+    # Run rime_deployer on host buildPlatform to compile binary tables
+    mkdir -p build-deploy/user build-deploy/staging
+    ${buildPackages.librime}/bin/rime_deployer --add-schema \
+      luna_pinyin double_pinyin wubi86 cangjie5 stroke bopomofo jyutping \
+      build-deploy/user $out/share/rime-data
+
+    ${buildPackages.librime}/bin/rime_deployer --build \
+      build-deploy/user $out/share/rime-data build-deploy/staging || true
+
+    cp -n build-deploy/staging/* $out/share/rime-data/build/ 2>/dev/null || true
+    cp -n build-deploy/staging/* $out/share/rime-data/ 2>/dev/null || true
+  '';
+
   meta = with lib; {
-    description = "AsteroidOS on-screen virtual keyboard with watch style and layouts";
+    description = "AsteroidOS on-screen virtual keyboard with watch style, layouts, and integrated RIME input method engine";
     homepage = "https://asteroidos.org/";
     license = licenses.gpl3Plus;
     platforms = platforms.linux;
