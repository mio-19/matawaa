From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 9 Nov 2026 13:53:50 +1100
Subject: [PATCH] asteroid-bluebinder: start bluebinder at multi-user.target
 and seed board-address

The smartwatch image boots default.target -> multi-user.target and never
reaches graphical.target, so the bluebinder vhci proxy to the Android
Bluetooth HAL never started. Without it there is no hci0, and the Settings
Bluetooth toggle had no org.bluez/hci0 adapter to power on.

Also seed /var/lib/bluetooth/board-address from /persist/btmac.ini before
running bluebinder_post.sh: the vendor property ro.vendor.bt.bdaddr_path
points at /mnt/vendor/persist/bdaddr.ini, which hoki does not have, so the
upstream script exited 1 every start and board-address was never created.
---
 examples/asteroid/asteroid-desktop.nix | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index d684d006..2bb6bac2 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -481,7 +481,7 @@ in
       # Proxies the Android binder based Bluetooth HAL to BlueZ over vhci.
       systemd.services.bluebinder = {
         description = "Android binder based bluetooth proxy (vhci)";
-        wantedBy = [ "graphical.target" ];
+        wantedBy = [ "multi-user.target" ];
         after = [
           "android-init.service"
           "dbus.service"
@@ -491,7 +491,23 @@ in
           Type = "notify";
           ExecStartPre = "-${pkgs.asteroid.bluebinder}/libexec/bluebinder_wait.sh";
           ExecStart = "${pkgs.asteroid.bluebinder}/sbin/bluebinder";
-          ExecStartPost = "-${pkgs.asteroid.bluebinder}/libexec/bluebinder_post.sh";
+          # The vendor property ro.vendor.bt.bdaddr_path points at
+          # /mnt/vendor/persist/bdaddr.ini, which hoki does not have; the
+          # controller address is stored in /persist/btmac.ini instead, so
+          # bluebinder_post.sh always failed to populate board-address. Seed it
+          # from the file that exists on this device; the upstream script then
+          # takes its early-exit path.
+          ExecStartPost = [
+            "-${pkgs.writeShellScript "bluebinder-board-address" ''
+              if [ -f /var/lib/bluetooth/board-address ]; then exit 0; fi
+              if [ -f /persist/btmac.ini ]; then
+                ${pkgs.coreutils}/bin/mkdir -p /var/lib/bluetooth
+                ${pkgs.coreutils}/bin/tr -d '\r\n' < /persist/btmac.ini > /var/lib/bluetooth/board-address
+                ${pkgs.coreutils}/bin/chmod 644 /var/lib/bluetooth/board-address
+              fi
+            ''}"
+            "-${pkgs.asteroid.bluebinder}/libexec/bluebinder_post.sh"
+          ];
           Restart = "always";
           TimeoutStartSec = 60;
         };
