diff --git a/overlay/asteroidos/asteroid-launcher/circlemask-qrc.patch b/overlay/asteroidos/asteroid-launcher/circlemask-qrc.patch
new file mode 100644
index 00000000..d8a0670d
--- /dev/null
+++ b/overlay/asteroidos/asteroid-launcher/circlemask-qrc.patch
@@ -0,0 +1,15 @@
+# Upstream AsteroidOS asteroid-launcher:
+# https://github.com/AsteroidOS/asteroid-launcher/blob/master/src/qml/compositor/CircleMaskShader.qml#L43
+# Commit 960a48d2 ("speed-dial: Fix cut-off launcher items") ported shaders to Qt 6 via qt_add_shaders(),
+# but CircleMaskShader.qml omitted the "qrc:" scheme, resolving against the Linux root fs and crashing QRhi.
+# See also upstream CMakeLists.txt:
+# https://github.com/AsteroidOS/asteroid-launcher/blob/master/src/CMakeLists.txt#L69-L75
+--- a/src/qml/compositor/CircleMaskShader.qml
++++ b/src/qml/compositor/CircleMaskShader.qml
+@@ -40,5 +40,5 @@ ShaderEffect {
+     property real end: 0.25
+     property real beginning: 0.25 - smoothness
+ 
+-    fragmentShader: "/qml/compositor/circlemaskshader.frag.qsb"
++    fragmentShader: "qrc:/qml/compositor/circlemaskshader.frag.qsb"
+ }
diff --git a/overlay/asteroidos/asteroid-launcher/default.nix b/overlay/asteroidos/asteroid-launcher/default.nix
new file mode 100644
index 00000000..34a7fd1e
--- /dev/null
+++ b/overlay/asteroidos/asteroid-launcher/default.nix
@@ -0,0 +1,151 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  fetchpatch,
+  cmake,
+  pkg-config,
+  qt6,
+  qml-asteroid,
+  mlite,
+  mce-dev,
+  mce-qt6,
+  ngf-qt6,
+  usb-moded-qt6,
+  keepalive,
+  timed-qt6,
+  dbus,
+  dbus-glib,
+  systemd,
+  kdePackages,
+  buildPackages,
+  libhybris,
+  noUsrShareHook,
+}:
+
+let
+  isCross = !stdenv.buildPlatform.canExecute stdenv.hostPlatform;
+in
+stdenv.mkDerivation (finalAttrs: {
+  pname = "asteroid-launcher";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "AsteroidOS";
+    repo = "asteroid-launcher";
+    rev = "29f4257ec9835ead090c8157e46948c769081ed2";
+    sha256 = "1c7swnsqxsrfdhdim9rbq4d33ivxskkck4yz8hmridfwdzzpiv53";
+  };
+
+  strictDeps = true;
+
+  postPatch = ''
+    substituteInPlace src/qml/MainScreen.qml \
+      --replace-fail "/usr/share/asteroid-launcher" "/run/current-system/sw/share/asteroid-launcher"
+
+    substituteInPlace lipstick/src/localemanager.cpp \
+      --replace-fail '"/usr/share/translations"' "\"$out/share/translations\""
+
+    substituteInPlace lipstick/src/components/launchermodel.cpp \
+      --replace-fail '"/usr/share/lipstick/lipstick.conf"' "\"$out/share/lipstick/lipstick.conf\"" \
+      --replace-fail '#define LAUNCHER_APPS_PATH "/usr/share/applications/"' '#define LAUNCHER_APPS_PATH "/run/current-system/sw/share/applications/"' \
+      --replace-fail '#define LAUNCHER_ICONS_PATH "/usr/share/icons/hicolor/86x86/apps/"' '#define LAUNCHER_ICONS_PATH "/run/current-system/sw/share/icons/hicolor/86x86/apps/"'
+
+    substituteInPlace lipstick/src/notifications/notificationmanager.cpp \
+      --replace-fail '"/usr/share/lipstick/notificationcategories"' "\"$out/share/lipstick/notificationcategories\"" \
+      --replace-fail 'DESKTOP_ENTRY_PATH= "/usr/share/applications/"' 'DESKTOP_ENTRY_PATH= "/run/current-system/sw/share/applications/"'
+
+    substituteInPlace src/notificationsnoozer.cpp \
+      --replace-fail "/usr/bin/notificationtool" "/run/current-system/sw/bin/notificationtool"
+  '';
+
+  # AsteroidOS wayland compositor & shell
+  # Upstream repository: https://github.com/AsteroidOS/asteroid-launcher
+  patches = [
+    # QuickPanel quick-toggle button to trigger the find-phone alarm on the companion phone
+    ./find-phone.patch
+    # Tip for first-time tutorial indicating long press skips the guide
+    # Upstream PR: https://github.com/AsteroidOS/asteroid-launcher/pull/310
+    (fetchpatch {
+      url = "https://github.com/AsteroidOS/asteroid-launcher/pull/310.patch";
+      hash = "sha256-zFU7CbI4YqPSDWirkhUW5wxYwYLi0rft2AxwJ7TGqMg=";
+    })
+    # App-branded notification preview and view improvements
+    # Upstream PR: https://github.com/AsteroidOS/asteroid-launcher/pull/308
+    (fetchpatch {
+      url = "https://github.com/AsteroidOS/asteroid-launcher/pull/308.diff";
+      hash = "sha256-QzBzGPIk9khM8Q5b7ZHMhxd/TVI6UrDIthZMzn7el1I=";
+    })
+    # Remove OpacityMask dependency from the 400ms initial splash animation
+    ./splash-no-opacitymask.patch
+    # Proactively show and activate compositor window on startup (matching upstream AsteroidOS DisplayOn)
+    # Upstream Lipstick compositor display lifecycle:
+    # https://github.com/AsteroidOS/asteroid-launcher/blob/master/lipstick/src/compositor/lipstickcompositor.cpp#L364-L375
+    ./display-on-startup.patch
+    # Fix CircleMaskShader QSB fragment shader URI to use qrc scheme for round screen masking
+    # Upstream: https://github.com/AsteroidOS/asteroid-launcher/blob/master/src/qml/compositor/CircleMaskShader.qml#L43
+    # Upstream CMake qt_add_shaders: https://github.com/AsteroidOS/asteroid-launcher/blob/master/src/CMakeLists.txt#L69-L75
+    ./circlemask-qrc.patch
+    # Log which stage of the compositor scene came up, so an empty scene (black
+    # screen with a live render loop) names the failing Loader instead of
+    # leaving only "update from item" chatter in the log.
+    ./qml-boot-diagnostics.patch
+  ];
+
+  nativeBuildInputs = [
+    cmake
+    kdePackages.extra-cmake-modules
+    pkg-config
+    qt6.wrapQtAppsHook
+    noUsrShareHook
+  ];
+
+  cmakeFlags = [
+    "-DECM_DIR=${kdePackages.extra-cmake-modules}/share/ECM/cmake"
+  ]
+  ++ lib.optionals isCross [
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+    "-DQt6LinguistTools_DIR=${buildPackages.qt6.qttools}/lib/cmake/Qt6LinguistTools"
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    qt6.qtwayland
+    qt6.qtsensors
+    qt6.qtshadertools
+    qml-asteroid
+    mlite
+    mce-dev
+    mce-qt6
+    ngf-qt6
+    usb-moded-qt6
+    keepalive
+    timed-qt6
+    dbus
+    dbus-glib
+    systemd
+    libhybris
+  ];
+
+  qtWrapperArgs = [
+    "--prefix"
+    "LD_LIBRARY_PATH"
+    ":"
+    "${libhybris}/lib"
+  ];
+
+  postInstall = ''
+    install -Dm644 ${./org.nemomobile.compositor.conf} $out/share/dbus-1/system.d/org.nemomobile.compositor.conf
+  '';
+
+  meta = with lib; {
+    description = "AsteroidOS Wayland compositor and smartwatch home shell";
+    homepage = "https://asteroidos.org/";
+    license = licenses.gpl3Plus;
+    mainProgram = "asteroid-launcher";
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/asteroid-launcher/display-on-startup.patch b/overlay/asteroidos/asteroid-launcher/display-on-startup.patch
new file mode 100644
index 00000000..6d842685
--- /dev/null
+++ b/overlay/asteroidos/asteroid-launcher/display-on-startup.patch
@@ -0,0 +1,44 @@
+# Upstream reference:
+# https://github.com/AsteroidOS/asteroid-launcher/blob/master/lipstick/src/compositor/lipstickcompositor.cpp#L364-L375
+# LipstickCompositor requires DisplayOn to show and activate the compositor window.
+--- a/lipstick/src/compositor/lipstickcompositor.cpp
++++ b/lipstick/src/compositor/lipstickcompositor.cpp
+@@ -364,7 +364,13 @@
+ void LipstickCompositor::initialize()
+ {
+     m_displayState = new QMceDisplay(this);
+-    reactOnDisplayStateChanges(m_displayState->state());
++    QMceDisplay::State initialState = m_displayState->valid()
++        ? m_displayState->state()
++        : QMceDisplay::DisplayOn;
++    m_currentDisplayState = QMceDisplay::DisplayOff;
++    m_updatesEnabled = false;
++    setUpdatesEnabled(initialState != QMceDisplay::DisplayOff);
++    reactOnDisplayStateChanges(initialState);
+     connect(m_displayState, &QMceDisplay::stateChanged,
+             this, &LipstickCompositor::onDisplayStateChanged);
+ 
+@@ -588,13 +594,20 @@
+ 
+ void LipstickCompositor::reactOnDisplayStateChanges(QMceDisplay::State state)
+ {
+-    if (m_currentDisplayState == state) {
++    if (m_currentDisplayState == state && m_window->isVisible()) {
+         return;
+     }
+ 
+-    if (state == QMceDisplay::DisplayOn) {
++    if (state == QMceDisplay::DisplayOn || state == QMceDisplay::DisplayDim) {
++        m_window->showFullScreen();
++        if (m_window->handle()) {
++            QGuiApplication::platformNativeInterface()->nativeResourceForIntegration("DisplayOn");
++        }
++        emit displayAboutToBeOn();
+         m_window->setVisible(true);
+-        emit displayOn();
++        if (state == QMceDisplay::DisplayOn) {
++            emit displayOn();
++        }
+     } else if (state == QMceDisplay::DisplayOff) {
+         QCoreApplication::postEvent(this, new QTouchEvent(QEvent::TouchCancel));
+         emit displayOff();
