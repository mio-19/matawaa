index 00000000..c8fc8896
--- /dev/null
+++ b/overlay/asteroidos/asteroid-launcher/splash-no-opacitymask.patch
@@ -0,0 +1,54 @@
+--- a/src/qml/misc/Splash.qml
++++ b/src/qml/misc/Splash.qml
+@@ -30,7 +30,6 @@
+ 
+ import QtQuick
+ import org.asteroid.controls
+-import Qt5Compat.GraphicalEffects
+ 
+ Item {
+     anchors.fill: parent
+@@ -42,7 +41,6 @@
+         onTriggered: {
+             background.opacity = 0
+             logoTransform.scale = 14
+-            cutout.width = Dims.w(150)
+         }
+     }
+     Rectangle {
+@@ -60,8 +58,8 @@
+     Rectangle {
+         id: logo
+         anchors.fill: parent
+-        color: "black"
+-        visible: false
++        color: "transparent"
++        visible: true
+         Image {
+             property var logoSize: (parent.width > parent.height ? parent.height : parent.width) * 0.55
+             id: logoSvg
+@@ -80,24 +78,4 @@
