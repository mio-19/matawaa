diff --git a/devices/google-aurora/kernel/0001-video-fbdev-add-qcom-continuous-splash-framebuffer.patch b/devices/google-aurora/kernel/0001-video-fbdev-add-qcom-continuous-splash-framebuffer.patch
new file mode 100644
index 00000000..84eff1bb
--- /dev/null
+++ b/devices/google-aurora/kernel/0001-video-fbdev-add-qcom-continuous-splash-framebuffer.patch
@@ -0,0 +1,264 @@
+From 50cd91f86d0b1767ded718f610d15c85b9814f9f Mon Sep 17 00:00:00 2001
+From: Florent Revest <revestflo@gmail.com>
+Date: Thu, 18 Jun 2026 10:00:00 +0000
+Subject: [PATCH] video: fbdev: add qcom continuous-splash framebuffer
+
+Upstream-Status: Inappropriate
+
+Expose a Qualcomm bootloader continuous-splash buffer as a legacy /dev/fb0.
+The SDE/MDSS display keeps scanning the bootloader splash region until the
+userspace composer takes over, but the downstream SDE DRM driver has no fbdev
+emulation -- so simple fbdev clients (psplash) have no surface during boot.
+This minimal platform driver, bound to a 'qcom,cont-splash-fb' DT node, maps
+that already-live region write-combine into userspace; writes appear on the
+panel immediately with no modeset/DRM/kickoff. Generic across qcom ports.
+---
+ drivers/video/fbdev/Kconfig               |  11 ++
+ drivers/video/fbdev/Makefile              |   1 +
+ drivers/video/fbdev/qcom-cont-splash-fb.c | 206 ++++++++++++++++++++++
+ 3 files changed, 218 insertions(+)
+ create mode 100644 drivers/video/fbdev/qcom-cont-splash-fb.c
+
+diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
+index 662524574cc3..981bae74e89a 100644
+--- a/drivers/video/fbdev/Kconfig
++++ b/drivers/video/fbdev/Kconfig
+@@ -2241,3 +2241,14 @@ config FB_SM712
+ source "drivers/video/fbdev/omap/Kconfig"
+ source "drivers/video/fbdev/omap2/Kconfig"
+ source "drivers/video/fbdev/mmp/Kconfig"
++config FB_QCOM_CONT_SPLASH
++	tristate "Qualcomm continuous-splash framebuffer support"
++	depends on FB && OF
++	help
++	  Expose a Qualcomm bootloader continuous-splash buffer (described by a
++	  "qcom,cont-splash-fb" device-tree node) as a legacy /dev/fb0, so simple
++	  fbdev clients such as psplash can draw a boot splash into the buffer the
++	  SDE/MDSS display is already scanning, before the userspace composer
++	  takes over the display.
++
++
+diff --git a/drivers/video/fbdev/Makefile b/drivers/video/fbdev/Makefile
+index 477b9624b703..5b1776d5a7ad 100644
+--- a/drivers/video/fbdev/Makefile
++++ b/drivers/video/fbdev/Makefile
+@@ -132,3 +132,4 @@ obj-$(CONFIG_FB_SIMPLE)           += simplefb.o
+ 
+ # the test framebuffer is last
+ obj-$(CONFIG_FB_VIRTUAL)          += vfb.o
++obj-$(CONFIG_FB_QCOM_CONT_SPLASH) += qcom-cont-splash-fb.o
+diff --git a/drivers/video/fbdev/qcom-cont-splash-fb.c b/drivers/video/fbdev/qcom-cont-splash-fb.c
+new file mode 100644
+index 000000000000..f90258d39307
+--- /dev/null
++++ b/drivers/video/fbdev/qcom-cont-splash-fb.c
+@@ -0,0 +1,206 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * qcom-cont-splash-fb: expose a Qualcomm bootloader continuous-splash buffer
++ * as a legacy /dev/fb0.
++ *
++ * On Qualcomm SoCs the bootloader paints a boot logo into a reserved
++ * "continuous splash" memory region and the SDE/MDSS display keeps scanning
++ * that region out to the panel until the userspace composer takes over. The
++ * downstream SDE DRM driver intentionally ships no fbdev emulation, so there is
++ * no /dev/fb0 for simple fbdev clients (e.g. psplash) during the boot window.
++ *
++ * This driver exposes that already-live splash buffer as a minimal framebuffer:
++ * a userspace write lands in the very buffer the display is scanning, so it
++ * appears immediately -- no modeset, no DRM, no command-mode kickoff. Once the
++ * composer takes over the display the splash region is no longer scanned and
++ * this fb simply stops being visible, which is exactly the boot-splash lifetime.
++ *
++ * The buffer is described by a DT node (simple-framebuffer-style geometry):
++ *
++ *	cont-splash-fb {
++ *		compatible = "qcom,cont-splash-fb";
++ *		reg = <0x0 0x5c000000 0x0 0x90000>;
++ *		width  = <384>;
++ *		height = <384>;
++ *		stride = <1536>;
++ *		format = "x8r8g8b8";
++ *	};
++ *
++ * The region is mapped write-combine into userspace so writes drain straight to
++ * DRAM regardless of whether the display master is cache-coherent; the kernel
++ * never writes the cacheable linear alias, so no cache maintenance is needed.
++ */
++
++#include <linux/fb.h>
++#include <linux/io.h>
++#include <linux/mm.h>
++#include <linux/module.h>
++#include <linux/of.h>
++#include <linux/of_address.h>
++#include <linux/platform_device.h>
++
++struct qcsfb_format {
++	const char *name;
++	u32 bpp;
++	struct fb_bitfield transp, red, green, blue;
++};
++
++/* Names match the device-tree "format" strings used by simple-framebuffer. */
++static const struct qcsfb_format qcsfb_formats[] = {
++	{ "r5g6b5",   16, {0, 0, 0}, {11, 5, 0}, {5, 6, 0}, {0, 5, 0} },
++	{ "x8r8g8b8", 32, {0, 0, 0},  {16, 8, 0}, {8, 8, 0}, {0, 8, 0} },
++	{ "a8r8g8b8", 32, {24, 8, 0}, {16, 8, 0}, {8, 8, 0}, {0, 8, 0} },
++	{ "x8b8g8r8", 32, {0, 0, 0},  {0, 8, 0},  {8, 8, 0}, {16, 8, 0} },
++	{ "a8b8g8r8", 32, {24, 8, 0}, {0, 8, 0},  {8, 8, 0}, {16, 8, 0} },
++};
++
++struct qcsfb_par {
++	resource_size_t base;
++	resource_size_t size;
++};
++
++static int qcsfb_mmap(struct fb_info *info, struct vm_area_struct *vma)
++{
++	struct qcsfb_par *par = info->par;
++	unsigned long size = vma->vm_end - vma->vm_start;
++	unsigned long offset = (unsigned long)vma->vm_pgoff << PAGE_SHIFT;
++
++	if (offset > par->size || size > par->size - offset)
++		return -EINVAL;
++
++	vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);
++	return remap_pfn_range(vma, vma->vm_start,
++			       (par->base >> PAGE_SHIFT) + vma->vm_pgoff,
++			       size, vma->vm_page_prot);
++}
++
++/* Geometry is fixed by the bootloader; reject any reconfiguration so clients
++ * (e.g. psplash probing for a double buffer) fall back to single-buffered use. */
++static int qcsfb_check_var(struct fb_var_screeninfo *var, struct fb_info *info)
++{
++	if (var->bits_per_pixel != info->var.bits_per_pixel)
++		return -EINVAL;
++	var->xres = var->xres_virtual = info->var.xres;
++	var->yres = var->yres_virtual = info->var.yres;
++	var->xoffset = var->yoffset = 0;
++	var->red = info->var.red;
++	var->green = info->var.green;
++	var->blue = info->var.blue;
++	var->transp = info->var.transp;
++	return 0;
++}
++
++static const struct fb_ops qcsfb_ops = {
++	.owner		= THIS_MODULE,
++	.fb_check_var	= qcsfb_check_var,
++	.fb_mmap	= qcsfb_mmap,
++};
++
++static int qcsfb_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	const struct qcsfb_format *fmt = NULL;
++	struct fb_info *info;
++	struct qcsfb_par *par;
++	struct resource res;
++	const char *format;
++	u32 width, height, stride;
++	int ret, i;
++
++	ret = of_address_to_resource(dev->of_node, 0, &res);
++	if (ret)
++		return dev_err_probe(dev, ret, "missing/invalid reg\n");
++
++	if (of_property_read_u32(dev->of_node, "width", &width) ||
++	    of_property_read_u32(dev->of_node, "height", &height) ||
++	    of_property_read_u32(dev->of_node, "stride", &stride) ||
++	    of_property_read_string(dev->of_node, "format", &format))
++		return dev_err_probe(dev, -EINVAL,
++				     "need width/height/stride/format\n");
++
++	for (i = 0; i < ARRAY_SIZE(qcsfb_formats); i++) {
++		if (!strcmp(format, qcsfb_formats[i].name)) {
++			fmt = &qcsfb_formats[i];
++			break;
++		}
++	}
++	if (!fmt)
++		return dev_err_probe(dev, -EINVAL, "unsupported format '%s'\n",
++				     format);
++
++	if ((resource_size_t)stride * height > resource_size(&res))
++		return dev_err_probe(dev, -EINVAL,
++				     "geometry exceeds reserved region\n");
++
++	info = framebuffer_alloc(sizeof(*par), dev);
++	if (!info)
++		return -ENOMEM;
++	par = info->par;
++	par->base = res.start;
++	par->size = resource_size(&res);
++
++	strscpy(info->fix.id, "qcomsplash", sizeof(info->fix.id));
++	info->fix.type = FB_TYPE_PACKED_PIXELS;
++	info->fix.visual = FB_VISUAL_TRUECOLOR;
++	info->fix.accel = FB_ACCEL_NONE;
++	info->fix.line_length = stride;
++	info->fix.smem_start = res.start;
++	info->fix.smem_len = par->size;
++
++	info->var.xres = info->var.xres_virtual = width;
++	info->var.yres = info->var.yres_virtual = height;
++	info->var.bits_per_pixel = fmt->bpp;
++	info->var.transp = fmt->transp;
++	info->var.red = fmt->red;
++	info->var.green = fmt->green;
++	info->var.blue = fmt->blue;
++	info->var.activate = FB_ACTIVATE_NOW;
++	info->var.vmode = FB_VMODE_NONINTERLACED;
++	info->var.width = info->var.height = -1;
++
++	info->fbops = &qcsfb_ops;
++	info->flags = FBINFO_DEFAULT | FBINFO_VIRTFB;
++	/* Userspace maps the splash region directly (see qcsfb_mmap); the kernel
++	 * never touches a cacheable alias of it, so leave screen_base unset. */
++	info->screen_base = NULL;
++	info->screen_size = par->size;
++
++	ret = register_framebuffer(info);
++	if (ret) {
++		framebuffer_release(info);
++		return dev_err_probe(dev, ret, "register_framebuffer failed\n");
++	}
++
++	platform_set_drvdata(pdev, info);
++	dev_info(dev, "fb%d: %ux%u-%u %s splash@%pa\n", info->node,
++		 width, height, fmt->bpp, format, &res.start);
++	return 0;
++}
++
++static int qcsfb_remove(struct platform_device *pdev)
++{
++	struct fb_info *info = platform_get_drvdata(pdev);
++
++	unregister_framebuffer(info);
++	framebuffer_release(info);
++	return 0;
++}
++
++static const struct of_device_id qcsfb_of_match[] = {
++	{ .compatible = "qcom,cont-splash-fb" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, qcsfb_of_match);
++
++static struct platform_driver qcsfb_driver = {
++	.driver = {
++		.name = "qcom-cont-splash-fb",
++		.of_match_table = qcsfb_of_match,
++	},
++	.probe = qcsfb_probe,
++	.remove = qcsfb_remove,
++};
++module_platform_driver(qcsfb_driver);
++
++MODULE_DESCRIPTION("Qualcomm continuous-splash framebuffer");
++MODULE_LICENSE("GPL");
+-- 
+2.47.3
+
diff --git a/devices/google-aurora/kernel/cc-o-c-respfile.patch b/devices/google-aurora/kernel/cc-o-c-respfile.patch
new file mode 100644
index 00000000..f017ff4a
--- /dev/null
+++ b/devices/google-aurora/kernel/cc-o-c-respfile.patch
@@ -0,0 +1,29 @@
+Subject: [PATCH] kbuild: C compile via @response-file (qcacld/WiFi)
+
+cmd_cc_o_c = $(CC) $(c_flags) -c -o $@ $< — for qcacld-3.0 $(c_flags)
+(huge include+define set) makes the single /bin/sh command exceed the
+kernel MAX_ARG_STRLEN (128 KiB per argv) -> E127 before cc runs. Write
+$(c_flags) to a clang/gcc @response-file via GNU make builtin $(file
+...) (no shell/argv limit). Generic; same technique as cmd_mod.
+
+Upstream-Status: Inappropriate [aurora qcacld out-of-tree workaround]
+
+Signed-off-by: Florent Revest <revestflo@gmail.com>
+---
+--- a/scripts/Makefile.build
++++ b/scripts/Makefile.build
+@@ -156,7 +156,13 @@
+ # (See cmd_cc_o_c + relevant part of rule_cc_o_c)
+ 
+ quiet_cmd_cc_o_c = CC $(quiet_modtag)  $@
+-      cmd_cc_o_c = $(CC) $(c_flags) -c -o $@ $<
++# qcacld: $(c_flags) is so large that `$(CC) $(c_flags) ...`
++# exceeds the kernel MAX_ARG_STRLEN (128 KiB single argv) ->
++# /bin/sh "Argument list too long" (E127) before cc runs.
++# Pass flags via a clang/gcc @response-file written with GNU
++# make builtin $(file ...) (no shell/argv limit). Generic &
++# harmless for all modules. (aurora qcacld/WiFi.)
++      cmd_cc_o_c = $(file >$@.rsp,$(c_flags)) $(CC) @$@.rsp -c -o $@ $< && rm -f $@.rsp
+ 
+ ifdef CONFIG_MODVERSIONS
+ # When module versioning is enabled the following steps are executed:
diff --git a/devices/google-aurora/kernel/cmd-mod-file-func.patch b/devices/google-aurora/kernel/cmd-mod-file-func.patch
new file mode 100644
index 00000000..124bf73b
--- /dev/null
+++ b/devices/google-aurora/kernel/cmd-mod-file-func.patch
@@ -0,0 +1,36 @@
+Subject: [PATCH] kbuild: generate .mod via $(file) not printf (qcacld/WiFi)
+
+scripts/Makefile.build cmd_mod does
+  printf '%s\n' $(real-search ...) | awk ... > $@
+For a module with thousands of objects (qcacld-3.0 WiFi on aurora) the
+$(real-search) expansion becomes a single argv string that exceeds the
+kernel's MAX_ARG_STRLEN (128 KiB per argument) — /bin/sh rejects the
+printf with "Argument list too long" (NOT ARG_MAX; ulimit -s does not
+help). The module link itself already uses an @response-file, only the
+.mod generation overflows. GNU make >= 4 provides the builtin
+$(file >FILE,TEXT) which writes the list with no shell/argv limit;
+write the object list with that and dedup with awk. Fixes the qcacld
+build; harmless for all other modules. Device-specific build aid.
+
+Upstream-Status: Inappropriate [aurora qcacld build workaround for an
+old kbuild; newer kbuild already avoids the giant argv]
+
+Signed-off-by: Florent Revest <revestflo@gmail.com>
+---
+--- a/scripts/Makefile.build
++++ b/scripts/Makefile.build
+@@ -308,8 +308,12 @@
+ 	$(call if_changed,cc_lto_link_modules)
+ endif
+ 
+-cmd_mod = printf '%s\n' $(call real-search, $*.o, .o, -objs -y -m) | \
+-	$(AWK) '!x[$$0]++ { print("$(obj)/"$$0) }' > $@
++# qcacld etc. have thousands of objects: `printf '%s\n' <list>`
++# exceeds the kernel MAX_ARG_STRLEN (128 KiB single argv string).
++# Write the list via GNU make's builtin $(file ...) (no shell/argv
++# limit) then dedup with awk. (Patched for aurora qcacld/WiFi.)
++cmd_mod = $(file >$@.tmp,$(call real-search, $*.o, .o, -objs -y -m)) \
++	$(AWK) '{ for (i = 1; i <= NF; i++) if (!x[$$i]++) print "$(obj)/" $$i }' $@.tmp > $@ && rm -f $@.tmp
+ 
+ $(obj)/%.mod: FORCE
+ 	$(call if_changed,mod)
diff --git a/devices/google-aurora/kernel/default.nix b/devices/google-aurora/kernel/default.nix
new file mode 100644
index 00000000..50b08bfb
--- /dev/null
+++ b/devices/google-aurora/kernel/default.nix
@@ -0,0 +1,52 @@
+{
+  mobile-nixos,
+  fetchFromGitLab,
+  fetchurl,
+  runCommand,
+  ...
+}:
+
+# Google Pixel Watch 2 (aurora) runs an Android 13 downstream 5.15 GKI kernel.
+# Upstream UBPorts kernel source:
+# gitlab.com/ubports/porting/community-ports/android13/google-eos/kernel-for-google-eos.git (branch halium-13.0)
+let
+  src = fetchFromGitLab {
+    owner = "ubports/porting/community-ports/android13/google-eos";
+    repo = "kernel-for-google-eos";
+    rev = "063840c5aae117bf0faac8b34fba0e37c9f619f8";
+    sha256 = "0bicl1n5sqglffz31vf1092c31ygwx8achqw6zbc8wsx8pfz5aig";
+  };
+
+  # Upstream AsteroidOS kernel configuration fragment:
+  # https://github.com/AsteroidOS/meta-smartwatch/blob/873c865ca06593d239f911b76b09228ddd70eccc/meta-aurora/recipes-kernel/linux/linux-aurora/sw5100.fragment
+  sw5100Fragment = fetchurl {
+    url = "https://raw.githubusercontent.com/AsteroidOS/meta-smartwatch/873c865ca06593d239f911b76b09228ddd70eccc/meta-aurora/recipes-kernel/linux/linux-aurora/sw5100.fragment";
+    sha256 = "1p36ngv64dc1q1qjswmzxb9yzj3bx75rv2zg1gk1jfla0hp5cslm";
+  };
+
+  # Generate defconfig matching AsteroidOS linux-aurora_5.15.144.bb:
+  # merge_config.sh gki_defconfig + monaco_GKI.config + sw5100.fragment
+  configfile = runCommand "google-aurora-defconfig" { } ''
+    sh ${src}/scripts/kconfig/merge_config.sh -m -r -O . \
+      ${src}/arch/arm64/configs/gki_defconfig \
+      ${src}/arch/arm64/configs/vendor/monaco_GKI.config \
+      ${sw5100Fragment}
+    echo "# CONFIG_DEBUG_INFO_BTF is not set" >> .config
+    cp .config $out
+  '';
+in
+mobile-nixos.kernel-builder {
+  version = "5.15.144";
+  inherit configfile src;
+
+  patches = [
+    ./0001-video-fbdev-add-qcom-continuous-splash-framebuffer.patch
+    ./cc-o-c-respfile.patch
+    ./cmd-mod-file-func.patch
+    ./eud-secure-fail-nonfatal.patch
+    ./modfinal-cc-o-c-respfile.patch
+    ./rtc-pm8xxx-read-only.patch
+  ];
+
+  isModular = true;
+}
diff --git a/devices/google-aurora/kernel/eud-secure-fail-nonfatal.patch b/devices/google-aurora/kernel/eud-secure-fail-nonfatal.patch
new file mode 100644
index 00000000..d1b2d89a
--- /dev/null
+++ b/devices/google-aurora/kernel/eud-secure-fail-nonfatal.patch
@@ -0,0 +1,44 @@
+From: Florent Revest <revestflo@gmail.com>
+Subject: [PATCH] soc: qcom: eud: aurora: don't abort enable_eud() on secure-EUD failure
+
+On a production Pixel Watch 2 the TrustZone monitor rejects the
+secure-EUD enable (qcom_scm_io_writel -> rc:-22). enable_eud() then
+returns early, before its final extcon_set_state_sync(EXTCON_USB,
+true), leaving EUD's extcon stuck "disconnected". dwc3-msm is wired to
+the EUD extcon (its google,extcon-usb-shim phandle has no driver, see
+dwc3-msm-force-peripheral.patch), so it never sees a USB attach and no
+UDC is created -> USB/adb dead.
+
+The secure step only gates EUD's own debug endpoint, which is unusable
+on production anyway. Log the failure but continue so the EXTCON_USB
+attach event is still asserted -- that is all dwc3-msm needs.
+
+Upstream-Status: Inappropriate [aurora bring-up]
+Signed-off-by: Florent Revest <revestflo@gmail.com>
+---
+--- a/drivers/soc/qcom/eud.c
++++ b/drivers/soc/qcom/eud.c
+@@ -180,11 +180,19 @@
+ 	if (priv->secure_eud_en && !check_eud_mode_mgr2(priv)) {
+ 		ret = qcom_scm_io_writel(priv->eud_mode_mgr2_phys_base +
+ 				   EUD_REG_EUD_EN2, EUD_ENABLE_CMD);
+-		if (ret) {
++		if (ret)
++			/*
++			 * aurora: on production the TZ monitor rejects the
++			 * secure-EUD enable (rc:-22). That only gates EUD's
++			 * own debug endpoint, which is unusable here anyway.
++			 * Do NOT return: fall through so the EXTCON_USB=true
++			 * below is still asserted -- that extcon event is the
++			 * only thing dwc3-msm needs to bring the USB gadget
++			 * (adb) up on this watch.
++			 */
+ 			dev_err(&pdev->dev,
+-			"qcom_scm_io_writel failed with rc:%d\n", ret);
+-			return;
+-		}
++			"qcom_scm_io_writel failed rc:%d (non-fatal; EUD extcon still drives USB attach)\n",
++			ret);
+ 	}
+ 
+ 	/* Ensure Register Writes Complete */
diff --git a/devices/google-aurora/kernel/modfinal-cc-o-c-respfile.patch b/devices/google-aurora/kernel/modfinal-cc-o-c-respfile.patch
new file mode 100644
index 00000000..687b01a0
--- /dev/null
+++ b/devices/google-aurora/kernel/modfinal-cc-o-c-respfile.patch
@@ -0,0 +1,36 @@
+Subject: [PATCH] kbuild: modfinal C compile via @response-file (qcacld/WiFi)
+
+cc-o-c-respfile.patch routes $(c_flags) through an @response-file in
+scripts/Makefile.build, but scripts/Makefile.modfinal carries its own
+independent cmd_cc_o_c for the generated %.mod.o objects. That one still
+passes the flags on the command line, so building qcacld's wlan.mod.o with
+the huge -I set the recipe computes for the wlan trees exceeds the kernel
+MAX_ARG_STRLEN (128 KiB per argv):
+
+    make[3]: /bin/sh: Argument list too long
+    make[3]: *** [scripts/Makefile.modfinal:31: .../wlan.mod.o] Error 127
+
+Apply the same technique here. The filter-out stays inside the response
+file so CC_FLAGS_CFI/CFLAGS_GCOV are still dropped.
+
+Upstream-Status: Inappropriate [aurora qcacld out-of-tree workaround]
+
+Signed-off-by: Darrel Griet <dgriet@gmail.com>
+---
+--- a/scripts/Makefile.modfinal
++++ b/scripts/Makefile.modfinal
+@@ -25,7 +25,13 @@
+ part-of-module = y
+ 
+ quiet_cmd_cc_o_c = CC [M]  $@
+-      cmd_cc_o_c = $(CC) $(filter-out $(CC_FLAGS_CFI) $(CFLAGS_GCOV), $(c_flags)) -c -o $@ $<
++# qcacld: $(c_flags) carries the recipe-generated wlan -I set, which is
++# large enough that `$(CC) $(c_flags) ...` exceeds the kernel
++# MAX_ARG_STRLEN (128 KiB single argv) -> /bin/sh "Argument list too
++# long" (E127) before cc runs. Pass the flags via a clang/gcc
++# @response-file written with GNU make builtin $(file ...). (aurora
++# qcacld/WiFi.)
++      cmd_cc_o_c = $(file >$@.rsp,$(filter-out $(CC_FLAGS_CFI) $(CFLAGS_GCOV), $(c_flags))) $(CC) @$@.rsp -c -o $@ $< && rm -f $@.rsp
+ 
+ %.mod.o: %.mod.c FORCE
+ 	$(call if_changed_dep,cc_o_c)
diff --git a/devices/google-aurora/kernel/rtc-pm8xxx-read-only.patch b/devices/google-aurora/kernel/rtc-pm8xxx-read-only.patch
new file mode 100644
index 00000000..1c5e64a1
--- /dev/null
+++ b/devices/google-aurora/kernel/rtc-pm8xxx-read-only.patch
@@ -0,0 +1,42 @@
+From: Florent Revest <revestflo@gmail.com>
+Subject: [PATCH] rtc: pm8xxx: force the aurora RTC read-only
+
+Upstream-Status: Inappropriate [aurora-specific HW quirk]
+
+Aurora's (Pixel Watch 2) pm5100 RTC is writable but VOLATILE: it resets to
+~epoch (1970) on every cold boot and never retains wall-clock time. The
+device tree marks the node "allow-set-time", so userspace time daemons
+(dsme/timed) successfully write it, conclude it is a trustworthy clock, and
+then slam the system clock to the raw ~1970 RTC value -- clobbering the time
+restored at boot by swclock-offset.
+
+Force allow_set_time = false so RTC_SET_TIME returns -EACCES. dsme then takes
+its "circumventing read only RTC" delta path (anchored by its mintime floor
+and the swclock-offset-seeded system time), keeping correct wall time without
+any change to the shared dsme recipe. RTC reads and wakeup alarms do not need
+write access, so suspend wakeups keep working.
+
+Signed-off-by: Florent Revest <revestflo@gmail.com>
+--- a/drivers/rtc/rtc-pm8xxx.c
++++ b/drivers/rtc/rtc-pm8xxx.c
+@@ -656,8 +656,18 @@
+ 	if (rtc_dd->rtc_alarm_irq < 0)
+ 		return -ENXIO;
+ 
+-	rtc_dd->allow_set_time = of_property_read_bool(pdev->dev.of_node,
+-						      "allow-set-time");
++	/*
++	 * AURORA (Pixel Watch 2): the pm5100 RTC is VOLATILE -- it resets to
++	 * ~epoch on every cold boot and never holds wall-clock time. The
++	 * device tree marks the node "allow-set-time", which lets userspace
++	 * (dsme/timed) write the RTC, conclude it is a trustworthy clock and
++	 * then pull the system clock back to ~1970. Force the RTC read-only
++	 * so RTC_SET_TIME returns -EACCES: dsme's "circumventing read only
++	 * RTC" delta path then keeps correct system time (seeded by
++	 * swclock-offset), while RTC reads and wakeup alarms -- which do not
++	 * need write access -- keep working.
++	 */
++	rtc_dd->allow_set_time = false;
+ 
+ 	rtc_dd->regs = match->data;
+ 	rtc_dd->rtc_dev = &pdev->dev;
