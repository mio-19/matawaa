From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 23:20:02 +1100
Subject: [PATCH] overlay/systemd-257: expose the remaining package feature
 flags

Current NixOS checks withRepart, withHomed, withSysupdate, withUserDb, withVmspawn, and withVConsole on systemd.package. Match the vendored 257 feature selections.
---
 overlay/systemd-257/default.nix | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/overlay/systemd-257/default.nix b/overlay/systemd-257/default.nix
index 03024c23..ade399df 100644
--- a/overlay/systemd-257/default.nix
+++ b/overlay/systemd-257/default.nix
@@ -894,6 +894,12 @@ stdenv.mkDerivation (finalAttrs: {
     # systemd 257 definition predates it.
     withLogind = true;
     withNspawn = true;
+    withHomed = false;
+    withRepart = false;
+    withSysupdate = false;
+    withUserDb = true;
+    withVmspawn = true;
+    withVConsole = true;
 
     inherit
       withBootloader
