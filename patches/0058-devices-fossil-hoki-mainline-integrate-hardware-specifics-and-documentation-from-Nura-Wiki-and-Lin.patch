 # Fossil Gen 6 pure-mainline target.
 #
+# Hardware: Qualcomm Snapdragon Wear 4100+ (SDA429W / SDM429W)
+# Codename: fossil-hoki / hoki
+#
+# Mainline and community references:
+# - Nura / postmarketOS Wiki: https://wiki.nura.eco/wiki/Fossil_Gen_6_(fossil-hoki)
+# - Mainline Linux kernel PR: https://github.com/msm89x7-mainline/linux/pull/29
+# - lk2nd bootloader PR:      https://github.com/msm8916-mainline/lk2nd/pull/552
+# - postmarketOS MR:          https://gitlab.postmarketos.org/postmarketOS/pmaports/-/merge_requests/6809
+#
+# Fastboot & Boot Notes:
+# - Entering Fastboot mode: Power off the device, then hold all three physical buttons.
+# - Display: simple-framebuffer at 0x90001000 (416x416, 24-bit RGB r8g8b8, stride 1248).
+# - Rootfs: Btrfs on userdata partition (mmcblk0p50).
+#
 # This target runs the modern upstream Linux 6.18 kernel without Android
 # proprietary blobs or libhybris. It uses Freedreno Mesa graphics with DRM/KMS,
 # standard Wayland / Qt EGLFS KMS display stack, systemd 262+, and CDC-NCM USB
@@ -92,9 +106,9 @@
   };
 
