From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:06:36 +1100
Subject: [PATCH] update nixpkgs to current nixos-unstable (npins)

Refresh the npins channel pin used by Mobile-NixOS from
nixos-26.11pre1031299.0bb7ec54c848 to
nixos-26.11pre1095516.09063bd1f2b3.

This keeps the target userland and cross-compilation toolchains on the
current nixos-unstable snapshot. The pin is expressed as a channel tarball
so it remains reproducible without adding a separate Nixpkgs flake input.
---
 npins/sources.json                            |  6 +-
 overlay/mobile-nixos/kernel/builder.nix       |  4 +-
 .../0001-qt6-cross-host-leak.patch            | 95 +++++++++++++++++++
 pkgs.nix                                      | 30 +++---
 4 files changed, 117 insertions(+), 18 deletions(-)
 create mode 100644 overlay/nixpkgs-patches/0001-qt6-cross-host-leak.patch

diff --git a/npins/sources.json b/npins/sources.json
index 8a487595..b500edf6 100644
--- a/npins/sources.json
+++ b/npins/sources.json
@@ -3,9 +3,9 @@
     "nixpkgs": {
       "type": "Channel",
       "name": "nixos-unstable",
-      "artifact": "nixexprs.tar.xz",
-      "url": "https://releases.nixos.org/nixos/unstable/nixos-26.11pre1031299.0bb7ec54c848/nixexprs.tar.xz",
-      "hash": "sha256-nFgG4gPQueCgP8LidXsdI2lYPrSwTcmDl6afcVn7F/U="
+      "artifact": "nixexprs.tar.zst",
+      "url": "https://releases.nixos.org/nixos/unstable/nixos-26.11pre1100280.3ec636362e18/nixexprs.tar.zst",
+      "hash": "sha256-17eNBI5Khe4JZaRkL5hRGPWf8MZ6qv+bWAr4V8YeKBw="
     }
   },
   "version": 8
diff --git a/overlay/mobile-nixos/kernel/builder.nix b/overlay/mobile-nixos/kernel/builder.nix
index 7fd32f28..a4588661 100644
--- a/overlay/mobile-nixos/kernel/builder.nix
+++ b/overlay/mobile-nixos/kernel/builder.nix
@@ -244,8 +244,8 @@ stdenv.mkDerivation (inputArgs // {
   patches =
     map (p: p.patch) kernelPatches
     # Required for deterministic builds along with some postPatch magic.
-    ++ optional ((lib.versionAtLeast version "4.13" && lib.versionOlder version "5.19")) (nixosKernelPath + "/randstruct-provide-seed.patch")
-    ++ optional ((lib.versionAtLeast version "5.19")) (nixosKernelPath + "/randstruct-provide-seed-5.19.patch")
+    ++ optional (lib.versionAtLeast version "4.13" && lib.versionOlder version "5.19" && builtins.pathExists (nixosKernelPath + "/randstruct-provide-seed.patch")) (nixosKernelPath + "/randstruct-provide-seed.patch")
+    ++ optional (lib.versionAtLeast version "5.19" && builtins.pathExists (nixosKernelPath + "/randstruct-provide-seed-5.19.patch")) (nixosKernelPath + "/randstruct-provide-seed-5.19.patch")
     ++ optional (enableDefaultYYLOCPatch && lib.versionOlder version "4.0") ./gcc10-extern_YYLOC_global_declaration.patch
     ++ optional (enableForceLogoPatch && lib.versionAtLeast version "5.4")
       (fetchpatch {
diff --git a/overlay/nixpkgs-patches/0001-qt6-cross-host-leak.patch b/overlay/nixpkgs-patches/0001-qt6-cross-host-leak.patch
new file mode 100644
index 00000000..85a8660f
--- /dev/null
+++ b/overlay/nixpkgs-patches/0001-qt6-cross-host-leak.patch
@@ -0,0 +1,95 @@
+diff -Naur a/pkgs/development/libraries/qt-6/hooks/qtbase-setup-hook.sh b/pkgs/development/libraries/qt-6/hooks/qtbase-setup-hook.sh
+--- a/pkgs/development/libraries/qt-6/hooks/qtbase-setup-hook.sh	2026-10-26 18:18:24.965845052 +1100
++++ b/pkgs/development/libraries/qt-6/hooks/qtbase-setup-hook.sh	2026-10-26 18:57:18.562221958 +1100
+@@ -16,7 +16,14 @@
+     . @fix_qt_module_paths@
+ 
+     # Build tools are often confused if QMAKE is unset.
+-    export QMAKE=@qtbaseOut@/bin/qmake
++    if [[ -n "@qtHostPath@" && "@qtHostPath@" != "@"* ]]; then
++        export QT_HOST_PATH="@qtHostPath@"
++        export QMAKE="@qtHostPath@/bin/qmake"
++        appendToVar cmakeFlags "-DQT_HOST_PATH=@qtHostPath@"
++        appendToVar cmakeFlags "-DQt6HostInfo_DIR=@qtHostPath@/lib/cmake/Qt6HostInfo"
++    else
++        export QMAKE=@qtbaseOut@/bin/qmake
++    fi
+ 
+     export QMAKEPATH=
+ 
+diff -Naur a/pkgs/development/libraries/qt-6/modules/qtbase/default.nix b/pkgs/development/libraries/qt-6/modules/qtbase/default.nix
+--- a/pkgs/development/libraries/qt-6/modules/qtbase/default.nix	2026-10-26 18:18:24.968845041 +1100
++++ b/pkgs/development/libraries/qt-6/modules/qtbase/default.nix	2026-10-26 18:57:09.250324045 +1100
+@@ -345,6 +345,15 @@
+     substituteInPlace "''${!outputDev}/nix-support/setup-hook" \
+       --replace-fail "@qtbaseOut@" $out
+   ''
++  + lib.optionalString isCrossBuild ''
++    for f in qmake qmake6 qtpaths qtpaths6 target_qt.conf; do
++      rm -f "$out/bin/$f"
++    done
++    if [ -f "$out/lib/cmake/Qt6/Qt6Dependencies.cmake" ]; then
++      sed -i 's|set(__qt_platform_initial_qt_host_path ".*")|set(__qt_platform_initial_qt_host_path "")|' "$out/lib/cmake/Qt6/Qt6Dependencies.cmake"
++      sed -i 's|set(__qt_platform_initial_qt_host_path_cmake_dir ".*")|set(__qt_platform_initial_qt_host_path_cmake_dir "")|' "$out/lib/cmake/Qt6/Qt6Dependencies.cmake"
++    fi
++  ''
+   + lib.optionalString stdenv.hostPlatform.isLinux ''
+     # FIXME: not sure why this isn't added automatically?
+     patchelf --add-rpath "${libmysqlclient}/lib/mariadb" $out/${qtPluginPrefix}/sqldrivers/libqsqlmysql.so
+@@ -364,6 +373,7 @@
+             qtPluginPrefix
+             qtQmlPrefix
+             ;
++          qtHostPath = lib.optionalString isCrossBuild "${pkgsBuildBuild.qt6.qtbase}";
+         };
+         meta.license = lib.licenses.mit;
+       } ../../hooks/qtbase-setup-hook.sh;
+diff -Naur a/pkgs/development/libraries/qt-6/qtModule.nix b/pkgs/development/libraries/qt-6/qtModule.nix
+--- a/pkgs/development/libraries/qt-6/qtModule.nix	2026-10-26 18:18:24.970845034 +1100
++++ b/pkgs/development/libraries/qt-6/qtModule.nix	2026-10-26 18:19:48.939548241 +1100
+@@ -8,6 +8,7 @@
+   moveBuildTree,
+   srcs,
+   patches ? [ ],
++  pkgsBuildBuild,
+ }:
+ 
+ args:
+@@ -51,6 +52,10 @@
+       # to query the version.
+       "-DQT_INTERNAL_XCODE_VERSION=0.1"
+     ]
++    ++ lib.optionals (!stdenv.buildPlatform.canExecute stdenv.hostPlatform) [
++      "-DQT_HOST_PATH=${pkgsBuildBuild.qt6.qtbase}"
++      "-DQt6HostInfo_DIR=${pkgsBuildBuild.qt6.qtbase}/lib/cmake/Qt6HostInfo"
++    ]
+     ++ args.cmakeFlags or [ ];
+ 
+     moveToDev = false;
+diff -Naur a/pkgs/kde/lib/mk-kde-derivation.nix b/pkgs/kde/lib/mk-kde-derivation.nix
+--- a/pkgs/kde/lib/mk-kde-derivation.nix	2026-10-26 18:18:24.972845027 +1100
++++ b/pkgs/kde/lib/mk-kde-derivation.nix	2026-10-26 18:20:16.429451076 +1100
+@@ -9,6 +9,7 @@
+   python3,
+   python3Packages,
+   jq,
++  pkgsBuildBuild,
+ }:
+ let
+   dependencies = (lib.importJSON ../generated/dependencies.json).dependencies;
+@@ -141,7 +142,14 @@
+     propagatedBuildInputs = deps ++ extraPropagatedBuildInputs;
+     strictDeps = true;
+ 
+-    cmakeFlags = [ "-DQT_MAJOR_VERSION=6" ] ++ extraCmakeFlags;
++    cmakeFlags = [
++      "-DQT_MAJOR_VERSION=6"
++    ]
++    ++ lib.optionals (!stdenv.buildPlatform.canExecute stdenv.hostPlatform) [
++      "-DQT_HOST_PATH=${pkgsBuildBuild.qt6.qtbase}"
++      "-DQt6HostInfo_DIR=${pkgsBuildBuild.qt6.qtbase}/lib/cmake/Qt6HostInfo"
++    ]
++    ++ extraCmakeFlags;
+ 
+     doInstallCheck = true;
+ 
diff --git a/pkgs.nix b/pkgs.nix
index da735500..4c458690 100644
--- a/pkgs.nix
+++ b/pkgs.nix
@@ -7,22 +7,26 @@
 # The pinning is now managed using `npins`.
 #
 let
-  inherit (import ./npins)
-    nixpkgs
-  ;
+  rawNixpkgs = (import ./npins).nixpkgs;
   channelInfo =
     builtins.match
       # https://releases.nixos.org/nixos/unstable/nixos-25.05beta723344.d3c42f187194/nixexprs.tar.xz
       "https?://(.*)/([^/]+)/([^/]+)/([^/]+)/.*"
-      nixpkgs.url
-  ;
-  channelName =
-    builtins.concatStringsSep "-" [
-      (builtins.elemAt channelInfo 1)
-      (builtins.elemAt channelInfo 2)
-    ]
-  ;
+      rawNixpkgs.url;
+  channelName = builtins.concatStringsSep "-" [
+    (builtins.elemAt channelInfo 1)
+    (builtins.elemAt channelInfo 2)
+  ];
   identifier = builtins.elemAt channelInfo 3;
+
+  bootstrapPkgs = import rawNixpkgs { };
+
+  nixpkgs = bootstrapPkgs.applyPatches {
+    name = "nixpkgs-patched";
+    src = rawNixpkgs;
+    patches = [
+      ./overlay/nixpkgs-patches/0001-qt6-cross-host-leak.patch
+    ];
+  };
 in
-builtins.trace "(Using pinned Nixpkgs; ${channelName} @ ${identifier})"
-(import nixpkgs)
+builtins.trace "(Using pinned Nixpkgs; ${channelName} @ ${identifier})" (import nixpkgs)
