From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sun, 1 Nov 2026 12:22:08 +1100
Subject: [PATCH] Match Android headers across libhybris consumers

Use the Android headers selected by libhybris for the HWC plugin, SensorFW, and MCE plugin. ARM buffer base alignment and field offsets differ between generic Android 6 headers and Hoki Android 9 headers. Remove independent header arguments so callPackage cannot silently inject generic headers. Preserve allocation diagnostics for on-device verification.
---
 .../hwcomposer-allocation-diagnostics.patch   | 31 +++++++++++++++++++
 devices/fossil-hoki/hybris.nix                |  2 ++
 examples/asteroid/asteroid-desktop.nix        |  1 +
 overlay/asteroidos/default.nix                |  3 +-
 .../mce-plugin-libhybris/default.nix          |  9 ++----
 .../qt6-qpa-hwcomposer-plugin/default.nix     | 31 +++++++------------
 overlay/asteroidos/sensorfw/default.nix       | 31 ++++++-------------
 overlay/libhybris/default.nix                 | 23 +++-----------
 8 files changed, 64 insertions(+), 67 deletions(-)
 create mode 100644 devices/fossil-hoki/hwcomposer-allocation-diagnostics.patch

diff --git a/devices/fossil-hoki/hwcomposer-allocation-diagnostics.patch b/devices/fossil-hoki/hwcomposer-allocation-diagnostics.patch
new file mode 100644
index 00000000..cb9ddd4b
--- /dev/null
+++ b/devices/fossil-hoki/hwcomposer-allocation-diagnostics.patch
@@ -0,0 +1,31 @@
+--- a/egl/platforms/hwcomposer/hwcomposer_window.cpp
++++ b/egl/platforms/hwcomposer/hwcomposer_window.cpp
+@@ -106,7 +106,27 @@
+     busy = 0;
+     status = 0;
+ 
+-    hybris_gralloc_allocate(width, height, format, (uint32_t)usage, &handle, (uint32_t*)&stride);
++    const int allocationResult =
++        hybris_gralloc_allocate(width, height, format, (uint32_t)usage,
++                                &handle, (uint32_t*)&stride);
++
++    if (getenv("HYBRIS_HWC_DEBUG")) {
++        const native_handle_t *nativeHandle = handle;
++        fprintf(stderr,
++                "hybris-hwc: allocate this=%p native=%p requested=%ux%u "
++                "format=0x%x usage=0x%" PRIx64 " result=%d "
++                "buffer=%ux%u stride=%d format=0x%x usage=0x%" PRIx64 " "
++                "handle=%p numFds=%d numInts=%d fd0=%d\n",
++                this, static_cast<ANativeWindowBuffer *>(this),
++                width, height, format, usage, allocationResult,
++                ANativeWindowBuffer::width, ANativeWindowBuffer::height,
++                ANativeWindowBuffer::stride, ANativeWindowBuffer::format,
++                ANativeWindowBuffer::usage, nativeHandle,
++                nativeHandle ? nativeHandle->numFds : -1,
++                nativeHandle ? nativeHandle->numInts : -1,
++                (nativeHandle && nativeHandle->numFds > 0)
++                    ? nativeHandle->data[0] : -1);
++    }
+ 
+     TRACE("width=%d height=%d stride=%d format=x%x usage=x%x status=%s this=%p",
+         width, height, stride, format, usage, strerror(-status), this);
