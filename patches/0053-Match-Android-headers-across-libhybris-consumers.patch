+++ b/overlay/asteroidos/mce-plugin-libhybris/default.nix
@@ -11,10 +11,6 @@
   pkg-config,
   glib,
   libhybris,
-  # The plugin includes <android-config.h>, <system/window.h> and
-  # <hardware/lights.h>, which must match the headers libhybris was built
-  # against.
-  android-headers ? libhybris.passthru.androidHeaders,
 }:
 
 stdenv.mkDerivation {
@@ -43,8 +39,9 @@ stdenv.mkDerivation {
     "-I${glib.dev}/lib/glib-2.0/include"
     # glibconfig.h is arch-specific and lives in the main output.
     "-I${glib}/lib/glib-2.0/include"
-    "-I${android-headers}/include"
-    "-I${android-headers}/include/android"
+    # Use libhybris's device headers directly. A defaulted android-headers
