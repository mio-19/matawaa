From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sun, 1 Nov 2026 21:37:27 +1100
Subject: [PATCH] Expose system PATH to AsteroidOS user services and authorize
 timezone setting

---
 examples/asteroid/asteroid-desktop.nix | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index a0c1cdf8..a44898fb 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -736,6 +736,14 @@ in
       };
     };
 
+    # AsteroidOS desktop entries and service wrappers invoke apps through
+    # `invoker`. Expose the system profile to all systemd user services so
+    # AsteroidOS apps and service wrappers can find `invoker`, core utilities,
+    # and wrappers without conflicting with the system-level user manager service.
+    systemd.user.settings.Manager = {
+      DefaultEnvironment = "PATH=/run/wrappers/bin:/run/current-system/sw/bin";
+    };
+
     # Upstream AsteroidOS setcap's the launcher with cap_wake_alarm and
     # cap_block_suspend for always-on-display ticks. File capabilities make the
     # kernel set AT_SECURE, and glibc then discards LD_PRELOAD/LD_LIBRARY_PATH —
@@ -800,6 +808,13 @@ in
             subject.user == "ceres") {
           return polkit.Result.YES;
         }
+        if ((action.id == "org.freedesktop.timedate1.set-timezone" ||
+             action.id == "org.freedesktop.timedate1.set-time" ||
+             action.id == "org.freedesktop.timedate1.set-local-rtc" ||
+             action.id == "org.freedesktop.timedate1.set-ntp") &&
+            subject.user == "ceres") {
+          return polkit.Result.YES;
+        }
       });
     '';
 
