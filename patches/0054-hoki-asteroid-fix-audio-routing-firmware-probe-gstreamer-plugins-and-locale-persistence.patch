From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sun, 8 Nov 2026 19:10:51 +1100
Subject: [PATCH] hoki/asteroid: fix audio routing, firmware probe, gstreamer
 plugins, and locale persistence

---
 devices/fossil-hoki/default.nix        | 7 ++++---
 examples/asteroid/asteroid-desktop.nix | 4 +++-
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/devices/fossil-hoki/default.nix b/devices/fossil-hoki/default.nix
index 11bf6c15..3d9fa2be 100644
--- a/devices/fossil-hoki/default.nix
+++ b/devices/fossil-hoki/default.nix
@@ -168,6 +168,7 @@ in
   # closure so the kernel direct firmware loader (/sys/module/firmware_class/parameters/path)
   # finds a530_pm4.fw, a530_pfp.fw, a506_zap.*, ice40.bin, and tfa98xx.cnt.
   hardware.firmware = [ hokiFirmware ];
+  mobile.boot.stage-1.firmware = [ hokiFirmware ];
 
   # Hardware audio mixer DAI link routing for NXP TFA98xx speaker amplifier & digital mic
   # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/issues/343
@@ -215,11 +216,11 @@ in
 
         if [ -e /proc/asound/card0 ]; then
           # QUAT_MI2S_RX connects MultiMedia1 frontend to TFA98xx speaker amplifier DAI link
-          tinymix -D 0 "QUAT_MI2S_RX Audio Mixer MultiMedia1" 1 || true
+          tinymix -D 0 set "QUAT_MI2S_RX Audio Mixer MultiMedia1" 1 1 || true
           # TERT_MI2S_TX connects digital microphone to MultiMedia1 capture frontend
-          tinymix -D 0 "MultiMedia1 Mixer TERT_MI2S_TX" 1 || true
+          tinymix -D 0 set "MultiMedia1 Mixer TERT_MI2S_TX" 1 || true
           # Route digital mic 1 to DEC1
-          tinymix -D 0 "DEC1 MUX" "DMIC1" || true
+          tinymix -D 0 set "DEC1 MUX" "DMIC1" || true
         fi
       '';
     };
diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index ae813782..de27dd0a 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -104,6 +104,7 @@ in
         asteroid.qml-asteroid
         # Sound and feedback pipelines
         gst_all_1.gstreamer
+        gst_all_1.gstreamer.out
         gst_all_1.gst-plugins-base
         gst_all_1.gst-plugins-good
         # Provides the invoker command used by AsteroidOS Qt app launchers.
@@ -216,8 +217,9 @@ in
       "d /var/lib/timed/shared_settings 0775 ceres users -"
       # Upstream supported-languages_git.bb seeds the ceres locale drop-in that
       # user@.service.d/locale.conf reads (installed via environment.etc below).
+      # Use "C" (create only if non-existent) to allow user locale selections to persist across reboots.
       "d /home/.system/var/lib/environment/1000 0755 ceres users -"
-      "C+ /home/.system/var/lib/environment/1000/locale.conf 0644 ceres users - ${
+      "C /home/.system/var/lib/environment/1000/locale.conf 0644 ceres users - ${
         pkgs.writeText "asteroid-locale.conf" ''
           # Default locale generated dynamically from config.i18n.defaultLocale
           LANG=${config.i18n.defaultLocale}
