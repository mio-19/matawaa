diff --git a/overlay/patches/systemd-261-faccessat-old-kernel.patch b/overlay/patches/systemd-261-faccessat-old-kernel.patch
new file mode 100644
index 00000000..9fd1fd0b
--- /dev/null
+++ b/overlay/patches/systemd-261-faccessat-old-kernel.patch
@@ -0,0 +1,19 @@
+# systemd 261 uses faccessat(fd, "", X_OK, AT_EMPTY_PATH) to verify
+# executables. Vendor 4.14 kernels return EINVAL for AT_EMPTY_PATH,
+# which makes pin_callout_binary() fail and systemd freeze at startup.
+# Fall back to access(path, X_OK) on EINVAL as well as ENOSYS.
+
+--- a/src/basic/path-util.c
++++ b/src/basic/path-util.c
+@@ -687,8 +687,9 @@
+                 return r;
+ 
+         r = access_fd(fd, X_OK);
+-        if (r == -ENOSYS)
+-                /* /proc/ is not mounted. Fall back to access(). */
++        if (IN_SET(r, -ENOSYS, -EINVAL))
++                /* /proc/ is not mounted, or the kernel does not support
++                 * faccessat(AT_EMPTY_PATH) (Linux < 5.8). Fall back to access(). */
+                 r = RET_NERRNO(access(name, X_OK));
+         if (r < 0)
+                 return r;
diff --git a/overlay/patches/systemd-261-mountpoint-old-kernel.patch b/overlay/patches/systemd-261-mountpoint-old-kernel.patch
new file mode 100644
index 00000000..cb5a10e2
--- /dev/null
+++ b/overlay/patches/systemd-261-mountpoint-old-kernel.patch
@@ -0,0 +1,143 @@
+# Backport systemd v257 mount-point detection fallback for kernels without
+# STATX_ATTR_MOUNT_ROOT (Linux < 6.8), such as the vendor 4.14 kernels used
+# by supported watches.
+# Reference: https://github.com/systemd/systemd/blob/v257/src/basic/mountpoint-util.c
+
+--- a/src/basic/mountpoint-util.c
++++ b/src/basic/mountpoint-util.c
+@@ -240,7 +240,10 @@
+ }
+ 
+ int is_mount_point_at(int dir_fd, const char *path, int flags) {
+-        int r;
++        _cleanup_close_ int fd = -EBADF;
++        _cleanup_free_ struct file_handle *h = NULL, *h_parent = NULL;
++        int mount_id = -1, mount_id_parent = -1, r;
++        bool nosupp = false;
+ 
+         assert(wildcard_fd_is_valid(dir_fd));
+         assert((flags & ~AT_SYMLINK_FOLLOW) == 0);
+@@ -261,25 +264,109 @@
+                         /* optional_mask = */ 0,
+                         STATX_ATTR_MOUNT_ROOT,
+                         &sx);
+-        if (r < 0)
++        if (r >= 0) {
++                if (FLAGS_SET(sx.stx_attributes, STATX_ATTR_MOUNT_ROOT))
++                        return true;
++
++                /* When running on chroot environment, the root may not be a mount point, but we unconditionally
++                 * return true when the input is "/" in the above, but the shortcut may not work e.g. when the path
++                 * is relative. */
++                struct statx sx2;
++                r = xstatx(AT_FDCWD,
++                           "/",
++                           AT_STATX_DONT_SYNC,
++                           STATX_TYPE|STATX_INO,
++                           &sx2);
++                if (r < 0)
++                        return r;
++
++                return statx_inode_same(&sx, &sx2);
++        }
++
++        /* Linux before 6.8 does not expose STATX_ATTR_MOUNT_ROOT. Fall back to the
++         * name_to_handle_at()/fstat() logic used by older systemd releases. */
++        if (!IN_SET(r, -EUNATCH, -EINVAL) &&
++            !ERRNO_IS_NEG_NOT_SUPPORTED(r) &&
++            !ERRNO_IS_NEG_PRIVILEGE(r))
+                 return r;
+ 
+-        if (FLAGS_SET(sx.stx_attributes, STATX_ATTR_MOUNT_ROOT))
++        if (isempty(path)) {
++                if (dir_fd == XAT_FDROOT)
++                        fd = open("/", O_PATH|O_DIRECTORY|O_CLOEXEC);
++                else if (dir_fd == AT_FDCWD)
++                        fd = open(".", O_PATH|O_DIRECTORY|O_CLOEXEC);
++                else
++                        fd = fcntl(dir_fd, F_DUPFD_CLOEXEC, 3);
++        } else {
++                _cleanup_close_ int root_fd = -EBADF;
++
++                if (dir_fd == XAT_FDROOT) {
++                        root_fd = open("/", O_PATH|O_DIRECTORY|O_CLOEXEC);
++                        if (root_fd < 0)
++                                return -errno;
++                }
++
++                fd = openat(dir_fd == XAT_FDROOT ? root_fd : dir_fd, path,
++                            O_PATH|O_CLOEXEC|
++                            (FLAGS_SET(flags, AT_SYMLINK_FOLLOW) ? 0 : O_NOFOLLOW));
++        }
++        if (fd < 0)
++                return -errno;
++
++        r = name_to_handle_at_try_fid(fd, "", &h, &mount_id, /* ret_unique_mnt_id= */ NULL, AT_EMPTY_PATH);
++        if (r < 0) {
++                if (r == -ENOTDIR)
++                        goto fallback_fstat;
++                if (is_name_to_handle_at_fatal_error(r))
++                        return r;
++                if (!ERRNO_IS_NEG_NOT_SUPPORTED(r))
++                        goto fallback_fstat;
++                nosupp = true;
++        }
++
++        r = name_to_handle_at_try_fid(fd, "..", &h_parent, &mount_id_parent, /* ret_unique_mnt_id= */ NULL, 0);
++        if (r < 0) {
++                if (r == -ENOTDIR)
++                        goto fallback_fstat;
++                if (is_name_to_handle_at_fatal_error(r))
++                        return r;
++                if (!ERRNO_IS_NEG_NOT_SUPPORTED(r))
++                        goto fallback_fstat;
++                if (nosupp)
++                        goto fallback_fstat;
++
++                /* The parent does not support name_to_handle_at() but the path
++                 * does, so the path must be a mount point. */
++                return true;
++        }
++        if (nosupp)
+                 return true;
+ 
+-        /* When running on chroot environment, the root may not be a mount point, but we unconditionally
+-         * return true when the input is "/" in the above, but the shortcut may not work e.g. when the path
+-         * is relative. */
+-        struct statx sx2;
+-        r = xstatx(AT_FDCWD,
+-                   "/",
+-                   AT_STATX_DONT_SYNC,
+-                   STATX_TYPE|STATX_INO,
+-                   &sx2);
+-        if (r < 0)
+-                return r;
++        if (file_handle_equal(h_parent, h))
++                return true;
++
++        return mount_id != mount_id_parent;
++
++fallback_fstat:
++        {
++                struct stat a, b;
++
++                if (fstat(fd, &a) < 0)
++                        return -errno;
++
++                /* Files and symlinks are never mount points. */
++                if (!S_ISDIR(a.st_mode))
++                        return false;
++
++                if (fstatat(fd, "..", &b, 0) < 0)
++                        return -errno;
++
++                /* A directory with the same device and inode as its parent is the root directory. */
++                if (stat_inode_same(&a, &b))
++                        return true;
+ 
+-        return statx_inode_same(&sx, &sx2);
++                return a.st_dev != b.st_dev;
++        }
+ }
+ 
+ /* flags can be AT_SYMLINK_FOLLOW or 0 */
diff --git a/overlay/patches/systemd-262-close-range-old-kernel.patch b/overlay/patches/systemd-262-close-range-old-kernel.patch
new file mode 100644
index 00000000..462eaa31
--- /dev/null
+++ b/overlay/patches/systemd-262-close-range-old-kernel.patch
@@ -0,0 +1,92 @@
+# systemd 262's close_all_fds() uses close_range(), which is unavailable on
+# Linux < 5.9. On the hoki 4.14 kernel every service fails at step FDS with
+# "Function not implemented" or "Operation not permitted" (status=202/FDS).
+#
+# Probe close_range() once. When it is missing, close descriptors through
+# /proc/self/fd. The old close_all_fds_frugal() fallback refuses to loop over
+# RLIMIT_NOFILE (1073741791) potential fds, so it cannot be used for the
+# service-manager path. Keep the /proc-less fallback for
+# close_all_fds_without_malloc(), which must remain safe in signal handler
+# context.
+#
+# Reference: https://github.com/systemd/systemd/blob/v262/src/basic/fd-util.c
+--- a/src/basic/fd-util.c
++++ b/src/basic/fd-util.c
+@@ -325,11 +325,27 @@
+         }
+ }
+ 
++static bool close_range_supported(void) {
++        static int cached = -1;
++
++        if (cached < 0) {
++                if (close_range(INT_MAX, INT_MAX, 0) < 0 && errno == ENOSYS)
++                        cached = 0;
++                else
++                        cached = 1;
++        }
++
++        return cached > 0;
++}
++
+ int close_all_fds_without_malloc(const int except[], size_t n_except) {
+         int r;
+ 
+         assert(n_except == 0 || except);
+ 
++        if (!close_range_supported())
++                return close_all_fds_frugal(except, n_except);
++
+         r = close_all_fds_special_case(except, n_except);
+         if (r < 0)
+                 return r;
+@@ -339,11 +355,49 @@
+         return close_all_fds_frugal(except, n_except);
+ }
+ 
++static int close_all_fds_procfs(const int except[], size_t n_except) {
++        _cleanup_closedir_ DIR *d = NULL;
++        int r = 0;
++
++        d = opendir("/proc/self/fd");
++        if (!d)
++                return -errno;
++
++        for (;;) {
++                struct dirent *de;
++                int fd;
++
++                errno = 0;
++                de = readdir(d);
++                if (!de) {
++                        if (errno > 0)
++                                return -errno;
++                        break;
++                }
++
++                if (de->d_name[0] == '.')
++                        continue;
++                if (safe_atoi(de->d_name, &fd) < 0)
++                        continue;
++                if (fd < 3 || fd == dirfd(d))
++                        continue;
++                if (fd_in_set(fd, except, n_except))
++                        continue;
++
++                RET_GATHER(r, close_nointr(fd));
++        }
++
++        return r;
++}
++
+ int close_all_fds(const int except[], size_t n_except) {
+         int r;
+ 
+         assert(n_except == 0 || except);
+ 
++        if (!close_range_supported())
++                return close_all_fds_procfs(except, n_except);
++
+         r = close_all_fds_special_case(except, n_except);
+         if (r < 0)
+                 return r;
diff --git a/overlay/patches/systemd-262-epoll-pwait2-old-kernel.patch b/overlay/patches/systemd-262-epoll-pwait2-old-kernel.patch
new file mode 100644
index 00000000..fd54bbb1
--- /dev/null
+++ b/overlay/patches/systemd-262-epoll-pwait2-old-kernel.patch
@@ -0,0 +1,19 @@
+# systemd 262 uses epoll_pwait2 (Linux 5.11). The vendor 4.14 kernel can
+# return EINVAL for the unimplemented syscall instead of ENOSYS; treat that
+# like a missing syscall and fall back to epoll_wait().
+--- a/src/libsystemd/sd-event/sd-event.c
++++ b/src/libsystemd/sd-event/sd-event.c
+@@ -4643,7 +4643,12 @@
+                                 /* sigmask= */ NULL);
+                 if (r >= 0)
+                         return r;
+-                if (!ERRNO_IS_NOT_SUPPORTED(errno) && !ERRNO_IS_PRIVILEGE(errno))
++
++                /* The vendor 4.14 kernel may return EINVAL for the unimplemented
++                 * epoll_pwait2 syscall. Treat it like a missing syscall and fall
++                 * back to epoll_wait(). */
++                if (!ERRNO_IS_NOT_SUPPORTED(errno) && !ERRNO_IS_PRIVILEGE(errno) &&
++                    errno != EINVAL)
+                         return -errno; /* Only fallback to old epoll_wait() if the syscall is masked or not
+                                         * supported. */
+ 
diff --git a/overlay/patches/systemd-262-pidfd-old-kernel.patch b/overlay/patches/systemd-262-pidfd-old-kernel.patch
new file mode 100644
index 00000000..f1a18f53
--- /dev/null
+++ b/overlay/patches/systemd-262-pidfd-old-kernel.patch
@@ -0,0 +1,37 @@
+# systemd 262 pidfd fallbacks for vendor kernels older than Linux 5.8.
+#
+# The hoki 4.14 kernel has incomplete pidfd support: pidfd_open() may exist
+# while waitid(P_PIDFD) returns EINVAL. systemd 262 treats that as fatal:
+#
+#   Failed to wait for '(environment-generators)': Invalid argument
+#   Freezing execution.
+#
+# Fall back to waitid(P_PID) when the pidfd wait is unsupported.
+#
+# Reference: https://github.com/systemd/systemd/blob/v262/src/basic/pidref.c
+--- a/src/basic/pidref.c
++++ b/src/basic/pidref.c
+@@ -108,7 +108,8 @@
+         if (fd < 0) {
+                 /* Graceful fallback in case the kernel is out of fds.
+                  * The PIDFD_THREAD flag is supported since kernel v6.9 (64bef697d33b75fc06c5789b3f8108680271529f). */
+-                if (!(ERRNO_IS_RESOURCE(errno) || (errno == EINVAL && FLAGS_SET(flags, PIDFD_THREAD))))
++                if (!(ERRNO_IS_RESOURCE(errno) ||
++                      IN_SET(errno, ENOSYS, EOPNOTSUPP, EINVAL)))
+                         return log_debug_errno(errno, "Failed to open pidfd for pid " PID_FMT ": %m", pid);
+ 
+                 fd = -EBADF;
+@@ -502,9 +503,11 @@
+ 
+                 siginfo_t si = {};
+ 
+-                if (pidref->fd >= 0)
++                if (pidref->fd >= 0) {
+                         r = RET_NERRNO(waitid(P_PIDFD, pidref->fd, &si, WEXITED));
+-                else
++                        if (IN_SET(r, -EINVAL, -ENOSYS, -EOPNOTSUPP))
++                                r = RET_NERRNO(waitid(P_PID, pidref->pid, &si, WEXITED));
++                } else
+                         r = RET_NERRNO(waitid(P_PID, pidref->pid, &si, WEXITED));
+                 if (r >= 0) {
+                         if (ret_si)
diff --git a/overlay/patches/systemd-262-proc-credentials-old-kernel.patch b/overlay/patches/systemd-262-proc-credentials-old-kernel.patch
new file mode 100644
index 00000000..cf16aa51
--- /dev/null
+++ b/overlay/patches/systemd-262-proc-credentials-old-kernel.patch
@@ -0,0 +1,41 @@
+# systemd 262 uses hidepid=invisible (Linux 5.8+) and the new mount API for
+# credentials (fsopen/fsmount, Linux 5.2+). On 4.14 the textual hidepid option
+# is rejected and fsmount_credentials_fs() returns ENOSYS.
+#
+# Older systemd versions fall back to an unrestricted proc mount when the
+# hidepid option is rejected. Do the same here instead of translating
+# invisible to hidepid=2, which has different per-namespace semantics on
+# pre-5.8 kernels. Keep the plain-directory credentials fallback for old
+# kernels.
+--- a/src/core/namespace.c
++++ b/src/core/namespace.c
+@@ -1588,7 +1588,15 @@
+          * one. i.e we don't reuse existing mounts here under any condition, we want a new instance owned by
+          * our user namespace and with our hidepid= settings applied. Hence, let's get rid of everything
+          * mounted on /proc/ first. */
+-        return mount_private_apivfs("proc", mount_entry_path(m), "/proc", opts, p->runtime_scope);
++        r = mount_private_apivfs("proc", mount_entry_path(m), "/proc", opts, p->runtime_scope);
++        if (r == -EINVAL && opts) {
++                /* hidepid=invisible requires Linux 5.8. On older kernels the
++                 * textual option is rejected; fall back to an unrestricted
++                 * proc mount, as systemd did before v257. */
++                opts = mfree(opts);
++                r = mount_private_apivfs("proc", mount_entry_path(m), "/proc", NULL, p->runtime_scope);
++        }
++        return r;
+ }
+ 
+ static int mount_tmpfs(const MountEntry *m) {
+--- a/src/core/exec-credential.c
++++ b/src/core/exec-credential.c
+@@ -1052,8 +1052,8 @@
+         }
+ 
+         mfd = fsmount_credentials_fs(&fs_fd);
+-        if (ERRNO_IS_NEG_PRIVILEGE(mfd) && !dir_mounted) {
+-                log_debug_errno(mfd, "Lacking privilege to mount credentials fs, falling back to plain directory.");
++        if ((ERRNO_IS_NEG_PRIVILEGE(mfd) || IN_SET(mfd, -ENOSYS, -EOPNOTSUPP)) && !dir_mounted) {
++                log_debug_errno(mfd, "Unable to mount credentials fs, falling back to plain directory: %m");
+                 return setup_credentials_plain_dir(context, cred_dir);
+         }
+         if (mfd < 0)
