new file mode 100644
index 0000000..416b066
--- /dev/null
+++ b/overlay/asteroidos/apps/camera/remotecamerabridge.cpp
@@ -0,0 +1,130 @@
+/*
+ * Copyright (C) 2026 AsteroidOS
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "remotecamerabridge.h"
+
+#include <QDBusConnection>
+#include <QDBusInterface>
+#include <QDBusMessage>
+#include <QDebug>
+#include <QSet>
+#include <QTimer>
+#include <QVariantMap>
+
+namespace {
+const QString kService = QStringLiteral("org.asteroidos.btsyncd");
+const QString kPath = QStringLiteral("/org/asteroidos/btsyncd/appbridge");
+const QString kInterface = QStringLiteral("org.asteroidos.btsyncd.AppBridge");
+const QString kCameraId = QStringLiteral("org.asteroidos.camera");
+}
+
+RemoteCameraBridge::RemoteCameraBridge(QObject *parent)
+    : QObject(parent)
+{
+    QDBusConnection::systemBus().connect(
+        kService, kPath, kInterface, QStringLiteral("messageReceived"),
+        this, SLOT(onMessageReceived(QString, QString, QString)));
+}
+
+bool RemoteCameraBridge::isSendAllowed(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("capture"),
+        QStringLiteral("flip"),
+        QStringLiteral("zoom_in"),
+        QStringLiteral("zoom_out"),
+        QStringLiteral("torch"),
+        QStringLiteral("mode_photo"),
+        QStringLiteral("mode_video"),
+        QStringLiteral("status_query"),
+    };
+    return allowed.contains(action);
+}
+
+bool RemoteCameraBridge::isReceiveAllowed(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("ready"),
+        QStringLiteral("paused"),
+        QStringLiteral("photo_captured"),
+        QStringLiteral("video_started"),
+        QStringLiteral("video_stopped"),
+    };
+    return allowed.contains(action);
+}
+
+bool RemoteCameraBridge::sendCommand(const QString &action)
+{
+    if (!isSendAllowed(action)) {
+        qWarning() << "RemoteCameraBridge: refusing to send non-allowlisted action" << action;
+        return false;
+    }
+
+    QDBusMessage msg = QDBusMessage::createMethodCall(kService, kPath, kInterface,
+                                                      QStringLiteral("sendMessage"));
+    msg << kCameraId << action << QString();
+    QDBusConnection::systemBus().asyncCall(msg);
+    return true;
+}
+
+void RemoteCameraBridge::onMessageReceived(const QString &appId, const QString &action, const QString &payload)
+{
+    if (appId != kCameraId) {
+        return;
+    }
+    if (!isReceiveAllowed(action) || !payload.isEmpty()) {
+        qWarning() << "RemoteCameraBridge: ignoring unexpected message from phone";
+        return;
+    }
+
+    if (!m_bleConnected) {
+        m_bleConnected = true;
+        emit bleConnectedChanged();
+    }
+
+    if (action == QLatin1String("ready")) {
+        setPhoneReady(true);
+    } else if (action == QLatin1String("paused")) {
+        setPhoneReady(false);
+    } else if (action == QLatin1String("photo_captured")) {
+        vibrate(100);
+    }
+
+    emit commandReceived(action);
+}
+
+void RemoteCameraBridge::setPhoneReady(bool ready)
+{
+    if (m_phoneReady != ready) {
+        m_phoneReady = ready;
+        emit phoneReadyChanged();
+    }
+}
+
+void RemoteCameraBridge::vibrate(int ms)
+{
+    Q_UNUSED(ms);
+    QDBusInterface ngf(
+        "com.nokia.NonGraphicFeedback1.Backend",
+        "/com/nokia/NonGraphicFeedback1",
+        "com.nokia.NonGraphicFeedback1",
+        QDBusConnection::sessionBus());
+    if (ngf.isValid()) {
+        ngf.call(QDBus::NoBlock, "play", "camera_click", QVariantMap());
+    } else {
+        QDBusInterface mce(
+            "com.nokia.mce",
+            "/com/nokia/mce/request",
+            "com.nokia.mce.request",
+            QDBusConnection::systemBus());
+        if (mce.isValid()) {
+            mce.call(QDBus::NoBlock, "req_vibrator_pattern_activate", "PatternWebPageTap");
+        }
+    }
+}
diff --git a/overlay/asteroidos/apps/camera/remotecamerabridge.h b/overlay/asteroidos/apps/camera/remotecamerabridge.h
new file mode 100644
index 0000000..2a57118
--- /dev/null
+++ b/overlay/asteroidos/apps/camera/remotecamerabridge.h
@@ -0,0 +1,61 @@
+/*
+ * Copyright (C) 2026 AsteroidOS
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef REMOTECAMERABRIDGE_H
+#define REMOTECAMERABRIDGE_H
+
+#include <QObject>
+#include <QString>
+
+/*
+ * Remote shutter / remote control for the paired phone camera.
+ *
+ * The only transport is the authenticated BLE AppBridge exposed by
+ * asteroid-btsyncd on the system bus. There is no network path and no video
+ * stream; both command directions are checked against fixed allowlists and
+ * carry no payload.
+ */
+class RemoteCameraBridge : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool bleConnected READ bleConnected NOTIFY bleConnectedChanged)
+    Q_PROPERTY(bool phoneReady READ phoneReady NOTIFY phoneReadyChanged)
+
+public:
+    explicit RemoteCameraBridge(QObject *parent = nullptr);
+
+    bool bleConnected() const { return m_bleConnected; }
+    bool phoneReady() const { return m_phoneReady; }
+
+    // Watch -> phone actions that may be sent.
+    static bool isSendAllowed(const QString &action);
+    // Phone -> watch actions that are acted upon.
+    static bool isReceiveAllowed(const QString &action);
+
+public slots:
+    // Returns false (and sends nothing) if the action is not allowlisted.
+    bool sendCommand(const QString &action);
+    void vibrate(int ms = 50);
+
+signals:
+    void bleConnectedChanged();
+    void phoneReadyChanged();
+    void commandReceived(const QString &action);
+
+private slots:
+    void onMessageReceived(const QString &appId, const QString &action, const QString &payload);
+
+private:
+    void setPhoneReady(bool ready);
+
+    bool m_bleConnected = false;
+    bool m_phoneReady = false;
+};
+
+#endif // REMOTECAMERABRIDGE_H
