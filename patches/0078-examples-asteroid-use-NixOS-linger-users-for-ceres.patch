From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 19:38:34 +1100
Subject: [PATCH] examples/asteroid: use NixOS linger-users for ceres

Remove the custom linger-ceres unit, the tmpfiles marker, and the linger-users disable. users.users.ceres.linger now uses the standard NixOS linger-users.service and loginctl enable-linger.
---
 examples/asteroid/asteroid-desktop.nix | 23 +++--------------------
 1 file changed, 3 insertions(+), 20 deletions(-)

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index bbca20e6..54348ca4 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -96,8 +96,6 @@ in
 
     systemd.tmpfiles.rules = [
       "d /var/lib/kiwix 0775 ceres users -"
-      "d /var/lib/systemd/linger 0755 root root -"
-      "f /var/lib/systemd/linger/ceres 0644 root root -"
     ];
 
     # BlueZ dual-mode controller configuration (simultaneous BLE sync and Classic BT profiles)
@@ -122,24 +120,9 @@ in
       enable = false;
     };
 
-    # Start the ceres user manager through a systemd unit that writes the
-    # logind linger marker before logind starts. This avoids the stage-1
-    # hard-coded touch and the loginctl EnableLinger EINVAL on this kernel.
-    systemd.services.linger-ceres = {
-      description = "Create the logind linger marker for ceres";
-      wantedBy = [ "sysinit.target" ];
-      before = [ "systemd-logind.service" "multi-user.target" ];
-      after = [ "systemd-tmpfiles-setup.service" ];
-      serviceConfig = {
-        Type = "oneshot";
-        RemainAfterExit = true;
-        ExecStart = "${pkgs.writeShellScript "linger-ceres" ''
-          ${pkgs.coreutils}/bin/mkdir -p /var/lib/systemd/linger
-          ${pkgs.coreutils}/bin/touch /var/lib/systemd/linger/ceres
-        ''}";
-      };
-    };
-    systemd.services.linger-users.enable = false;
+    # users.users.ceres.linger generates NixOS's linger-users.service, which
+    # calls loginctl enable-linger after logind starts. Let the normal systemd
+    # linger mechanism own the marker; do not pre-seed it or override the unit.
 
     # Smartwatch stem/power button should be handled by compositor/shell, not
     # logind shutdown; match AsteroidOS systemd-conf powerkey.conf.
