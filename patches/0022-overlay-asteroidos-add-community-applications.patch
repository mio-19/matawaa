From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:25:14 +1100
Subject: [PATCH] overlay/asteroidos: add community applications

Package the bundled community watch applications: sensorlogd, health,
map, qmltester, skedaddle, weatherfetch, beatfork, benchymark,
docking-bay, heliograph, horizon, meteormatch, pulsar, rag, shopper,
toolwatch, and touchdown.
---
 overlay/asteroidos/community-apps/default.nix | 354 ++++++++++++++++++
 overlay/asteroidos/default.nix                |   5 +
 2 files changed, 359 insertions(+)
 create mode 100644 overlay/asteroidos/community-apps/default.nix

diff --git a/overlay/asteroidos/community-apps/default.nix b/overlay/asteroidos/community-apps/default.nix
new file mode 100644
index 00000000..843b7c85
--- /dev/null
+++ b/overlay/asteroidos/community-apps/default.nix
@@ -0,0 +1,354 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  qt6,
+  mkAsteroidApp,
+  mlite,
+  espeak-classic,
+}:
+
+rec {
+  unofficial-watchfaces = stdenv.mkDerivation {
+    pname = "asteroid-unofficial-watchfaces";
+    version = "nightly";
+
+    src = fetchFromGitHub {
+      owner = "AsteroidOS";
+      repo = "unofficial-watchfaces";
+      rev = "2d8247c28262ba686f49a873beba4d6bff4183c1";
+      sha256 = "0dg57c80dvbw9h5cnypljqshbz198wg66rap8l6qcrq3gx3f8js1";
+    };
+
+    installPhase = ''
+      runHook preInstall
+      mkdir -p $out/share/asteroid-launcher/watchfaces
+      cp -r * $out/share/asteroid-launcher/watchfaces/
+      runHook postInstall
+    '';
+
+    meta = with lib; {
+      description = "Community collection of watchfaces for AsteroidOS launcher";
+      homepage = "https://github.com/AsteroidOS/unofficial-watchfaces";
+      license = licenses.gpl3Plus;
+      platforms = platforms.all;
+    };
+  };
+
+  blaster = mkAsteroidApp {
+    name = "blaster";
+    owner = "eLtMosen";
+    repo = "asteroid-blaster";
+    desc = "Tilt-controlled asteroid shooting arcade frenzy for AsteroidOS smartwatches";
+    rev = "7947938807d5de4ea7cb918b0241377aac9d3216";
+    sha256 = "1vsndy01pwc333zs2c4lp4rcj4qvgmgpq0lc574h27dgkjqkphl1";
+    extraBuildInputs = [
+      qt6.qtsensors
+      qt6.qtshadertools
+    ];
+  };
+
+  dodger = mkAsteroidApp {
+    name = "dodger";
+    owner = "eLtMosen";
+    repo = "asteroid-dodger";
+    desc = "Tilt-controlled asteroid survival game for AsteroidOS smartwatches";
+    rev = "9643d40db9c609a006ed89a87dc1afd907492af1";
+    sha256 = "098igv2yaj3pjkiklkzmby8wlr3zmrbb8rmv0f3l1x6n56dv5096";
+    extraBuildInputs = [
+      qt6.qtsensors
+      qt6.qtshadertools
+    ];
+  };
+
+  sensorlogd = mkAsteroidApp {
+    name = "sensorlogd";
+    desc = "Background sensor logging daemon and QML plugin for health metrics on AsteroidOS";
+    rev = "bdc9f0bb0fd6ef39f08fb01697d95cb2b98c86b6";
+    sha256 = "1lb5m8g4k8sq9j9kynmffmzfj6q98rnwzbi7dr1i8fs6iq12a1ri";
+    postPatch = ''
+            for dir in . daemon qmlplugin; do
+              mkdir -p $dir/QtSensors
+              cat <<'EOF' > $dir/QtSensors/QStepCounterSensor
+      #pragma once
+      #include <QtSensors/QSensor>
+      #include <QtSensors/QSensorReading>
+
+      class QStepCounterReading : public QSensorReading {
+      public:
+          explicit QStepCounterReading(QObject *parent = nullptr) : QSensorReading(parent, nullptr), m_steps(0) {}
+          int steps() const { return m_steps; }
+          void setSteps(int steps) { m_steps = steps; }
+      private:
+          int m_steps;
+      };
+
+      class QStepCounterSensor : public QSensor {
+      public:
+          explicit QStepCounterSensor(QObject *parent = nullptr)
+              : QSensor(QByteArray("QStepCounterSensor"), parent), m_reading(new QStepCounterReading(this)) {}
+          QStepCounterReading *reading() const { return m_reading; }
+      private:
+          QStepCounterReading *m_reading;
+      };
+      EOF
+              cp $dir/QtSensors/QStepCounterSensor $dir/QtSensors/qstepcountersensor.h
+
+              cat <<'EOF' > $dir/QtSensors/QHrmSensor
+      #pragma once
+      #include <QtSensors/QSensor>
+      #include <QtSensors/QSensorReading>
+
+      class QHrmReading : public QSensorReading {
+      public:
+          explicit QHrmReading(QObject *parent = nullptr) : QSensorReading(parent, nullptr), m_bpm(0) {}
+          int bpm() const { return m_bpm; }
+          void setBpm(int bpm) { m_bpm = bpm; }
+      private:
+          int m_bpm;
+      };
+
+      class QHrmSensor : public QSensor {
+      public:
+          enum Status {
+              NoContact,
+              Unreliable,
+              AccuracyLow,
+              AccuracyMedium,
+              AccuracyHigh
+          };
+          explicit QHrmSensor(QObject *parent = nullptr)
+              : QSensor(QByteArray("QHrmSensor"), parent), m_reading(new QHrmReading(this)) {}
+          QHrmReading *reading() const { return m_reading; }
+          Status status() const { return AccuracyHigh; }
+      private:
+          QHrmReading *m_reading;
+      };
+      EOF
+              cp $dir/QtSensors/QHrmSensor $dir/QtSensors/qhrmsensor.h
+            done
+    '';
+    extraBuildInputs = [
+      qt6.qtsensors
+      mlite
+    ];
+  };
+
+  health = mkAsteroidApp {
+    name = "health";
+    desc = "Step counter, heart rate monitor, and wellness tracker for AsteroidOS";
+    rev = "c85390fb9dd643f9b58e73bf698833ed7727b89f";
+    sha256 = "1kk8y094sva6y3hnw0lbrk1liacpnfqknbrlv6hsry9fwgdxv3kq";
+    extraBuildInputs = [
+      qt6.qtsensors
+      mlite
+      sensorlogd
+    ];
+  };
+
+  # Inspired by CoMaps offline map caching and compass heading orientation: https://github.com/comaps/comaps
+  map = mkAsteroidApp {
+    name = "map";
+    desc = "Touch and GPS map viewer for AsteroidOS smartwatches";
+    rev = "8263b2175843e83c32baee2eec5380559db2b735";
+    sha256 = "0f9rfbkr42fpa5f1bj3w9b8hwp1qn9v9zy7rwrjr10m1c5q64c7h";
+    extraBuildInputs = [
+      qt6.qtlocation
+      qt6.qtpositioning
+    ];
+  };
+
+  qmltester = mkAsteroidApp {
+    name = "qmltester";
+    owner = "MagneFire";
+    repo = "asteroid-qmltester";
+    desc = "Interactive developer QML viewer and testing workbench on AsteroidOS";
+    rev = "b397ebfa77025ddbf093fa4cbab7d5d218cc8624";
+    sha256 = "0szlc78av6d94bpzgbc0lwwf5z921b87agpjg0nw1x80asz8xwbp";
+  };
+
+  skedaddle = mkAsteroidApp {
+    name = "skedaddle";
+    owner = "beroset";
+    repo = "asteroid-skedaddle";
+    desc = "Outdoor exercise and running activity tracker with GPX recording";
+    rev = "f5620c7b0c6f7ca06e2ee483ed2a0377204b6682";
+    sha256 = "0v07y2fzh1zvnsnsg7b77fjpv9mq1sn4lc0k050pyf7yziy6liya";
+    extraBuildInputs = [
+      qt6.qtpositioning
+      espeak-classic
+    ];
+  };
+
+  weatherfetch = mkAsteroidApp {
+    name = "weatherfetch";
+    owner = "beroset";
+    repo = "asteroid-weatherfetch";
+    desc = "Direct internet weather forecast fetcher for AsteroidOS";
+    rev = "70044bb4904d22f521fa7eb7448d5007bd863f97";
+    sha256 = "04m1shcw9a36dpa5ibw5728c6d1vqiah9djlr79fq51c12sy7fvl";
+    extraBuildInputs = [
+      mlite
+    ];
+  };
+
+  # A metronome and chromatic tuning fork app for smartwatches
+  # Upstream repository: https://github.com/moWerk/asteroid-beatfork
+  beatfork = mkAsteroidApp {
+    name = "beatfork";
+    owner = "moWerk";
+    repo = "asteroid-beatfork";
+    desc = "Metronome and chromatic tuning fork app for smartwatches";
+    rev = "e3fbc5dd6da40868e0f338c9a0d3f6e877afca25";
+    sha256 = "1s4n5qfqximi05szksjbl806rpd37j3q7245z1iip5rrnlbkc7m2";
+    extraBuildInputs = [
+      qt6.qtmultimedia
+    ];
+  };
+
+  # Benchmark tool for smartwatches: https://github.com/moWerk/benchymark
+  benchymark = mkAsteroidApp {
+    name = "benchymark";
+    owner = "moWerk";
+    repo = "benchymark";
+    desc = "Benchmark tool for AsteroidOS smartwatches";
+    rev = "11e90920e76e6c62fe1076d4c3927b81b1154e96";
+    sha256 = "0x3c5rm2b8b8cfq7a1kl1699lmn88id70zmrsqzf53bxiv1ms8x4";
+    extraBuildInputs = [
+      qt6.qtsensors
+    ];
+  };
+
+  # Docking bay and charging status: https://github.com/moWerk/asteroid-docking-bay
+  docking-bay = stdenv.mkDerivation {
+    pname = "asteroid-docking-bay";
+    version = "nightly";
+
+    src = fetchFromGitHub {
+      owner = "moWerk";
+      repo = "asteroid-docking-bay";
+      rev = "37503828b30c4061a815b10887c46b548137b34f";
+      sha256 = "0g8x6v27ni3zqwir2sif7a0csb78adii47g4y4mnqm3vfklknnp1";
+    };
+
+    dontBuild = true;
+
+    installPhase = ''
+      runHook preInstall
+      mkdir -p $out/bin $out/share/asteroid-docking-bay
+      cp -r * $out/share/asteroid-docking-bay/
+      if [ -f bin/watchctl ]; then
+        install -m 755 bin/watchctl $out/bin/watchctl
+      fi
+      runHook postInstall
+    '';
+
+    meta = with lib; {
+      description = "Docking bay and battery charge status monitor for smartwatches";
+      homepage = "https://github.com/moWerk/asteroid-docking-bay";
+      license = licenses.gpl3Plus;
+      platforms = platforms.all;
+    };
+  };
+
+  # Solar elevation and daylight tracker: https://github.com/moWerk/asteroid-heliograph
+  heliograph = mkAsteroidApp {
+    name = "heliograph";
+    owner = "moWerk";
+    desc = "Solar elevation, daylight tracker, and sundial calculator for smartwatches";
+    rev = "612fd6b1e9229cbacb5f724bc21e239cd034f632";
+    sha256 = "11khf2f2fj2vgvrc7m95n13ac7f09phi1x07xf5g12rwc09yw648";
+    extraBuildInputs = [
+      qt6.qtpositioning
+    ];
+  };
+
+  # Artificial horizon and spirit level: https://github.com/moWerk/asteroid-horizon
+  horizon = mkAsteroidApp {
+    name = "horizon";
+    owner = "moWerk";
+    desc = "Artificial horizon and spirit level bubble display for smartwatches";
+    rev = "3339b36ab549e11949f3399e49ced07e1035ee96";
+    sha256 = "1gvy5nkgdr62f1aqss6sxbzlwc4n74r3xa82ymvyml0ccnp80iql";
+    extraBuildInputs = [
+      qt6.qtsensors
+    ];
+  };
+
+  # Space arcade memory reflex matching game: https://github.com/moWerk/asteroid-meteormatch
+  meteormatch = mkAsteroidApp {
+    name = "meteormatch";
+    owner = "moWerk";
+    desc = "Fast-paced space arcade memory and reflex matching game for smartwatches";
+    rev = "3a597047d1e4021d8eddf715e4c6e110c04080d1";
+    sha256 = "043jmqf4hb4fci13ikn88r32cr0r280jy16kaik43k7cnnacbgzv";
+  };
+
+  # Stroboscope and visual flasher: https://github.com/moWerk/asteroid-pulsar
+  pulsar = mkAsteroidApp {
+    name = "pulsar";
+    owner = "moWerk";
+    desc = "Stroboscope and pulsing visual flasher tool for smartwatches";
+    rev = "a7b9339bc6ba882ec0717a45e2edddc1e304cd84";
+    sha256 = "10ddg0ig5nmx7mczxxbw67qpawqv04261y8fmm92dzm1b4qb59yz";
+  };
+
+  # RAG dataset and design specification: https://github.com/moWerk/asteroid-rag
+  rag = stdenv.mkDerivation {
+    pname = "asteroid-rag";
+    version = "nightly";
+
+    src = fetchFromGitHub {
+      owner = "moWerk";
+      repo = "asteroid-rag";
+      rev = "0eaf32483ac17a69ee2ce79524c2d8704fcce619";
+      sha256 = "0s9zh7cqhwzbh99xwd812bfc7xz64axwaagbzg926mi4yz87h5cx";
+    };
+
+    dontBuild = true;
+
+    installPhase = ''
+      runHook preInstall
+      mkdir -p $out/share/doc/asteroid-rag
+      cp -r * $out/share/doc/asteroid-rag/
+      runHook postInstall
+    '';
+
+    meta = with lib; {
+      description = "Reference design guide and RAG dataset for AsteroidOS";
+      homepage = "https://github.com/moWerk/asteroid-rag";
+      license = licenses.gpl3Plus;
+      platforms = platforms.all;
+    };
+  };
+
+  # Checklist and shopping list app: https://github.com/moWerk/asteroid-shopper
+  shopper = mkAsteroidApp {
+    name = "shopper";
+    owner = "moWerk";
+    desc = "Simple and handy checklist and shopping list app for smartwatches";
+    rev = "c0eea7e655611d060071fa213a64fa03f03de0ff";
+    sha256 = "0mgvbhp6spahhp2jz94k7id9l18axk0blnl4rpcgngbfqg7awqgd";
+  };
+
+  # Mechanical watch timegrapher: https://github.com/moWerk/asteroid-toolwatch
+  toolwatch = mkAsteroidApp {
+    name = "toolwatch";
+    owner = "moWerk";
+    desc = "Mechanical watch accuracy checker and timegrapher tool for smartwatches";
+    rev = "07b6675ae6e4734fee7971d4f4a22a9637f5f1a9";
+    sha256 = "0jd3nj6pi9by5i8rpalsmpj63yiqjqqri6fz5v45lhis4add0p0v";
+  };
+
+  # Lunar lander retro thruster game: https://github.com/moWerk/asteroid-touchdown
+  touchdown = mkAsteroidApp {
+    name = "touchdown";
+    owner = "moWerk";
+    desc = "Lunar lander retro thruster landing game for smartwatches";
+    rev = "660a26f3bd06846766c0114357c06fa195081c6c";
+    sha256 = "1h47612wf7zfb76glg78099xysvidpln71pmjyafi1ras81jfvk3";
+    extraBuildInputs = [
+      qt6.qtsensors
+    ];
+  };
+}
diff --git a/overlay/asteroidos/default.nix b/overlay/asteroidos/default.nix
index 63fa2227..6b22231d 100644
--- a/overlay/asteroidos/default.nix
+++ b/overlay/asteroidos/default.nix
@@ -58,5 +58,10 @@ rec {
 
   virtualkeyboard = callPackage ./virtualkeyboard { };
 
+  community-apps = callPackage ./community-apps {
+    inherit mkAsteroidApp mlite;
+    inherit (pkgs) espeak-classic;
+  };
+
   inherit (pkgs) msm-fb-refresher;
 }
