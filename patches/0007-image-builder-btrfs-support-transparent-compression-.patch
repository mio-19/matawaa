From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 10:42:20 +1100
Subject: [PATCH] image-builder/btrfs: support transparent compression and
 disable block-group-tree

This patch updates the btrfs image builder module:

- Pass -O ^block-group-tree to mkfs.btrfs to ensure compatibility with
  older Linux 4.14/4.9 kernels that lack the block-group-tree feature.
- Add a configurable compression option (defaulting to zstd:3).
- Adjust minimal filesystem size calculation to account for btrfs metadata
  overhead and transparent compression workspace before shrinking.

Signed-off-by: Mio <mio@mio19.uk>
---
 .../filesystem-image/filesystem/btrfs.nix           | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/overlay/image-builder/filesystem-image/filesystem/btrfs.nix b/overlay/image-builder/filesystem-image/filesystem/btrfs.nix
index f6d95e13..18665072 100644
--- a/overlay/image-builder/filesystem-image/filesystem/btrfs.nix
+++ b/overlay/image-builder/filesystem-image/filesystem/btrfs.nix
@@ -24,6 +24,14 @@ in
         Volume ID of the filesystem.
       '';
     };
+    compression = mkOption {
+      type = types.nullOr types.str;
+      default = "zstd:3";
+      example = "zstd:3";
+      description = ''
+        Transparent compression algorithm and level for files populated into the image.
+      '';
+    };
   };
 
   config = mkMerge [
@@ -41,12 +49,17 @@ in
       minimumSize = config.helpers.size.MiB 110;
 
       computeMinimalSize = ''
+        # Btrfs metadata overhead and compression buffer space before shrinking
+        size=$(( size + (size * 10 / 100) + 150 * 1024 * 1024 ))
       '';
 
       buildPhases = {
         copyPhase = ''
           mkfs.btrfs \
+            -f \
+            -O ^block-group-tree \
             -r . \
+            ${optionalString (config.btrfs.compression != null) "--compress ${config.btrfs.compression}"} \
             ${optionalString (partitionID != null) "-U ${partitionID}"} \
             ${optionalString (label != null) "-L ${escapeShellArg label}"} \
             ${optionalString (config.size == null) "--shrink"} \
