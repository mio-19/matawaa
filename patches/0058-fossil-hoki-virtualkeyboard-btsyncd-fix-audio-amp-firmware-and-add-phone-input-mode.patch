 .../virtualkeyboard/layouts/en_US/symbols.qml |  54 ++++++++
 .../virtualkeyboard/layouts/phone/main.qml    |  82 +++++++++++
 .../virtualkeyboard/layouts/zh_CN/main.qml    |  79 ++++++++++-
 .../virtualkeyboard/layouts/zh_HK/main.qml    |  80 ++++++++++-
 .../virtualkeyboard/layouts/zh_TW/main.qml    |  80 ++++++++++-
