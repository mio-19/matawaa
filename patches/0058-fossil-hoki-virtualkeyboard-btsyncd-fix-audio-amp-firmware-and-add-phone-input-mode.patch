diff --git a/overlay/asteroidos/virtualkeyboard/phoneinputbridge.cpp b/overlay/asteroidos/virtualkeyboard/phoneinputbridge.cpp
new file mode 100644
index 00000000..a0a040d0
--- /dev/null
+++ b/overlay/asteroidos/virtualkeyboard/phoneinputbridge.cpp
@@ -0,0 +1,86 @@
+/*
+ * AsteroidOS Virtual Keyboard - Phone Input Bridge
+ *
+ * Copyright (C) 2026 AsteroidOS
+ */
+
+#include "phoneinputbridge.h"
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCall>
+#include <QDebug>
+
+namespace {
+const QString kService = QStringLiteral("org.asteroidos.btsyncd");
+const QString kPath = QStringLiteral("/org/asteroidos/btsyncd/appbridge");
+const QString kInterface = QStringLiteral("org.asteroidos.btsyncd.AppBridge");
+const QString kAppId = QStringLiteral("org.asteroidos.keyboard");
+const QString kWireAppId = QStringLiteral("kbd");
+} // namespace
+
+namespace QtVirtualKeyboard {
+
+PhoneInputBridge::PhoneInputBridge(QObject *parent)
+    : QObject(parent)
+    , m_statusText(QStringLiteral("Type on phone..."))
+{
+    QDBusConnection::systemBus().connect(
+        kService, kPath, kInterface, QStringLiteral("messageReceived"),
+        this, SLOT(onMessageReceived(QString, QString, QString)));
+}
+
+PhoneInputBridge::~PhoneInputBridge()
+{
+    if (m_active) {
+        closeInput();
+    }
+}
+
+void PhoneInputBridge::requestInput(const QString &hint)
+{
+    m_active = true;
+    m_statusText = QStringLiteral("Waiting for phone...");
+    emit activeChanged();
+    emit statusTextChanged();
+
+    QDBusMessage msg = QDBusMessage::createMethodCall(kService, kPath, kInterface,
+                                                      QStringLiteral("sendMessage"));
+    msg << kWireAppId << QStringLiteral("request_input") << hint;
+    QDBusConnection::systemBus().asyncCall(msg);
+    qDebug() << "PhoneInputBridge: requested input on phone";
+}
+
+void PhoneInputBridge::closeInput()
+{
+    if (!m_active) return;
+    m_active = false;
+    emit activeChanged();
+
+    QDBusMessage msg = QDBusMessage::createMethodCall(kService, kPath, kInterface,
+                                                      QStringLiteral("sendMessage"));
+    msg << kWireAppId << QStringLiteral("close") << QString();
+    QDBusConnection::systemBus().asyncCall(msg);
+    qDebug() << "PhoneInputBridge: closed phone input";
+}
+
+void PhoneInputBridge::onMessageReceived(const QString &appId, const QString &action, const QString &payload)
+{
+    if (appId != kAppId && appId != kWireAppId) {
+        return;
+    }
+
+    qDebug() << "PhoneInputBridge: received" << appId << action << payload;
+    if (action == QStringLiteral("commit") || action == QStringLiteral("text")) {
+        if (!payload.isEmpty()) {
+            emit textCommitted(payload);
+            m_statusText = QStringLiteral("Text received!");
+            emit statusTextChanged();
+        }
+    } else if (action == QStringLiteral("close")) {
+        m_active = false;
+        emit activeChanged();
+    }
+}
+
+} // namespace QtVirtualKeyboard
