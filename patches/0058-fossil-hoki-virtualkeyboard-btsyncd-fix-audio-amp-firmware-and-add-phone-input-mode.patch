+            text: "📱"
+            functionKey: true
+            onClicked: {
+                phoneOverlay.visible = true
+                phoneBridge.requestInput()
+            }
+        }
+        SpaceKey { weight: 740 }
+        HideKeyboardKey { weight: 180 }
+    }
+
+    Rectangle {
+        id: phoneOverlay
+        anchors.fill: parent
+        visible: false
+        color: "#1c1c1e"
+        z: 999
+
+        Column {
+            anchors.centerIn: parent
+            spacing: 12
+            width: parent.width * 0.9
+
+            Text {
+                text: "📱 Input on Phone"
+                color: "#ffffff"
+                font.bold: true
+                font.pixelSize: 18
+                anchors.horizontalCenter: parent.horizontalCenter
+            }
+
+            Text {
+                text: phoneBridge.statusText
+                color: "#a0a0a0"
+                font.pixelSize: 13
+                wrapMode: Text.WordWrap
+                horizontalAlignment: Text.AlignHCenter
+                anchors.horizontalCenter: parent.horizontalCenter
+            }
+
+            Rectangle {
+                width: parent.width * 0.7
+                height: 38
+                radius: 19
+                color: "#3a3a3c"
+                anchors.horizontalCenter: parent.horizontalCenter
+
+                Text {
+                    anchors.centerIn: parent
+                    text: "⌨️ Return"
+                    color: "#ffffff"
+                    font.bold: true
+                    font.pixelSize: 14
+                }
+
+                MouseArea {
+                    anchors.fill: parent
+                    onClicked: {
+                        phoneBridge.closeInput()
+                        phoneOverlay.visible = false
+                    }
+                }
+            }
+        }
     }
 }
