+/*
+ * AsteroidOS Virtual Keyboard - Phone Input Bridge
+ *
+ * Copyright (C) 2026 AsteroidOS
+ */
+
+#pragma once
+
+#include <QObject>
+#include <QString>
+#include <QtQml/qqml.h>
+
+namespace QtVirtualKeyboard {
+
+class PhoneInputBridge : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_ADDED_IN_VERSION(1, 0)
+    Q_PROPERTY(bool active READ isActive NOTIFY activeChanged)
+    Q_PROPERTY(QString statusText READ statusText NOTIFY statusTextChanged)
+
+public:
+    explicit PhoneInputBridge(QObject *parent = nullptr);
+    ~PhoneInputBridge() override;
+
+    bool isActive() const { return m_active; }
+    QString statusText() const { return m_statusText; }
+
+    Q_INVOKABLE void requestInput(const QString &hint = QString());
+    Q_INVOKABLE void closeInput();
+
+Q_SIGNALS:
+    void activeChanged();
+    void statusTextChanged();
+    void textCommitted(const QString &text);
+
+private Q_SLOTS:
+    void onMessageReceived(const QString &appId, const QString &action, const QString &payload);
+
+private:
+    bool m_active = false;
+    QString m_statusText;
+};
+
+} // namespace QtVirtualKeyboard
