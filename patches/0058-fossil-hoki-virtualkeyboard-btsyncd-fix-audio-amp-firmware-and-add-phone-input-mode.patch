From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sun, 8 Nov 2026 23:24:07 +1100
Subject: [PATCH] fossil-hoki, virtualkeyboard, btsyncd: fix audio amp firmware
 and add phone input mode

---
 devices/fossil-hoki/default.nix               |  21 +--
 devices/fossil-hoki/tfa9890.cnt.base64        |  93 +++++++++++++
 .../asteroid-btsyncd/appbridgeservice.cpp     |  39 ++++++
 .../0001-add-rime-plugin-and-layouts.patch    |   7 +-
 .../asteroidos/virtualkeyboard/default.nix    |   2 +
 .../virtualkeyboard/layouts/en_GB/main.qml    | 128 ++++++++++++++++++
 .../virtualkeyboard/layouts/en_GB/symbols.qml |  54 ++++++++
 .../virtualkeyboard/layouts/en_US/main.qml    | 128 ++++++++++++++++++
 .../virtualkeyboard/layouts/en_US/symbols.qml |  54 ++++++++
 .../virtualkeyboard/layouts/phone/main.qml    |  82 +++++++++++
 .../virtualkeyboard/layouts/zh_CN/main.qml    |  79 ++++++++++-
 .../virtualkeyboard/layouts/zh_HK/main.qml    |  80 ++++++++++-
 .../virtualkeyboard/layouts/zh_TW/main.qml    |  80 ++++++++++-
 .../virtualkeyboard/phoneinputbridge.cpp      |  86 ++++++++++++
 .../virtualkeyboard/phoneinputbridge.h        |  46 +++++++
 15 files changed, 957 insertions(+), 22 deletions(-)
 create mode 100644 devices/fossil-hoki/tfa9890.cnt.base64
 create mode 100644 overlay/asteroidos/virtualkeyboard/layouts/en_GB/main.qml
 create mode 100644 overlay/asteroidos/virtualkeyboard/layouts/en_GB/symbols.qml
 create mode 100644 overlay/asteroidos/virtualkeyboard/layouts/en_US/main.qml
 create mode 100644 overlay/asteroidos/virtualkeyboard/layouts/en_US/symbols.qml
 create mode 100644 overlay/asteroidos/virtualkeyboard/layouts/phone/main.qml
 create mode 100644 overlay/asteroidos/virtualkeyboard/phoneinputbridge.cpp
 create mode 100644 overlay/asteroidos/virtualkeyboard/phoneinputbridge.h

diff --git a/devices/fossil-hoki/default.nix b/devices/fossil-hoki/default.nix
index ba41941c..5ae5b7cb 100644
--- a/devices/fossil-hoki/default.nix
+++ b/devices/fossil-hoki/default.nix
@@ -9,6 +9,10 @@ let
   hybrisAndroid = import ./hybris-android.nix { inherit pkgs; };
   androidSystemData = import ./android-system-data.nix { inherit pkgs; };
 
+  tfa9890Cnt = pkgs.runCommand "tfa9890.cnt" { } ''
+    ${pkgs.coreutils}/bin/base64 -d ${./tfa9890.cnt.base64} > $out
+  '';
+
   # Static vendor and system firmware package for kernel direct firmware loader
   hokiFirmware = pkgs.runCommand "hoki-firmware" { } ''
     mkdir -p $out/lib/firmware
@@ -16,9 +20,7 @@ let
     if [ -d ${androidSystemData}/system/etc/firmware ]; then
       cp -a ${androidSystemData}/system/etc/firmware/* $out/lib/firmware/
     fi
-    if [ -e $out/lib/firmware/tfa98xx.cnt ]; then
-      ln -sf tfa98xx.cnt $out/lib/firmware/tfa9890.cnt
-    fi
+    cp -f ${tfa9890Cnt} $out/lib/firmware/tfa9890.cnt
   '';
 
   # Non-graphic feedback (haptics) DRV260X configuration for tactile feedback
@@ -176,7 +178,10 @@ in
     description = "Fossil Gen 6 TFA98xx audio amplifier and microphone mixer routing";
     wantedBy = [ "multi-user.target" ];
     wants = [ "dev-snd-controlC0.device" ];
-    after = [ "dev-snd-controlC0.device" "sound.target" ];
+    after = [
+      "dev-snd-controlC0.device"
+      "sound.target"
+    ];
     path = with pkgs; [
       alsa-utils
       coreutils
@@ -199,10 +204,10 @@ in
 
         # Ensure TFA98xx amplifier DSP container firmware is linked under both names in /lib/firmware
         mkdir -p /lib/firmware
+        ln_force "${tfa9890Cnt}" /lib/firmware/tfa9890.cnt
         for p in /system/etc/firmware/tfa98xx.cnt /vendor/firmware/tfa98xx.cnt /etc/firmware/tfa98xx.cnt; do
           if [ -e "$p" ]; then
             ln_force "$p" /lib/firmware/tfa98xx.cnt
-            ln_force "$p" /lib/firmware/tfa9890.cnt
             break
           fi
         done
@@ -216,10 +221,10 @@ in
         done
 
         if [ -e /dev/snd/controlC0 ]; then
-          # QUAT_MI2S_RX_DL_HL enables speaker downlink audio flow
-          tinymix -D 0 set "QUAT_MI2S_RX_DL_HL Switch" 1 || true
           # QUAT_MI2S_RX connects MultiMedia1 frontend to TFA98xx speaker amplifier DAI link
-          tinymix -D 0 set "QUAT_MI2S_RX Audio Mixer MultiMedia1" 1 1 || true
+          tinymix -D 0 set "QUAT_MI2S_RX Audio Mixer MultiMedia1" 1 || true
+          tinymix -D 0 set "mono Profile" "Music" || true
+          tinymix -D 0 set "mono Music Playback Volume" 3 || true
           # TERT_MI2S_TX connects digital microphone to MultiMedia1 capture frontend
           tinymix -D 0 set "MultiMedia1 Mixer TERT_MI2S_TX" 1 || true
           # Route digital mic 1 to DEC1
