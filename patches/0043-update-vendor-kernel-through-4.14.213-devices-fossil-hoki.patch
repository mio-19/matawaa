+- 		goto out;
+- 
+--	if (pm_runtime_suspended(hba->dev)) {
+--		ret = ufshcd_runtime_resume(hba);
+--		if (ret)
+--			goto out;
+--	}
+-+	pm_runtime_get_sync(hba->dev);
+- 
+- 	ret = ufshcd_suspend(hba, UFS_SHUTDOWN_PM);
