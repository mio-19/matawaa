diff --git a/overlay/asteroidos/keepalive/default.nix b/overlay/asteroidos/keepalive/default.nix
new file mode 100644
index 00000000..f9a34dfb
--- /dev/null
+++ b/overlay/asteroidos/keepalive/default.nix
@@ -0,0 +1,167 @@
+# Nemo keepalive background activity scheduling library
+# Upstream repository: https://github.com/sailfishos/nemo-keepalive
+{
+  lib,
+  stdenv,
+  cmake,
+  pkg-config,
+  qt6,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "keepalive";
+  version = "1.0.0";
+  dontUnpack = true;
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+  ];
+
+  postPatch = ''
+        mkdir -p src include/keepalive
+        cat << "EOF" > CMakeLists.txt
+    cmake_minimum_required(VERSION 3.16)
+    project(keepalive LANGUAGES CXX)
+    find_package(Qt6 REQUIRED COMPONENTS Core)
+    set(CMAKE_AUTOMOC ON)
+    add_library(keepalive SHARED src/backgroundactivity.cpp src/backgroundactivity.h)
+    target_include_directories(keepalive PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/include>
+      $<INSTALL_INTERFACE:include>
+    )
+    target_link_libraries(keepalive PUBLIC Qt6::Core)
+    set_target_properties(keepalive PROPERTIES VERSION 1.0.0 SOVERSION 1)
+    install(TARGETS keepalive DESTINATION lib)
+    install(DIRECTORY include/keepalive DESTINATION include)
+    configure_file(keepalive.pc.in keepalive.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/keepalive.pc DESTINATION lib/pkgconfig)
+    EOF
+        cat << "EOF" > include/keepalive/backgroundactivity.h
+    #ifndef BACKGROUNDACTIVITY_H_
+    #define BACKGROUNDACTIVITY_H_
+    #include <QObject>
+    #include <QTimer>
+    class BackgroundActivity : public QObject {
+        Q_OBJECT
+        Q_ENUMS(State Frequency)
+    public:
+        enum State { Stopped, Waiting, Running };
+        enum Frequency {
+            Range = 0,
+            ThirtySeconds = 30,
+            TwoAndHalfMinutes = 150,
+            FiveMinutes = 300,
+            TenMinutes = 600,
+            FifteenMinutes = 900,
+            ThirtyMinutes = 1800,
+            OneHour = 3600,
+            TwoHours = 7200,
+            FourHours = 14400,
+            EightHours = 28800,
+            TenHours = 36000,
+            TwelveHours = 43200,
+            TwentyFourHours = 86400,
+            MaximumFrequency = 0x7fffffff
+        };
+        explicit BackgroundActivity(QObject *parent = nullptr);
+        virtual ~BackgroundActivity();
+        Frequency wakeupFrequency() const;
+        void wakeupRange(int &min_delay, int &max_delay) const;
+        bool isWaiting() const;
+        bool isRunning() const;
+        bool isStopped() const;
+        BackgroundActivity::State state() const;
+        void setWakeupFrequency(Frequency slot);
+        void setWakeupRange(int min_delay, int max_delay);
+        void setState(BackgroundActivity::State new_state);
+        void wait(Frequency slot);
+        void wait(int min_delay, int max_delay = -1);
+        QString id() const;
+    public Q_SLOTS:
+        void wait();
+        void run();
+        void stop();
+    Q_SIGNALS:
+        void waiting();
+        void running();
+        void stopped();
+        void stateChanged();
+    private Q_SLOTS:
+        void onTimeout();
+    private:
+        State m_state = Stopped;
+        Frequency m_frequency = Range;
+        int m_minDelay = 0;
+        int m_maxDelay = 0;
+        QTimer *m_timer;
+    };
+    #endif
+    EOF
+        cp include/keepalive/* src/
+        cat << "EOF" > src/backgroundactivity.cpp
+    #include <keepalive/backgroundactivity.h>
+    BackgroundActivity::BackgroundActivity(QObject *parent) : QObject(parent), m_timer(new QTimer(this)) {
+        m_timer->setSingleShot(true);
+        connect(m_timer, &QTimer::timeout, this, &BackgroundActivity::onTimeout);
+    }
+    BackgroundActivity::~BackgroundActivity() {}
+    BackgroundActivity::Frequency BackgroundActivity::wakeupFrequency() const { return m_frequency; }
+    void BackgroundActivity::wakeupRange(int &min_delay, int &max_delay) const { min_delay = m_minDelay; max_delay = m_maxDelay; }
+    bool BackgroundActivity::isWaiting() const { return m_state == Waiting; }
+    bool BackgroundActivity::isRunning() const { return m_state == Running; }
+    bool BackgroundActivity::isStopped() const { return m_state == Stopped; }
+    BackgroundActivity::State BackgroundActivity::state() const { return m_state; }
+    void BackgroundActivity::setWakeupFrequency(Frequency slot) { m_frequency = slot; }
+    void BackgroundActivity::setWakeupRange(int min_delay, int max_delay) { m_minDelay = min_delay; m_maxDelay = max_delay; }
+    void BackgroundActivity::setState(BackgroundActivity::State new_state) {
+        if (m_state != new_state) {
+            m_state = new_state;
+            emit stateChanged();
+            if (m_state == Waiting) emit waiting();
+            else if (m_state == Running) emit running();
+            else if (m_state == Stopped) emit stopped();
+        }
+    }
+    void BackgroundActivity::wait(Frequency slot) { setWakeupFrequency(slot); wait((int)slot, (int)slot); }
+    void BackgroundActivity::wait(int min_delay, int max_delay) { setWakeupRange(min_delay, max_delay); wait(); }
+    void BackgroundActivity::wait() {
+        setState(Waiting);
+        int delay = (m_minDelay > 0) ? m_minDelay : 10;
+        m_timer->start(delay * 1000);
+    }
+    void BackgroundActivity::run() { m_timer->stop(); setState(Running); }
+    void BackgroundActivity::stop() { m_timer->stop(); setState(Stopped); }
+    void BackgroundActivity::onTimeout() { run(); }
+    QString BackgroundActivity::id() const { return QStringLiteral("activity"); }
+    #include "moc_backgroundactivity.cpp"
+    EOF
+        cat << "EOF" > keepalive.pc.in
+    prefix=@CMAKE_INSTALL_PREFIX@
+    exec_prefix=''${prefix}
+    libdir=''${prefix}/lib
+    includedir=''${prefix}/include
+
+    Name: keepalive
+    Description: CPU/display keepalive development library
+    Version: 1.0.0
+    Requires: Qt6Core
+    Libs: -L''${libdir} -lkeepalive
+    Cflags: -I''${includedir}
+    EOF
+  '';
+
+  meta = with lib; {
+    description = "Nemomobile CPU and display keepalive library";
+    homepage = "https://github.com/sailfishos/nemo-keepalive";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/mce-dev/default.nix b/overlay/asteroidos/mce-dev/default.nix
new file mode 100644
index 00000000..ccf3ec5a
--- /dev/null
+++ b/overlay/asteroidos/mce-dev/default.nix
@@ -0,0 +1,41 @@
+# Mode Control Entity (MCE) development headers and pkgconfig
+# Upstream repository: https://github.com/sailfishos/mce-dev
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-nemomobile/mce-dev
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  pkg-config,
+}:
+
+stdenv.mkDerivation rec {
+  pname = "mce-dev";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "mce-dev";
+    rev = "5e351e2f17bba85423ee7ee13ae0d1bb10292cad";
+    hash = "sha256-e1hCeZCYu9CC2w2ok2TGKXsaB72DCCnLRGoJYPR/7ZM=";
+  };
+
+  nativeBuildInputs = [ pkg-config ];
+
+  dontBuild = true;
+
+  installPhase = ''
+    mkdir -p $out/include/mce $out/lib/pkgconfig
+    cp -r include/mce/* $out/include/mce/
+    sed -e "s|^prefix=.*|prefix=$out|" \
+        -e "s|^includedir=.*|includedir=$out/include|" \
+        -e "s|^Version:.*|Version: 1.33.0|" \
+        mce.pc > $out/lib/pkgconfig/mce.pc
+  '';
+
+  meta = with lib; {
+    description = "Mode Control Entity development headers and pkgconfig";
+    homepage = "https://github.com/sailfishos/mce-dev";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/mce-qt6/default.nix b/overlay/asteroidos/mce-qt6/default.nix
new file mode 100644
index 00000000..6abc14e4
--- /dev/null
+++ b/overlay/asteroidos/mce-qt6/default.nix
@@ -0,0 +1,88 @@
+# Qt6 bindings and client library for Mode Control Entity (MCE)
+# Upstream repository: https://github.com/sailfishos/libmce-qt
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  mce-dev,
+  buildPackages,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "mce-qt6";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "libmce-qt";
+    rev = "a8bbbdc63a70401bf8c1fe8a2a85ee9e7644af97";
+    sha256 = "sha256-xTKBW1G3BZn518IumbUs1yRToEdlbolkeVXJ/8aXBgg=";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    mce-dev
+  ];
+
+  postPatch = ''
+        cat << "EOF" > CMakeLists.txt
+    cmake_minimum_required(VERSION 3.16)
+    project(mce-qt6 LANGUAGES CXX)
+    find_package(Qt6 REQUIRED COMPONENTS Core DBus)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(mce REQUIRED IMPORTED_TARGET mce)
+    set(CMAKE_AUTOMOC ON)
+    file(GLOB SOURCES "lib/src/*.cpp")
+    file(GLOB HEADERS "lib/include/*.h")
+    add_library(mce-qt6 SHARED ''${SOURCES} ''${HEADERS} request_interface.cpp signal_interface.cpp)
+    target_compile_definitions(mce-qt6 PRIVATE QMCE_LIBRARY)
+    target_include_directories(mce-qt6 PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/lib/include>
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}>
+      $<INSTALL_INTERFACE:include/mce-qt6>
+    )
+    target_link_libraries(mce-qt6 PUBLIC Qt6::Core Qt6::DBus PkgConfig::mce)
+    set_target_properties(mce-qt6 PROPERTIES VERSION 1.5.1 SOVERSION 1)
+    install(TARGETS mce-qt6 DESTINATION lib)
+    install(FILES ''${HEADERS} DESTINATION include/mce-qt6)
+    configure_file(mce-qt6.pc.in mce-qt6.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/mce-qt6.pc DESTINATION lib/pkgconfig)
+    EOF
+        cat << "EOF" > mce-qt6.pc.in
+    prefix=@CMAKE_INSTALL_PREFIX@
+    exec_prefix=''${prefix}
+    libdir=''${prefix}/lib
+    includedir=''${prefix}/include/mce-qt6
+
+    Name: mce-qt6
+    Description: Qt bindings for mce
+    Version: 1.5.1
+    Requires: Qt6Core Qt6DBus mce
+    Libs: -L''${libdir} -lmce-qt6
+    Cflags: -I''${includedir}
+    EOF
+  '';
+
+  preConfigure = ''
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -N -c QMceRequestProxy -p request_interface.h:request_interface.cpp lib/dbus/com.nokia.mce.request.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -N -c QMceSignalProxy -p signal_interface.h:signal_interface.cpp lib/dbus/com.nokia.mce.signal.xml
+  '';
+
+  meta = with lib; {
+    description = "Qt6 client library and bindings for Mode Control Entity";
+    homepage = "https://github.com/sailfishos/libmce-qt";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+})
