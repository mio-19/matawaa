diff --git a/overlay/asteroidos/ngf-qt6/default.nix b/overlay/asteroidos/ngf-qt6/default.nix
new file mode 100644
index 00000000..3cbf568b
--- /dev/null
+++ b/overlay/asteroidos/ngf-qt6/default.nix
@@ -0,0 +1,78 @@
+# Qt6 client library for Non-Graphic Feedback (NGF) daemon
+# Upstream repository: https://github.com/sailfishos/libngf-qt
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "ngf-qt6";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "libngf-qt";
+    rev = "94caafdbc31341e9b9834199aedaa0c5f4a7bd44";
+    sha256 = "sha256-Spg1PfS0mkLDaCaR7RZUKbne+RFLJ1SSUnIgupfYgMw=";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+  ];
+
+  postPatch = ''
+        cat << "EOF" > CMakeLists.txt
+    cmake_minimum_required(VERSION 3.16)
+    project(ngf-qt6 LANGUAGES CXX)
+    find_package(Qt6 REQUIRED COMPONENTS Core DBus)
+    set(CMAKE_AUTOMOC ON)
+    file(GLOB HEADERS "src/include/*")
+    set(SOURCES src/dbus/client.cpp src/dbus/clientprivate.cpp)
+    add_library(ngf-qt6 SHARED ''${SOURCES} ''${HEADERS})
+    target_compile_definitions(ngf-qt6 PRIVATE NGFCLIENT_LIBRARY)
+    target_include_directories(ngf-qt6 PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/src/include>
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/src/dbus>
+      $<INSTALL_INTERFACE:include/ngf-qt6>
+    )
+    target_link_libraries(ngf-qt6 PUBLIC Qt6::Core Qt6::DBus)
+    set_target_properties(ngf-qt6 PROPERTIES VERSION 1.0.0 SOVERSION 1)
+    install(TARGETS ngf-qt6 DESTINATION lib)
+    install(FILES ''${HEADERS} DESTINATION include/ngf-qt6)
+    configure_file(ngf-qt6.pc.in ngf-qt6.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/ngf-qt6.pc DESTINATION lib/pkgconfig)
+    EOF
+        cat << "EOF" > ngf-qt6.pc.in
+    prefix=@CMAKE_INSTALL_PREFIX@
+    exec_prefix=''${prefix}
+    libdir=''${prefix}/lib
+    includedir=''${prefix}/include/ngf-qt6
+
+    Name: ngf-qt6
+    Description: Qt client library for NGF daemon
+    Version: 1.0.0
+    Requires: Qt6Core Qt6DBus
+    Libs: -L''${libdir} -lngf-qt6
+    Cflags: -I''${includedir}
+    EOF
+  '';
+
+  meta = with lib; {
+    description = "Qt6 client library for Non-Graphic Feedback daemon";
+    homepage = "https://github.com/sailfishos/libngf-qt";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/timed-qt6/default.nix b/overlay/asteroidos/timed-qt6/default.nix
new file mode 100644
index 00000000..2fc3f7e0
--- /dev/null
+++ b/overlay/asteroidos/timed-qt6/default.nix
@@ -0,0 +1,162 @@
+# Timed Qt6 client library interface
+# Upstream repository: https://github.com/sailfishos/timed
+{
+  lib,
+  stdenv,
+  cmake,
+  pkg-config,
+  qt6,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "timed-qt6";
+  version = "1.0.0";
+  dontUnpack = true;
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+  ];
+
+  postPatch = ''
+        mkdir -p src include/timed-qt6
+        cat << "EOF" > CMakeLists.txt
+    cmake_minimum_required(VERSION 3.16)
+    project(timed-qt6 LANGUAGES CXX)
+    find_package(Qt6 REQUIRED COMPONENTS Core DBus)
+    set(CMAKE_AUTOMOC ON)
+    add_library(timed-qt6 SHARED src/timed.cpp src/interface.h)
+    target_include_directories(timed-qt6 PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/include>
+      $<INSTALL_INTERFACE:include>
+    )
+    target_link_libraries(timed-qt6 PUBLIC Qt6::Core Qt6::DBus)
+    set_target_properties(timed-qt6 PROPERTIES VERSION 1.0.0 SOVERSION 1)
+    install(TARGETS timed-qt6 DESTINATION lib)
+    install(DIRECTORY include/timed-qt6 DESTINATION include)
+    configure_file(timed-qt6.pc.in timed-qt6.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/timed-qt6.pc DESTINATION lib/pkgconfig)
+    EOF
+        cat << "EOF" > include/timed-qt6/event-declarations.h
+    #pragma once
+    #include <QString>
+    #include <ctime>
+
+    namespace Maemo {
+    namespace Timed {
+
+    class Event {
+    public:
+        class Action {
+        public:
+            void whenDue() {}
+            void runCommand(const char *, const char *) {}
+        };
+
+        Event() = default;
+        void setTicker(const QString &) {}
+        void setTicker(time_t) {}
+        void setAttribute(const QString &, const QString &) {}
+        void setActionWakeup() {}
+        void setSingleShotFlag(bool = true) {}
+        void setAlarmFlag(bool = true) {}
+        void setBootFlag(bool = true) {}
+        void setKeepAliveFlag(bool = true) {}
+        void setReminderFlag(bool = true) {}
+        Action &addAction() { static Action act; return act; }
+    };
+
+    } // namespace Timed
+    } // namespace Maemo
+    EOF
+        cat << "EOF" > include/timed-qt6/event
+    #pragma once
+    #include <timed-qt6/event-declarations.h>
+    EOF
+        cat << "EOF" > include/timed-qt6/event.h
+    #pragma once
+    #include <timed-qt6/event-declarations.h>
+    EOF
+        cat << "EOF" > include/timed-qt6/exception
+    #pragma once
+    #include <exception>
+
+    namespace Maemo {
+    namespace Timed {
+    class Exception : public std::exception {};
+    }
+    }
+    EOF
+        cat << "EOF" > include/timed-qt6/exception.h
+    #pragma once
+    #include <timed-qt6/exception>
+    EOF
+        cat << "EOF" > include/timed-qt6/interface.h
+    #pragma once
+    #include <QObject>
+    #include <QDBusReply>
+    #include <QDBusError>
+    #include <QList>
+    #include <QMap>
+    #include <QString>
+    #include <QVariant>
+    #include <timed-qt6/event-declarations.h>
+
+    namespace Maemo {
+    namespace Timed {
+
+    class Interface : public QObject {
+        Q_OBJECT
+    public:
+        explicit Interface(QObject *parent = nullptr) : QObject(parent) {}
+        virtual ~Interface() {}
+
+        bool isValid() const { return true; }
+        QDBusError lastError() const { return QDBusError(); }
+        QDBusReply<QList<QVariant>> query_sync(const QMap<QString, QVariant> &) { return QDBusReply<QList<QVariant>>(); }
+        QDBusReply<bool> cancel_sync(uint) { return QDBusReply<bool>(); }
+        QDBusReply<uint> replace_event_sync(const Event &, uint) { return QDBusReply<uint>(); }
+        QDBusReply<uint> add_event_sync(const Event &) { return QDBusReply<uint>(); }
+    };
+
+    } // namespace Timed
+    } // namespace Maemo
+    EOF
+        cat << "EOF" > include/timed-qt6/interface
+    #pragma once
+    #include <timed-qt6/interface.h>
+    EOF
+        cp include/timed-qt6/* src/
+        cat << "EOF" > src/timed.cpp
+    #include "interface.h"
+    #include "moc_interface.cpp"
+    EOF
+        cat << "EOF" > timed-qt6.pc.in
+    prefix=@CMAKE_INSTALL_PREFIX@
+    exec_prefix=''${prefix}
+    libdir=''${prefix}/lib
+    includedir=''${prefix}/include
+
+    Name: timed-qt6
+    Description: Timed Qt6 client library
+    Version: 1.0.0
+    Requires: Qt6Core Qt6DBus
+    Libs: -L''${libdir} -ltimed-qt6
+    Cflags: -I''${includedir}
+    EOF
+  '';
+
+  meta = with lib; {
+    description = "Time daemon Qt6 client library";
+    homepage = "https://github.com/sailfishos/timed";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/usb-moded-qt6/default.nix b/overlay/asteroidos/usb-moded-qt6/default.nix
new file mode 100644
index 00000000..3d7c5b0e
--- /dev/null
+++ b/overlay/asteroidos/usb-moded-qt6/default.nix
@@ -0,0 +1,113 @@
+# Qt6 bindings and client library for usb-moded daemon
+# Upstream repository: https://github.com/sailfishos/libusb-moded-qt
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  dbus,
+  buildPackages,
+}:
+
+let
+  usb-moded-dev = stdenv.mkDerivation (finalAttrs: {
+    pname = "usb-moded-dev";
+    version = "nightly";
+
+    src = fetchFromGitHub {
+      owner = "sailfishos";
+      repo = "usb-moded";
+      rev = "6190edfe778df9896f1f3026a7ab087dbc02dd3f";
+      sha256 = "sha256-fv5jurY/ulGfWIc4VbTeuyVNs/QqNyxzC6Hyb6amg9c=";
+    };
+
+    strictDeps = true;
+
+    installPhase = ''
+      mkdir -p $out/include/usb-moded $out/lib/pkgconfig
+      cp src/com.meego.usb_moded.xml $out/include/usb-moded/
+      cp src/usb_moded*.h $out/include/usb-moded/
+      sed -e "s|@VERSION@|0.86.0|" \
+          -e "s|prefix=/usr|prefix=$out|" \
+          usb_moded.pc.in > $out/lib/pkgconfig/usb_moded.pc
+    '';
+  });
+in
+stdenv.mkDerivation (finalAttrs: {
+  pname = "usb-moded-qt6";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "libusb-moded-qt";
+    rev = "10f2bcb86e9c116ae94da668d997c09c0966388c";
+    sha256 = "sha256-hCNbpJQz/0Vja7lZTk8zJvEYxt3jCDZoSv4XPTdbBZs=";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    usb-moded-dev
+    dbus
+  ];
+
+  postPatch = ''
+        cat << "EOF" > CMakeLists.txt
+    cmake_minimum_required(VERSION 3.16)
+    project(usb-moded-qt6 LANGUAGES CXX)
+    find_package(Qt6 REQUIRED COMPONENTS Core DBus)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(dbus-1 REQUIRED IMPORTED_TARGET dbus-1)
+    pkg_check_modules(usb_moded REQUIRED IMPORTED_TARGET usb_moded)
+    set(CMAKE_AUTOMOC ON)
+    file(GLOB HEADERS "src/*.h")
+    set(SOURCES src/qusbmode.cpp src/qusbmoded.cpp usb_moded_interface.cpp)
+    add_library(usb-moded-qt6 SHARED ''${SOURCES} ''${HEADERS})
+    target_compile_definitions(usb-moded-qt6 PRIVATE QUSBMODED_LIBRARY)
+    target_include_directories(usb-moded-qt6 PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/src>
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}>
+      $<INSTALL_INTERFACE:include/usb-moded-qt6>
+    )
+    target_link_libraries(usb-moded-qt6 PUBLIC Qt6::Core Qt6::DBus PkgConfig::dbus-1 PkgConfig::usb_moded)
+    set_target_properties(usb-moded-qt6 PROPERTIES VERSION 1.0.0 SOVERSION 1)
+    install(TARGETS usb-moded-qt6 DESTINATION lib)
+    install(FILES ''${HEADERS} DESTINATION include/usb-moded-qt6)
+    configure_file(usb-moded-qt6.pc.in usb-moded-qt6.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/usb-moded-qt6.pc DESTINATION lib/pkgconfig)
+    EOF
+        cat << "EOF" > usb-moded-qt6.pc.in
+    prefix=@CMAKE_INSTALL_PREFIX@
+    exec_prefix=''${prefix}
+    libdir=''${prefix}/lib
+    includedir=''${prefix}/include/usb-moded-qt6
+
+    Name: usb-moded-qt6
+    Description: Qt bindings for usb_moded
+    Version: 1.0.0
+    Requires: Qt6Core Qt6DBus
+    Libs: -L''${libdir} -lusb-moded-qt6
+    Cflags: -I''${includedir}
+    EOF
+  '';
+
+  preConfigure = ''
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -N -c QUsbModedInterface -p usb_moded_interface.h:usb_moded_interface.cpp ${usb-moded-dev}/include/usb-moded/com.meego.usb_moded.xml
+  '';
+
+  meta = with lib; {
+    description = "Qt6 client library and bindings for usb_moded daemon";
+    homepage = "https://github.com/sailfishos/libusb-moded-qt";
+    license = licenses.bsd3;
+    platforms = platforms.linux;
+  };
+})
