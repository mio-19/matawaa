+# Nemomobile SensorFW sensor daemon and Qt client API
+# Upstream repository: https://github.com/sailfishos/sensorfw
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-nemomobile/sensorfw
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  systemd,
+  libhybris,
+  udev,
+  metaAsteroidSrc,
+}:
+
+stdenv.mkDerivation {
+  pname = "sensorfw";
+  version = "0.15.1";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "sensorfw";
+    rev = "b62d0e591d736c904128fcfc8476f22cfdbe53b9";
+    hash = "sha256-+rTwVJSaYAV7lCUPISxtlPZvRyIeFiAgsdOfuBat98k=";
+  };
+
+  patches = [
+    "${metaAsteroidSrc}/recipes-nemomobile/sensorfw/files/0001-Do-not-hide-stepcounter-by-default.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/sensorfw/files/0002-Add-heart-rate-monitor-sensor-with-hybris-adaptor.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/sensorfw/files/0003-Add-Wrist-gesture-sensor-via-libhybris-adaptor.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/sensorfw/files/0004-Fix-compilation-when-autohybris-is-used.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/sensorfw/files/0005-Fix-compilation-when-hybris-is-used.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/sensorfw/files/0006-hybrisadaptor-Queue-erroneous-events-too.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/sensorfw/files/0007-qt-api-Fix-synchronous-D-Bus-calls-on-Qt-6.patch"
+  ];
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    systemd
+    libhybris
+    libhybris.androidHeaders
+    udev
+  ];
+
+  # Upstream only ships qmake project files; CMakeLists.txt mirrors them.
+  postPatch = ''
+    cp ${./CMakeLists.txt} CMakeLists.txt
+  '';
+
+  cmakeFlags = [
+    "-DENABLE_HYBRIS=ON"
+    "-DHYBRIS_LIB=${libhybris}"
+    "-DANDROID_INCLUDE=${libhybris.androidHeadersInclude}"
+  ];
+
+  meta = with lib; {
+    description = "Nemomobile sensor daemon and Qt sensor client API";
+    homepage = "https://github.com/sailfishos/sensorfw";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/swclock-offset/default.nix b/overlay/asteroidos/swclock-offset/default.nix
