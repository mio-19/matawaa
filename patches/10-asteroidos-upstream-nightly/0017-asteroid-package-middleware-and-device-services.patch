diff --git a/overlay/asteroidos/nemo-qml-plugin-notifications/default.nix b/overlay/asteroidos/nemo-qml-plugin-notifications/default.nix
new file mode 100644
index 00000000..b7ae2e17
--- /dev/null
+++ b/overlay/asteroidos/nemo-qml-plugin-notifications/default.nix
@@ -0,0 +1,121 @@
+# Nemomobile notifications library and QML plugin (Nemo.Notifications)
+# Upstream repository: https://github.com/sailfishos/nemo-qml-plugin-notifications
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/blob/master/recipes-nemomobile/nemo-qml-plugins/nemo-qml-plugin-notifications_git.bb
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  buildPackages,
+}:
+
+stdenv.mkDerivation {
+  pname = "nemo-qml-plugin-notifications";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "nemo-qml-plugin-notifications";
+    rev = "d4d0a0ce8257b90293b8df469830f0e288faeeae";
+    hash = "sha256-zqbFYiV5isEpSkzYmXeh3sUY4skTvtSGQL++KH3cIjQ=";
+  };
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+  ];
+
+  # Upstream is a qmake project: src/src.pro builds libnemonotifications-qt6
+  # and src/plugin/plugin.pro builds the Nemo.Notifications QML plugin.
+  postPatch = ''
+    cat > CMakeLists.txt << 'EOF'
+    cmake_minimum_required(VERSION 3.16)
+    project(nemonotifications LANGUAGES CXX)
+
+    set(CMAKE_CXX_STANDARD 17)
+    set(CMAKE_CXX_STANDARD_REQUIRED ON)
+    set(CMAKE_AUTOMOC ON)
+
+    find_package(Qt6 REQUIRED COMPONENTS Core Gui Qml DBus)
+
+    set(SRC_DIR "''${CMAKE_CURRENT_SOURCE_DIR}/src")
+
+    add_library(nemonotifications-qt6 SHARED
+      ''${SRC_DIR}/notification.cpp
+      ''${SRC_DIR}/notificationmanagerproxy.cpp
+      ''${SRC_DIR}/notification.h
+      ''${SRC_DIR}/notification_p.h
+      ''${SRC_DIR}/notificationmanagerproxy.h
+      ''${SRC_DIR}/notificationexport.h
+    )
+    target_compile_definitions(nemonotifications-qt6 PRIVATE
+      BUILD_NEMO_QML_PLUGIN_NOTIFICATIONS_LIB)
+    target_include_directories(nemonotifications-qt6 PUBLIC
+      ''${SRC_DIR}
+      ''${CMAKE_CURRENT_BINARY_DIR})
+    target_link_libraries(nemonotifications-qt6 PUBLIC Qt6::Core Qt6::Gui Qt6::DBus)
+    set_target_properties(nemonotifications-qt6 PROPERTIES
+      OUTPUT_NAME nemonotifications-qt6)
+
+    add_library(nemonotifications MODULE ''${SRC_DIR}/plugin/plugin.cpp)
+    target_include_directories(nemonotifications PRIVATE
+      ''${SRC_DIR}
+      ''${CMAKE_CURRENT_BINARY_DIR})
+    target_link_libraries(nemonotifications PRIVATE
+      nemonotifications-qt6
+      Qt6::Core
+      Qt6::Qml
+      Qt6::DBus)
+    set_target_properties(nemonotifications PROPERTIES
+      OUTPUT_NAME nemonotifications)
+
+    install(TARGETS nemonotifications-qt6 DESTINATION lib)
+    install(TARGETS nemonotifications DESTINATION lib/qt-6/qml/Nemo/Notifications)
+    install(FILES
+      ''${SRC_DIR}/plugin/qmldir
+      ''${SRC_DIR}/plugin/plugins.qmltypes
+      DESTINATION lib/qt-6/qml/Nemo/Notifications)
+    install(FILES
+      ''${SRC_DIR}/notification.h
+      ''${SRC_DIR}/notification_p.h
+      ''${SRC_DIR}/notificationexport.h
+      DESTINATION include/nemonotifications-qt6)
+    EOF
+  '';
+
+  postInstall = ''
+    # Provide both libnemonotifications.so and nemonotifications.so symlinks for QML plugin loader
+    ln -s libnemonotifications.so $out/lib/qt-6/qml/Nemo/Notifications/nemonotifications.so
+  '';
+
+  cmakeFlags = [
+    "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+  ];
+
+  preConfigure = ''
+    # Upstream src.pro generates the proxy through qdbusxml2cpp with
+    # QT_HOST_BINS; do the same explicitly for cross builds.
+    (cd src && ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp \
+      -p notificationmanagerproxy -c NotificationManagerProxy -i notification_p.h \
+      org.freedesktop.Notifications.xml)
+  '';
+
+  meta = with lib; {
+    description = "Nemomobile notifications library and QML plugin for AsteroidOS";
+    homepage = "https://github.com/sailfishos/nemo-qml-plugin-notifications";
+    license = licenses.bsd3;
+    platforms = platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/nfcd/default.nix b/overlay/asteroidos/nfcd/default.nix
new file mode 100644
index 00000000..d12414ad
--- /dev/null
+++ b/overlay/asteroidos/nfcd/default.nix
@@ -0,0 +1,197 @@
+# Upstream:
+#   meta-asteroid/recipes-nemomobile/nfcd/nfcd_git.bb
+#   meta-asteroid/recipes-nemomobile/nfcd/nfcd-mce-plugin_git.bb
+#   meta-asteroid/recipes-nemomobile/nfcd/nfcd-binder-plugin_git.bb
+#   meta-asteroid/recipes-nemomobile/mce/libmce-glib_git.bb
+#   meta-smartwatch/meta-hoki/recipes-nemomobile/nfcd/nfcd_git.bbappend
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  pkg-config,
+  glib,
+  libglibutil,
+  libgbinder,
+  systemd,
+  file,
+  mce-dev,
+  libncicore,
+  libnfcdef,
+  libnciplugin,
+  metaAsteroidSrc,
+}:
+
+let
+  libmceGlibSrc = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "libmce-glib";
+    rev = "49cff7f515979777d137cbb6a78076a50fdb99f2";
+    hash = "sha256-CIqhZUIYFwsfm0OgpjHTBTaa581MDK11ehsBI0hJDHI=";
+  };
+
+  nfcdMcePluginSrc = fetchFromGitHub {
+    owner = "mer-hybris";
+    repo = "nfcd-mce-plugin";
+    rev = "87e762e063f9c645762ee7e4bb6f9d1df80a052b";
+    hash = "sha256-oLiLfg5zh+Wm8BVKsRVT0MecZIXke7At8x52I9qnCxU=";
+  };
+
+  nfcdBinderPluginSrc = fetchFromGitHub {
+    owner = "mer-hybris";
+    repo = "nfcd-binder-plugin";
+    rev = "ee270922a39d3730226936d7e78896dd508400be";
+    hash = "sha256-t0dLVeEeFfvpaR1QuEW5KdWFEHPWrVP2VnFNtXg1r7w=";
+  };
+in
+stdenv.mkDerivation {
+  pname = "nfcd";
+  version = "1.2.4";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "nfcd";
+    rev = "482ca8bc3eca4ce2fc04cb9ab368d173353a1c65";
+    hash = "sha256-DAKjLW6RtGBer6aDTvCAjEABuKLjwcUQXvRKC0+Wzdc=";
+  };
+
+  patches = [
+    "${metaAsteroidSrc}/recipes-nemomobile/nfcd/nfcd/0001-Makefile-Allow-for-CC-to-be-overridden.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/nfcd/nfcd/0002-Makefile-Allow-for-INSTALL_SYSTEMD_DIR-to-be-overrid.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/nfcd/nfcd/0003-systemd-Allow-the-service-to-be-started-as-root.patch"
+  ];
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    pkg-config
+    glib # gdbus-codegen
+  ];
+
+  buildInputs = [
+    glib
+    libglibutil
+    libgbinder
+    systemd
+    file
+    mce-dev
+    libncicore
+    libnfcdef
+    libnciplugin
+  ];
+
+  postPatch = ''
+    for mf in core/Makefile plugins/Makefile src/Makefile \
+              tools/iso-dep/Makefile tools/ndef-read/Makefile \
+              tools/ndef-share/Makefile tools/ndef-write/Makefile \
+              tools/nfc-io/Makefile; do
+      substituteInPlace "$mf" \
+        --replace-quiet "pkg-config" "\$(PKG_CONFIG)" \
+        --replace-quiet "	ranlib " "	\$(RANLIB) "
+    done
+    substituteInPlace core/nfcd-plugin.pc.in \
+      --replace-fail "includedir=/usr/include" "includedir=${placeholder "out"}/include"
+  '';
+
+  buildPhase = ''
+    runHook preBuild
+
+    commonFlags=(
+      "KEEP_SYMBOLS=1"
+      "HAVE_DBUSACCESS=0"
+      "CC=${stdenv.cc.targetPrefix}gcc"
+      "AR=${stdenv.cc.targetPrefix}ar"
+      "RANLIB=${stdenv.cc.targetPrefix}ranlib"
+      "LIBDIR=${placeholder "out"}/lib"
+    )
+
+    make -C core "''${commonFlags[@]}" release pkgconfig
+    make -C plugins "''${commonFlags[@]}" release
+    make -C src "''${commonFlags[@]}" release
+    make -C tools "''${commonFlags[@]}" release
+
+    # Build libmce-glib (required by nfcd-mce-plugin).
+    cp -r ${libmceGlibSrc} libmce-glib
+    chmod -R u+w libmce-glib
+    substituteInPlace libmce-glib/Makefile \
+      --replace-fail "pkg-config" "\$(PKG_CONFIG)" \
+      --replace-fail "INCLUDES = -I\$(INCLUDE_DIR) -I\$(GEN_DIR)" \
+        "INCLUDES = -I\$(INCLUDE_DIR) -I\$(GEN_DIR) -I${mce-dev}/include"
+    make -C libmce-glib "''${commonFlags[@]}" release
+    ln -sf libmce-glib.so.1 libmce-glib/build/release/libmce-glib.so
+
+    # Build nfcd-mce-plugin (RDEPENDS of nfcd_git.bb).
+    cp -r ${nfcdMcePluginSrc} nfcd-mce-plugin
+    chmod -R u+w nfcd-mce-plugin
+    patch -d nfcd-mce-plugin -p1 < ${metaAsteroidSrc}/recipes-nemomobile/nfcd/nfcd-mce-plugin/0001-Makefile-Allow-for-CC-to-be-overridden.patch
+    substituteInPlace nfcd-mce-plugin/Makefile \
+      --replace-fail "LDPKGS = libmce-glib libglibutil gobject-2.0 glib-2.0" \
+        "LDPKGS = libglibutil gobject-2.0 glib-2.0" \
+      --replace-fail "PKGS = \$(LDPKGS) nfcd-plugin" \
+        "PKGS = \$(LDPKGS) libnfcdef" \
+      --replace-fail "pkg-config" "\$(PKG_CONFIG)"
+    make -C nfcd-mce-plugin "''${commonFlags[@]}" \
+      CFLAGS="-I$(pwd)/core/include -I$(pwd)/libmce-glib/include -I${mce-dev}/include" \
+      LDFLAGS="-L$(pwd)/libmce-glib/build/release -Wl,-rpath,${placeholder "out"}/lib -lmce-glib" \
+      release
+
+    # Build nfcd-binder-plugin (RDEPENDS added by meta-hoki/recipes-nemomobile/nfcd/nfcd_git.bbappend).
+    cp -r ${nfcdBinderPluginSrc} nfcd-binder-plugin
+    chmod -R u+w nfcd-binder-plugin
+    patch -d nfcd-binder-plugin -p1 < ${metaAsteroidSrc}/recipes-nemomobile/nfcd/nfcd-binder-plugin/0001-Makefile-Allow-for-CC-to-be-overridden.patch
+    substituteInPlace nfcd-binder-plugin/Makefile \
+      --replace-fail "PKGS = \$(LDPKGS) nfcd-plugin" \
+        "PKGS = \$(LDPKGS) libnfcdef" \
+      --replace-fail "pkg-config" "\$(PKG_CONFIG)"
+    make -C nfcd-binder-plugin "''${commonFlags[@]}" \
+      CFLAGS="-I$(pwd)/core/include" \
+      release
+
+    runHook postBuild
+  '';
+
+  installPhase = ''
+    runHook preInstall
+
+    mkdir -p $out/sbin $out/bin $out/lib/nfcd/plugins $out/lib/pkgconfig \
+      $out/include/nfcd $out/lib/systemd/system $out/etc/dbus-1/system.d \
+      $out/share/dbus-1/system.d
+
+    install -m755 src/build/release/nfcd $out/sbin/nfcd
+    install -m644 src/nfcd.service $out/lib/systemd/system/nfcd.service
+    substituteInPlace $out/lib/systemd/system/nfcd.service \
+      --replace-fail "/usr/sbin/nfcd" "$out/sbin/nfcd"
+
+    install -m644 core/include/*.h $out/include/nfcd/
+    install -m644 core/build/nfcd-plugin.pc $out/lib/pkgconfig/nfcd-plugin.pc
+
+    for tool in iso-dep ndef-read ndef-share ndef-write nfc-io; do
+      install -m755 "tools/$tool/build/release/$tool" "$out/bin/$tool"
+    done
+
+    # Install libmce-glib shared library and plugins
+    install -m755 libmce-glib/build/release/libmce-glib.so.1.1.0 $out/lib/
+    ln -sf libmce-glib.so.1.1.0 $out/lib/libmce-glib.so.1.1
+    ln -sf libmce-glib.so.1.1 $out/lib/libmce-glib.so.1
+    ln -sf libmce-glib.so.1 $out/lib/libmce-glib.so
+
+    install -m755 nfcd-mce-plugin/build/release/mce.so $out/lib/nfcd/plugins/mce.so
+    install -m755 nfcd-binder-plugin/build/release/binder.so $out/lib/nfcd/plugins/binder.so
+
+    # Install D-Bus system policies (removing non-existent 'nfc' user block since
+    # AsteroidOS runs nfcd as root via patch 0003).
+    for conf in plugins/*/*.conf; do
+      base=$(basename "$conf")
+      sed '/<policy user="nfc">/,/<\/policy>/d' "$conf" > "$out/etc/dbus-1/system.d/$base"
+      cp "$out/etc/dbus-1/system.d/$base" "$out/share/dbus-1/system.d/$base"
+    done
+
+    runHook postInstall
+  '';
+
+  meta = {
+    description = "SailfishOS NFC daemon with MCE and Android hwbinder plugins";
+    homepage = "https://github.com/sailfishos/nfcd";
+    license = lib.licenses.bsd3;
+    platforms = lib.platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/ngf-qt6/default.nix b/overlay/asteroidos/ngf-qt6/default.nix
new file mode 100644
index 00000000..06bf7395
--- /dev/null
+++ b/overlay/asteroidos/ngf-qt6/default.nix
@@ -0,0 +1,96 @@
+# Qt6 client library and Nemo.Ngf QML plugin for Non-Graphic Feedback (NGF) daemon
+# Upstream repository: https://github.com/sailfishos/libngf-qt
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  buildPackages,
+}:
+
+stdenv.mkDerivation {
+  pname = "ngf-qt6";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "libngf-qt";
+    rev = "94caafdbc31341e9b9834199aedaa0c5f4a7bd44";
+    hash = "sha256-Spg1PfS0mkLDaCaR7RZUKbne+RFLJ1SSUnIgupfYgMw=";
+  };
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+  ];
+
+  cmakeFlags = [
+    "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+  ];
+
+  postPatch = ''
+    cat << "EOF" > CMakeLists.txt
+    cmake_minimum_required(VERSION 3.16)
+    project(ngf-qt6 LANGUAGES CXX)
+    set(CMAKE_CXX_STANDARD 17)
+    set(CMAKE_AUTOMOC ON)
+    find_package(Qt6 REQUIRED COMPONENTS Core DBus Qml)
+    file(GLOB HEADERS "src/include/*")
+    set(SOURCES src/dbus/client.cpp src/dbus/clientprivate.cpp)
+    add_library(ngf-qt6 SHARED ''${SOURCES} ''${HEADERS})
+    target_compile_definitions(ngf-qt6 PRIVATE NGFCLIENT_LIBRARY)
+    target_include_directories(ngf-qt6 PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/src/include>
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/src/dbus>
+      $<INSTALL_INTERFACE:include/ngf-qt6>
+    )
+    target_link_libraries(ngf-qt6 PUBLIC Qt6::Core Qt6::DBus)
+    set_target_properties(ngf-qt6 PROPERTIES VERSION 1.0.0 SOVERSION 1)
+    install(TARGETS ngf-qt6 DESTINATION lib)
+    install(FILES ''${HEADERS} DESTINATION include/ngf-qt6)
+    configure_file(ngf-qt6.pc.in ngf-qt6.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/ngf-qt6.pc DESTINATION lib/pkgconfig)
+
+    add_library(ngf-declarative MODULE
+      declarative/src/plugin.cpp
+      declarative/src/declarativengfevent.cpp
+      declarative/src/declarativengfeventproperty.cpp
+    )
+    target_include_directories(ngf-declarative PRIVATE src/include declarative/src)
+    target_link_libraries(ngf-declarative PRIVATE Qt6::Core Qt6::Qml ngf-qt6)
+    install(TARGETS ngf-declarative LIBRARY DESTINATION lib/qt-6/qml/Nemo/Ngf)
+    install(FILES declarative/qmldir declarative/plugins.qmltypes DESTINATION lib/qt-6/qml/Nemo/Ngf)
+    EOF
+    cat << "EOF" > ngf-qt6.pc.in
+    prefix=@CMAKE_INSTALL_PREFIX@
+    exec_prefix=''${prefix}
+    libdir=''${prefix}/lib
+    includedir=''${prefix}/include/ngf-qt6
+
+    Name: ngf-qt6
+    Description: Qt client library for NGF daemon
+    Version: 1.0.0
+    Requires: Qt6Core Qt6DBus
+    Libs: -L''${libdir} -lngf-qt6
+    Cflags: -I''${includedir}
+    EOF
+  '';
+
+  meta = with lib; {
+    description = "Qt6 client library and Nemo.Ngf QML plugin for Non-Graphic Feedback daemon";
+    homepage = "https://github.com/sailfishos/libngf-qt";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+}
