diff --git a/overlay/asteroidos/keepalive/default.nix b/overlay/asteroidos/keepalive/default.nix
new file mode 100644
index 00000000..d83dcfab
--- /dev/null
+++ b/overlay/asteroidos/keepalive/default.nix
@@ -0,0 +1,104 @@
+# Nemo keepalive background activity scheduling library and QML plugin
+# Upstream repository: https://github.com/sailfishos/nemo-keepalive
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/blob/master/recipes-nemomobile/nemo-keepalive/nemo-keepalive_git.bb
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  pkg-config,
+  qt6,
+  mce-dev,
+  libiphb,
+  buildPackages,
+  metaAsteroidSrc,
+}:
+
+stdenv.mkDerivation {
+  pname = "keepalive";
+  version = "1.2.6";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "nemo-keepalive";
+    rev = "c38d05b5ebc871dc36561abaf9bbf1dfb8438e83";
+    hash = "sha256-4DjLZqqtuVlZru9aXP4VMrnhrGFdzIbSlEoyEcQXvAk=";
+  };
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  # Runtime examples must not retain native Qt or the cross compiler, including
+  # through debug info in files installed outside the standard fixup paths.
+  disallowedReferences = [
+    buildPackages.qt6.qtbase
+    stdenv.cc.cc
+  ];
+
+  patches = [
+    "${metaAsteroidSrc}/recipes-nemomobile/nemo-keepalive/nemo-keepalive/0001-Disable-tests.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/nemo-keepalive/nemo-keepalive/0002-Fix-build.patch"
+  ];
+
+  nativeBuildInputs = [
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    mce-dev
+    libiphb
+  ];
+
+  propagatedBuildInputs = [ libiphb ];
+
+  postPatch = ''
+    substituteInPlace lib/lib.pro \
+      --replace-fail '$$[QT_INSTALL_LIBS]' '/lib' \
+      --replace-fail '/usr/include/keepalive' '/include/keepalive' \
+      --replace-fail 'pkgconfig.files = $$PWD/pkgconfig/keepalive.pc' "" \
+      --replace-fail 'pkgconfig.path  = $$target.path/pkgconfig' "" \
+      --replace-fail 'QMAKE_PKGCONFIG_LIBDIR      = $$target.path' "QMAKE_PKGCONFIG_LIBDIR = $out/lib" \
+      --replace-fail 'QMAKE_PKGCONFIG_INCDIR      = $$develheaders.path' "QMAKE_PKGCONFIG_INCDIR = $out/include/keepalive" \
+      --replace-fail 'QMAKE_PKGCONFIG_REQUIRES    = Qt$''${QT_MAJOR_VERSION}Core Qt$''${QT_MAJOR_VERSION}DBus' \
+                     'QMAKE_PKGCONFIG_REQUIRES = Qt6Core Qt6DBus libiphb' \
+      --replace-fail 'INSTALLS += target develheaders pkgconfig' 'INSTALLS += target develheaders'
+    substituteInPlace plugin/plugin.pro \
+      --replace-fail '$$[QT_INSTALL_QML]' '/lib/qt-6/qml'
+    for project in examples/*/*.pro; do
+      substituteInPlace "$project" \
+        --replace-fail '$$[QT_INSTALL_BINS]' '/bin'
+    done
+    substituteInPlace keepalive.pro \
+      --replace-fail '$$[QT_INSTALL_EXAMPLES]/keepalive' '/share/qt-6/examples/keepalive'
+  '';
+
+  configurePhase = ''
+    runHook preConfigure
+    export PATH="${buildPackages.qt6.qtbase}/bin:$PATH"
+    export QMAKEPATH="${qt6.qtbase.dev}:${qt6.qtdeclarative.dev}"
+    ${buildPackages.qt6.qtbase}/bin/qmake -early \
+      "QMAKE_CC=$CC" "QMAKE_CXX=$CXX" "QMAKE_LINK=$CXX" \
+      "QMAKE_AR=$AR cqs" "QMAKE_STRIP=$STRIP" \
+      "QMAKE_PKG_CONFIG=$PKG_CONFIG"
+    runHook postConfigure
+  '';
+
+  enableParallelBuilding = true;
+
+  installFlags = [ "INSTALL_ROOT=$(out)" ];
+
+  postInstall = ''
+    substituteInPlace $out/lib/pkgconfig/keepalive.pc \
+      --replace-fail 'prefix=${buildPackages.qt6.qtbase}' 'prefix=$out'
+    mkdir -p $out/lib/qt-6/qml/org/nemomobile
+    ln -s ../../Nemo/KeepAlive $out/lib/qt-6/qml/org/nemomobile/keepalive
+  '';
+
+  meta = with lib; {
+    description = "Nemomobile CPU and display keepalive library and QML plugin";
+    homepage = "https://github.com/sailfishos/nemo-keepalive";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+}
