diff --git a/overlay/asteroidos/mce/default.nix b/overlay/asteroidos/mce/default.nix
new file mode 100644
index 00000000..00a69c32
--- /dev/null
+++ b/overlay/asteroidos/mce/default.nix
@@ -0,0 +1,108 @@
+# Nemomobile Mode Control Entity (MCE) daemon with AsteroidOS patches
+# Upstream repository: https://github.com/sailfishos/mce
+# AsteroidOS recipes: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-nemomobile/mce
+{
+  lib,
+  stdenv,
+  fetchgit,
+  pkg-config,
+  glib,
+  dbus,
+  dbus-glib,
+  systemd,
+  udev,
+  libdsme,
+  libiphb,
+  libngf,
+  usb-moded-dev,
+  mce-dev,
+  mce-plugin-libhybris,
+  metaAsteroidSrc,
+}:
+
+stdenv.mkDerivation {
+  pname = "mce";
+  version = "1.109.2";
+
+  src = fetchgit {
+    url = "https://github.com/sailfishos/mce.git";
+    rev = "51135ea73ae162ec7708415801505e10a6f3fe5f";
+    hash = "sha256-MpOVMUnuFTs9xMudta5LiFEmfI6cx9Oj7+hvzEErS+Q=";
+    fetchSubmodules = true;
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    pkg-config
+  ];
+
+  buildInputs = [
+    glib
+    dbus
+    dbus-glib
+    systemd
+    udev
+    libdsme
+    libiphb
+    libngf
+    usb-moded-dev
+    mce-dev
+  ];
+
+  patches = [
+    "${metaAsteroidSrc}/recipes-nemomobile/mce/mce/0001-Double-tap-emulation-Adapts-the-state-machine-to-a-s.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/mce/mce/0002-tilt-to-wake-Wake-screen-when-wrist-gesture-arrives.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/mce/mce/0003-inactivity-Allow-activities-in-lockscreen-mode.-aste.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/mce/mce/0004-Ambient-mode-Adapt-low-power-mode-to-allow-for-actua.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/mce/mce/0005-Ambient-Mode-Wait-for-compositor-when-sending-enable.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/mce/mce/0006-Ambient-Mode-Exit-ambient-mode-when-touch-is-detecte.patch"
+    "${metaAsteroidSrc}/recipes-nemomobile/mce/mce/0007-powerkey-Also-suspend-on-palm-reports.patch"
+  ];
+
+  postPatch = ''
+    substituteInPlace Makefile \
+      --replace-fail 'MODULEDIR             := $(_LIBDIR)/mce/modules' "MODULEDIR := $out/lib/mce/modules" \
+      --replace-fail 'DBUSDIR               := $(_SYSCONFDIR)/dbus-1/system.d' "DBUSDIR := $out/share/dbus-1/system.d" \
+      --replace-fail 'CONFDIR               := $(_SYSCONFDIR)/mce' "CONFDIR := $out/etc/mce"
+  '';
+
+  makeFlags = [
+    "PKG_CONFIG=${stdenv.cc.targetPrefix}pkg-config"
+    "ENABLE_SYSTEMD_SUPPORT=y"
+    "ENABLE_HYBRIS=y"
+    "ENABLE_DOUBLETAP_EMULATION=y"
+  ];
+
+  installPhase = ''
+    runHook preInstall
+    mkdir -p $out/sbin $out/lib/mce/modules $out/etc/mce $out/share/dbus-1/system.d $out/share/mce
+
+    install -m755 mce $out/sbin/mce
+    install -m755 tools/mcetool tools/evdev_trace tools/dummy_compositor $out/sbin/
+
+    install -m755 modules/*.so $out/lib/mce/modules/
+    install -m755 ${mce-plugin-libhybris}/lib/mce/modules/hybris.so $out/lib/mce/modules/
+
+    install -m644 mce.conf $out/share/dbus-1/system.d/com.nokia.mce.conf
+
+    install -m644 inifiles/mce.ini $out/etc/mce/10mce.ini
+    install -m644 inifiles/mce-radio-states.ini $out/etc/mce/20mce-radio-states.ini
+    install -m644 inifiles/hybris-led.ini $out/etc/mce/20hybris-led.ini
+    install -m644 inifiles/hybris-features.ini $out/etc/mce/20hybris-features.ini
+    install -m644 inifiles/debug-led.ini $out/etc/mce/20debug-led.ini
+    install -m644 inifiles/als-defaults.ini $out/etc/mce/20als-defaults.ini
+    install -m644 inifiles/evdev-types.ini $out/etc/mce/20evdev-types.ini
+    install -m644 inifiles/legacy.ini $out/etc/mce/11legacy.ini
+
+    install -m644 ${./builtin-gconf.values} $out/share/mce/builtin-gconf.values
+    runHook postInstall
+  '';
+
+  meta = with lib; {
+    description = "Nemomobile Mode Control Entity (MCE) daemon with AsteroidOS gestures and ambient display support";
+    homepage = "https://github.com/sailfishos/mce";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+}
