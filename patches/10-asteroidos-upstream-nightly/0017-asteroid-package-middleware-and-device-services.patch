diff --git a/overlay/asteroidos/accounts-qt/default.nix b/overlay/asteroidos/accounts-qt/default.nix
new file mode 100644
index 00000000..b0ba7f11
--- /dev/null
+++ b/overlay/asteroidos/accounts-qt/default.nix
@@ -0,0 +1,85 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitLab,
+  cmake,
+  pkg-config,
+  qt6,
+  libaccounts-glib,
+  glib,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "accounts-qt";
+  version = "1.17";
+
+  # Same revision as upstream:
+  # meta-asteroid/recipes-nemomobile/libaccounts/libaccounts-qt6_1.17.bb
+  # (SRCREV c8fdd05f1a1ff5886f4649d24f2ba8c5f61cfa3a, which is the VERSION_1.17
+  #  tree; verified by prefetch - the hash below is identical for both).
+  src = fetchFromGitLab {
+    owner = "accounts-sso";
+    repo = "libaccounts-qt";
+    rev = "c8fdd05f1a1ff5886f4649d24f2ba8c5f61cfa3a";
+    hash = "sha256-mPZgD4r7vlUP6wklvZVknGqTXZBckSOtNzK7p6e2qSA=";
+  };
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    libaccounts-glib
+    glib
+  ];
+
+  postPatch = ''
+    cat > CMakeLists.txt <<'EOF'
+    cmake_minimum_required(VERSION 3.16)
+    project(accounts-qt LANGUAGES CXX)
+    set(CMAKE_CXX_STANDARD 17)
+    set(CMAKE_AUTOMOC ON)
+    add_compile_definitions(BUILDING_ACCOUNTS_QT QT_NO_KEYWORDS QT_NO_CAST_TO_ASCII QT_NO_CAST_FROM_ASCII)
+
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(GLIB REQUIRED IMPORTED_TARGET libaccounts-glib gio-2.0)
+    find_package(Qt6 REQUIRED COMPONENTS Core Xml)
+
+    file(GLOB SOURCES Accounts/*.cpp)
+    file(GLOB HEADERS Accounts/*.h)
+
+    add_library(accounts-qt6 SHARED ''${SOURCES} ''${HEADERS})
+    target_include_directories(accounts-qt6 PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}>
+      $<INSTALL_INTERFACE:include/accounts-qt6>
+    )
+    target_link_libraries(accounts-qt6 PUBLIC Qt6::Core Qt6::Xml PkgConfig::GLIB)
+    set_target_properties(accounts-qt6 PROPERTIES OUTPUT_NAME accounts-qt6 SOVERSION 1 VERSION 1.17)
+
+    install(TARGETS accounts-qt6 LIBRARY DESTINATION lib ARCHIVE DESTINATION lib)
+
+    file(GLOB ROOT_HEADERS Accounts/Account Accounts/AccountService Accounts/Application Accounts/AuthData Accounts/Error Accounts/Manager Accounts/Provider Accounts/Service Accounts/ServiceType)
+    install(FILES ''${HEADERS} ''${ROOT_HEADERS} DESTINATION include/accounts-qt6/Accounts)
+
+    configure_file(Accounts/accounts-qt6.pc.in accounts-qt6.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/accounts-qt6.pc DESTINATION lib/pkgconfig)
+    EOF
+
+    substituteInPlace Accounts/accounts-qt6.pc.in \
+      --replace-fail '$$INSTALL_PREFIX' "$out" \
+      --replace-fail '$$INSTALL_LIBDIR' "$out/lib" \
+      --replace-fail '$$PROJECT_VERSION' '${finalAttrs.version}'
+  '';
+
+  meta = with lib; {
+    description = "Qt-based client library for the accounts-sso framework";
+    homepage = "https://gitlab.com/accounts-sso/accounts-qt";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/amber-mpris/CMakeLists.txt b/overlay/asteroidos/amber-mpris/CMakeLists.txt
new file mode 100644
index 00000000..03a35cfe
--- /dev/null
+++ b/overlay/asteroidos/amber-mpris/CMakeLists.txt
@@ -0,0 +1,128 @@
+cmake_minimum_required(VERSION 3.16)
+project(amber-mpris VERSION 1.0.0 LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_AUTOMOC ON)
+
+find_package(Qt6Core REQUIRED)
+find_package(Qt6DBus REQUIRED)
+find_package(Qt6Qml REQUIRED)
+
+include(GNUInstallDirs)
+
+# Static library for qtdbusextended
+add_library(qtdbusextended STATIC
+    qtdbusextended/dbusextendedabstractinterface.cpp
+    qtdbusextended/dbusextendedabstractinterface.h
+    qtdbusextended/dbusextended.h
+)
+target_include_directories(qtdbusextended PUBLIC qtdbusextended)
+target_link_libraries(qtdbusextended PUBLIC Qt6::Core Qt6::DBus)
+set_target_properties(qtdbusextended PROPERTIES POSITION_INDEPENDENT_CODE ON)
+
+# Shared library ambermpris6
+add_library(ambermpris6 SHARED
+    src/mpris.cpp
+    src/mprisclient.cpp
+    src/mpriscontroller.cpp
+    src/mprisintrospectableadaptor.cpp
+    src/mprismetadata.cpp
+    src/mprismetadataproxy.cpp
+    src/mprisplayer.cpp
+    src/mprisplayeradaptor.cpp
+    src/mprisplayerinterface.cpp
+    src/mprispropertiesadaptor.cpp
+    src/mprisrootinterface.cpp
+    src/mprisserviceadaptor.cpp
+    src/mpris.h
+    src/mpris_p.h
+    src/mprisclient.h
+    src/mprisclient_p.h
+    src/mpriscontroller.h
+    src/mprisintrospectableadaptor_p.h
+    src/mprismetadata.h
+    src/mprismetadata_p.h
+    src/mprismetadataproxy.h
+    src/mprisplayeradaptor_p.h
+    src/mprisplayer.h
+    src/mprisplayer_p.h
+    src/ambermpris.h
+    src/ambermpris_p.h
+    src/mprispropertiesadaptor_p.h
+    src/mprisserviceadaptor_p.h
+)
+target_compile_definitions(ambermpris6 PRIVATE MPRIS_QT_LIBRARY)
+target_include_directories(ambermpris6 PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/qtdbusextended>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/AmberMpris>
+)
+target_link_libraries(ambermpris6 PUBLIC Qt6::Core Qt6::DBus PRIVATE qtdbusextended)
+
+# QML declarative plugin
+add_library(ambermprisplugin SHARED
+    declarative/declarativemprisplayer.cpp
+    declarative/declarativemprisplayer_p.h
+    declarative/mprisplugin.cpp
+    declarative/mprisplugin.h
+)
+target_include_directories(ambermprisplugin PRIVATE src qtdbusextended declarative)
+target_link_libraries(ambermprisplugin PRIVATE ambermpris6 Qt6::Core Qt6::DBus Qt6::Qml)
+
+# Headers to install
+set(AMBER_HEADERS
+    src/Mpris
+    src/MprisPlayer
+    src/MprisClient
+    src/MprisController
+    src/MprisMetaData
+    src/mpris.h
+    src/mprisclient.h
+    src/mpriscontroller.h
+    src/mprisplayer.h
+    src/mprismetadata.h
+    src/ambermpris.h
+)
+
+install(TARGETS ambermpris6
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+)
+
+install(FILES ${AMBER_HEADERS}
+    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/AmberMpris
+)
+
+# Install QML plugin into Amber/Mpris
+set(QML_INSTALL_DIR ${CMAKE_INSTALL_LIBDIR}/qt-6/qml/Amber/Mpris)
+install(TARGETS ambermprisplugin
+    DESTINATION ${QML_INSTALL_DIR}
+)
+install(FILES
+    declarative/qmldir
+    declarative/plugins.qmltypes
+    DESTINATION ${QML_INSTALL_DIR}
+)
+if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/example/qml/MprisAudio.qml)
+    install(FILES example/qml/MprisAudio.qml DESTINATION ${QML_INSTALL_DIR})
+endif()
+
+# Configure and install pkg-config
+set(PKG_CONFIG_PREFIX "${CMAKE_INSTALL_PREFIX}")
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/ambermpris6.pc
+"prefix=${PKG_CONFIG_PREFIX}
+exec_prefix=\${prefix}
+libdir=\${prefix}/lib
+includedir=\${prefix}/include/AmberMpris
+
+Name: AmberMpris
+Description: AmberMpris library
+Version: 1.0.0
+Requires: Qt6Core Qt6DBus
+Libs: -L\${libdir} -lambermpris6
+Cflags: -I\${includedir}
+")
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/ambermpris6.pc
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig
+)
diff --git a/overlay/asteroidos/amber-mpris/default.nix b/overlay/asteroidos/amber-mpris/default.nix
new file mode 100644
index 00000000..f38be0d3
--- /dev/null
+++ b/overlay/asteroidos/amber-mpris/default.nix
@@ -0,0 +1,54 @@
+# QML MPRIS integration library used by AsteroidOS music and btsyncd components
+# Upstream repository: https://github.com/sailfishos/amber-mpris
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-qt/amber-mpris
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  buildPackages,
+}:
+
+stdenv.mkDerivation {
+  pname = "amber-mpris";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "amber-mpris";
+    rev = "0dc2c15104a13c16f3028cb9e73f1e4dc886f4d0";
+    hash = "sha256-kOjzaF6Xu1D06V8Dq9i0mUXwROH0rXTNC2zVnbiYUHI=";
+  };
+
+  strictDeps = true;
+
+  preConfigure = ''
+    cp ${./CMakeLists.txt} CMakeLists.txt
+  '';
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+  ];
+
+  cmakeFlags = [
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+  ];
+
+  dontWrapQtApps = true;
+
+  meta = with lib; {
+    description = "Qt and QML MPRIS interface and adaptor";
+    homepage = "https://github.com/sailfishos/amber-mpris";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/bluebinder/default.nix b/overlay/asteroidos/bluebinder/default.nix
new file mode 100644
index 00000000..e38bf0b5
--- /dev/null
+++ b/overlay/asteroidos/bluebinder/default.nix
@@ -0,0 +1,81 @@
+# Upstream: meta-asteroid/recipes-core/bluebinder/bluebinder.bb
+# Simple proxy for using Android binder based bluetooth through vhci.
+{
+  lib,
+  stdenv,
+  fetchgit,
+  libgbinder,
+  glib,
+  libglibutil,
+  bluez,
+  systemd,
+  metaAsteroidSrc,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "bluebinder";
+  version = "1.0.20";
+
+  src = fetchgit {
+    url = "https://github.com/mer-hybris/bluebinder.git";
+    rev = "c3e1b155e308f6df9c9a02dbd909a44e7319ab7d";
+    hash = "sha256-D7rRnLCkoroYyVrV8fmfi408MIcq1LReI7Qu7gcAyK4=";
+  };
+
+  # Same patches as the upstream recipe.
+  patches = [
+    "${metaAsteroidSrc}/recipes-core/bluebinder/bluebinder/0001-service-fixes.patch"
+    "${metaAsteroidSrc}/recipes-core/bluebinder/bluebinder/0002-Hold-a-wakelock-while-forwarding-HAL-packets-to-vhci.patch"
+  ];
+
+  buildInputs = [
+    libgbinder
+    glib
+    libglibutil
+    bluez
+    systemd
+  ];
+
+  dontConfigure = true;
+
+  # The upstream Makefile shells out to pkg-config, which is not available for
+  # the target in this cross build; pass the same flags explicitly instead.
+  buildPhase = ''
+    runHook preBuild
+    $CC -Wall -flto bluebinder.c -DUSE_SYSTEMD=1 -o bluebinder \
+      -I${libgbinder.dev}/include/gbinder \
+      -I${libglibutil.dev}/include \
+      -I${libglibutil.dev}/include/gutil \
+      -I${glib.dev}/include/glib-2.0 \
+      -I${lib.getOutput "out" glib}/lib/glib-2.0/include \
+      -I${bluez.dev}/include \
+      -I${systemd.dev}/include \
+      -L${libgbinder}/lib -lgbinder \
+      -L${libglibutil}/lib -lglibutil \
+      -L${lib.getOutput "out" glib}/lib -lglib-2.0 \
+      -L${bluez}/lib -lbluetooth \
+      -L${systemd}/lib -lsystemd
+    runHook postBuild
+  '';
+
+  installPhase = ''
+    runHook preInstall
+    install -Dm755 bluebinder $out/sbin/bluebinder
+    install -Dm755 bluebinder_post.sh $out/libexec/bluebinder_post.sh
+    install -Dm755 bluebinder_wait.sh $out/libexec/bluebinder_wait.sh
+    # The vendor getprop and droid helpers live under /system/bin on this
+    # image, not /usr/bin.
+    substituteInPlace $out/libexec/bluebinder_post.sh \
+      --replace-fail /usr/bin/getprop /system/bin/getprop \
+      --replace-fail /usr/bin/droid/droid-get-bt-address.sh /system/bin/droid-get-bt-address.sh
+    substituteInPlace $out/libexec/bluebinder_wait.sh \
+      --replace-fail /usr/bin/getprop /system/bin/getprop
+    runHook postInstall
+  '';
+
+  meta = {
+    description = "Android binder based bluetooth proxy through vhci";
+    license = lib.licenses.gpl2Plus;
+    platforms = [ "armv7l-linux" ];
+  };
+})
diff --git a/overlay/asteroidos/default.nix b/overlay/asteroidos/default.nix
index 7ce4a083..d84329a2 100644
--- a/overlay/asteroidos/default.nix
+++ b/overlay/asteroidos/default.nix
@@ -3,7 +3,15 @@
 rec {
   noUsrShareHook = callPackage ./lib/no-usr-share-hook.nix { };
 
+  mkAsteroidApp = callPackage ./lib/mk-asteroid-app.nix {
+    inherit qml-asteroid mapplauncherd noUsrShareHook;
+  };
+
   qml-asteroid = callPackage ./qml-asteroid { inherit noUsrShareHook; };
+  mapplauncherd = callPackage ./mapplauncherd { inherit metaAsteroidSrc; };
+
+  # Upstream meta-asteroid checkout, used for unmodified recipe payloads
+  # (udev rules, unit files, patches) instead of vendoring them.
   metaAsteroidSrc = pkgs.fetchgit {
     url = "https://github.com/AsteroidOS/meta-asteroid";
     rev = "c84c0bbd731f9dfa3b04295bac239dd7fa64c722";
@@ -12,4 +20,110 @@ rec {
   meta-asteroid-src = metaAsteroidSrc;
 
   # Device features shipped by upstream meta-hoki (IMAGE_INSTALL) and asteroid-image.
+  udev-droid-system = callPackage ./udev-droid-system { inherit metaAsteroidSrc; };
+  swclock-offset = callPackage ./swclock-offset { };
+  bluebinder = callPackage ./bluebinder { inherit metaAsteroidSrc; };
+  ngfd = callPackage ./ngfd { inherit metaAsteroidSrc mce-dev; };
+  libncicore = callPackage ./libncicore { inherit metaAsteroidSrc; };
+  libnfcdef = callPackage ./libnfcdef { inherit metaAsteroidSrc; };
+  libnciplugin = callPackage ./libnciplugin {
+    inherit metaAsteroidSrc libncicore libnfcdef;
+  };
+  nfcd = callPackage ./nfcd {
+    inherit
+      metaAsteroidSrc
+      mce-dev
+      libncicore
+      libnfcdef
+      libnciplugin
+      ;
+  };
+
+  amber-mpris = callPackage ./amber-mpris { };
+  mlite = callPackage ./mlite { };
+  libconnman-qt = callPackage ./libconnman-qt { };
+  libiodata = callPackage ./libiodata { };
+  mce-dev = callPackage ./mce-dev { };
+  mce-plugin-libhybris = callPackage ./mce-plugin-libhybris { };
+  mce-qt6 = callPackage ./mce-qt6 {
+    inherit mce-dev;
+  };
+  ngf-qt6 = callPackage ./ngf-qt6 { };
+  usb-moded-dev = callPackage ./usb-moded-dev { };
+  usb-moded-qt6 = callPackage ./usb-moded-qt6 {
+    inherit usb-moded-dev;
+  };
+
+  # Low-level Nemomobile/SailfishOS libraries for MCE and KeepAlive
+  libdsme = callPackage ./libdsme { };
+  libiphb = callPackage ./libiphb {
+    inherit mce-dev libdsme;
+  };
+  libngf = callPackage ./libngf { };
+
+  # Mode Control Entity (MCE) daemon
+  # Upstream repository: https://github.com/sailfishos/mce
+  # AsteroidOS recipes: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-nemomobile/mce
+  mce = callPackage ./mce {
+    inherit
+      libdsme
+      libiphb
+      libngf
+      usb-moded-dev
+      mce-dev
+      mce-plugin-libhybris
+      metaAsteroidSrc
+      ;
+  };
+
+  # Nemomobile SensorFW daemon and client API (qtsensors sensorfw backend).
+  # Upstream: https://github.com/sailfishos/sensorfw
+  sensorfw = callPackage ./sensorfw {
+    inherit metaAsteroidSrc;
+    inherit (pkgs) libhybris;
+  };
+
+  # Device state machine daemon MCE talks to.
+  # Upstream: https://github.com/sailfishos/dsme
+  dsme = callPackage ./dsme {
+    inherit
+      metaAsteroidSrc
+      libdsme
+      libngf
+      libiphb
+      mce-dev
+      ;
+  };
+
+  keepalive = callPackage ./keepalive {
+    inherit mce-dev libiphb metaAsteroidSrc;
+  };
+  timed-qt6 = callPackage ./timed-qt6 {
+    inherit libiodata metaAsteroidSrc;
+  };
+  nemo-qml-plugin-alarms = callPackage ./nemo-qml-plugin-alarms {
+    inherit timed-qt6;
+  };
+  nemo-qml-plugin-notifications = callPackage ./nemo-qml-plugin-notifications { };
+
+  # Calendar subsystem: accounts-qt, kcalendarcore, mkcal, and nemo-qml-plugin-calendar
+  # Upstream repository: https://gitlab.com/accounts-sso/accounts-qt
+  # Upstream repository: https://github.com/sailfishos-mirror/kcalendarcore
+  # Upstream repository: https://github.com/sailfishos/mkcal
+  # Upstream repository: https://github.com/sailfishos/nemo-qml-plugin-calendar
+  accounts-qt = callPackage ./accounts-qt { };
+  kcalendarcore = callPackage ./kcalendarcore { };
+  mkcal = callPackage ./mkcal {
+    inherit kcalendarcore timed-qt6;
+  };
+  nemo-qml-plugin-calendar = callPackage ./nemo-qml-plugin-calendar {
+    inherit
+      accounts-qt
+      kcalendarcore
+      mkcal
+      timed-qt6
+      libiodata
