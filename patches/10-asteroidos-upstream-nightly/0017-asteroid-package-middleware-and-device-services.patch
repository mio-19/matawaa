+  stdenv,
+  fetchFromGitHub,
+  pkg-config,
+}:
+
+stdenv.mkDerivation rec {
+  pname = "mce-dev";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "mce-dev";
+    rev = "01d50d9670eef183bd6d0f1e1e3656a69af3ac2d";
+    hash = "sha256-PJKHg25oiBdiBlB1yiQMsf84fczXHU7duL6p3HMwnWw=";
