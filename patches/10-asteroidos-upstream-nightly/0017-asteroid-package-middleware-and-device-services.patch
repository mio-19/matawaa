diff --git a/overlay/asteroidos/mce-plugin-libhybris/default.nix b/overlay/asteroidos/mce-plugin-libhybris/default.nix
new file mode 100644
index 00000000..6066dc34
--- /dev/null
+++ b/overlay/asteroidos/mce-plugin-libhybris/default.nix
@@ -0,0 +1,69 @@
+# libhybris plugin for MCE: display brightness/blanking and LED control on
+# Android hardware. Without it MCE falls back to sysfs backlights, which do not
+# exist on Android devices, so the panel never gets powered/brightness set.
+#
+# Upstream recipe:
+# https://github.com/AsteroidOS/meta-asteroid/blob/5021f282a286a4825b6314264f0a7ff62cbe72d1/recipes-nemomobile/mce/mce-plugin-libhybris_git.bb
+{
+  lib,
+  stdenv,
+  fetchgit,
+  pkg-config,
+  glib,
+  libhybris,
+}:
+
+stdenv.mkDerivation {
+  pname = "mce-plugin-libhybris";
+  version = "2024-12-16";
+
+  src = fetchgit {
+    url = "https://github.com/nemomobile/mce-plugin-libhybris.git";
+    rev = "2c48a3f1724b9e82acd13addb70f3201508c811a";
+    hash = "sha256-YfPXKrqMRz1Nb+VdMtS7ViMp75/jElp16ggS4EGn548=";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    pkg-config
+  ];
+
+  buildInputs = [
+    glib
+    libhybris
+  ];
+
+  NIX_CFLAGS_COMPILE = [
+    "-I${glib.dev}/include/glib-2.0"
+    "-I${glib.dev}/lib/glib-2.0/include"
+    # glibconfig.h is arch-specific and lives in the main output.
+    "-I${glib}/lib/glib-2.0/include"
+    # Use libhybris's device headers directly. A defaulted android-headers
+    # argument would still be filled with the generic package by callPackage.
+    "-I${libhybris.androidHeadersInclude}"
+    "-I${libhybris}/include"
+  ];
+
+  # The Makefile only links libhardware when the hybris support switch is on.
+  # Its defaults install into /usr/lib and a /tmp test dir, so pass the
+  # destinations explicitly.
+  buildPhase = ''
+    make ENABLE_HYBRIS_SUPPORT=1 PKG_NAMES="libhardware glib-2.0"
+  '';
+
+  installPhase = ''
+    make install \
+      ENABLE_HYBRIS_SUPPORT=1 \
+      PKG_NAMES="libhardware glib-2.0" \
+      DESTDIR=$out \
+      _LIBDIR=/lib
+  '';
+
+  meta = with lib; {
+    description = "libhybris plugin for the Nemomobile Mode Control Entity (MCE)";
+    homepage = "https://github.com/nemomobile/mce-plugin-libhybris";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/mce-qt6/default.nix b/overlay/asteroidos/mce-qt6/default.nix
new file mode 100644
index 00000000..05416955
--- /dev/null
+++ b/overlay/asteroidos/mce-qt6/default.nix
@@ -0,0 +1,100 @@
+# Qt6 bindings and client library for Mode Control Entity (MCE)
+# Upstream repository: https://github.com/sailfishos/libmce-qt
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  mce-dev,
+  buildPackages,
+}:
+
+stdenv.mkDerivation {
+  pname = "mce-qt6";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "libmce-qt";
+    rev = "7fb63aa8258fd96bf121fa4f28c03aa43f7dc703";
+    hash = "sha256-fWEI0eisU5mPcPNt8EdB3blrOqTREjGDysCjf0FaRLU=";
+  };
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    mce-dev
+  ];
+
+  cmakeFlags = [
+    "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+  ];
+
+  postPatch = ''
+        cat << "EOF" > CMakeLists.txt
+    cmake_minimum_required(VERSION 3.16)
+    project(mce-qt6 LANGUAGES CXX)
+    find_package(Qt6 REQUIRED COMPONENTS Core DBus Qml)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(mce REQUIRED IMPORTED_TARGET mce)
+    set(CMAKE_AUTOMOC ON)
+    file(GLOB SOURCES "lib/src/*.cpp")
+    file(GLOB HEADERS "lib/include/*.h")
+    add_library(mce-qt6 SHARED ''${SOURCES} ''${HEADERS} request_interface.cpp signal_interface.cpp)
+    target_compile_definitions(mce-qt6 PRIVATE QMCE_LIBRARY)
+    target_include_directories(mce-qt6 PUBLIC
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}/lib/include>
+      $<BUILD_INTERFACE:''${CMAKE_CURRENT_SOURCE_DIR}>
+      $<INSTALL_INTERFACE:include/mce-qt6>
+    )
+    target_link_libraries(mce-qt6 PUBLIC Qt6::Core Qt6::DBus PkgConfig::mce)
+    set_target_properties(mce-qt6 PROPERTIES VERSION 1.5.1 SOVERSION 1)
+    install(TARGETS mce-qt6 DESTINATION lib)
+    install(FILES ''${HEADERS} DESTINATION include/mce-qt6)
+    configure_file(mce-qt6.pc.in mce-qt6.pc @ONLY)
+    install(FILES ''${CMAKE_CURRENT_BINARY_DIR}/mce-qt6.pc DESTINATION lib/pkgconfig)
+
+    add_library(qmcedeclarative MODULE plugin/qmcedeclarativeplugin.cpp)
+    target_include_directories(qmcedeclarative PRIVATE lib/include)
+    target_link_libraries(qmcedeclarative PRIVATE Qt6::Core Qt6::Qml mce-qt6)
+    install(TARGETS qmcedeclarative LIBRARY DESTINATION lib/qt-6/qml/Nemo/Mce)
+    install(FILES plugin/qmldir plugin/plugins.qmltypes DESTINATION lib/qt-6/qml/Nemo/Mce)
+    EOF
+        cat << "EOF" > mce-qt6.pc.in
+    prefix=@CMAKE_INSTALL_PREFIX@
+    exec_prefix=''${prefix}
+    libdir=''${prefix}/lib
+    includedir=''${prefix}/include/mce-qt6
+
+    Name: mce-qt6
+    Description: Qt bindings for mce
+    Version: 1.5.1
+    Requires: Qt6Core Qt6DBus mce
+    Libs: -L''${libdir} -lmce-qt6
+    Cflags: -I''${includedir}
+    EOF
+  '';
+
+  preConfigure = ''
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -N -c QMceRequestProxy -p request_interface.h:request_interface.cpp lib/dbus/com.nokia.mce.request.xml
+    ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp -N -c QMceSignalProxy -p signal_interface.h:signal_interface.cpp lib/dbus/com.nokia.mce.signal.xml
+  '';
+
+  meta = with lib; {
+    description = "Qt6 client library and bindings for Mode Control Entity";
+    homepage = "https://github.com/sailfishos/libmce-qt";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+}
