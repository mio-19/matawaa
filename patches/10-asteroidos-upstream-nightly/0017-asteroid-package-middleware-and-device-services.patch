diff --git a/overlay/asteroidos/timed-qt6/default.nix b/overlay/asteroidos/timed-qt6/default.nix
new file mode 100644
index 00000000..07053b86
--- /dev/null
+++ b/overlay/asteroidos/timed-qt6/default.nix
@@ -0,0 +1,109 @@
+# Timed Qt6 daemon, Voland client library, and Timed client library
+# Upstream repository: https://github.com/sailfishos/timed
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-nemomobile/timed
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  pkg-config,
+  qt6,
+  systemd,
+  libiodata,
+  buildPackages,
+  metaAsteroidSrc,
+  tzdata,
+}:
+
+let
+  isCross = !stdenv.buildPlatform.canExecute stdenv.hostPlatform;
+  nativeIodata = if isCross then buildPackages.callPackage ../libiodata { } else libiodata;
+in
+stdenv.mkDerivation {
+  pname = "timed-qt6";
+  version = "3.6.0";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "timed";
+    rev = "80ea5e63cf58db616789adbfeb9cf3bfd63dddaa";
+    hash = "sha256-6axLd3XRCIsuYnKQ0AiCD6Cxut9Ck9hNWwIbkj4Aza8=";
+  };
+
+  strictDeps = true;
+
+  patches = [
+    "${metaAsteroidSrc}/recipes-nemomobile/timed/timed/0002-Drop-sailfish-access-control-dependency.patch"
+  ];
+
+  nativeBuildInputs = [
+    pkg-config
+    qt6.wrapQtAppsHook
+    nativeIodata
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    systemd
+    libiodata
+    tzdata
+  ];
+
+  propagatedBuildInputs = [ libiodata ];
+
+  postPatch = ''
+    substituteInPlace timed.pro \
+      --replace-fail 'SUBDIRS += src tests tools' 'SUBDIRS += src tools'
+    substituteInPlace src/lib/lib.pro \
+      --replace-fail '$$[QT_INSTALL_LIBS]' '/lib' \
+      --replace-fail '/usr/include/timed-qt$''${QT_MAJOR_VERSION}' '/include/timed-qt$''${QT_MAJOR_VERSION}' \
+      --replace-fail '/usr/include/$$TARGET' '/include/$$TARGET' \
+      --replace-fail '$$[QT_INSTALL_DATA]/mkspecs/features' '/lib/qt-6/mkspecs/features'
+    printf '\nINCLUDEPATH += %s\n' '${libiodata}/include' >> src/lib/lib.pro
+    substituteInPlace src/voland/voland.pro \
+      --replace-fail '$$[QT_INSTALL_LIBS]' '/lib' \
+      --replace-fail '/usr/include/timed-voland-qt$''${QT_MAJOR_VERSION}' '/include/timed-voland-qt$''${QT_MAJOR_VERSION}' \
+      --replace-fail '$$[QT_INSTALL_DATA]/mkspecs/features' '/lib/qt-6/mkspecs/features'
+    substituteInPlace src/server/server.pro \
+      --replace-fail '$$(DESTDIR)/usr/bin' '/bin' \
+      --replace-fail '$$(DESTDIR)/etc/dbus-1/system.d' '/share/dbus-1/system.d' \
+      --replace-fail '$$(DESTDIR)/etc' '/etc' \
+      --replace-fail '$$(DESTDIR)/usr/lib/systemd/user' '/lib/systemd/user' \
+      --replace-fail 'INSTALLS += target timedrc dbusconf systemd oneshot' 'INSTALLS += target timedrc dbusconf systemd'
+    printf '\nINCLUDEPATH += %s\n' '${libiodata}/include' >> src/server/server.pro
+    substituteInPlace tools/timedclient/timedclient.pro \
+      --replace-fail '$$(DESTDIR)/usr/bin' '/bin'
+    cp ${metaAsteroidSrc}/recipes-nemomobile/timed/timed/timed.conf src/server/timed.conf
+    substituteInPlace src/server/settings.cpp \
+      --replace-fail '"/usr/share/zoneinfo/' "\"${tzdata}/share/zoneinfo/"
+    substituteInPlace src/lib/aliases.cpp \
+      --replace-fail '"/usr/share/zoneinfo/' "\"${tzdata}/share/zoneinfo/"
+  '';
+
+  preConfigure = ''
+    mkdir -p src/h/timed-qt6
+    cp src/lib/qmacro.h src/h/timed-qt6/
+  '';
+
+  configurePhase = ''
+    runHook preConfigure
+    export TIMED_VERSION=3.6
+    export PATH="${buildPackages.qt6.qtbase}/bin:$PATH"
+    export QMAKEPATH="${qt6.qtbase.dev}:${qt6.qtdeclarative.dev}:${nativeIodata}/lib/qt-6"
+    ${buildPackages.qt6.qtbase}/bin/qmake -early \
+      "QMAKE_CC=$CC" "QMAKE_CXX=$CXX" "QMAKE_LINK=$CXX" \
+      "QMAKE_AR=$AR cqs" "QMAKE_STRIP=$STRIP" \
+      "QMAKE_PKG_CONFIG=$PKG_CONFIG"
+    runHook postConfigure
+  '';
+
+  enableParallelBuilding = true;
+
+  installFlags = [ "INSTALL_ROOT=$(out)" ];
+
+  meta = with lib; {
+    description = "Nemomobile time daemon and Qt6 client libraries";
+    homepage = "https://github.com/sailfishos/timed";
+    license = licenses.lgpl21Plus;
+    platforms = platforms.linux;
+  };
+}
