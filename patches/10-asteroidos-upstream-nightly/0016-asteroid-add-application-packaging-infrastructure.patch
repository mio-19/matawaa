From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 9 Nov 2026 10:55:49 +1100
Subject: [PATCH] asteroid: add application packaging infrastructure

---
 overlay/asteroidos/default.nix                             |   15 ++++++++
 overlay/asteroidos/lib/mk-asteroid-app.nix                 |  121 ++++++++++++++++++++++
 overlay/asteroidos/lib/no-usr-share-hook.nix               |    5 ++++
 overlay/asteroidos/lib/no-usr-share-hook.sh                |   30 +++++++++++
 overlay/asteroidos/qml-asteroid/default.nix                |  124 ++++++++++++++++++++++
 overlay/asteroidos/lib/generate-desktop.nix                |   41 +++++++++++++
6 files changed, 336 insertions(+)

diff --git a/overlay/asteroidos/default.nix b/overlay/asteroidos/default.nix
new file mode 100644
index 00000000..7ce4a083
--- /dev/null
+++ b/overlay/asteroidos/default.nix
@@ -0,0 +1,15 @@
+{ callPackage, pkgs }:
+
+rec {
+  noUsrShareHook = callPackage ./lib/no-usr-share-hook.nix { };
+
+  qml-asteroid = callPackage ./qml-asteroid { inherit noUsrShareHook; };
+  metaAsteroidSrc = pkgs.fetchgit {
+    url = "https://github.com/AsteroidOS/meta-asteroid";
+    rev = "c84c0bbd731f9dfa3b04295bac239dd7fa64c722";
+    hash = "sha256-AZF9IUTtSNTpgcu7kOL4OLIg/WJIGBI04Q9WIrnMQUA=";
+  };
+  meta-asteroid-src = metaAsteroidSrc;
+
+  # Device features shipped by upstream meta-hoki (IMAGE_INSTALL) and asteroid-image.
+}
diff --git a/overlay/asteroidos/lib/mk-asteroid-app.nix b/overlay/asteroidos/lib/mk-asteroid-app.nix
new file mode 100644
index 0000000000000000000000000000000000000000..d479c8b09044393b309ec91c9e3056da06184973
--- /dev/null
+++ b/overlay/asteroidos/lib/mk-asteroid-app.nix
@@ -0,0 +1,121 @@
+# Unified builder for AsteroidOS smartwatch applications
+# Inspired by Nixpkgs mkKdeDerivation: https://github.com/NixOS/nixpkgs/blob/master/pkgs/kde/lib/mk-kde-derivation.nix
+{
+  lib,
+  stdenv,
+  cmake,
+  pkg-config,
+  qt6,
+  qml-asteroid,
+  mapplauncherd,
+  noUsrShareHook,
+  kdePackages,
+  buildPackages,
+}:
+
+{
+  name,
+  pname ? "asteroid-${name}",
+  version ? "nightly",
+  owner ? "AsteroidOS",
+  repo ? pname,
+  src ? null,
+  rev ? null,
+  sha256 ? null,
+  hash ? null,
+  desc ? "Smartwatch application for AsteroidOS",
+  extraNativeBuildInputs ? [ ],
+  extraBuildInputs ? [ ],
+  patches ? [ ],
+  postPatch ? "",
+  postBuild ? "",
+  postInstall ? "",
+  postFixup ? "",
+  cmakeFlags ? [ ],
+  meta ? { },
+}:
+
+let
+  isCross = !stdenv.buildPlatform.canExecute stdenv.hostPlatform;
+  generateDesktop = buildPackages.callPackage ./generate-desktop.nix {
+    inherit (qml-asteroid) src;
+  };
+in
+stdenv.mkDerivation {
+  inherit pname version;
+
+  src =
+    if src != null then
+      src
+    else
+      (buildPackages.fetchFromGitHub {
+        inherit owner repo rev;
+        ${if hash != null then "hash" else "sha256"} = if hash != null then hash else sha256;
+      });
+
+  strictDeps = true;
+  inherit patches postBuild postInstall;
+
+  postPatch = ''
+    # CMake install destinations must stay relative to CMAKE_INSTALL_PREFIX.
+    find . -name CMakeLists.txt -exec sed -i 's|DESTINATION /usr/share|DESTINATION share|g' {} +
+    grep -IlRZ '/usr/share/asteroid-launcher' . > "$TMPDIR/asteroid-launcher-paths" || [ "$?" -eq 1 ]
+    while IFS= read -r -d "" file; do
+      sed -i 's|/usr/share/asteroid-launcher|/run/current-system/sw/share/asteroid-launcher|g' "$file"
+    done < "$TMPDIR/asteroid-launcher-paths"
+  ''
+  + postPatch;
+
+  nativeBuildInputs = [
+    cmake
+    kdePackages.extra-cmake-modules
+    pkg-config
+    qt6.wrapQtAppsHook
+    generateDesktop
+    noUsrShareHook
+  ]
+  ++ lib.optionals (!isCross) [
+    qt6.qtdeclarative
+    qt6.qttools
+  ]
+  ++ extraNativeBuildInputs;
+
+  cmakeFlags = [
+    "-DQT_MAJOR_VERSION=6"
+    "-DECM_DIR=${kdePackages.extra-cmake-modules}/share/ECM/cmake"
+  ]
+  ++ lib.optionals isCross [
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+    "-DQt6LinguistTools_DIR=${buildPackages.qt6.qttools}/lib/cmake/Qt6LinguistTools"
+  ]
+  ++ cmakeFlags;
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    qt6.qtsvg
+    qml-asteroid
+  ]
+  ++ extraBuildInputs;
+
+  # Self-contained app launcher scripts: ensure invoker is resolved to its absolute Nix store path
+  postFixup = ''
+    if [ -d "$out/bin" ]; then
+      find "$out/bin" -type f -exec sed -i "s|\\bexec invoker\\b|exec ${mapplauncherd}/bin/invoker|g" {} +
+    fi
+  ''
+  + postFixup;
+
+  meta =
+    with lib;
+    {
+      description = desc;
+      homepage = "https://asteroidos.org/";
+      license = licenses.gpl3Plus;
+      mainProgram = pname;
+      platforms = platforms.linux;
+    }
+    // meta;
+}
diff --git a/overlay/asteroidos/lib/no-usr-share-hook.nix b/overlay/asteroidos/lib/no-usr-share-hook.nix
new file mode 100644
index 00000000..8d7c7073
--- /dev/null
+++ b/overlay/asteroidos/lib/no-usr-share-hook.nix
@@ -0,0 +1,5 @@
+{ makeSetupHook }:
+
+makeSetupHook {
+  name = "no-usr-share-hook";
+} ./no-usr-share-hook.sh
diff --git a/overlay/asteroidos/lib/no-usr-share-hook.sh b/overlay/asteroidos/lib/no-usr-share-hook.sh
new file mode 100644
index 00000000..afbe09c5
--- /dev/null
+++ b/overlay/asteroidos/lib/no-usr-share-hook.sh
@@ -0,0 +1,30 @@
+# Check installed runtime files after package-specific fixups and wrappers.
+auditNoUsrShare() {
+    local output dir file found=0
+    local -a files=()
+
+    for output in $outputs; do
+        for dir in ${usrShareAuditDirs:-bin lib libexec share}; do
+            if [ -d "${!output}/$dir" ]; then
+                mapfile -d '' files < <(
+                    find "${!output}/$dir" \( -type f -o -type l \) \
+                        ! -path '*/share/doc/*' \
+                        ! -path '*/docs/*' \
+                        ! -path '*/tests/*' \
+                        ! -name '*.md' \
+                        -print0
+                )
+                for file in "${files[@]}"; do
+                    if { [ -L "$file" ] && [[ $(readlink "$file") == *'/usr/share'* ]]; } || \
+                       { [ -f "$file" ] && LC_ALL=C grep -aFq '/usr/share' "$file"; }; then
+                        echo "Unpatched /usr/share reference: $file" >&2
+                        found=1
+                    fi
+                done
+            fi
+        done
+    done
+    return "$found"
+}
+
+postFixupHooks+=(auditNoUsrShare)
diff --git a/overlay/asteroidos/qml-asteroid/default.nix b/overlay/asteroidos/qml-asteroid/default.nix
new file mode 100644
index 00000000..db13a9a2
--- /dev/null
+++ b/overlay/asteroidos/qml-asteroid/default.nix
@@ -0,0 +1,124 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  kdePackages,
+  buildPackages,
+  noUsrShareHook,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "qml-asteroid";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "AsteroidOS";
+    repo = "qml-asteroid";
+    rev = "c1905485d4aa22f964273e93a62ef23c27a7754b";
+    sha256 = "14l43mnff8a7v1dw1d066i0nvswxmj1la3k6a0mxkyzxhykw68iq";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    kdePackages.extra-cmake-modules
+    pkg-config
+    qt6.wrapQtAppsHook
+    noUsrShareHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    qt6.qtsvg
+    qt6.qtshadertools
+    qt6.qtwayland
+  ];
+
+  postPatch = ''
+        substituteInPlace src/settings/src/languagemodel.cpp \
+          --replace-fail '"/usr/share/supported-languages"' '"/run/current-system/sw/share/supported-languages"'
+
+        substituteInPlace src/app/asteroidapp.cpp \
+          --replace-fail '"/usr/share/translations"' '"/run/current-system/sw/share/translations"' \
+          --replace-fail '"/usr/share/applications/"' '"/run/current-system/sw/share/applications/"' \
+          --replace-fail 'if (!translator->load(QLocale(), appName(), ".", "/run/current-system/sw/share/translations", ".qm")) {' \
+                         'if (!translator->load(QLocale(), appName(), ".", "/run/current-system/sw/share/translations", ".qm") && !translator->load(QLocale("en_GB"), appName(), ".", "/run/current-system/sw/share/translations", ".qm")) {'
+
+        substituteInPlace src/controls/src/icon.cpp \
+          --replace-fail '"/usr/share/icons/asteroid/"' '"/run/current-system/sw/share/icons/asteroid/"'
+
+        substituteInPlace src/controls/CMakeLists.txt \
+          --replace-fail '"-indexdir" "/usr/share/doc/qt5" ' ""
+
+        substituteInPlace CMakeLists.txt \
+          --replace-fail 'find_package(Mapplauncherd_qt6 MODULE REQUIRED)' ""
+        substituteInPlace src/app/CMakeLists.txt \
+          --replace-fail 'Mapplauncherd_qt6::Mapplauncherd_qt6' ""
+        substituteInPlace src/app/asteroidapp.cpp \
+          --replace-fail '#include <MDeclarativeCache>' '#include <QGuiApplication>
+    #include <QQuickView>
+    namespace MDeclarativeCache { inline QGuiApplication *qApplication(int &argc, char **argv) { return new QGuiApplication(argc, argv); } inline QQuickView *qQuickView() { return new QQuickView(); } }'
+
+        cat <<'EOF' > cmake/FindMapplauncherd_qt6.cmake
+    set(Mapplauncherd_qt6_FOUND TRUE)
+    if(NOT TARGET Mapplauncherd_qt6::Mapplauncherd_qt6)
+        add_library(Mapplauncherd_qt6::Mapplauncherd_qt6 INTERFACE IMPORTED)
+    endif()
+    EOF
+
+        cat <<'EOF' > cmake/FindTimed.cmake
+    set(Timed_FOUND TRUE)
+    set(Timed_LIBRARIES "timed-qt6")
+    if(NOT TARGET Timed::Timed)
+        add_library(Timed::Timed INTERFACE IMPORTED)
+        set_target_properties(Timed::Timed PROPERTIES
+            INTERFACE_LINK_LIBRARIES "timed-qt6"
+        )
+    endif()
+    EOF
+  '';
+
+  cmakeFlags = [
+    "-DWITH_ASTEROIDAPP=ON"
+    "-DWITH_CMAKE_MODULES=ON"
+    "-DECM_DIR=${kdePackages.extra-cmake-modules}/share/ECM/cmake"
+    "-DCMAKE_PREFIX_PATH=${qt6.qtdeclarative};${qt6.qtbase};${qt6.qtsvg};${qt6.qtwayland};${qt6.qtshadertools}"
+    "-DQt6Quick_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Quick"
+    "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+  ];
+
+  dontWrapQtApps = true;
+
+  postInstall = ''
+        mkdir -p $out/lib/cmake/AsteroidApp6
+        cp -r $out/lib/cmake/asteroidapp6/* $out/lib/cmake/AsteroidApp6/ || true
+
+        mkdir -p $out/include
+        cat <<'EOF' > $out/include/MDeclarativeCache
+    #pragma once
+    #include <QGuiApplication>
+    #include <QQuickView>
+
+    namespace MDeclarativeCache {
+    inline QGuiApplication *qApplication(int &argc, char **argv) { return new QGuiApplication(argc, argv); }
+    inline QQuickView *qQuickView() { return new QQuickView(); }
+    }
+    EOF
+        cp $out/include/MDeclarativeCache $out/include/mdeclarativecache.h
+  '';
+
+  meta = with lib; {
+    description = "QML components, styles, and controls for AsteroidOS";
+    homepage = "https://asteroidos.org/";
+    license = licenses.lgpl3Plus;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/lib/generate-desktop.nix b/overlay/asteroidos/lib/generate-desktop.nix
new file mode 100644
index 0000000000000000000000000000000000000000..a89bc6a2445c3fb41105c8dbc7c294d087b0fc0c
--- /dev/null
+++ b/overlay/asteroidos/lib/generate-desktop.nix
@@ -0,0 +1,41 @@
+# The upstream generator is a shell tool; building all of qml-asteroid for the
+# build machine is unnecessary when cross-compiling applications.
+{
+  lib,
+  stdenvNoCC,
+  makeWrapper,
+  coreutils,
+  gnugrep,
+  src,
+}:
+
+stdenvNoCC.mkDerivation {
+  pname = "asteroid-generate-desktop";
+  version = "2.1.0";
+  inherit src;
+
+  nativeBuildInputs = [ makeWrapper ];
+  dontConfigure = true;
+  dontBuild = true;
+
+  installPhase = ''
+    runHook preInstall
+    install -Dm755 generate-desktop.sh "$out/bin/asteroid-generate-desktop"
+    wrapProgram "$out/bin/asteroid-generate-desktop" \
+      --prefix PATH : ${
+        lib.makeBinPath [
+          coreutils
+          gnugrep
+        ]
+      }
+    runHook postInstall
+  '';
+
+  meta = {
+    description = "Generate translated AsteroidOS desktop entries";
+    homepage = "https://github.com/AsteroidOS/qml-asteroid";
+    license = lib.licenses.bsd3;
+    mainProgram = "asteroid-generate-desktop";
+    platforms = lib.platforms.unix;
+  };
+}
