diff --git a/overlay/asteroidos/egl-probe/default.nix b/overlay/asteroidos/egl-probe/default.nix
new file mode 100644
index 00000000..81ca384f
--- /dev/null
+++ b/overlay/asteroidos/egl-probe/default.nix
@@ -0,0 +1,35 @@
+# Diagnostic binary used by the debug launcher service to report the EGL
+# config inventory of libhybris' hwcomposer platform.
+{
+  lib,
+  stdenv,
+  libhybris,
+}:
+
+stdenv.mkDerivation {
+  pname = "egl-probe";
+  version = "0";
+
+  src = ./.;
+
+  buildPhase = ''
+    runHook preBuild
+    $CC -O2 -Wall -o egl-probe egl-probe.c \
+      -I${libhybris}/include \
+      -L${libhybris}/lib \
+      -Wl,-rpath,${libhybris}/lib \
+      -lEGL
+    runHook postBuild
+  '';
+
+  installPhase = ''
+    runHook preInstall
+    install -Dm755 egl-probe $out/bin/egl-probe
+    runHook postInstall
+  '';
+
+  meta = with lib; {
+    description = "EGL config inventory probe for libhybris hwcomposer";
+    platforms = platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/egl-probe/egl-probe.c b/overlay/asteroidos/egl-probe/egl-probe.c
new file mode 100644
index 00000000..c8c7f189
--- /dev/null
+++ b/overlay/asteroidos/egl-probe/egl-probe.c
@@ -0,0 +1,123 @@
+/* Diagnostic: dump the EGL display/config inventory from the launcher's
+ * environment (libhybris EGL, EGL_PLATFORM=hwcomposer). Run as an
+ * ExecStartPre of asteroid-launcher so the output lands in launcher.log. */
+#include <EGL/egl.h>
+#include <stdio.h>
+#include <unistd.h>
+
+static const char *errname(EGLint e)
+{
+    switch (e) {
+    case EGL_SUCCESS: return "SUCCESS";
+    case EGL_NOT_INITIALIZED: return "NOT_INITIALIZED";
+    case EGL_BAD_ACCESS: return "BAD_ACCESS";
+    case EGL_BAD_ALLOC: return "BAD_ALLOC";
+    case EGL_BAD_ATTRIBUTE: return "BAD_ATTRIBUTE";
+    case EGL_BAD_CONFIG: return "BAD_CONFIG";
+    case EGL_BAD_CONTEXT: return "BAD_CONTEXT";
+    case EGL_BAD_CURRENT_SURFACE: return "BAD_CURRENT_SURFACE";
+    case EGL_BAD_DISPLAY: return "BAD_DISPLAY";
+    case EGL_BAD_MATCH: return "BAD_MATCH";
+    case EGL_BAD_NATIVE_PIXMAP: return "BAD_NATIVE_PIXMAP";
+    case EGL_BAD_NATIVE_WINDOW: return "BAD_NATIVE_WINDOW";
+    case EGL_BAD_PARAMETER: return "BAD_PARAMETER";
+    case EGL_BAD_SURFACE: return "BAD_SURFACE";
+    case EGL_CONTEXT_LOST: return "CONTEXT_LOST";
+    default: return "?";
+    }
+}
+
+static int get(EGLDisplay d, EGLConfig c, EGLint attr)
+{
+    EGLint v = -1;
+    eglGetConfigAttrib(d, c, attr, &v);
+    return v;
+}
+
+int main(void)
+{
+    EGLDisplay d = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    printf("egl-probe: display=%p\n", (void *)d);
+    if (d == EGL_NO_DISPLAY) {
+        EGLint e = eglGetError();
+        printf("egl-probe: eglGetDisplay failed 0x%x (%s)\n", e, errname(e));
+        return 1;
+    }
+
+    EGLint maj = 0, min = 0;
+    if (!eglInitialize(d, &maj, &min)) {
+        EGLint e = eglGetError();
+        printf("egl-probe: eglInitialize failed 0x%x (%s)\n", e, errname(e));
+        return 1;
+    }
+    printf("egl-probe: EGL %d.%d vendor=%s version=%s apis=%s\n",
+           maj, min,
+           eglQueryString(d, EGL_VENDOR),
+           eglQueryString(d, EGL_VERSION),
+           eglQueryString(d, EGL_CLIENT_APIS));
+
+    EGLint n = 0;
+    eglGetConfigs(d, NULL, 0, &n);
+    printf("egl-probe: configs=%d\n", n);
+    if (n > 0 && n <= 4096) {
+        static EGLConfig cfgs[4096];
+        eglGetConfigs(d, cfgs, n, &n);
+        for (EGLint i = 0; i < n; i++) {
+            printf("egl-probe: cfg id=%d rgba=%d/%d/%d/%d depth=%d stencil=%d samples=%d surface=0x%x renderable=0x%x caveat=0x%x\n",
+                   get(d, cfgs[i], EGL_CONFIG_ID),
+                   get(d, cfgs[i], EGL_RED_SIZE),
+                   get(d, cfgs[i], EGL_GREEN_SIZE),
+                   get(d, cfgs[i], EGL_BLUE_SIZE),
+                   get(d, cfgs[i], EGL_ALPHA_SIZE),
+                   get(d, cfgs[i], EGL_DEPTH_SIZE),
+                   get(d, cfgs[i], EGL_STENCIL_SIZE),
+                   get(d, cfgs[i], EGL_SAMPLES),
+                   get(d, cfgs[i], EGL_SURFACE_TYPE),
+                   get(d, cfgs[i], EGL_RENDERABLE_TYPE),
+                   get(d, cfgs[i], EGL_CONFIG_CAVEAT));
+        }
+    }
+
+    /* Exactly what qt6-qpa-hwcomposer-plugin's HwComposerContext forces for a
+     * 32-bit screen: RGBA8888 + depth 24 + stencil 8, ES2, window surface. */
+    EGLint strict[] = {
+        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 8,
+        EGL_GREEN_SIZE, 8,
+        EGL_BLUE_SIZE, 8,
+        EGL_ALPHA_SIZE, 8,
+        EGL_DEPTH_SIZE, 24,
+        EGL_STENCIL_SIZE, 8,
+        EGL_SAMPLES, 0,
+        EGL_NONE
+    };
+    EGLConfig c = NULL;
+    EGLint m = 0;
+    EGLBoolean ok = eglChooseConfig(d, strict, &c, 1, &m);
+    {
+        EGLint e = eglGetError();
+        printf("egl-probe: chooseConfig(strict rgba8888/stencil8)=%d matched=%d err=0x%x (%s)\n",
+               ok, m, e, errname(e));
+    }
+
+    EGLint relaxed[] = {
+        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 8,
+        EGL_GREEN_SIZE, 8,
+        EGL_BLUE_SIZE, 8,
+        EGL_NONE
+    };
+    ok = eglChooseConfig(d, relaxed, &c, 1, &m);
+    {
+        EGLint e = eglGetError();
+        printf("egl-probe: chooseConfig(relaxed rgb888)=%d matched=%d err=0x%x (%s)\n",
+               ok, m, e, errname(e));
+    }
+
+    /* Note: Calling eglTerminate(d) under libhybris hwcomposer can hang or deadlock
+     * in the Android HWC teardown/vsync worker thread. Flush and exit immediately. */
+    fflush(stdout);
+    _exit(0);
+}
diff --git a/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
new file mode 100644
index 00000000..18a7b4a3
--- /dev/null
+++ b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/default.nix
@@ -0,0 +1,256 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  fetchurl,
+  runCommand,
+  cmake,
+  pkg-config,
+  qt6,
+  buildPackages,
+  libhybris,
+  libudev,
+  glib,
+  mtdev,
+  metaAsteroidSrc,
+}:
+
+let
+  # HWC2 was introduced after the Android 6 headers in android-headers 23.
+  # Supplement the device headers with HWC2 declarations. Native window and
+  # gralloc types must still come from the exact headers used by libhybris:
+  # mixing Android 6 and Pie changes the C++ buffer base offset on ARM.
+  hwc2Headers = runCommand "android-hwc2-headers" { } ''
+    mkdir -p $out/include/hardware
+    cp ${
+      fetchurl {
+        url = "https://raw.githubusercontent.com/aosp-mirror/platform_hardware_libhardware/android-10.0.0_r1/include/hardware/hardware.h";
+        sha256 = "1s5f4gxmqhd4xfddwaiw9q8csjnk8fcmb02370v7xj6n100jzk05";
+      }
+    } $out/include/hardware/hardware.h
+    cp ${
+      fetchurl {
+        url = "https://raw.githubusercontent.com/aosp-mirror/platform_hardware_libhardware/android-10.0.0_r1/include/hardware/hwcomposer_defs.h";
+        sha256 = "1far10f35b95apgqdasmpl7jgdqm51j5xjwzsgj3h59n5n1almhi";
+      }
+    } $out/include/hardware/hwcomposer_defs.h
+    cp ${
+      fetchurl {
+        url = "https://raw.githubusercontent.com/aosp-mirror/platform_hardware_libhardware/android-10.0.0_r1/include/hardware/hwcomposer.h";
+        sha256 = "12i9w601lnsli38wnwal81zzvfr4x6ynlxhm2crd1qwhw29jwqz7";
+      }
+    } $out/include/hardware/hwcomposer.h
+    cp ${
+      fetchurl {
+        url = "https://raw.githubusercontent.com/aosp-mirror/platform_hardware_libhardware/android-10.0.0_r1/include/hardware/hwcomposer2.h";
+        sha256 = "0f2vp1mqvn7psvx0xhdfspxjf07f4gr42wprkv1l8n5llfxqklgd";
+      }
+    } $out/include/hardware/hwcomposer2.h
+  '';
+in
+stdenv.mkDerivation (finalAttrs: {
+  pname = "qt6-qpa-hwcomposer-plugin";
+  version = "6.3.0+git";
+
+  src = fetchFromGitHub {
+    owner = "mer-hybris";
+    repo = "qt5-qpa-hwcomposer-plugin";
+    rev = "998956aebe21ac7ba6e7315d1c12e6e11c93d742";
+    hash = "sha256-AOannPAXLDEUedz6KFLvLZE92VbhgNG1vdxDRbJLhaw=";
+  };
+
+  sourceRoot = "source/hwcomposer";
+  patchFlags = [ "-p2" ];
+
+  patches = [
+    "${metaAsteroidSrc}/recipes-qt/qt6/qt6-qpa-hwcomposer-plugin/0001-Add-ambient-mode-display-support.patch"
+    "${metaAsteroidSrc}/recipes-qt/qt6/qt6-qpa-hwcomposer-plugin/0003-Support-Qt-6.10.patch"
+    "${metaAsteroidSrc}/recipes-qt/qt6/qt6-qpa-hwcomposer-plugin/0005-Explicitly-make-hwcomposer-a-shared-library.patch"
+    "${metaAsteroidSrc}/recipes-qt/qt6/qt6-qpa-hwcomposer-plugin/0006-v10-Fix-refresh-rate-fallback-unit.patch"
+    "${metaAsteroidSrc}/recipes-qt/qt6/qt6-qpa-hwcomposer-plugin/0007-v10-Make-updates-request-driven-and-vsync-paced.patch"
+    ./hwc-present-diagnostics.patch
+  ];
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    qt6.qtwayland
+    libhybris
+    libhybris.androidHeaders
+    hwc2Headers
+    libudev
+    glib
+    mtdev
+  ];
+
+  cmakeFlags = [
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+  ];
+
+  postPatch = ''
+        substituteInPlace main.cpp \
+          --replace-fail 'Q_PLUGIN_METADATA(IID QPlatformIntegrationFactoryInterface_iid FILE "hwcomposer.json")' \
+                         'Q_PLUGIN_METADATA(IID "org.qt-project.Qt.QPA.QPlatformIntegrationFactoryInterface.5.3" FILE "hwcomposer.json")'
+
+        substituteInPlace hwcomposer_backend.cpp \
+          --replace-fail 'pwr_module->init(pwr_module);' 'if (pwr_module->init) pwr_module->init(pwr_module);' \
+          --replace-fail 'pwr_module->powerHint(pwr_module, POWER_HINT_INTERACTION, NULL);' 'if (pwr_module->powerHint) pwr_module->powerHint(pwr_module, POWER_HINT_INTERACTION, NULL);'
+
+        substituteInPlace hwcomposer_backend_v20.cpp \
+          --replace-fail 'pwr_device->setInteractive(pwr_device, false);' 'if (pwr_device->setInteractive) pwr_device->setInteractive(pwr_device, false);' \
+          --replace-fail 'pwr_device->setInteractive(pwr_device, true);' 'if (pwr_device->setInteractive) pwr_device->setInteractive(pwr_device, true);'
+
+        # Embed precompiled Qt 6 GraphicalEffects shaders (.qsb) into the QPA plugin
+        # so they are registered in memory (qrc:/qt-project.org/imports/Qt5Compat/GraphicalEffects/shaders_ng/*)
+        # when asteroid-launcher loads the hwcomposer QPA platform plugin.
+        tar -xf ${qt6.qt5compat.src} --strip-components=4 "qt5compat-everywhere-src-${qt6.qt5compat.version}/src/imports/graphicaleffects5/shaders_ng"
+        cat > shaders.qrc << 'QRC'
+    <RCC>
+        <qresource prefix="/qt-project.org/imports/Qt5Compat/GraphicalEffects">
+            <file>shaders_ng/brightnesscontrast.frag.qsb</file>
+            <file>shaders_ng/colorize.frag.qsb</file>
+            <file>shaders_ng/coloroverlay.frag.qsb</file>
+            <file>shaders_ng/conicalgradient_mask.frag.qsb</file>
+            <file>shaders_ng/conicalgradient_nomask.frag.qsb</file>
+            <file>shaders_ng/desaturate.frag.qsb</file>
+            <file>shaders_ng/displace.frag.qsb</file>
+            <file>shaders_ng/fastblur.frag.qsb</file>
+            <file>shaders_ng/fastblur_internal.frag.qsb</file>
+            <file>shaders_ng/fastblur_internal.vert.qsb</file>
+            <file>shaders_ng/fastinnershadow.frag.qsb</file>
+            <file>shaders_ng/fastinnershadow_level0.frag.qsb</file>
+            <file>shaders_ng/fastglow.frag.qsb</file>
+            <file>shaders_ng/gammaadjust.frag.qsb</file>
+            <file>shaders_ng/gaussianinnershadow.frag.qsb</file>
+            <file>shaders_ng/gaussianinnershadow_shadow.frag.qsb</file>
+            <file>shaders_ng/huesaturation.frag.qsb</file>
+            <file>shaders_ng/leveladjust.frag.qsb</file>
+            <file>shaders_ng/lineargradient.vert.qsb</file>
+            <file>shaders_ng/lineargradient_mask.frag.qsb</file>
+            <file>shaders_ng/lineargradient_nomask.frag.qsb</file>
+            <file>shaders_ng/opacitymask.frag.qsb</file>
+            <file>shaders_ng/opacitymask_invert.frag.qsb</file>
+            <file>shaders_ng/radialgradient.vert.qsb</file>
+            <file>shaders_ng/radialgradient_mask.frag.qsb</file>
+            <file>shaders_ng/radialgradient_nomask.frag.qsb</file>
+            <file>shaders_ng/recursiveblur.vert.qsb</file>
+            <file>shaders_ng/recursiveblur.frag.qsb</file>
+            <file>shaders_ng/rectangularglow.frag.qsb</file>
+            <file>shaders_ng/thresholdmask.frag.qsb</file>
+        </qresource>
+    </RCC>
+    QRC
+        ${buildPackages.qt6.qtbase}/libexec/rcc shaders.qrc -o qrc_shaders.cpp
+
+        cat > CMakeLists.txt <<EOF
+        cmake_minimum_required(VERSION 3.16)
+        project(hwcomposer LANGUAGES CXX)
+        set(CMAKE_CXX_STANDARD 17)
+        set(CMAKE_AUTOMOC ON)
+
+        find_package(Qt6 REQUIRED COMPONENTS Core Gui DBus OpenGL WaylandCompositor)
+        find_package(PkgConfig REQUIRED)
+        pkg_check_modules(GLIB REQUIRED glib-2.0)
+        pkg_check_modules(LIBUDEV REQUIRED libudev)
+        pkg_check_modules(MTDEV REQUIRED mtdev)
+
+        add_library(hwcomposer MODULE
+          main.cpp
+          hwcomposer_context.cpp
+          hwcomposer_screeninfo.cpp
+          hwcomposer_backend.cpp
+          hwcomposer_backend_v0.cpp
+          hwcomposer_backend_v10.cpp
+          hwcomposer_backend_v11.cpp
+          hwcomposer_backend_v20.cpp
+          qeglfsbackingstore.cpp
+          qeglfscontext.cpp
+          qeglfsintegration.cpp
+          qeglfsscreen.cpp
+          qeglfswindow.cpp
+          qrc_shaders.cpp
+        )
+
+        target_include_directories(hwcomposer PRIVATE
+          .
+          ${hwc2Headers}/include
+          ${libhybris.androidHeadersInclude}
+          ${libhybris.androidHeadersInclude}/hardware
+          ${libhybris}/include
+          ${libhybris}/include/hybris/eglplatformcommon
+          ${libhybris}/include/hybris/platformcommon
+          ${libhybris}/include/hybris/hwcomposerwindow
+          ${qt6.qtbase}/include/QtCore/${qt6.qtbase.version}
+          ${qt6.qtbase}/include/QtCore/${qt6.qtbase.version}/QtCore
+          ${qt6.qtbase}/include/QtGui/${qt6.qtbase.version}
+          ${qt6.qtbase}/include/QtGui/${qt6.qtbase.version}/QtGui
+          ${qt6.qtbase}/include/QtGui/${qt6.qtbase.version}/QtGui/private
+          ${qt6.qtbase.dev}/include/QtCore/${qt6.qtbase.version}
+          ${qt6.qtbase.dev}/include/QtGui/${qt6.qtbase.version}
+          ${qt6.qtbase.dev}/include/QtGui/${qt6.qtbase.version}/QtGui
+          ${qt6.qtwayland.dev}/include/QtWaylandCompositor/${qt6.qtwayland.version}
+          ${qt6.qtwayland.dev}/include/QtWaylandCompositor/${qt6.qtwayland.version}/QtWaylandCompositor
+          ''${GLIB_INCLUDE_DIRS}
+          ''${LIBUDEV_INCLUDE_DIRS}
+          ''${MTDEV_INCLUDE_DIRS}
+        )
+        target_compile_definitions(hwcomposer PRIVATE
+          QCOM_BSP
+          QEGL_EXTRA_DEBUG
+          MESA_EGL_NO_X11_HEADERS
+          QT_OPENGL_ES_2
+          GL_GLEXT_PROTOTYPES
+          HWC_PLUGIN_HAVE_HWCOMPOSER1_API
+          HWC_PLUGIN_HAVE_HWCOMPOSER2_API
+        )
+        target_compile_options(hwcomposer PRIVATE
+          "SHELL:-include stddef.h"
+          "SHELL:-include ${hwc2Headers}/include/hardware/hardware.h"
+          "SHELL:-include ${hwc2Headers}/include/hardware/hwcomposer_defs.h"
+          "SHELL:-include ${hwc2Headers}/include/hardware/hwcomposer.h"
+        )
+        target_link_libraries(hwcomposer PRIVATE
+          Qt6::Core
+          Qt6::Gui
+          Qt6::DBus
+          Qt6::OpenGL
+          Qt6::WaylandCompositor
+          ''${GLIB_LIBRARIES}
+          ''${LIBUDEV_LIBRARIES}
+          ''${MTDEV_LIBRARIES}
+          ${libhybris}/lib/libEGL.so.1
+          ${libhybris}/lib/libGLESv2.so.2
+          ${libhybris}/lib/libhybris-common.so.1
+          ${libhybris}/lib/libsync.so.2
+          ${libhybris}/lib/libhardware.so.2.0.0
+          ${libhybris}/lib/libhwc2.so.1.0.0
+          ${libhybris}/lib/libhybris-eglplatformcommon.so.1.0.0
+          ${libhybris}/lib/libhybris-hwcomposerwindow.so.1.0.0
+        )
+
+        install(TARGETS hwcomposer LIBRARY DESTINATION lib/qt-6/plugins/platforms)
+    EOF
+  '';
+
+  postFixup = ''
+    ${buildPackages.patchelf}/bin/patchelf \
+      --set-rpath "${libhybris}/lib:$(${buildPackages.patchelf}/bin/patchelf --print-rpath $out/lib/qt-6/plugins/platforms/libhwcomposer.so)" \
+      $out/lib/qt-6/plugins/platforms/libhwcomposer.so
+  '';
+
+  meta = with lib; {
+    description = "Qt6 QPA plugin for libhybris hwcomposer";
+    homepage = "https://github.com/mer-hybris/qt5-qpa-hwcomposer-plugin";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/hwc-present-diagnostics.patch b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/hwc-present-diagnostics.patch
new file mode 100644
index 00000000..fb5f9bd6
--- /dev/null
+++ b/overlay/asteroidos/qt6-qpa-hwcomposer-plugin/hwc-present-diagnostics.patch
@@ -0,0 +1,204 @@
+--- a/hwcomposer/hwcomposer_backend.cpp
++++ b/hwcomposer/hwcomposer_backend.cpp
+@@ -109,6 +109,7 @@
+         // Create hwcomposer backend directly without opening hardware module
+         // because on some devices loading hwc2 module twice breaks graphics
+         // (The first load is in the composer android service.)
++        fprintf(stderr, "== hwcomposer: using HWC2 backend ==\n");
+         return new HwComposerBackend_v20(NULL, pwr_module, libminisf);
+     }
+ #endif
+@@ -196,7 +197,8 @@
+ #endif /* HWC_PLUGIN_HAVE_HWCOMPOSER1_API */
+ #ifdef HWC_PLUGIN_HAVE_HWCOMPOSER2_API
+             case HWC_DEVICE_API_VERSION_2_0:
