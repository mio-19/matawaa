+
+  autoPatchelfFlags = [ "--keep-libc" ];
+
+  buildInputs = [
+    libxcrypt
+    libcap
+    libuuid
+    linuxHeaders
+    bashInteractive # for patch shebangs
+  ]
+
+  ++ lib.optionals withGcrypt [
+    libgcrypt
+    libgpg-error
