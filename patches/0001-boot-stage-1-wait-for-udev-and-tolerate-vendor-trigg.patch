From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:26:28 +1100
Subject: [PATCH] boot/stage-1: wait for udev and tolerate vendor trigger
 failures

Improve stage-1 udev bring-up on older vendor kernels:

- Wait for the /run/udev/control socket before issuing udevadm commands.
- Restrict the initial trigger to the subsystems needed during boot.
- Treat trigger and settle failures as warnings instead of aborting boot.
- Use a shorter settle timeout once NIXOS_SYSTEM is already present.

Signed-off-by: Mio <mio@mio19.uk>
---
 boot/init/tasks/udev.rb | 27 +++++++++++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/boot/init/tasks/udev.rb b/boot/init/tasks/udev.rb
index ff0f068a..3d9d98c0 100644
--- a/boot/init/tasks/udev.rb
+++ b/boot/init/tasks/udev.rb
@@ -22,14 +22,35 @@ class Tasks::UDev < SingletonTask
 
   def run()
     udevd
-    udevadm("trigger", "--action=add")
-    udevadm("settle")
+
+    begin
+      udevadm("trigger", "--action=add", "--subsystem-match=platform", "--subsystem-match=mmc", "--subsystem-match=block", "--subsystem-match=input", "--subsystem-match=graphics")
+    rescue System::CommandError => e
+      $logger.warn("udevadm trigger non-fatal warning (proceeding): #{e.message}")
+    end
+
+    if File.exist?("/dev/disk/by-label/NIXOS_SYSTEM")
+      begin
+        udevadm("settle", "--timeout=1")
+      rescue System::CommandError
+      end
+    else
+      begin
+        udevadm("settle", "--timeout=5")
+      rescue System::CommandError => e
+        $logger.warn("udevadm settle non-fatal timeout (proceeding): #{e.message}")
+      end
+    end
   end
 
   def udevd()
     *args = []
     args << "--debug" if debug?
     System.run("systemd-udevd", "--daemon", *args)
+    20.times do
+      break if File.exist?("/run/udev/control")
+      sleep(0.1)
+    end
   end
 
   # TODO: Allow configuring its debug state
@@ -39,5 +60,7 @@ class Tasks::UDev < SingletonTask
 
   def teardown()
     udevadm("control", "--exit")
+  rescue System::CommandError => e
+    $logger.warn("udevadm control --exit failed; udevd may already be stopped: #{e.message}")
   end
 end
