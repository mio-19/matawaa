From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 20:17:24 +1100
Subject: [PATCH] overlay/cross-compile: fix native libcanberra relink

Newer binutils fail while libtool relinks the libcanberra-multi plugin:
make install has not yet created the libcanberra.so symlink, so the
linker cannot resolve -lcanberra.

Pre-create the symlink from the build tree during preInstall. This fixes
the native libcanberra build pulled in by the updated nixpkgs pin during
cross-compilation.

Signed-off-by: Mio <mio@mio19.uk>
---
 overlay/cross-compile.nix | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/overlay/cross-compile.nix b/overlay/cross-compile.nix
index bd95fdc6..c111af81 100644
--- a/overlay/cross-compile.nix
+++ b/overlay/cross-compile.nix
@@ -51,6 +51,16 @@ else
       enableParallelBuilding = false;
     });
 
+    # libtool relinks the libcanberra-multi plugin before make install creates
+    # the libcanberra.so symlink, so the linker cannot resolve -lcanberra with
+    # current binutils. Pre-create the symlink from the build tree.
+    libcanberra = super.libcanberra.overrideAttrs (old: {
+      preInstall = (old.preInstall or "") + ''
+        mkdir -p $out/lib
+        ln -sf "$PWD/src/.libs/libcanberra.so.0.2.5" "$out/lib/libcanberra.so"
+      '';
+    });
+
     # Upstream nixpkgs Qt6 modules skip QtQuick integration during cross-compilation
     # because cross Qt6QuickTools, Qt6QmlTools, and Qt6ShaderToolsTools cmake flags are missing.
     qt6 = super.qt6.overrideScope (
