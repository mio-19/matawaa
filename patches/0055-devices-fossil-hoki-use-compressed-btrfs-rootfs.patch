From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 10:18:17 +1100
Subject: [PATCH] devices/fossil-hoki: use compressed btrfs rootfs

Switch the hoki rootfs to btrfs with zstd:3 compression and keep btrfs-progs in both the stage-1 extraUtils and stage-2 system packages. btrfs-progs provides btrfs filesystem resize for growing the rootfs after flashing.
---
 devices/fossil-hoki/default.nix | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/devices/fossil-hoki/default.nix b/devices/fossil-hoki/default.nix
index e2e47366..d3663d8c 100644
--- a/devices/fossil-hoki/default.nix
+++ b/devices/fossil-hoki/default.nix
@@ -18,6 +18,14 @@
 
   mobile.device.supportLevel = "supported";
 
+  mobile.generatedFilesystems.rootfs = {
+    filesystem = lib.mkForce "btrfs";
+    btrfs.compression = "zstd:3";
+  };
+
+  # btrfs-progs provides `btrfs filesystem resize` for rootfs growth and
+  # maintenance; stage-1 already gets it from modules/rootfs.nix.
+
   mobile.hardware = {
     # Qualcomm Snapdragon Wear 4100+ (SDA429W / SDM429W), Cortex-A53.
     # The Android system image is the 32-bit armv7l ABI.
@@ -88,6 +96,7 @@
 
   environment.systemPackages = [
     pkgs.alsa-utils
+    pkgs.btrfs-progs
   ];
 
   # Hardware audio mixer DAI link routing for NXP TFA98xx speaker amplifier & digital mic
