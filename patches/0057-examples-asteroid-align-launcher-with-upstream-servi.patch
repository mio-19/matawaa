From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 10:04:34 +1100
Subject: [PATCH] examples/asteroid: align launcher with upstream service

Match the upstream launcher unit contract with Type=notify, Requires=dbus.socket, ConditionUser=!root, WorkingDirectory=/, the compositor EnvironmentFile, the coldboot precondition and TimeoutStopSec. Install the hoki 20-device.conf under /var/lib/environment/compositor instead of exporting the compositor variables globally, and add the Android binder/ashmem udev permissions.
---
 devices/fossil-hoki/default.nix        | 20 ++++++++++++--------
 examples/asteroid/asteroid-desktop.nix | 14 ++++++++++++++
 2 files changed, 26 insertions(+), 8 deletions(-)

diff --git a/devices/fossil-hoki/default.nix b/devices/fossil-hoki/default.nix
index ba0c97e4..3ebe0d83 100644
--- a/devices/fossil-hoki/default.nix
+++ b/devices/fossil-hoki/default.nix
@@ -134,18 +134,15 @@
     };
   };
 
-  # AsteroidOS Wayland compositor & libhybris hwcomposer environment options for hoki
-  # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-asteroid/asteroid-launcher/asteroid-launcher-configs/20-device.conf
-  environment.variables = {
-    QPA_HWC_FORCE_GLES = "1";
-    QPA_HWC2_FORCE_DOZE_UPDATE = "1";
-    QT_OPENGL_NO_BGRA = "1";
-    LIPSTICK_OPTIONS = "-plugin evdevkeyboard:/dev/input/event4 -plugin evdevkeyboard:/dev/input/event0 -plugin evdevmouse:/dev/input/event1";
-  };
+  # AsteroidOS Wayland compositor environment is installed as
+  # /var/lib/environment/compositor/20-device.conf below, matching the
+  # upstream EnvironmentFile contract.
 
   # Hardware node permissions and symlinks for Android HAL / libhybris
   # Upstream reference: https://github.com/AsteroidOS/meta-smartwatch/blob/master/meta-hoki/recipes-android/android-init/android-init/init.rc
   services.udev.extraRules = ''
+    KERNEL=="binder", MODE="0666"
+    KERNEL=="ashmem", MODE="0666"
     KERNEL=="hwbinder", MODE="0666"
     KERNEL=="vndbinder", MODE="0666"
     KERNEL=="mdss_rotator", MODE="0666"
@@ -187,6 +184,13 @@
   # Subsystem boots and firmware mount setup
   # GNSS vendor service symlink PR: https://github.com/AsteroidOS/meta-smartwatch/pull/342
   systemd.tmpfiles.rules = [
+    "d /var/lib/environment/compositor 0755 root root -"
+    "L+ /var/lib/environment/compositor/20-device.conf - - - - ${pkgs.writeText "20-device.conf" ''
+      LIPSTICK_OPTIONS="-plugin evdevkeyboard:/dev/input/event4 -plugin evdevkeyboard:/dev/input/event0 -plugin evdevmouse:/dev/input/event1"
+      QPA_HWC_FORCE_GLES=1
+      QPA_HWC2_FORCE_DOZE_UPDATE=1
+      QT_OPENGL_NO_BGRA=1
+    ''}"
     "L+ /system/lib/hw/gps.default.so - - - - /vendor/lib/hw/gps.default.so"
     "L+ /vendor/bin/hw/android.hardware.gnss@1.0-service - - - - /vendor/bin/hw/android.hardware.gnss@1.0-service-qti"
     "L+ /dev/graphics/fb0 - - - - /dev/fb0"
diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index 311502b1..8615cb64 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -155,6 +155,8 @@ in
     systemd.user.services.asteroid-launcher = {
       description = "AsteroidOS Wayland Compositor and Launcher";
       wantedBy = [ "default.target" ];
+      requires = [ "dbus.socket" ];
+      unitConfig.ConditionUser = "!root";
       environment = {
         QT_IM_MODULE = "qtvirtualkeyboard";
         QT_VIRTUALKEYBOARD_STYLE = "watch";
@@ -165,7 +167,19 @@ in
       }
       // config.environment.variables;
       serviceConfig = {
+        Type = "notify";
+        WorkingDirectory = "/";
+        EnvironmentFile = "-/var/lib/environment/compositor/*.conf";
+        ExecStartPre = [
+          "${pkgs.writeShellScript "asteroid-launcher-precondition" ''
+            if [ -f /usr/lib/systemd/user/android-boot-completed.service ]; then
+              while [ ! -f /dev/.coldboot_done ]; do sleep 1; done
+            fi
+          ''}"
+          "-${pkgs.bash}/bin/bash -c 'echo QUIT > /run/psplash_fifo 2>/dev/null || true'"
+        ];
         ExecStart = "${config.security.wrapperDir}/asteroid-launcher $LIPSTICK_OPTIONS -plugin evdevtouch --systemd";
+        TimeoutStopSec = "3s";
         Restart = "always";
         RestartSec = "2s";
       };
