From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 22:06:35 +1100
Subject: [PATCH] watch: select legacy or modern kernel and systemd generation

Add mobile.hardware.watch.kernel with legacy/modern values. Legacy selects the vendor 4.14 kernel and systemd 257; modern selects the mainline kernel and the current systemd 262. Also patch GCC 16.2.0 libgomp and route makeBinaryWrapper through the patched stdenv so the legacy systemd 257 package can be attempted.
---
 devices/families/asteroidos.nix               |  7 ++++-
 devices/fossil-hoki-mainline/default.nix      |  2 ++
 modules/hardware-watch.nix                    | 27 +++++++++++++++++++
 overlay/cross-compile.nix                     | 19 +++++++++++--
 .../gcc-16.2.0-libgomp-uid-buffer.patch       | 13 +++++++++
 5 files changed, 65 insertions(+), 3 deletions(-)
 create mode 100644 overlay/patches/gcc-16.2.0-libgomp-uid-buffer.patch

diff --git a/devices/families/asteroidos.nix b/devices/families/asteroidos.nix
index 85c62efc..c4550492 100644
--- a/devices/families/asteroidos.nix
+++ b/devices/families/asteroidos.nix
@@ -12,7 +12,12 @@ let
     ;
 in
 {
-  systemd.package = lib.mkForce pkgs.systemd257;
+  systemd.package = lib.mkForce (
+    if config.mobile.hardware.watch.kernel == "legacy" then
+      pkgs.systemd257
+    else
+      pkgs.systemd
+  );
 
   mobile.system.type = mkDefault "android";
   mobile.system.system = mkDefault "armv7l-linux";
diff --git a/devices/fossil-hoki-mainline/default.nix b/devices/fossil-hoki-mainline/default.nix
index c5ca20c7..35ee3b43 100644
--- a/devices/fossil-hoki-mainline/default.nix
+++ b/devices/fossil-hoki-mainline/default.nix
@@ -19,6 +19,8 @@
 
   nixpkgs.hostPlatform = lib.mkForce "aarch64-linux";
 
+  mobile.hardware.watch.kernel = lib.mkForce "modern";
+
   mobile.device = {
     name = lib.mkForce "fossil-hoki-mainline";
     identity = {
diff --git a/modules/hardware-watch.nix b/modules/hardware-watch.nix
index 35ac4030..c43cedf0 100644
--- a/modules/hardware-watch.nix
+++ b/modules/hardware-watch.nix
@@ -117,6 +117,33 @@ in
       '';
     };
 
+    kernel = mkOption {
+      type = types.enum [ "legacy" "modern" ];
+      default = "legacy";
+      description = ''
+        Watch kernel generation. "legacy" uses the vendor 4.14 kernel and the
+        old systemd 257 package; "modern" uses the mainline kernel and the
+        current systemd package.
+      '';
+    };
+
+    stage1-pause-debug.enable = mkOption {
+      type = types.bool;
+      default = false;
+      description = "Enable development-only stage-1 console, SSH/telnet, and switch-root pause; enable explicitly in the debug device/example configuration.";
+    };
+
+    stage2-save-logs.enable = mkOption {
+      type = types.bool;
+      default = false;
+      description = "Persist the stage-2 systemd journal to /var/log/journal and coredumps to /var/lib/systemd/coredump for debugging; disabled for production watches.";
+    };
+
+    stage2-ssh.enable = mkOption {
+      type = types.bool;
+      default = false;
+      description = "Enable the stage-2 SSH server and USB networking without the stage-1 pause/console.";
+    };
   };
 
   config = mkIf (config.mobile.enable && watchCfg.enable) {
diff --git a/overlay/cross-compile.nix b/overlay/cross-compile.nix
index 8b2b29f3..53820322 100644
--- a/overlay/cross-compile.nix
+++ b/overlay/cross-compile.nix
@@ -59,11 +59,22 @@ else
           ];
         });
 
+    # The systemd 257 definition comes from Nixpkgs 25.05, but GCC 16.2.0's
+    # libgomp sizes the omp_get_uid_from_device buffer for 10 digits and
+    # misses the sign, so the target build fails under -Werror=format-truncation.
+    systemdStdenv = super.stdenv.override {
+      cc = super.stdenv.cc.override {
+        cc = super.stdenv.cc.cc.overrideAttrs (old: {
+          patches = (old.patches or []) ++ [ ./patches/gcc-16.2.0-libgomp-uid-buffer.patch ];
+        });
+      };
+    };
+
     systemd257 =
       (super.lib.callPackageWith
-        (builtins.intersectAttrs (super.lib.functionArgs (import ./systemd-257)) super)
+        (builtins.intersectAttrs (super.lib.functionArgs (import ./systemd-257)) final)
         ./systemd-257
-        { }
+        { stdenv = systemdStdenv; }
       ).override (
         super.lib.optionalAttrs (superStdenv.hostPlatform.isAarch32) {
           withLibBPF = false;
@@ -74,6 +85,10 @@ else
     inherit systemd257;
     systemd_latest-oldkernel = systemd262OldKernel;
 
+    makeBinaryWrapper = super.makeBinaryWrapper.override {
+      stdenv = systemdStdenv;
+    };
+
     # ModemManager's generated GDBus sources race with the static archive link
     # when building in parallel; serialize its build.
     modemmanager = super.modemmanager.overrideAttrs (old: {
diff --git a/overlay/patches/gcc-16.2.0-libgomp-uid-buffer.patch b/overlay/patches/gcc-16.2.0-libgomp-uid-buffer.patch
new file mode 100644
index 00000000..17006966
--- /dev/null
+++ b/overlay/patches/gcc-16.2.0-libgomp-uid-buffer.patch
@@ -0,0 +1,13 @@
+diff --git a/libgomp/target.c b/libgomp/target.c
+--- a/libgomp/target.c
++++ b/libgomp/target.c
+@@ -5950,7 +5950,7 @@
+   if (devicep->get_uid_func)
+     devicep->uid = devicep->get_uid_func (devicep->target_id);
+   if (!devicep->uid)
+     {
+-      size_t ln = strlen (STR_OMP_DEV_PREFIX) + 10 + 1;
++      size_t ln = strlen (STR_OMP_DEV_PREFIX) + 12 + 1;
+       char *uid;
+       uid = gomp_malloc (ln);
+       snprintf (uid, ln, "%s%d", STR_OMP_DEV_PREFIX, device_num);
