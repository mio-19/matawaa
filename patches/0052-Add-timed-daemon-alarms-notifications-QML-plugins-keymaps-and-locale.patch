diff --git a/overlay/asteroidos/nemo-qml-plugin-alarms/default.nix b/overlay/asteroidos/nemo-qml-plugin-alarms/default.nix
new file mode 100644
index 00000000..2d20303c
--- /dev/null
+++ b/overlay/asteroidos/nemo-qml-plugin-alarms/default.nix
@@ -0,0 +1,131 @@
+# Nemomobile alarms QML plugin (Nemo.Alarms)
+# Upstream repository: https://github.com/sailfishos/nemo-qml-plugin-alarms
+# Packaging reference in AsteroidOS: https://github.com/AsteroidOS/meta-asteroid/blob/master/recipes-nemomobile/nemo-qml-plugins/nemo-qml-plugin-alarms_git.bb
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  buildPackages,
+  timed-qt6,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "nemo-qml-plugin-alarms";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "nemo-qml-plugin-alarms";
+    rev = "4377d1e31a56c763ba3e2d61137f97529281c1bd";
+    sha256 = "07phqhlfkiq8fb10l7y1czfqnij2kda55jg5vx8ig92khzxj49gz";
+  };
+
+  strictDeps = true;
+  dontWrapQtApps = true;
+
+  nativeBuildInputs = [
+    cmake
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    timed-qt6
+  ];
+
+  # Upstream is a qmake project; mirror the src/src.pro target (Qt QML plugin
+  # using the timed-qt6 and timed-voland-qt6 client libraries).
+  postPatch = ''
+    # timed-qt6 intentionally does not install src/lib/hidden/exception (a
+    # file named "exception" in the public include dir shadows the C++
+    # standard header). alarms only includes it, never uses it.
+    substituteInPlace src/alarmobject.cpp \
+      --replace "#include <timed-qt6/exception>" "#include <timed-qt6/exception.h>"
+
+    cat > CMakeLists.txt << 'EOF'
+    cmake_minimum_required(VERSION 3.16)
+    project(nemoalarms LANGUAGES CXX)
+
+    set(CMAKE_CXX_STANDARD 17)
+    set(CMAKE_CXX_STANDARD_REQUIRED ON)
+    set(CMAKE_AUTOMOC ON)
+
+    find_package(Qt6 REQUIRED COMPONENTS Core Qml DBus)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(TIMED REQUIRED timed-qt6)
+    pkg_check_modules(TIMED_VOLAND REQUIRED timed-voland-qt6)
+
+    set(SRC_DIR "''${CMAKE_CURRENT_SOURCE_DIR}/src")
+
+    add_library(nemoalarms MODULE
+      ''${SRC_DIR}/plugin.cpp
+      ''${SRC_DIR}/alarmsbackendmodel.cpp
+      ''${SRC_DIR}/alarmsbackendmodel_p.cpp
+      ''${SRC_DIR}/enabledalarmsproxymodel.cpp
+      ''${SRC_DIR}/alarmobject.cpp
+      ''${SRC_DIR}/alarmhandlerinterface.cpp
+      ''${SRC_DIR}/alarmdialogobject.cpp
+      ''${SRC_DIR}/alarmsettings.cpp
+      ''${SRC_DIR}/interface.cpp
+      ''${SRC_DIR}/alarmsbackendmodel.h
+      ''${SRC_DIR}/alarmsbackendmodel_p.h
+      ''${SRC_DIR}/enabledalarmsproxymodel.h
+      ''${SRC_DIR}/alarmobject.h
+      ''${SRC_DIR}/alarmhandlerinterface.h
+      ''${SRC_DIR}/alarmdialogobject.h
+      ''${SRC_DIR}/alarmsettings.h
+      ''${SRC_DIR}/interface.h
+      ''${SRC_DIR}/time_interface.cpp
+    )
+
+    target_include_directories(nemoalarms PRIVATE
+      ''${SRC_DIR}
+      ''${CMAKE_CURRENT_BINARY_DIR}
+      ''${TIMED_INCLUDE_DIRS}
+      ''${TIMED_VOLAND_INCLUDE_DIRS}
+    )
+
+    target_link_libraries(nemoalarms PRIVATE
+      Qt6::Core
+      Qt6::Qml
+      Qt6::DBus
+      ''${TIMED_LIBRARIES}
+      ''${TIMED_VOLAND_LIBRARIES}
+    )
+
+    set_target_properties(nemoalarms PROPERTIES
+      PREFIX ""
+      OUTPUT_NAME nemoalarms
+      LIBRARY_OUTPUT_DIRECTORY "''${CMAKE_CURRENT_BINARY_DIR}"
+    )
+
+    install(TARGETS nemoalarms DESTINATION lib/qt-6/qml/Nemo/Alarms)
+    install(FILES ''${SRC_DIR}/qmldir ''${SRC_DIR}/plugins.qmltypes
+      DESTINATION lib/qt-6/qml/Nemo/Alarms)
+    EOF
+  '';
+
+  cmakeFlags = [
+    "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+  ];
+
+  preConfigure = ''
+    # qmake's DBUS_INTERFACES generates time_interface.h/.cpp from the
+    # introspection XML (header_flags/source_flags: -N -c TimeDaemon).
+    (cd src && ${buildPackages.qt6.qtbase}/bin/qdbusxml2cpp \
+      -p time_interface -N -c TimeDaemon com.nokia.time.xml)
+  '';
+
+  meta = with lib; {
+    description = "Nemomobile alarms QML plugin for AsteroidOS";
+    homepage = "https://github.com/sailfishos/nemo-qml-plugin-alarms";
+    license = licenses.bsd3;
+    platforms = platforms.linux;
+  };
+})
