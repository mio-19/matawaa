+
+  supported-languages = stdenv.mkDerivation {
+    pname = "supported-languages";
+    version = "2.1";
+
+    src = fetchFromGitHub {
+      owner = "AsteroidOS";
+      repo = "supported-languages";
+      rev = "182c3e31a93b157eea3d51f2152d712d16c71f1a";
+      sha256 = "17kv5jfd8l0hk0x838m983kjpqv3pp52snnzqb8vmihc1968lgaw";
+    };
+
+    installPhase = ''
+      runHook preInstall
+      mkdir -p $out/share/supported-languages
+      cp *.conf $out/share/supported-languages/
+      runHook postInstall
+    '';
+
+    meta = with lib; {
+      description = "Supported locale configuration files for AsteroidOS";
+      homepage = "https://asteroidos.org/";
+      license = licenses.gpl3Plus;
+      platforms = platforms.all;
+    };
+  };
+
+  keymaps =
+    let
+      qtbase = buildPackages.qt6.qtbase;
+      kmap2qmap = buildPackages.stdenv.mkDerivation {
+        pname = "kmap2qmap";
+        inherit (buildPackages.qt6.qttools) version src;
+        patches = [
+          "${metaAsteroidSrc}/recipes-qt/qt6/qttools/0001-kmap2qmap-Map-MenuKB-key.patch"
+          "${metaAsteroidSrc}/recipes-qt/qt6/qttools/0002-kmap2qmap-Map-Sleep-key.patch"
+        ];
+        buildPhase = ''
+          runHook preBuild
+          $CXX -std=c++17 -fPIC -O2 \
+            src/kmap2qmap/main.cpp \
+            -I${qtbase}/include \
+            -I${qtbase}/include/QtCore \
+            -I${qtbase}/include/QtCore/${qtbase.version} \
+            -I${qtbase}/include/QtCore/${qtbase.version}/QtCore \
+            -I${qtbase}/include/QtGui \
+            -I${qtbase}/include/QtGui/${qtbase.version} \
+            -I${qtbase}/include/QtGui/${qtbase.version}/QtGui \
+            -I${qtbase}/include/QtInputSupport \
+            -I${qtbase}/include/QtInputSupport/${qtbase.version} \
+            -I${qtbase}/include/QtInputSupport/${qtbase.version}/QtInputSupport \
+            -L${qtbase}/lib \
+            -Wl,-rpath,${qtbase}/lib \
+            -lQt6InputSupport -lQt6Gui -lQt6Core \
+            -o kmap2qmap
+          runHook postBuild
+        '';
+        installPhase = ''
+          runHook preInstall
+          install -Dm755 kmap2qmap $out/bin/kmap2qmap
+          runHook postInstall
+        '';
+      };
+    in
+    stdenv.mkDerivation {
+      pname = "asteroid-keymaps";
+      version = "2.1";
+      dontUnpack = true;
+      nativeBuildInputs = [ kmap2qmap ];
+      installPhase = ''
+        runHook preInstall
+        mkdir -p $out/share/qt6/keymaps
+        kmap2qmap ${metaAsteroidSrc}/recipes-asteroid/asteroid-launcher/asteroid-launcher-configs/keys.kmap $out/share/qt6/keymaps/keys.qmap
+        runHook postInstall
+      '';
+      meta = with lib; {
+        description = "Hardware button keymap for AsteroidOS smartwatches";
+        homepage = "https://asteroidos.org/";
+        license = licenses.gpl3Plus;
+        platforms = platforms.all;
+      };
+    };
 }
