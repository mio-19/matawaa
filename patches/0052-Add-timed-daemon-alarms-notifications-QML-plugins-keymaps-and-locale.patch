 examples/asteroid/asteroid-desktop.nix        |  77 ++++++++-
 overlay/asteroidos/apps/default.nix           |   4 +-
 overlay/asteroidos/assets/default.nix         |  84 +++++++++
 .../asteroidos/asteroid-launcher/default.nix  |   4 +-
 overlay/asteroidos/default.nix                |   8 +-
 overlay/asteroidos/libiodata/default.nix      |   7 +
