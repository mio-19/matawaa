From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sun, 1 Nov 2026 22:27:22 +1100
Subject: [PATCH] Accelerate smartwatch boot sequence and disable WebProcess
 sandbox on wearable kernels

---
 examples/asteroid/asteroid-desktop.nix | 10 +++++-----
 overlay/asteroidos/browser/src/main.c  |  4 ++++
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index b9b1960e..cc0a48d6 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -336,7 +336,7 @@ in
         ExecStartPre = [
           "${pkgs.writeShellScript "asteroid-wait-for-lipstick" ''
             i=0
-            while [ "$i" -lt 60 ]; do
+            while [ "$i" -lt 600 ]; do
               if ${pkgs.dbus}/bin/dbus-send --system --print-reply \
                    --dest=org.freedesktop.DBus /org/freedesktop/DBus \
                    org.freedesktop.DBus.NameHasOwner \
@@ -345,7 +345,7 @@ in
                 exit 0
               fi
               i=$((i + 1))
-              sleep 1
+              sleep 0.1
             done
             exit 0
           ''}"
@@ -700,8 +700,8 @@ in
             # android-init.service touches this marker once the property
             # service and the vendor HALs are up; wait for it with a bound.
             i=0
-            while [ ! -e /dev/.coldboot_done ] && [ "$i" -lt 30 ]; do
-              sleep 1
+            while [ ! -e /dev/.coldboot_done ] && [ "$i" -lt 300 ]; do
+              sleep 0.1
               i=$((i + 1))
             done
           ''}"
@@ -734,7 +734,7 @@ in
       unitConfig.ConditionUser = "!root";
       serviceConfig = {
         Type = "simple";
-        ExecStartPre = "-${pkgs.coreutils}/bin/sleep 10";
+        ExecStartPre = "-${pkgs.coreutils}/bin/sleep 1";
         ExecStart = "${pkgs.bash}/bin/bash -ec 'if [ \"$(/system/bin/getprop sys.boot_completed)\" != 1 ]; then /system/bin/setprop sys.boot_completed 1; fi'";
       };
     };
diff --git a/overlay/asteroidos/browser/src/main.c b/overlay/asteroidos/browser/src/main.c
index 785f614f..abd05227 100644
--- a/overlay/asteroidos/browser/src/main.c
+++ b/overlay/asteroidos/browser/src/main.c
@@ -365,6 +365,10 @@ static void activate(GtkApplication *app, gpointer user_data)
 
 int main(int argc, char *argv[])
 {
+    /* Smartwatch vendor kernels (3.18 - 4.14) do not support unprivileged user namespaces
+     * or mounting /proc inside bubblewrap; disable WebProcess sandbox on wearables */
+    g_setenv("WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS", "1", FALSE);
+
     memset(&g_app_data, 0, sizeof(WatchBrowserApp));
 
     if (argc > 1 && argv[1][0] != '-') {
