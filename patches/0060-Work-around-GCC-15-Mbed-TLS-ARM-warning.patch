From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sat, 31 Oct 2026 08:43:47 +1100
Subject: [PATCH] Work around GCC 15 Mbed TLS ARM warning

---
 overlay/cross-compile.nix | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/overlay/cross-compile.nix b/overlay/cross-compile.nix
index 6169ce18..60413860 100644
--- a/overlay/cross-compile.nix
+++ b/overlay/cross-compile.nix
@@ -96,9 +96,19 @@ else
             withLibBPF = false;
           }
         );
+
+    # Mbed TLS 3.6.6's ARM AES/GCM code triggers GCC 15's array-bounds
+    # diagnostic in its bytewise XOR helper. The package enables -Werror,
+    # so keep that compiler warning non-fatal for this cross-built package.
+    mbedtls = super.mbedtls.overrideAttrs (old: {
+      env = (old.env or { }) // {
+        NIX_CFLAGS_COMPILE = ((old.env or { }).NIX_CFLAGS_COMPILE or "") + " -Wno-error=array-bounds";
+      };
+    });
   in
   {
     inherit systemd257;
+    inherit mbedtls;
     # Keep the patched systemd 262 for old kernels available for debugging
     # or fallback even when the legacy profile selects systemd 257.
     systemd262oldkernel = systemd262OldKernel;
