From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 22:34:53 +1100
Subject: [PATCH] overlay/systemd-257: finish the legacy 257 build adaptation

Disable FIDO2, the documentation build, and the remaining postFixup-only dependencies, and silence GCC 16's duplicate-errno warning so the vendored 257 definition can build with the current package set.
---
 overlay/cross-compile.nix       | 1 +
 overlay/systemd-257/default.nix | 5 ++++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/overlay/cross-compile.nix b/overlay/cross-compile.nix
index b83b47f0..6c65efee 100644
--- a/overlay/cross-compile.nix
+++ b/overlay/cross-compile.nix
@@ -84,6 +84,7 @@ else
           withUkify = false;
           withHomed = false;
           withRepart = false;
+          withFido2 = false;
         }
         // super.lib.optionalAttrs (superStdenv.hostPlatform.isAarch32) {
           withLibBPF = false;
diff --git a/overlay/systemd-257/default.nix b/overlay/systemd-257/default.nix
index 03519861..fb59cf14 100644
--- a/overlay/systemd-257/default.nix
+++ b/overlay/systemd-257/default.nix
@@ -586,7 +586,7 @@ stdenv.mkDerivation (finalAttrs: {
     (lib.mesonEnable "xenctrl" false)
     (lib.mesonEnable "gnutls" false)
     (lib.mesonEnable "xkbcommon" false)
-    (lib.mesonEnable "man" true)
+    (lib.mesonEnable "man" false)
 
     (lib.mesonBool "analyze" withAnalyze)
     (lib.mesonBool "logind" withLogind)
@@ -798,6 +798,9 @@ stdenv.mkDerivation (finalAttrs: {
       "-USYSTEMD_BINARY_PATH"
       "-DSYSTEMD_BINARY_PATH=\"/run/current-system/systemd/lib/systemd/systemd\""
 
+      # GCC 16 warns about duplicate errno aliases in the generated
+      # errno-to-name.h; systemd's 257 build promotes it to an error.
+      "-Wno-error=override-init"
     ]
     ++ lib.optionals stdenv.hostPlatform.isMusl [
       "-D__UAPI_DEF_ETHHDR=0"
