+++ b/overlay/asteroidos/asteroid-launcher/default.nix
@@ -0,0 +1,108 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  qml-asteroid,
+  mlite,
