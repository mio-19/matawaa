 create mode 100644 overlay/asteroidos/asteroid-btsyncd/org.asteroidos.btsyncd.conf
 create mode 100644 overlay/asteroidos/asteroid-launcher/default.nix
 create mode 100644 overlay/asteroidos/nemo-qml-plugin-configuration/default.nix
