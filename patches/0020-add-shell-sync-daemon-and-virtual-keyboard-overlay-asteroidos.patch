+    <allow receive_sender="org.nemomobile.lipstick"/>
+    <allow receive_sender="org.nemomobile.compositor"/>
+  </policy>
+  <policy user="ceres">
+    <allow own="org.nemomobile.lipstick"/>
+    <allow own="org.nemomobile.compositor"/>
+    <allow send_destination="org.nemomobile.lipstick"/>
+    <allow send_destination="org.nemomobile.compositor"/>
+    <allow receive_sender="org.nemomobile.lipstick"/>
+    <allow receive_sender="org.nemomobile.compositor"/>
+  </policy>
+  <policy context="default">
+    <allow send_destination="org.nemomobile.lipstick"/>
+    <allow send_destination="org.nemomobile.compositor"/>
+    <allow receive_sender="org.nemomobile.lipstick"/>
+    <allow receive_sender="org.nemomobile.compositor"/>
