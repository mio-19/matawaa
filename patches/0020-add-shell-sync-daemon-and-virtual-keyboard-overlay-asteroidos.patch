 .../org.asteroidos.btsyncd.conf               |  13 ++
 .../asteroidos/asteroid-launcher/default.nix  |  82 ++++++++
 overlay/asteroidos/default.nix                |  32 +++
 .../nemo-qml-plugin-configuration/default.nix |  69 ++++++
 .../qt6-qpa-hwcomposer-plugin/default.nix     | 198 ++++++++++++++++++
 .../asteroidos/virtualkeyboard/default.nix    |  52 +++++
 7 files changed, 514 insertions(+)
