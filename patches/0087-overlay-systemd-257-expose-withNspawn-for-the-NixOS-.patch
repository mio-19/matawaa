From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 23:18:36 +1100
Subject: [PATCH] overlay/systemd-257: expose withNspawn for the NixOS 26.11
 module

Current NixOS checks the package attribute before installing the legacy systemd profile.
---
 overlay/systemd-257/default.nix | 1 +
 1 file changed, 1 insertion(+)

diff --git a/overlay/systemd-257/default.nix b/overlay/systemd-257/default.nix
index b704fccd..03024c23 100644
--- a/overlay/systemd-257/default.nix
+++ b/overlay/systemd-257/default.nix
@@ -893,6 +893,7 @@ stdenv.mkDerivation (finalAttrs: {
     # NixOS 26.11 checks this package attribute even though the vendored
     # systemd 257 definition predates it.
     withLogind = true;
+    withNspawn = true;
 
     inherit
       withBootloader
