+  # Incremental 4.14.213 -> 4.14.214 stable patch. The Fossil vendor tree
+  # already carries the dm-verity shutdown fix, so omit that upstream hunk.
+  stablePatch214 =
+    runCommand "linux-4.14.213-214.patch"
+      {
+        nativeBuildInputs = [ xz ];
+        src = fetchurl {
+          url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.14.213-214.xz";
+          hash = "sha256-z2VWV17dh99E2YhKa0kktt0VsLVi8rZPZEe2ELlvem8=";
+        };
+        patchFile = ./linux-4.14.213-214.patch.patch;
+      }
+      ''
+        mkdir -p "$TMPDIR/stable"
+        xz -dc "$src" > "$TMPDIR/stable/linux-4.14.213-214.patch"
+        (cd "$TMPDIR/stable" && patch -p1 -i "$patchFile")
+        cp "$TMPDIR/stable/linux-4.14.213-214.patch" "$out"
+      '';
+
   # Patch upstream defconfig to enable required Bluetooth protocols (RFCOMM, BNEP, HIDP),
   # Btrfs filesystem support, and transparent Zstandard/XXHash compression.
   configfile =
@@ -192,7 +211,7 @@ let
