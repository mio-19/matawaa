diff --git a/overlay/asteroidos/mapplauncherd/0001-Fix-dynamic-opening-issues.patch b/overlay/asteroidos/mapplauncherd/0001-Fix-dynamic-opening-issues.patch
new file mode 100644
index 00000000..993d33a1
--- /dev/null
+++ b/overlay/asteroidos/mapplauncherd/0001-Fix-dynamic-opening-issues.patch
@@ -0,0 +1,28 @@
+From 304762c3373d88274d888efbbfa7ad04d5eb0d07 Mon Sep 17 00:00:00 2001
+From: MagneFire <IDaNLContact@gmail.com>
+Date: Fri, 8 Jan 2021 22:15:30 +0100
+Subject: [PATCH] Make single-instance a shared library.
+Newer versions of glibc(>= 2.30) don't allow dlopen() on position independent executables. Normal (position dependent) executables weren't supported either.
+---
+ src/single-instance/CMakeLists.txt | 4 ++--
+ 1 file changed, 2 insertions(+), 2 deletions(-)
+
+Upstream-Status: Inappropriate
+
+diff --git a/src/single-instance/CMakeLists.txt b/src/single-instance/CMakeLists.txt
+index cc04ba2..1d3d13d 100644
+--- a/src/single-instance/CMakeLists.txt
++++ b/src/single-instance/CMakeLists.txt
+@@ -11,10 +11,10 @@ pkg_check_modules(DBUS dbus-1 REQUIRED)
+ include_directories(${CMAKE_CURRENT_SOURCE_DIR} ${DBUS_INCLUDE_DIRS} ${COMMON})
+ 
+ # Hide all symbols except the ones explicitly exported in the code (like main())
+-set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fvisibility=hidden -fPIC")
++set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fPIE -fvisibility=hidden -fPIC")
+ 
+ # Link as position independent executable
+-set(CMAKE_EXE_LINKER_FLAGS "-pie -rdynamic")
++set(CMAKE_EXE_LINKER_FLAGS "-rdynamic -shared")
+ 
+ # Set C flags because of report.c
+ set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fvisibility=hidden -fPIC")
diff --git a/overlay/asteroidos/mapplauncherd/0002-invoker-skip-the-sailjaild-D-Bus-query-when-sailjail.patch b/overlay/asteroidos/mapplauncherd/0002-invoker-skip-the-sailjaild-D-Bus-query-when-sailjail.patch
new file mode 100644
index 00000000..0597e987
--- /dev/null
+++ b/overlay/asteroidos/mapplauncherd/0002-invoker-skip-the-sailjaild-D-Bus-query-when-sailjail.patch
@@ -0,0 +1,40 @@
+From 934565b7817b85a341b88d23df7c90a28c62dd0a Mon Sep 17 00:00:00 2001
+From: Florent Revest <revestflo@gmail.com>
+Date: Wed, 10 Jun 2026 23:20:09 +0000
+Subject: [PATCH] invoker: skip the sailjaild D-Bus query when sailjail is not
+ installed
+
+Every launch performs a synchronous D-Bus round-trip (bus connect +
+method call + ServiceUnknown error reply) to org.sailfishos.sailjaild1
+on systems that do not ship the sandboxing daemon. Sandbox enforcement
+prepends /usr/bin/sailjail to the command anyway, so when that binary
+does not exist the query can never lead anywhere: gate it on
+access(SAILJAIL_PATH, X_OK) and drop the dead bus traffic from the
+launch critical path.
+
+Upstream-Status: Pending
+---
+ src/invoker/invoker.c | 7 +++++++
+ 1 file changed, 7 insertions(+)
+
+diff --git a/src/invoker/invoker.c b/src/invoker/invoker.c
+index 2bc1143..9642a7d 100644
+--- a/src/invoker/invoker.c
++++ b/src/invoker/invoker.c
+@@ -1136,6 +1136,13 @@ int main(int argc, char *argv[])
+         free(path);
+     }
+ 
++    // Sandboxing needs the sailjail binary (it gets prepended to the
++    // command below). On systems that do not ship it, skip the sailjaild
++    // D-Bus query: it is a synchronous bus round-trip (connect + method
++    // call + error reply) on the critical path of every single launch.
++    if (args.sandboxing_id && access(SAILJAIL_PATH, X_OK) == -1)
++        args.sandboxing_id = NULL;
++
+     // Application specific boosters are running in sandbox and can
+     // thus launch only sandboxed processes, otherwise
+     // If arguments don't define sailjail and sailjaild says the app must be sandboxed,
+-- 
+2.47.3
+
diff --git a/overlay/asteroidos/mapplauncherd/default.nix b/overlay/asteroidos/mapplauncherd/default.nix
new file mode 100644
index 00000000..08c75236
--- /dev/null
+++ b/overlay/asteroidos/mapplauncherd/default.nix
@@ -0,0 +1,48 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  glib,
+  dbus,
+  systemd,
+  libcap,
+  kdePackages,
+}:
+
+stdenv.mkDerivation {
+  pname = "mapplauncherd";
+  version = "2026-10-20";
+
+  src = fetchFromGitHub {
+    owner = "sailfishos";
+    repo = "mapplauncherd";
+    rev = "7216a9b5801ffe58d1021cc71b9e90ff7d67268f";
+    hash = "sha256-kdzWP+Ffzb8kDagtxnWtHWoRQcWagJbUqe7ZWFUoZnk=";
+  };
+
+  patches = [
+    ./0001-Fix-dynamic-opening-issues.patch
+    ./0002-invoker-skip-the-sailjaild-D-Bus-query-when-sailjail.patch
+  ];
+
+  strictDeps = true;
+  nativeBuildInputs = [ cmake pkg-config kdePackages.extra-cmake-modules ];
+  buildInputs = [ glib dbus systemd libcap ];
+  cmakeFlags = [ "-DECM_DIR=${kdePackages.extra-cmake-modules}/share/ECM/cmake" ];
+
+  # Upstream's documentation target requires unavailable Qt 5 tooling, and
+  # this systemd build exports libsystemd directly.
+  postPatch = ''
+    sed -i '/Target for documentation/,$d' CMakeLists.txt
+    sed -i 's@-L/lib -lsystemd-daemon@-lsystemd@' src/launcherlib/CMakeLists.txt
+  '';
+
+  meta = with lib; {
+    description = "AsteroidOS application launcher and invoker runtime";
+    homepage = "https://github.com/sailfishos/mapplauncherd";
+    license = licenses.lgpl21Only;
+    platforms = platforms.linux;
+  };
+}
