From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Tue, 20 Oct 2026 19:28:02 +1100
Subject: [PATCH] add packaging infrastructure (overlay/asteroidos)

Introduce the asteroid package set, the shared mkAsteroidApp derivation
builder, and the qml-asteroid wearable QML controls. Register the new
package set in the Mobile-NixOS overlay.
---
 overlay/asteroidos/default.nix               |  13 ++
 overlay/asteroidos/lib/mk-asteroid-app.nix   | 115 +++++++++++++++++
 overlay/asteroidos/lib/no-usr-share-hook.nix |   5 +
 overlay/asteroidos/lib/no-usr-share-hook.sh  |  30 +++++
 overlay/asteroidos/qml-asteroid/default.nix  | 124 +++++++++++++++++++
 overlay/oans/default.nix                     |  61 +++++++++
 overlay/overlay.nix                          |   5 +
 7 files changed, 353 insertions(+)
 create mode 100644 overlay/asteroidos/default.nix
 create mode 100644 overlay/asteroidos/lib/mk-asteroid-app.nix
 create mode 100644 overlay/asteroidos/lib/no-usr-share-hook.nix
 create mode 100644 overlay/asteroidos/lib/no-usr-share-hook.sh
 create mode 100644 overlay/asteroidos/qml-asteroid/default.nix
 create mode 100644 overlay/oans/default.nix

diff --git a/overlay/asteroidos/default.nix b/overlay/asteroidos/default.nix
new file mode 100644
index 00000000..f3735b09
--- /dev/null
+++ b/overlay/asteroidos/default.nix
@@ -0,0 +1,13 @@
+{ callPackage, pkgs }:
+
+rec {
+  noUsrShareHook = callPackage ./lib/no-usr-share-hook.nix { };
+
+  mkAsteroidApp = callPackage ./lib/mk-asteroid-app.nix {
+    inherit qml-asteroid noUsrShareHook;
+  };
+
+  qml-asteroid = callPackage ./qml-asteroid { inherit noUsrShareHook; };
+
+  inherit (pkgs) msm-fb-refresher;
+}
diff --git a/overlay/asteroidos/lib/mk-asteroid-app.nix b/overlay/asteroidos/lib/mk-asteroid-app.nix
new file mode 100644
index 00000000..fa056167
--- /dev/null
+++ b/overlay/asteroidos/lib/mk-asteroid-app.nix
@@ -0,0 +1,115 @@
+# Unified builder for AsteroidOS smartwatch applications
+# Inspired by Nixpkgs mkKdeDerivation: https://github.com/NixOS/nixpkgs/blob/master/pkgs/kde/lib/mk-kde-derivation.nix
+{
+  lib,
+  stdenv,
+  cmake,
+  pkg-config,
+  qt6,
+  qml-asteroid,
+  mapplauncherd,
+  noUsrShareHook,
+  kdePackages,
+  buildPackages,
+}:
+
+{
+  name,
+  pname ? "asteroid-${name}",
+  version ? "nightly",
+  owner ? "AsteroidOS",
+  repo ? pname,
+  src ? null,
+  rev ? null,
+  sha256 ? null,
+  hash ? null,
+  desc ? "Smartwatch application for AsteroidOS",
+  extraNativeBuildInputs ? [ ],
+  extraBuildInputs ? [ ],
+  patches ? [ ],
+  postPatch ? "",
+  cmakeFlags ? [ ],
+  meta ? { },
+  ...
+}:
+
+let
+  isCross = !stdenv.buildPlatform.canExecute stdenv.hostPlatform;
+in
+stdenv.mkDerivation (finalAttrs: {
+  inherit pname version;
+
+  src =
+    if src != null then
+      src
+    else
+      (buildPackages.fetchFromGitHub {
+        inherit owner repo rev;
+        ${if hash != null then "hash" else "sha256"} = if hash != null then hash else sha256;
+      });
+
+  strictDeps = true;
+  inherit patches;
+
+  postPatch = ''
+    # CMake install destinations must stay relative to CMAKE_INSTALL_PREFIX.
+    find . -name CMakeLists.txt -exec sed -i 's|DESTINATION /usr/share|DESTINATION share|g' {} +
+    grep -IlRZ '/usr/share/asteroid-launcher' . > "$TMPDIR/asteroid-launcher-paths" || [ "$?" -eq 1 ]
+    while IFS= read -r -d "" file; do
+      sed -i 's|/usr/share/asteroid-launcher|/run/current-system/sw/share/asteroid-launcher|g' "$file"
+    done < "$TMPDIR/asteroid-launcher-paths"
+  ''
+  + postPatch;
+
+  nativeBuildInputs = [
+    cmake
+    kdePackages.extra-cmake-modules
+    pkg-config
+    qt6.wrapQtAppsHook
+    qml-asteroid
+    noUsrShareHook
+  ]
+  ++ lib.optionals (!isCross) [
+    qt6.qtdeclarative
+    qt6.qttools
+  ]
+  ++ extraNativeBuildInputs;
+
+  cmakeFlags = [
+    "-DQT_MAJOR_VERSION=6"
+    "-DECM_DIR=${kdePackages.extra-cmake-modules}/share/ECM/cmake"
+  ]
+  ++ lib.optionals isCross [
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+    "-DQt6LinguistTools_DIR=${buildPackages.qt6.qttools}/lib/cmake/Qt6LinguistTools"
+  ]
+  ++ cmakeFlags;
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    qt6.qtsvg
+    qml-asteroid
+  ]
+  ++ extraBuildInputs;
+
+  # Self-contained app launcher scripts: ensure invoker is resolved to its absolute Nix store path
+  postFixup = ''
+    if [ -d "$out/bin" ]; then
+      find "$out/bin" -type f -exec sed -i "s|\\bexec invoker\\b|exec ${mapplauncherd}/bin/invoker|g" {} +
+    fi
+  '';
+
+  meta =
+    with lib;
+    {
+      description = desc;
+      homepage = "https://asteroidos.org/";
+      license = licenses.gpl3Plus;
+      mainProgram = pname;
+      platforms = platforms.linux;
+    }
+    // meta;
+})
