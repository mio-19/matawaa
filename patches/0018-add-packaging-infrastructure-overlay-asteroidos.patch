diff --git a/overlay/asteroidos/lib/no-usr-share-hook.sh b/overlay/asteroidos/lib/no-usr-share-hook.sh
new file mode 100644
index 00000000..afbe09c5
--- /dev/null
+++ b/overlay/asteroidos/lib/no-usr-share-hook.sh
@@ -0,0 +1,30 @@
+# Check installed runtime files after package-specific fixups and wrappers.
+auditNoUsrShare() {
+    local output dir file found=0
+    local -a files=()
+
+    for output in $outputs; do
+        for dir in ${usrShareAuditDirs:-bin lib libexec share}; do
+            if [ -d "${!output}/$dir" ]; then
+                mapfile -d '' files < <(
+                    find "${!output}/$dir" \( -type f -o -type l \) \
+                        ! -path '*/share/doc/*' \
+                        ! -path '*/docs/*' \
+                        ! -path '*/tests/*' \
+                        ! -name '*.md' \
+                        -print0
+                )
+                for file in "${files[@]}"; do
+                    if { [ -L "$file" ] && [[ $(readlink "$file") == *'/usr/share'* ]]; } || \
+                       { [ -f "$file" ] && LC_ALL=C grep -aFq '/usr/share' "$file"; }; then
+                        echo "Unpatched /usr/share reference: $file" >&2
+                        found=1
+                    fi
+                done
+            fi
+        done
+    done
+    return "$found"
+}
+
+postFixupHooks+=(auditNoUsrShare)
diff --git a/overlay/asteroidos/qml-asteroid/default.nix b/overlay/asteroidos/qml-asteroid/default.nix
new file mode 100644
index 00000000..db13a9a2
--- /dev/null
+++ b/overlay/asteroidos/qml-asteroid/default.nix
@@ -0,0 +1,124 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  qt6,
+  kdePackages,
+  buildPackages,
+  noUsrShareHook,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "qml-asteroid";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "AsteroidOS";
+    repo = "qml-asteroid";
+    rev = "c1905485d4aa22f964273e93a62ef23c27a7754b";
+    sha256 = "14l43mnff8a7v1dw1d066i0nvswxmj1la3k6a0mxkyzxhykw68iq";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    kdePackages.extra-cmake-modules
+    pkg-config
+    qt6.wrapQtAppsHook
+    noUsrShareHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+    qt6.qtsvg
+    qt6.qtshadertools
+    qt6.qtwayland
+  ];
+
+  postPatch = ''
+        substituteInPlace src/settings/src/languagemodel.cpp \
+          --replace-fail '"/usr/share/supported-languages"' '"/run/current-system/sw/share/supported-languages"'
+
+        substituteInPlace src/app/asteroidapp.cpp \
+          --replace-fail '"/usr/share/translations"' '"/run/current-system/sw/share/translations"' \
+          --replace-fail '"/usr/share/applications/"' '"/run/current-system/sw/share/applications/"' \
+          --replace-fail 'if (!translator->load(QLocale(), appName(), ".", "/run/current-system/sw/share/translations", ".qm")) {' \
+                         'if (!translator->load(QLocale(), appName(), ".", "/run/current-system/sw/share/translations", ".qm") && !translator->load(QLocale("en_GB"), appName(), ".", "/run/current-system/sw/share/translations", ".qm")) {'
+
+        substituteInPlace src/controls/src/icon.cpp \
+          --replace-fail '"/usr/share/icons/asteroid/"' '"/run/current-system/sw/share/icons/asteroid/"'
+
+        substituteInPlace src/controls/CMakeLists.txt \
+          --replace-fail '"-indexdir" "/usr/share/doc/qt5" ' ""
+
+        substituteInPlace CMakeLists.txt \
+          --replace-fail 'find_package(Mapplauncherd_qt6 MODULE REQUIRED)' ""
+        substituteInPlace src/app/CMakeLists.txt \
+          --replace-fail 'Mapplauncherd_qt6::Mapplauncherd_qt6' ""
+        substituteInPlace src/app/asteroidapp.cpp \
+          --replace-fail '#include <MDeclarativeCache>' '#include <QGuiApplication>
+    #include <QQuickView>
+    namespace MDeclarativeCache { inline QGuiApplication *qApplication(int &argc, char **argv) { return new QGuiApplication(argc, argv); } inline QQuickView *qQuickView() { return new QQuickView(); } }'
+
+        cat <<'EOF' > cmake/FindMapplauncherd_qt6.cmake
+    set(Mapplauncherd_qt6_FOUND TRUE)
+    if(NOT TARGET Mapplauncherd_qt6::Mapplauncherd_qt6)
+        add_library(Mapplauncherd_qt6::Mapplauncherd_qt6 INTERFACE IMPORTED)
+    endif()
+    EOF
+
+        cat <<'EOF' > cmake/FindTimed.cmake
+    set(Timed_FOUND TRUE)
+    set(Timed_LIBRARIES "timed-qt6")
+    if(NOT TARGET Timed::Timed)
+        add_library(Timed::Timed INTERFACE IMPORTED)
+        set_target_properties(Timed::Timed PROPERTIES
+            INTERFACE_LINK_LIBRARIES "timed-qt6"
+        )
+    endif()
+    EOF
+  '';
+
+  cmakeFlags = [
+    "-DWITH_ASTEROIDAPP=ON"
+    "-DWITH_CMAKE_MODULES=ON"
+    "-DECM_DIR=${kdePackages.extra-cmake-modules}/share/ECM/cmake"
+    "-DCMAKE_PREFIX_PATH=${qt6.qtdeclarative};${qt6.qtbase};${qt6.qtsvg};${qt6.qtwayland};${qt6.qtshadertools}"
+    "-DQt6Quick_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Quick"
+    "-DQt6Qml_DIR=${qt6.qtdeclarative}/lib/cmake/Qt6Qml"
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+  ];
+
+  dontWrapQtApps = true;
+
+  postInstall = ''
+        mkdir -p $out/lib/cmake/AsteroidApp6
+        cp -r $out/lib/cmake/asteroidapp6/* $out/lib/cmake/AsteroidApp6/ || true
+
+        mkdir -p $out/include
+        cat <<'EOF' > $out/include/MDeclarativeCache
+    #pragma once
+    #include <QGuiApplication>
+    #include <QQuickView>
+
+    namespace MDeclarativeCache {
+    inline QGuiApplication *qApplication(int &argc, char **argv) { return new QGuiApplication(argc, argv); }
+    inline QQuickView *qQuickView() { return new QQuickView(); }
+    }
+    EOF
+        cp $out/include/MDeclarativeCache $out/include/mdeclarativecache.h
+  '';
+
+  meta = with lib; {
+    description = "QML components, styles, and controls for AsteroidOS";
+    homepage = "https://asteroidos.org/";
+    license = licenses.lgpl3Plus;
+    platforms = platforms.linux;
+  };
+})
diff --git a/overlay/oans/default.nix b/overlay/oans/default.nix
new file mode 100644
index 00000000..e6888d6f
--- /dev/null
+++ b/overlay/oans/default.nix
@@ -0,0 +1,61 @@
+# oans: fast deduplication tool for btrfs/XFS, forked from duperemove.
+# Used as a build-time pass over the generated btrfs image.
+# https://github.com/martinus/oans
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  pkg-config,
+  glib,
+  sqlite,
+  util-linux,
+  libuuid,
+  libbsd,
+  xxhash,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "oans";
+  version = "1.14.1";
+
+  src = fetchFromGitHub {
+    owner = "martinus";
+    repo = "oans";
+    rev = "v${finalAttrs.version}";
+    hash = "sha256-rWUNNLCmmO/OLcuASBCRBe4d4Lpq4LqsB+QdLv3TNOw=";
+  };
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    pkg-config
+  ];
+
+  buildInputs = [
+    glib
+    sqlite
+    util-linux
+    libuuid
+    libbsd
+    xxhash
+  ];
+
+  # The Makefile derives the version from git; the release tarball has none.
+  makeFlags = [
+    "VERSION=${finalAttrs.version}"
+  ];
+
+  installPhase = ''
+    runHook preInstall
+    make install PREFIX=$out DESTDIR=
+    runHook postInstall
+  '';
+
+  meta = with lib; {
+    description = "Faster deduplication for btrfs and XFS (duperemove fork)";
+    homepage = "https://github.com/martinus/oans";
+    license = licenses.gpl2Only;
+    platforms = platforms.linux;
+    mainProgram = "oans";
+  };
+})
