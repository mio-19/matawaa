diff --git a/devices/asus-anthias/default.nix b/devices/asus-anthias/default.nix
new file mode 100644
index 00000000..0d0d7d5e
--- /dev/null
+++ b/devices/asus-anthias/default.nix
@@ -0,0 +1,57 @@
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+
+{
+  imports = [
+    ../families/asteroidos.nix
+  ];
+
+  mobile.device.name = "asus-anthias";
+  mobile.device.identity = {
+    name = "ZenWatch 1";
+    manufacturer = "ASUS";
+  };
+
+  mobile.device.supportLevel = "supported";
+
+  mobile.hardware = {
+    # Qualcomm Snapdragon 400 (APQ8026)
+    soc = "qualcomm-apq8026";
+    ram = 512;
+    screen = {
+      width = 320;
+      height = 320;
+      shape = "square";
+    };
+    watch = {
+      hasCrown = false;
+      hasHaptics = true;
+      aodSupport = true;
+      burnInProtection = true;
+    };
+  };
+
+  mobile.system.android = {
+    device_name = "anthias";
+    bootimg.flash = {
+      offset_base = "0x00000000";
+      offset_kernel = "0x00008000";
+      offset_ramdisk = "0x02000000";
+      offset_second = "0x00f00000";
+      offset_tags = "0x01e00000";
+      pagesize = "2048";
+    };
+  };
+
+  boot.kernelParams = [
+    "console=ttyMSM0,115200,n8"
+    "androidboot.console=ttyMSM0"
+    "androidboot.hardware=anthias"
+    "msm_rtb.filter=0x237"
+    "vmalloc=300M"
+  ];
+}
