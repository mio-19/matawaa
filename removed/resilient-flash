#!/usr/bin/env python3
"""Resilient Flasher for Smartwatches

Handles flaky USB pogo-pin magnetic cradles by chunking images, verifying SHA256
checksums per chunk, and resuming immediately upon disconnection.
All state is held strictly in-memory during execution (no disk checkpoints).
"""

import argparse
import hashlib
import os
import shutil
import struct
import subprocess
import sys
import tempfile
import time

SPARSE_MAGIC = 0xED26FF3A


def is_sparse(filepath):
  try:
    with open(filepath, "rb") as f:
      magic = struct.unpack("<I", f.read(4))[0]
      return magic == SPARSE_MAGIC
  except Exception:
    return False


def run_adb(adb_prefix, args, input_bytes=None, timeout=30, capture_only=False):
  cmd = adb_prefix + args
  proc = subprocess.Popen(
      cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE
  )
  try:
    stdout, stderr = proc.communicate(input=input_bytes, timeout=timeout)
    if not capture_only:
      if stdout:
        sys.stdout.write(stdout.decode("latin1", errors="replace"))
        sys.stdout.flush()
      if stderr:
        sys.stderr.write(stderr.decode("latin1", errors="replace"))
        sys.stderr.flush()
    else:
      # If capture_only, still pass through stderr if non-zero exit code
      if proc.returncode != 0 and stderr:
        sys.stderr.write(stderr.decode("latin1", errors="replace"))
        sys.stderr.flush()
    return proc.returncode, stdout, stderr
  except subprocess.TimeoutExpired:
    try:
      proc.kill()
      proc.communicate(timeout=2)
    except Exception:
      pass
    raise TimeoutError(f"ADB command timed out after {timeout}s: {' '.join(cmd)}")
  except Exception as e:
    try:
      proc.kill()
      proc.communicate(timeout=2)
    except Exception:
      pass
    raise e


def adb_kill_server(adb_prefix, reason="reset"):
  """Kills hung ADB server daemon to reset USB endpoints and sockets."""
  cmd_str = " ".join(adb_prefix + ["kill-server"])
  print(f"[*] Executing '{cmd_str}' [{reason}]...")
  try:
    proc = subprocess.Popen(
        adb_prefix + ["kill-server"], stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    stdout, stderr = proc.communicate(timeout=5)
    if stdout:
      sys.stdout.write(stdout.decode("latin1", errors="replace"))
      sys.stdout.flush()
    if stderr:
      sys.stderr.write(stderr.decode("latin1", errors="replace"))
      sys.stderr.flush()
  except Exception as e:
    print(f"    (kill-server warning: {e})")


def adb_start_server(adb_prefix):
  """Ensures ADB server is running cleanly."""
  for _ in range(5):
    try:
      proc = subprocess.Popen(
          adb_prefix + ["start-server"], stdout=subprocess.PIPE, stderr=subprocess.PIPE
      )
      stdout, stderr = proc.communicate(timeout=10)
      if proc.returncode == 0:
        return True
    except Exception:
      pass
    time.sleep(1)
  return False


def ensure_device_ready(adb_prefix, max_wait=30):
  """Verifies smartwatch connection over ADB in recovery mode.
  Handles 'offline' states with automatic reconnect, detects fastboot mode,
  and avoids unhandled 30s hangs on commands.
  """
  adb_start_server(adb_prefix)

  fastboot_cmd = ["sudo", "fastboot"] if "sudo" in adb_prefix else ["fastboot"]
  has_fastboot = shutil.which(fastboot_cmd[-1]) is not None

  start_t = time.time()
  last_offline_reconnect = 0

  while time.time() - start_t < max_wait:
    # 1. Check ADB devices
    try:
      proc = subprocess.Popen(
          adb_prefix + ["devices"], stdout=subprocess.PIPE, stderr=subprocess.PIPE
      )
      out, _ = proc.communicate(timeout=3)
      lines = [
          line.strip()
          for line in out.decode("latin1", errors="replace").splitlines()
          if line.strip()
          and not line.startswith("List of devices")
          and not line.startswith("*")
      ]
      for line in lines:
        parts = line.split()
        if len(parts) >= 2:
          serial, state = parts[0], parts[1]
          if state in ("recovery", "device"):
            print(f"[✓] Smartwatch connected in {state} mode ({serial}).")
            return True
          elif state == "offline":
            if time.time() - last_offline_reconnect > 5:
              print(f"[*] Device {serial} is offline. Attempting USB reconnect...")
              try:
                rec = subprocess.Popen(
                    adb_prefix + ["reconnect", "offline"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                )
                rec.communicate(timeout=3)
              except Exception:
                pass
              last_offline_reconnect = time.time()
            break
          elif state == "unauthorized":
            print(f"[!] Device {serial} is unauthorized. Please accept ADB prompt on watch.")
    except Exception:
      pass

    # 2. Check if device is in fastboot mode instead
    if has_fastboot:
      try:
        proc_fb = subprocess.Popen(
            fastboot_cmd + ["devices"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        fb_out, _ = proc_fb.communicate(timeout=2)
        fb_lines = [
            line.strip()
            for line in fb_out.decode("latin1", errors="replace").splitlines()
            if line.strip()
        ]
        if fb_lines:
          fb_serial = fb_lines[0].split()[0]
          print("\n" + "!" * 64)
          print(f"[!] Smartwatch ({fb_serial}) is in FASTBOOT mode, not Recovery mode!")
          print("!" * 64)
          print("    resilient-flash writes raw partitions using ADB in TWRP/recovery.")
          print("    To boot into TWRP recovery, run:")
          print("        fastboot boot path/to/twrp.img")
          print("    Or boot into recovery from the watch bootloader menu.")
          print("!" * 64 + "\n")
          raise RuntimeError("Smartwatch is in fastboot mode. Boot into recovery (TWRP) first.")
      except RuntimeError:
        raise
      except Exception:
        pass

    rem = max(1, int(max_wait - (time.time() - start_t)))
    sys.stdout.write(f"[*] Waiting for ADB device in recovery mode (check pogo pins)... {rem}s \r")
    sys.stdout.flush()
    time.sleep(1.5)

  print("\n[!] Error: Smartwatch not detected over ADB within timeout.", file=sys.stderr)
  print("    Please check that the watch is securely seated on the charging puck / magnetic cradle,", file=sys.stderr)
  print("    booted into TWRP recovery, or try replugging the USB cable / using a different USB port.", file=sys.stderr)
  raise TimeoutError("No ADB recovery device detected")


def wait_for_retry(adb_prefix, reason="retry", delay=10):
  """On failure: kill-server, start-server, wait 10s, then attempt writing directly."""
  print(
      "\n[!] Failure detected (adjust watch on magnetic cradle, reboot to recovery, replug USB cable, or plug into a different USB port if needed)."
  )
  adb_kill_server(adb_prefix, reason=reason)
  adb_start_server(adb_prefix)
  print(f"[*] Waiting {delay}s before retrying directly (no wait-for-device)...")
  for s in range(delay, 0, -1):
    sys.stdout.write(f"[*] Retrying directly in {s}s...\r")
    sys.stdout.flush()
    time.sleep(1)
  print(f"\n[*] Proceeding to attempt write directly...")


def find_boot_partitions(adb_prefix):
  """Finds boot partition(s) on device, supporting both A/B and legacy non-A/B layouts."""
  partitions = []
  ret_a, _, _ = run_adb(
      adb_prefix,
      ["shell", "test -e /dev/block/bootdevice/by-name/boot_a"],
      capture_only=True,
  )
  if ret_a == 0:
    partitions.append("/dev/block/bootdevice/by-name/boot_a")
    ret_b, _, _ = run_adb(
        adb_prefix,
        ["shell", "test -e /dev/block/bootdevice/by-name/boot_b"],
        capture_only=True,
    )
    if ret_b == 0:
      partitions.append("/dev/block/bootdevice/by-name/boot_b")
    return partitions

  ret_boot, _, _ = run_adb(
      adb_prefix,
      ["shell", "test -e /dev/block/bootdevice/by-name/boot"],
      capture_only=True,
  )
  if ret_boot == 0:
    return ["/dev/block/bootdevice/by-name/boot"]

  return []


def flash_partition(
    image_path,
    partition,
    adb_prefix,
    chunk_size_mb=16,
    verify=True,
    chunk_timeout=60,
):
  total_size = os.path.getsize(image_path)
  chunk_bytes = chunk_size_mb * 1024 * 1024
  num_chunks = (total_size + chunk_bytes - 1) // chunk_bytes

  print("=" * 64)
  print(f"Target Partition : {partition}")
  print(f"Source Image     : {image_path} ({total_size / (1024 * 1024):.1f} MB)")
  print(f"Chunk Size       : {chunk_size_mb} MB ({num_chunks} total chunks)")
  print(f"Verification     : {'SHA256 Checksumming' if verify else 'None'}")
  # Query partition capacity on device before flashing
  try:
    ret_sz, out_sz, _ = run_adb(
        adb_prefix,
        ["shell", f"blockdev --getsize64 {partition} 2>/dev/null || true"],
        capture_only=True,
    )
    if ret_sz == 0 and out_sz:
      part_bytes_str = out_sz.decode("latin1", errors="replace").strip()
      if part_bytes_str.isdigit():
        part_bytes = int(part_bytes_str)
        print(f"Partition Capacity: {part_bytes / (1024 * 1024):.1f} MB")
        if total_size > part_bytes:
          print(
              f"\n[!] ERROR: Image size ({total_size / (1024 * 1024):.1f} MB) exceeds"
              f" target partition capacity ({part_bytes / (1024 * 1024):.1f} MB)!",
              file=sys.stderr,
          )
          print(
              "    The uncompressed image cannot fit on this partition.",
              file=sys.stderr,
          )
          print(
              "    Please trim the image closure or flash sparse image with fastboot:",
              file=sys.stderr,
          )
          print(
              "      fastboot flash userdata system.img",
              file=sys.stderr,
          )
          sys.exit(1)
  except Exception:
    pass

  # State kept strictly in-memory
  verified_set = set()

  expected_full_hash = None
  if verify:
    print("[*] Computing whole image SHA256 on host...")
    whole_hasher = hashlib.sha256()
    with open(image_path, "rb") as f_hash:
      while chunk_b := f_hash.read(16 * 1024 * 1024):
        whole_hasher.update(chunk_b)
    expected_full_hash = whole_hasher.hexdigest()
    print(f"[i] Whole Image SHA256: {expected_full_hash}")

  with open(image_path, "rb") as f_img:
    start_time = time.time()
    for idx in range(num_chunks):
      offset_mb = idx * chunk_size_mb
      f_img.seek(idx * chunk_bytes)
      data = f_img.read(chunk_bytes)
      actual_chunk_len = len(data)
      actual_chunk_mb = (actual_chunk_len + (1024 * 1024) - 1) // (1024 * 1024)

      # Check if already verified in memory
      if idx in verified_set:
        pct = (idx + 1) * 100 // num_chunks
        print(
            f"[{pct:3d}%] Chunk {idx + 1:3d}/{num_chunks}: CACHED (verified in"
            " memory)"
        )
        continue

      # Compute host hash
      expected_hash = hashlib.sha256(data).hexdigest()

      chunk_flashed = False
      while not chunk_flashed:
        pct = (idx + 1) * 100 // num_chunks
        sys.stdout.write(
            f"[{pct:3d}%] Chunk {idx + 1:3d}/{num_chunks} ({actual_chunk_len / (1024 * 1024):.1f} MB): Writing..."
        )
        sys.stdout.flush()

        t0 = time.time()
        try:
          # Write chunk via dd with seek.
          # NOTE: Do NOT use count=... here! When reading from pipe stdin, dd counts each partial
          # read() syscall as an input record and aborts prematurely if count is specified.
          # Omitting count allows dd to read all input bytes until EOF (when pipe closes).
          cmd = [
              "shell",
              "-T",
              f"dd of={partition} bs=1048576 seek={offset_mb}",
          ]
          ret, _, err = run_adb(adb_prefix, cmd, input_bytes=data, timeout=chunk_timeout, capture_only=True)
          if ret != 0:
            err_msg = err.decode('latin1', errors='replace').strip()
            if offset_mb >= 2048 and "Invalid argument" in err_msg:
              print(
                  f"\n[!] FATAL: 'dd' failed with 'Invalid argument' at offset {offset_mb} MB (2 GiB boundary).",
                  file=sys.stderr,
              )
              print(
                  "    Reason: 32-bit seek offset overflow in recovery dd, or partition capacity reached.",
                  file=sys.stderr,
              )
              print(
                  "    Workaround: Flash the sparse image via fastboot: 'fastboot flash userdata system.img'",
                  file=sys.stderr,
              )
              print(
                  "    See BUGS.md for full technical details.",
                  file=sys.stderr,
              )
              sys.exit(1)
            raise RuntimeError(f"dd write failed: {err_msg}")

          dt = max(time.time() - t0, 0.001)
          speed = (actual_chunk_len / (1024 * 1024)) / dt

          if verify:
            sys.stdout.write(f" Verifying SHA256 ({speed:.1f} MB/s)...")
            sys.stdout.flush()

            # Read back chunk from watch and compute sha256 via pure POSIX pipeline
            # Using 2>/dev/null so dd record banners do not pollute the hash stream
            cmd_str = (
                f"dd if={partition} bs=1048576 skip={offset_mb}"
                f" count={actual_chunk_mb} 2>/dev/null |"
                f" head -c {actual_chunk_len} | sha256sum"
            )

            v_cmd = ["shell", "-T", cmd_str]
            v_ret, v_out, v_err = run_adb(
                adb_prefix,
                v_cmd,
                timeout=max(60, chunk_timeout),
                capture_only=True,
            )
            if v_ret != 0:
              raise RuntimeError(
                  f"SHA256 readback failed: {v_err.decode('latin1', errors='replace')}"
              )

            parts = v_out.decode(errors="replace").split()
            if not parts:
              raise RuntimeError(f"Device returned empty SHA256 output: {v_err.decode('latin1', errors='replace')}")
            watch_hash = parts[0]
            if watch_hash != expected_hash:
              print(f" MISMATCH! (Got {watch_hash[:8]} vs {expected_hash[:8]})")
              raise ValueError("Checksum mismatch on device")

          chunk_flashed = True
          verified_set.add(idx)
          sys.stdout.write(" OK\n")
          sys.stdout.flush()

        except Exception as ex:
          sys.stdout.write(f" FAILED: {ex}\n")
          wait_for_retry(
              adb_prefix,
              reason=f"chunk {idx + 1} write/verify exception",
              delay=10,
          )

    # Sync device filesystem buffers
    print("[*] Syncing hardware flash buffers...")
    run_adb(adb_prefix, ["shell", "sync"], timeout=30)
    total_time = time.time() - start_time
    print(
        f"[✓] Successfully flashed and verified all {num_chunks} chunks in"
        f" {total_time:.1f}s!"
    )

    if verify and expected_full_hash:
      print("\n" + "-" * 64)
      print(
          f"[*] Final Verification: Checking whole partition SHA256 ({total_size / (1024 * 1024):.1f} MB)..."
      )
      full_verified = False
      total_blocks = (total_size + 1048575) // 1048576
      while not full_verified:
        cmd_str = (
            f"dd if={partition} bs=1048576 count={total_blocks}"
            f" 2>/dev/null | head -c {total_size} | sha256sum"
        )

        try:
          sys.stdout.write("Reading back entire partition from watch eMMC...")
          sys.stdout.flush()
          t_vf0 = time.time()
          v_ret, v_out, v_err = run_adb(
              adb_prefix, ["shell", "-T", cmd_str], timeout=360, capture_only=True
          )
          if v_ret != 0:
            raise RuntimeError(
                f"Full partition SHA256 readback failed: {v_err.decode('latin1', errors='replace')}"
            )

          parts = v_out.decode(errors="replace").split()
          if not parts:
            raise RuntimeError("Device returned empty SHA256 output")
          device_full_hash = parts[0]
          vf_dt = max(time.time() - t_vf0, 0.001)
          vf_speed = (total_size / (1024 * 1024)) / vf_dt
          if device_full_hash != expected_full_hash:
            print(
                f"\n[!] FULL PARTITION CHECKSUM MISMATCH! ({vf_speed:.1f} MB/s)"
            )
            print(f"    Expected: {expected_full_hash}")
            print(f"    Got:      {device_full_hash}")
            raise ValueError("Whole partition SHA256 verification failed!")

          print(f" OK! ({vf_speed:.1f} MB/s)")
          print(f"[✓] Whole Partition SHA256 Verified: {device_full_hash}")
          full_verified = True
        except Exception as ex:
          sys.stdout.write(f" FAILED: {ex}\n")
          wait_for_retry(
              adb_prefix,
              reason="whole partition verification exception",
              delay=10,
          )
      print("-" * 64 + "\n")


def main():
  parser = argparse.ArgumentParser(
      description=(
          "Resilient Flasher for Smartwatches: handles flaky pogo-pin USB"
          " connections with in-memory chunked resume & SHA256 verification."
      )
  )
  parser.add_argument(
      "targets",
      nargs="+",
      help=(
          "Path to system.img, directory containing images, boot.img, and/or"
          " device name (in any order)"
      ),
  )
  parser.add_argument(
      "--boot-img",
      default=None,
      help="Path to boot.img (default: auto-detected in image dir, result/boot.img, or sibling)",
  )
  parser.add_argument(
      "--no-boot",
      action="store_true",
      help="Skip flashing boot partition",
  )
  parser.add_argument(
      "--userdata-partition",
      default="/dev/block/bootdevice/by-name/userdata",
      help="Destination partition for system.img",
  )
  parser.add_argument(
      "--chunk-size",
      type=int,
      default=16,
      help="Chunk size in MB (default: 16 MB)",
  )
  parser.add_argument(
      "--sudo",
      action="store_true",
      help="Run adb commands with sudo if host permissions require it",
  )
  parser.add_argument(
      "--no-verify",
      action="store_true",
      help="Disable per-chunk SHA256 checksum verification",
  )
  parser.add_argument(
      "--timeout",
      type=int,
      default=60,
      help="Timeout in seconds for writing each chunk (default: 60s)",
  )
  parser.add_argument(
      "--reboot", action="store_true", help="Reboot watch after successful flash"
  )
  args = parser.parse_args()

  adb_prefix = ["sudo", "adb"] if args.sudo else ["adb"]

  # Check if adb is available
  if not shutil.which(adb_prefix[-1]):
    print(f"Error: '{adb_prefix[-1]}' command not found on host.", file=sys.stderr)
    sys.exit(1)

  # Ensure ADB server is running and smartwatch is connected in recovery mode
  ensure_device_ready(adb_prefix, max_wait=30)

  # Resolve paths from flexible arguments
  system_path = None
  boot_img = os.path.abspath(args.boot_img) if args.boot_img else None

  for t in args.targets:
    t_abs = os.path.abspath(t)
    if os.path.isdir(t_abs):
      candidate_sys = os.path.join(t_abs, "system.img")
      if os.path.exists(candidate_sys):
        system_path = candidate_sys
      if not boot_img and not args.no_boot:
        candidate_boot = os.path.join(t_abs, "boot.img")
        if os.path.exists(candidate_boot):
          boot_img = candidate_boot
    elif os.path.isfile(t_abs):
      if os.path.basename(t_abs) == "boot.img":
        boot_img = t_abs
      elif os.path.basename(t_abs) in ("system.img", "rootfs.img") or t_abs.endswith(".img"):
        if not system_path or os.path.basename(t_abs) == "system.img":
          system_path = t_abs
      elif not system_path:
        system_path = t_abs
    elif os.path.exists(os.path.join("devices", t)):
      # Ignored device name parameter (e.g. 'fossil-hoki')
      pass
    elif not system_path and not os.path.exists(t_abs):
      # Might be device name without matching devices directory
      pass

  # Fallback auto-detection for boot.img if not specified
  if system_path and not boot_img and not args.no_boot:
    sibling_boot = os.path.join(os.path.dirname(system_path), "boot.img")
    if os.path.exists(sibling_boot):
      boot_img = sibling_boot
    elif os.path.exists("result/boot.img"):
      boot_img = os.path.abspath("result/boot.img")

  if not system_path or not os.path.exists(system_path):
    print(f"Error: Valid system image or directory not found in targets: {args.targets}", file=sys.stderr)
    sys.exit(1)

  # Check sparse vs raw
  raw_path = system_path
  temp_raw_created = False
  if is_sparse(system_path):
    print(
        f"[i] Detected Android sparse format in {system_path}. Unsparsing"
        " on host..."
    )
    if not shutil.which("simg2img"):
      print(
          "Error: 'simg2img' tool required to unsparse image on host.",
          file=sys.stderr,
      )
      sys.exit(1)
    raw_path = os.path.join(
        tempfile.gettempdir(),
        f"resilient_flash_raw_{os.getpid()}_{int(time.time())}.img",
    )
    subprocess.check_call(["simg2img", system_path, raw_path])
    temp_raw_created = True

  try:
    # Unmount target partitions if mounted in recovery (safe best-effort)
    try:
      run_adb(
          adb_prefix,
          ["shell", f"umount {args.userdata_partition} /data /userdata 2>/dev/null || true"],
          timeout=10,
          capture_only=True,
      )
    except Exception as e:
      print(f"[*] Note: pre-flash unmount note: {e}")

    # 1. Flash Userdata / Rootfs
    flash_partition(
        raw_path,
        args.userdata_partition,
        adb_prefix,
        chunk_size_mb=args.chunk_size,
        verify=not args.no_verify,
        chunk_timeout=args.timeout,
    )

    # 2. Flash Boot image if available
    if not args.no_boot and boot_img and os.path.exists(boot_img):
      print("\n" + "=" * 64)
      print(f"Flashing kernel boot image: {boot_img}")
      print("=" * 64)
      boot_parts = find_boot_partitions(adb_prefix)
      if not boot_parts:
        print(
            "[!] Warning: No boot partition found on device! Skipping boot image.",
            file=sys.stderr,
        )
      else:
        for boot_part in boot_parts:
          flash_partition(
              boot_img,
              boot_part,
              adb_prefix,
              chunk_size_mb=8,
              verify=not args.no_verify,
              chunk_timeout=args.timeout,
          )

    # 3. Clean stale Android cache
    print("\n[*] Initializing clean cache partition...")
    run_adb(
        adb_prefix,
        [
            "shell",
            (
                "umount /cache /dev/block/bootdevice/by-name/cache 2>/dev/null || true; "
                "mke2fs -t ext4 /dev/block/bootdevice/by-name/cache || "
                "make_ext4fs /dev/block/bootdevice/by-name/cache"
            ),
        ],
        timeout=15,
        capture_only=True,
    )

    if args.reboot:
      print("\n[*] Rebooting into NixOS...")
      run_adb(adb_prefix, ["reboot"], timeout=10)

    print("\n[✓] ALL FLASH OPERATIONS COMPLETE AND VERIFIED!")

  finally:
    if temp_raw_created and os.path.exists(raw_path):
      try:
        os.remove(raw_path)
      except Exception:
        pass


if __name__ == "__main__":
  try:
    main()
  except KeyboardInterrupt:
    print("\n[!] Flashing aborted by user (Ctrl+C).")
    sys.exit(130)
  except (TimeoutError, RuntimeError) as err:
    print(f"\n[!] Error: {err}", file=sys.stderr)
    sys.exit(1)
  except Exception as e:
    print(f"\n[!] Flash error: {e}", file=sys.stderr)
    sys.exit(1)
